func _show_warehouse_item_retrieve_popup(item, on_retrieve: Callable = Callable()) -> void :
	if item == null:
		return
	var item_id: = ""
	var item_name: = "物品"
	var item_count: = 1
	var item_type: = ""
	var rarity_color: = Color(0.9, 0.9, 0.9)
	var desc_text: = "暂无介绍"
	if item is Dictionary:
		item_id = str(item.get("id", ""))
		item_name = str(item.get("name", "物品"))
		item_count = max(1, int(item.get("count", 1)))
		item_type = str(item.get("item_type", item.get("type", "")))
		var cd: Dictionary = item.get("custom_data", {}) if item.get("custom_data") is Dictionary else {}
		if item_type == "sealed_suit" and not cd.is_empty():
			item_name = _get_sealed_suit_display_name(cd)
			desc_text = "封印状态的套装装备"
			rarity_color = Color(0.5, 0.5, 0.5)
		else:
			if GameData.ALL_ITEMS.has(item_name):
				var cfg = GameData.ALL_ITEMS[item_name]
				if cfg is Dictionary:
					desc_text = str(cfg.get("desc", desc_text))
	else:
		if "id" in item:
			item_id = str(item.id)
		if "name" in item:
			item_name = str(item.name)
		if "count" in item:
			item_count = max(1, int(item.count))
		if "item_type" in item:
			item_type = str(item.item_type)
		if item_type == "sealed_suit" and "custom_data" in item and item.custom_data is Dictionary and item.custom_data.size() > 0:
