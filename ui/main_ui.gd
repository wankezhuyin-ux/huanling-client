func clear_deferred_attr_authoritative_save() -> void :
	_deferred_attr_authoritative_save.clear()

func _flush_deferred_attr_authoritative_save() -> void :
	if game_manager == null or _deferred_attr_authoritative_save.is_empty():
		return
	var save_data: Dictionary = _deferred_attr_authoritative_save.duplicate(true)
	_deferred_attr_authoritative_save.clear()
	var pd: Variant = save_data.get("playerData", {})
	if not pd is Dictionary or pd.is_empty():
		return
	var save_rev: int = int(save_data.get("saveRevision", -1))
	if save_rev < 0:
		save_rev = game_manager._extract_save_revision_from_save_data(save_data)
	if game_manager.is_field_combat_hp_merge_blocked():
		game_manager.persist_player_attr_authoritative_after_rpc(save_rev)
	else:
		game_manager.apply_player_attr_authoritative_from_rpc(save_data, pd as Dictionary, save_rev, false)
	_flush_pending_battle_attr_logs()
	_maybe_retry_player_attr_auto_allocate("battle_loot")

