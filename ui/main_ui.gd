## 战斗页底栏四键。原先贴的是蓝色渐变九宫格，战场再花就彻底糊了；
## 现在统一墨底金线，停止战斗用朱砂示警。tex 参数保留只为兼容旧调用点。
func _apply_battle_bottom_button_style(btn: Button, _tex: Texture2D) -> void:
	if btn == null:
		return
	var accent: Color = INK_GOLD
	if btn.name == "StopBattleBtn":
		accent = INK_CINNABAR
	var fs: = btn.get_theme_font_size("font_size")
	if fs <= 0:
		fs = _ink_font(21.0)
	_ink_outline_button(btn, fs, accent)
	# 战场底色是实时截图，金线 0.09 的透明底压不住，这里补一层厚墨底。
	for st_name in ["normal", "hover", "pressed", "disabled"]:
		var base := btn.get_theme_stylebox(st_name)
		if base is StyleBoxFlat:
			var cp: StyleBoxFlat = (base as StyleBoxFlat).duplicate()
			cp.bg_color = Color(0.031, 0.038, 0.041, 0.82)
			btn.add_theme_stylebox_override(st_name, cp)
	btn.add_theme_constant_override("outline_size", 0)
	_ensure_button_press_scale_feedback(btn)

func _ensure_button_press_scale_feedback(btn: Button) -> void :
	if btn == null:
		return

	if bool(btn.get_meta("_press_scale_feedback", false)):
		btn.pivot_offset = btn.size * 0.5
		return
	btn.set_meta("_press_scale_feedback", true)
	btn.pivot_offset = btn.size * 0.5
	if not btn.resized.is_connected(_on_press_scale_btn_resized.bind(btn)):
		btn.resized.connect(_on_press_scale_btn_resized.bind(btn))
	btn.button_down.connect(_on_press_scale_btn_down.bind(btn))
	btn.button_up.connect(_on_press_scale_btn_up.bind(btn))
	btn.mouse_exited.connect(_on_press_scale_btn_mouse_exited.bind(btn))

func _on_press_scale_btn_resized(btn: Button) -> void :
	if btn != null and is_instance_valid(btn):
		btn.pivot_offset = btn.size * 0.5

func _on_press_scale_btn_down(btn: Button) -> void :
	_tween_button_press_scale(btn, 0.92)

func _on_press_scale_btn_up(btn: Button) -> void :
	_tween_button_press_scale(btn, 1.0)

func _on_press_scale_btn_mouse_exited(btn: Button) -> void :
	if btn != null and is_instance_valid(btn) and not btn.button_pressed:
		_tween_button_press_scale(btn, 1.0)

func _tween_button_press_scale(btn: Button, target: float) -> void :
	if btn == null or not is_instance_valid(btn):
		return
	btn.pivot_offset = btn.size * 0.5
	var old_tw = btn.get_meta("_press_scale_tween", null)
	if old_tw is Tween and is_instance_valid(old_tw):
		old_tw.kill()
	var tw: = btn.create_tween()
	btn.set_meta("_press_scale_tween", tw)
	tw.set_trans(Tween.TRANS_QUAD)
	tw.set_ease(Tween.EASE_OUT)
	tw.tween_property(btn, "scale", Vector2(target, target), 0.08)


func _wrap_fixed_square_button(btn: Button, side: float = 36.0) -> Control:
	var slot: = Control.new()
	slot.custom_minimum_size = Vector2(side, side)

	slot.size_flags_horizontal = 0
	slot.size_flags_vertical = 0
	slot.mouse_filter = Control.MOUSE_FILTER_PASS
	btn.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	btn.offset_left = 0.0
	btn.offset_top = 0.0
	btn.offset_right = 0.0
	btn.offset_bottom = 0.0
	btn.custom_minimum_size = Vector2(side, side)
	slot.add_child(btn)
	return slot

