	network = net
	network_user_id = user_id
	network_nickname = nickname
	_registered_character_name = character_name if character_name != "" else nickname

	_vip_info_loaded_successfully = false
	_force_vip_request_timer = 0.0
	if game_manager:
		game_manager.reset_session_save_state_for_account_switch()

	if game_manager and not game_manager.initialized:
		var skip_local_disk: bool = save_data != null and save_data.has("playerData")

		if network_user_id > 0 or not String(auth_token).strip_edges().is_empty():
			skip_local_disk = true
		game_manager.initialize(skip_local_disk)

	if network:
		add_child(network)
		network.save_uploaded.connect(_on_save_uploaded)
		network.save_downloaded.connect(_on_save_downloaded)
		network.vip_info_loaded.connect(_on_vip_info_loaded)
