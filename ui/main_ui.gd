func _finish_styled_popup(popup: Window) -> void :
	if popup == null or not is_instance_valid(popup):
		return
	add_child(popup)
	popup.popup_centered()
	UIStyle.animate_window_popup(popup)
	# 弹窗自带的 Panel 补第二根金线（和页面面板同一套框）
	var shell := popup.get_child(0) as Control if popup.get_child_count() > 0 else null
	if shell is Panel:
		_ink_add_inner_line(shell, 4.0, 0.28)
	_install_modal_dim()
	# ⚠️ 这里是 add_child 之后才装遮罩的：本弹窗的 node_added 早就发过了，
	# 永远不会被自动挂上 visibility_changed —— 表现就是"点取消后遮罩一直灰着"。
	# 所以当下这个弹窗必须手动挂一次。
	_hook_modal_dim_popup(popup)
	_refresh_modal_dim()


# ---------------------------------------------------------------- 弹窗遮罩
## 之前弹窗是"浮"在最亮的一层上，背景一点没压，玩家的注意力会被列表拉走；
## 设计稿里弹窗背后有整片压暗。这里补一层全屏遮罩：
##   · 挂在 MainUI 根上、铺满视口 → 顶栏和 dock 一起压，不再只压内容区
##   · mouse_filter = IGNORE → 不抢点击（弹窗是独立 Window，本来就浮在上面）
##   · 靠 node_added + tree_exiting 自动跟随弹窗数量，不需要每个弹窗手动开关
var _modal_dim: ColorRect = null
var _modal_dim_hooked := false


func _install_modal_dim() -> void:
	if _modal_dim != null and is_instance_valid(_modal_dim):
		return
	_modal_dim = ColorRect.new()
	_modal_dim.name = "ModalDim"
	_modal_dim.color = Color(0.006, 0.006, 0.004, 0.0)
	_modal_dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_modal_dim.visible = false
	add_child(_modal_dim)
	# ⚠️ MainUI 根的 size 有时是 (0,0)（anchors 尚未被 viewport 拉伸），
	# FULL_RECT 算出来就是 0×0 —— 表现是"遮罩建了但什么都没画"。
	# 和 InkPageBackdrop 一样，直接按视口尺寸定位。
	_modal_dim.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	_modal_dim.position = Vector2.ZERO
	_modal_dim.size = get_viewport_rect().size
	var vp := get_viewport()
	if vp != null and not vp.size_changed.is_connected(_fit_modal_dim):
		vp.size_changed.connect(_fit_modal_dim)
	if not _modal_dim_hooked:
		_modal_dim_hooked = true
		var tree := get_tree()
		if tree != null and not tree.node_added.is_connected(_on_any_node_added):
			tree.node_added.connect(_on_any_node_added)


func _fit_modal_dim() -> void:
	if _modal_dim == null or not is_instance_valid(_modal_dim):
		return
	_modal_dim.position = Vector2.ZERO
	_modal_dim.size = get_viewport_rect().size


func _on_any_node_added(node: Node) -> void:
	if node is Window and node.get_parent() == self:
		_hook_modal_dim_popup(node as Window)
		call_deferred("_refresh_modal_dim")


## 让某个弹窗在"显示/收起/被释放"时都通知遮罩重算。幂等。
func _hook_modal_dim_popup(win: Window) -> void:
	if win == null or not is_instance_valid(win):
		return
	if not win.tree_exiting.is_connected(_refresh_modal_dim):
		win.tree_exiting.connect(_refresh_modal_dim)
	if not win.visibility_changed.is_connected(_refresh_modal_dim):
		win.visibility_changed.connect(_refresh_modal_dim)


## 只要有任何一个可见弹窗，就把遮罩拉到目标透明度
const MODAL_DIM_ALPHA := 0.62

## 遮罩兜底：任何异常路径（弹窗被别处 hide/free、信号没接上）都不该把玩家
## 卡在一层灰暗里。0.25 秒巡检一次，没有可见弹窗就直接归零。
var _modal_dim_watch := 0.0

func _guard_modal_dim(delta: float) -> void:
	_modal_dim_watch += delta
	if _modal_dim_watch < 0.25:
		return
	_modal_dim_watch = 0.0
	if _modal_dim == null or not is_instance_valid(_modal_dim):
		return
	if not _modal_dim.visible:
		return
	if _ink_count_open_windows() > 0:
		return
	var c: Color = _modal_dim.color
	c.a = 0.0
	_modal_dim.color = c
	_modal_dim.visible = false


## 当前有几个真正显示中的弹窗（只算挂在 MainUI 下、且真的在树里可见的 Window）
func _ink_count_open_windows() -> int:
	var open := 0
	for c in get_children():
		if c is Window:
			var w: Window = c
			if w.visible and w.is_inside_tree() and not w.is_queued_for_deletion():
				open += 1
	return open

func _refresh_modal_dim() -> void:
	if _modal_dim == null or not is_instance_valid(_modal_dim):
		return
	var open := _ink_count_open_windows()
	var target: float = MODAL_DIM_ALPHA if open > 0 else 0.0
	_modal_dim.visible = target > 0.0 or _modal_dim.color.a > 0.01
	var tw := create_tween()
	tw.tween_property(_modal_dim, "color:a", target, 0.14 if target > 0.0 else 0.20)
	if target <= 0.0:
		tw.tween_callback(func() -> void:
			if _modal_dim != null and is_instance_valid(_modal_dim):
				_modal_dim.visible = false
		)

func _sanitize_dialog_text(raw_text: String, fallback_text: String) -> String:
	var text: = str(raw_text).strip_edges()
	if text.is_empty():
		return fallback_text
	var lines: = text.split("\n", false)
	var cleaned: Array[String] = []
	for line in lines:
		var trimmed: = str(line).strip_edges()
		var probe: = trimmed.replace("?", "").replace("？", "")
		if probe.is_empty():
			cleaned.append(fallback_text)
		else:
			cleaned.append(trimmed)
	return "\n".join(cleaned)

func _show_simple_dialog(title: String, message: String):
	var safe_message: = _sanitize_dialog_text(message, "操作失败，请稍后重试")
	var popup_key = "simple_dialog:%s:%s" % [title, safe_message]
	if _focus_existing_popup(popup_key):
		return
	var popup_width = 450
	var lines = safe_message.split("\n")
	var line_count = lines.size()
	var content_height = max(100, line_count * 28)
	var popup_height = 180 + content_height

	var dialog = Window.new()
	_mark_popup_key(dialog, popup_key)
	dialog.title = ""
	dialog.size = Vector2i(popup_width, popup_height)
	dialog.transparent = true
	dialog.borderless = true
	dialog.unresizable = true
	var close_dialog_once: = func():
		if not is_instance_valid(dialog):
			return
		if dialog.has_meta("closed"):
			return
		dialog.set_meta("closed", true)
		dialog.queue_free()
	dialog.close_requested.connect(close_dialog_once)

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	dialog.add_child(main_panel)

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 25
	vbox.offset_top = 25
	vbox.offset_right = -25
	vbox.offset_bottom = -25
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 20)
	main_panel.add_child(vbox)

	var title_label = Label.new()
	title_label.text = title
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 24)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	title_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vbox.add_child(title_label)

	var scroll = ScrollContainer.new()
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	vbox.add_child(scroll)

	var inner_vbox = VBoxContainer.new()
	inner_vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(inner_vbox)

	for line in lines:
		var line_label = Label.new()
		line_label.text = line
		line_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		line_label.add_theme_font_size_override("font_size", 18)
		line_label.add_theme_color_override("font_color", Color(0.9, 0.9, 0.95))
		line_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		inner_vbox.add_child(line_label)

	var btn_container = CenterContainer.new()
	btn_container.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_child(btn_container)

	var ok_btn = Button.new()
	ok_btn.text = "确定"
	UIStyle.style_popup_button(ok_btn, true)
	ok_btn.pressed.connect(close_dialog_once)
	btn_container.add_child(ok_btn)

	_present_modal_window(dialog)

func _show_network_required_quit_dialog(_message: String) -> void :
	var dlg: = Window.new()
	dlg.title = ""
	dlg.size = Vector2i(480, 260)
	dlg.transparent = true
	dlg.borderless = true
	dlg.unresizable = true
	var quit_game: = func() -> void :
		get_tree().quit()
	dlg.close_requested.connect(quit_game)

	var main_panel: = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	dlg.add_child(main_panel)

	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 25
	vbox.offset_top = 25
	vbox.offset_right = -25
	vbox.offset_bottom = -25
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 28)
	main_panel.add_child(vbox)

	var status_label: = Label.new()
	status_label.text = "正在自动重连…"
	status_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	status_label.add_theme_font_size_override("font_size", 24)
	status_label.add_theme_color_override("font_color", Color(0.92, 0.93, 0.96))
	vbox.add_child(status_label)

	var btn_container: = CenterContainer.new()
	btn_container.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_child(btn_container)

	var quit_btn: = Button.new()
	quit_btn.text = "退出"
	UIStyle.style_popup_button(quit_btn, false, Vector2(160, 50))
	quit_btn.pressed.connect(quit_game)
	btn_container.add_child(quit_btn)

	_present_modal_window(dlg)

	var retry_timer: = Timer.new()
	retry_timer.wait_time = 5.0
	retry_timer.one_shot = false
	dlg.add_child(retry_timer)
	retry_timer.timeout.connect( func _do_retry():
		if not is_instance_valid(dlg):
			return
		var http: = HTTPRequest.new()
		http.timeout = 10.0
		dlg.add_child(http)
		http.request_completed.connect( func(result: int, response_code: int, _h: PackedStringArray, _b: PackedByteArray):
			if is_instance_valid(http):
				http.queue_free()
			if result == HTTPRequest.RESULT_SUCCESS and response_code == 200:
				_online_gate_request_busy = false
				_online_gate_timer = 0.0
				if is_instance_valid(dlg):
					retry_timer.stop()
					dlg.queue_free()
					_add_log("[color=green]网络已恢复，游戏继续。[/color]")
				return
			var fallback: = HTTPRequest.new()
			fallback.timeout = 10.0
			dlg.add_child(fallback)
			fallback.request_completed.connect( func(fb_result: int, fb_code: int, _fh: PackedStringArray, _fb: PackedByteArray):
				if is_instance_valid(fallback):
					fallback.queue_free()
				if fb_result == HTTPRequest.RESULT_SUCCESS and fb_code == 200:
					_online_gate_request_busy = false
					_online_gate_timer = 0.0
					if is_instance_valid(dlg):
						retry_timer.stop()
						dlg.queue_free()
						_add_log("[color=green]网络已恢复，游戏继续。[/color]")
			, CONNECT_ONE_SHOT)
			fallback.request(_GameServerConfig.connectivity_fallback_url(), [], HTTPClient.METHOD_GET)
		, CONNECT_ONE_SHOT)
		http.request(_GameServerConfig.updates_manifest_url(), [], HTTPClient.METHOD_GET)
	)
	retry_timer.start()

func _on_network_sync_health_changed(is_degraded: bool, message: String) -> void :
	_refresh_sync_status_label()
	var now_ms: = Time.get_ticks_msec()
	if is_degraded:
		if _sync_degraded_started_ms <= 0:
			_sync_degraded_started_ms = now_ms
		if now_ms - _last_sync_log_ms >= SYNC_STATUS_LOG_COOLDOWN_MS:
			_last_sync_log_ms = now_ms
			_add_log("[color=yellow]%s[/color]" % message)
		var should_popup: = (now_ms - _last_sync_degraded_popup_ms) >= SYNC_DEGRADED_POPUP_COOLDOWN_MS
		if not _sync_degraded_notified:
			_sync_degraded_notified = true
			if should_popup:
				_last_sync_degraded_popup_ms = now_ms
				_show_simple_dialog("同步异常", message + "\n关键操作已临时锁定，网络恢复后自动解除。")
		return
	if _sync_degraded_notified:
		_sync_degraded_notified = false
		if _sync_degraded_started_ms > 0 and now_ms - _sync_degraded_started_ms >= SYNC_RECOVERY_LOG_MIN_DEGRADED_MS:
			_add_log("[color=green]网络恢复，云端同步已恢复正常。[/color]")
	_sync_degraded_started_ms = 0

func _on_network_sync_heartbeat_ok() -> void :

	call_deferred("_try_auto_realm_transition")

func _refresh_sync_status_label() -> void :
	if sync_status_label == null or not is_instance_valid(sync_status_label):
		return
	if not network or not network.is_logged_in():
		sync_status_label.text = "同步: 未登录"
		sync_status_label.modulate = Color(0.75, 0.75, 0.75)
		return
	var status_msg: = "同步正常"
	if network.has_method("get_sync_status_message"):
		status_msg = str(network.get_sync_status_message())
	var degraded: = false
	if network.has_method("is_sync_degraded"):
		degraded = bool(network.is_sync_degraded())
	if degraded:
		sync_status_label.text = "同步: 异常"
		sync_status_label.modulate = Color(1.0, 0.45, 0.45)
		sync_status_label.tooltip_text = status_msg
	else:
		sync_status_label.text = "同步: 正常"
		sync_status_label.modulate = Color(0.45, 1.0, 0.55)
		sync_status_label.tooltip_text = status_msg


func _main_ui_session_uses_http_api_fallback() -> bool:
	return network != null and str(network.server_url) == _GameServerConfig.api_http_fallback_base()

func _online_gate_request_url(url: String, can_retry_connectivity_fallback: bool) -> void :
	var http: = HTTPRequest.new()
	http.timeout = 10.0
	add_child(http)
	http.request_completed.connect( func(result: int, response_code: int, _headers: PackedStringArray, _body: PackedByteArray):
		if is_instance_valid(http):
			http.queue_free()
		if result == HTTPRequest.RESULT_SUCCESS and response_code == 200:
			_online_gate_request_busy = false
			return
		if can_retry_connectivity_fallback:
			_online_gate_request_url(_GameServerConfig.connectivity_fallback_url(), false)
			return
		_show_network_required_quit_dialog("网络连接已断开，本游戏需联网运行。\n请检查网络后重新启动游戏。")
	, CONNECT_ONE_SHOT)
	var err: = http.request(url, [], HTTPClient.METHOD_GET)
	if err != OK:
		if is_instance_valid(http):
			http.queue_free()
		if can_retry_connectivity_fallback:
			_online_gate_request_url(_GameServerConfig.connectivity_fallback_url(), false)
		else:
			_show_network_required_quit_dialog("无法发起网络检测，请检查网络后重新启动游戏。")

func _main_ui_periodic_online_check() -> void :
	if OS.has_feature("editor"):
		return
	if not network or not network.is_logged_in():
		return
	if not main_content or not main_content.visible:
		return
	if _online_gate_request_busy:
		return
	_online_gate_request_busy = true
	if _main_ui_session_uses_http_api_fallback():
		_online_gate_request_url(_GameServerConfig.connectivity_fallback_url(), false)
	else:
		_online_gate_request_url(_GameServerConfig.updates_manifest_url(), true)


func _inventory_item_disallows_batch_use(item: Variant) -> bool:
	if item == null:
		return true
	var n: = str(item.name).strip_edges()
	return n == "人物经验丹" or n == "宠物经验丹"

const PET_FRAGMENT_SYNTHESIZE_BATCH_MAX: = 50


func _request_bag_pet_fragment_synthesize(stone_count: int, close_item_popup_cb: Callable = Callable(), on_finished: Callable = Callable()) -> void :
	if game_manager == null or game_manager.network == null or not game_manager.network.is_logged_in():
		_show_simple_dialog("合成失败", "当前网络不可用，碎片合成需联网并由服务器确认。")
		if on_finished.is_valid():
			on_finished.call(false)
		return
	if game_manager.inventory_manager == null:
		_show_simple_dialog("合成失败", "背包未初始化")
		if on_finished.is_valid():
			on_finished.call(false)
		return
	var per: = PetEquipmentEnhance.FRAGMENTS_PER_STONE
	var count: = clampi(stone_count, 1, PET_FRAGMENT_SYNTHESIZE_BATCH_MAX)
	var need: = count * per
	var have_frag: int = game_manager.inventory_manager.get_item_count(PetEquipmentEnhance.FRAGMENT_ITEM)
	if have_frag < need:
		_show_simple_dialog("合成失败", "宠装碎片不足（需要%d个）" % need)
		if on_finished.is_valid():
			on_finished.call(false)
		return
	var op_id: = "pet_equipment_synthesize_fragments_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
	var on_success = func(data: Dictionary):
		if data.has("saveData") and data.get("saveData") is Dictionary:
			game_manager.apply_cloud_save(data.get("saveData"), {
				"reward_inventory_slice": true, 
				"authoritative_equipment_inventory": true, 
			})
		if close_item_popup_cb.is_valid():
			close_item_popup_cb.call()
		_show_simple_dialog("合成成功", str(data.get("message", "合成成功：宠装强化石 x%d" % count)))
		_update_bag_view()
		if on_finished.is_valid():
			on_finished.call(true)
	var on_failed = func(error: String):
		_show_simple_dialog("合成失败", error)
		if on_finished.is_valid():
			on_finished.call(false)
	game_manager.network.pet_equipment_synthesize_fragments_success.connect(on_success, CONNECT_ONE_SHOT)
	game_manager.network.pet_equipment_synthesize_fragments_failed.connect(on_failed, CONNECT_ONE_SHOT)
	game_manager.network.request_pet_equipment_synthesize_fragments(need, op_id, count)


