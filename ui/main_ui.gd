func _is_pet_bag_retrieve_locked() -> bool:
	return Time.get_ticks_msec() < _pet_bag_retrieve_lock_until_ms

func _set_pet_bag_retrieve_buttons_disabled_in_node(node: Node, disabled: bool) -> void :
	if node is Button and str(node.text) == "取出":
		node.disabled = disabled
	for child in node.get_children():
		_set_pet_bag_retrieve_buttons_disabled_in_node(child, disabled)

func _set_all_pet_bag_retrieve_buttons_disabled(disabled: bool) -> void :
	if pet_bag_container == null:
		return
	for child in pet_bag_container.get_children():
		_set_pet_bag_retrieve_buttons_disabled_in_node(child, disabled)

func _begin_pet_bag_retrieve_lock() -> void :
	_pet_bag_retrieve_lock_until_ms = Time.get_ticks_msec() + PET_BAG_RETRIEVE_LOCK_MS
	_pet_bag_retrieve_unlock_seq += 1
	var seq: = _pet_bag_retrieve_unlock_seq
	_set_all_pet_bag_retrieve_buttons_disabled(true)
	_run_pet_bag_retrieve_unlock_after_lock(seq)

func _run_pet_bag_retrieve_unlock_after_lock(seq: int) -> void :
	var remain_ms: = maxi(0, _pet_bag_retrieve_lock_until_ms - Time.get_ticks_msec())
	if remain_ms > 0:
		await get_tree().create_timer(remain_ms / 1000.0).timeout
	if seq != _pet_bag_retrieve_unlock_seq:
		return
	if _is_pet_bag_retrieve_locked():
		return
	_set_all_pet_bag_retrieve_buttons_disabled(false)

func _format_pet_list_skill_line(pet) -> String:
	var learned: PackedStringArray = PackedStringArray()
	var empty_count: = 0
	var locked_empty: = 0
	var slot_n: = 0
	if pet != null and pet.has_method("get_skill_slot_count"):
		slot_n = clampi(int(pet.get_skill_slot_count()), 1, 5)
	for i in range(slot_n):
		var skill_name: = ""
		var skill_level: = 0
		var slot_locked: = false
		if pet.has_method("get_skill_slot"):
			var skill_slot: Dictionary = pet.get_skill_slot(i)
			skill_name = str(skill_slot.get("skill_name", "")).strip_edges()
			skill_level = int(skill_slot.get("level", 0))
			slot_locked = bool(skill_slot.get("slot_locked", false))
			if not slot_locked and pet.has_method("is_skill_slot_locked"):
				slot_locked = bool(pet.is_skill_slot_locked(i))
		var has_skill: = skill_level > 0 and not skill_name.is_empty() and skill_name != "无"
		if has_skill:
			learned.append("%slv%d" % [skill_name, skill_level])
		elif slot_locked:
			locked_empty += 1
		else:
			empty_count += 1
	if learned.is_empty() and locked_empty <= 0:
		return "技能: 无"
	var parts: PackedStringArray = PackedStringArray()
	parts.append_array(learned)
	if locked_empty > 0:
		parts.append("锁%d" % locked_empty)
	if empty_count > 0:
		parts.append("空%d" % empty_count)
	return "技能: " + " · ".join(parts)

