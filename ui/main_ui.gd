func _play_coop_player_battle_attack() -> void :
	if not _should_use_battle_sprite_anim():
		return
	var spr: = _resolve_coop_player_battle_anim()
	if spr == null or spr.sprite_frames == null or not spr.sprite_frames.has_animation("attack"):
		return
	if _bt_visual_state("coop_player") == BT_ALLY_VIS_DEFEATED or _ally_coop_player_defeat_applied:
		return
	_set_bt_visual_state("coop_player", BT_ALLY_VIS_ATTACKING)
	spr.visible = true
	if spr.animation_finished.is_connected(_on_coop_player_battle_attack_finished):
		spr.animation_finished.disconnect(_on_coop_player_battle_attack_finished)
	spr.frame = 0
	spr.play("attack")
	spr.animation_finished.connect(_on_coop_player_battle_attack_finished, CONNECT_ONE_SHOT)

func _on_coop_player_battle_attack_finished() -> void :
	if not is_instance_valid(_battle_coop_player_sprite):
		return
	var spr: = _battle_coop_player_sprite as AnimatedSprite2D
	if spr == null or spr.sprite_frames == null:
		return
	if _bt_visual_state("coop_player") == BT_ALLY_VIS_DEFEATED or _ally_coop_player_defeat_applied:
		return
	var coop_player = _get_coop_battle_unit("coop_player")
	if coop_player == null or not coop_player.is_alive():
		return
	_set_bt_visual_state("coop_player", BT_ALLY_VIS_IDLE)
	_apply_battle_sprite_playback_state(spr)

func _play_coop_pet_battle_attack(time_scale: float = 1.0) -> void :
	if not _should_use_battle_sprite_anim():
		return
	var spr: = _resolve_coop_pet_battle_anim()
	if spr == null or spr.sprite_frames == null or not spr.sprite_frames.has_animation("attack"):
		return
	if _bt_visual_state("coop_pet") == BT_ALLY_VIS_DEFEATED or _ally_coop_pet_defeat_applied:
		return
	_set_bt_visual_state("coop_pet", BT_ALLY_VIS_ATTACKING)
	spr.visible = true
	if spr.animation_finished.is_connected(_on_coop_pet_battle_attack_finished):
		spr.animation_finished.disconnect(_on_coop_pet_battle_attack_finished)
	spr.speed_scale = 1.0 / maxf(0.25, time_scale)
	spr.frame = 0
	spr.play("attack")
	spr.animation_finished.connect(_on_coop_pet_battle_attack_finished, CONNECT_ONE_SHOT)

func _on_coop_pet_battle_attack_finished() -> void :
	if not is_instance_valid(_battle_coop_pet_sprite):
		return
	var spr: = _battle_coop_pet_sprite as AnimatedSprite2D
	if spr == null or spr.sprite_frames == null:
		return
	spr.speed_scale = 1.0
	if _bt_visual_state("coop_pet") == BT_ALLY_VIS_DEFEATED or _ally_coop_pet_defeat_applied:
		return
	var coop_pet = _get_coop_battle_unit("coop_pet")
	if coop_pet == null or not coop_pet.is_alive():
		return
	_set_bt_visual_state("coop_pet", BT_ALLY_VIS_IDLE)
	_apply_battle_sprite_playback_state(spr)

func _update_brother_tower_coop_death_stamps() -> void :
	if not _uses_coop_ally_slots():
		return
	var coop_player = _get_coop_battle_unit("coop_player")
	if is_instance_valid(_battle_coop_player_wrap):
		var dead: bool = coop_player == null or not coop_player.is_alive()
		var sprite_ci: = _safe_battle_canvas_item(_battle_coop_player_sprite)
		if sprite_ci != null:
			if dead:
				if not _ally_coop_player_defeat_applied or not _is_ally_defeat_fx_present(_battle_coop_player_wrap):
					if _apply_ally_defeat_effect(
						_battle_coop_player_wrap, 
						_battle_coop_player_wrap, 
						sprite_ci, 
						ALLY_DEFEATED_STATIC_OFFSET_PLAYER, 
						ALLY_DIZZY_OFFSET_PLAYER, 
						_battle_coop_player_name_label, 
						ALLY_DEFEATED_ANCHOR_ABOVE_NAME_Y_PLAYER, 
						_get_player_defeated_static_texture_for_character(int(coop_player.player_character_id) if coop_player else 0), 
						false, 
						_bt_ally_defeat_flip_horizontal()
					):
						_ally_coop_player_defeat_applied = true
			elif _ally_coop_player_defeat_applied or _is_ally_defeat_fx_present(_battle_coop_player_wrap):
				_clear_ally_defeat_effect(_battle_coop_player_wrap, _battle_coop_player_wrap, sprite_ci)
				_ally_coop_player_defeat_applied = false
				sprite_ci.modulate = Color.WHITE
	var coop_pet = _get_coop_battle_unit("coop_pet")
	if is_instance_valid(_battle_coop_pet_wrap):
		var slot = _battle_coop_pet_wrap.get_node_or_null("CoopPetSpriteSlot") as Control
		var sprite_ci2: = _safe_battle_canvas_item(_battle_coop_pet_sprite)
		var dead2: bool = coop_pet == null or not coop_pet.is_alive()
		if sprite_ci2 != null:
			if dead2:
				if not _ally_coop_pet_defeat_applied or not _is_ally_defeat_fx_present(_battle_coop_pet_wrap):
					if _apply_ally_defeat_effect(
						_battle_coop_pet_wrap, 
						slot, 
						sprite_ci2, 
						ALLY_DEFEATED_STATIC_OFFSET_PET, 
						ALLY_DIZZY_OFFSET_PET, 
						null, 
						0.0, 
						null, 
						false, 
						_bt_ally_pet_mirror_x()
					):
						_ally_coop_pet_defeat_applied = true
			elif _ally_coop_pet_defeat_applied or _is_ally_defeat_fx_present(_battle_coop_pet_wrap):
				_clear_ally_defeat_effect(_battle_coop_pet_wrap, slot, sprite_ci2)
				_ally_coop_pet_defeat_applied = false
				sprite_ci2.modulate = Color.WHITE

