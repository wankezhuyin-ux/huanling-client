func _update_login_dialog_info():
	if not startup_dialog or not is_instance_valid(startup_dialog):
		return


	var title_label = startup_dialog.get_node_or_null("MainPanel/VBoxContainer/TitleLabel")
	if title_label and title_label is Label:
		var display_name: String = str(network_nickname).strip_edges()
		if display_name == "" and game_manager.player:
			display_name = str(game_manager.player.player_name).strip_edges()
		if display_name != "":
			title_label.text = display_name


	var info_panel = startup_dialog.get_node_or_null("MainPanel/VBoxContainer/InfoPanel")
	if not info_panel:
		return

	var info_vbox = info_panel.get_child(0) if info_panel.get_child_count() > 0 else null
	if not info_vbox:
		return


	# 去掉「角色名称」行后，行序是 等级 / 境界 / 投胎 / 金币。
	if info_vbox.get_child_count() > 0 and game_manager.player:
		var level_row = info_vbox.get_child(0)
		if level_row and level_row.get_child_count() > 1:
			var level_label = level_row.get_child(1)
			if level_label and level_label is Label:
				level_label.text = "Lv.%d" % game_manager.player.level

	if info_vbox.get_child_count() > 3 and game_manager.player:
		var gold_row = info_vbox.get_child(3)
		if gold_row and gold_row.get_child_count() > 1:
			var gold_label = gold_row.get_child(1)
			if gold_label and gold_label is Label:
				gold_label.text = str(game_manager.player.gold)

func _start_game():
	_game_started = true
	# 启动弹窗（离线奖励 / 欢迎回来）还挂着的时候，不要把 HUD 掀出来：
	# 参考稿这两块面板背后是一整块干净的场景背景，角色条/金币/飞升投胎/底部导航
	# 一露出来玩家就会说「左上角一堆乱七八糟的东西」。
	var startup_blocked: = _startup_offline_pending or (startup_dialog != null and is_instance_valid(startup_dialog))
	if not startup_blocked:
		top_bar.visible = true
		main_content.visible = true
		bottom_nav.visible = true

	await get_tree().process_frame
	_add_qq_group_label()

	_update_player_ui()
	_update_pet_ui()
	_update_map_ui()


	_setup_pet_equipment_ui()


	game_manager.migrate_pet_equipment_from_inventory()

	_show_view("battle")

	_add_log("=== 幻灵归虚 ===")
	_add_log("欢迎来到修仙世界!")
	_add_log("当前地图：%s" % game_manager.current_map)

func _add_qq_group_label():
	# 顶栏要用**绝对坐标**摆，不能靠 anchor_right=1 让引擎按父节点宽度去算。
	# 实测（tools/ui_shot.gd --dumpui）：ink_home 那个场景根 Control 的 size 是 (0,0)
	# （它是被挂在 main.gd 的 Node2D 下面的），于是任何 anchor_right=1 的子节点
	# 算出来都是 0 宽；HBox 又按自身最小宽度居中到 0 宽的父节点上 → 整行被推到屏幕左边外面，
	# 参考稿 TopBar 是 左20/右-20/上10/下55 的一整条，这里直接按 viewport 宽算绝对矩形，
	# 父节点多少宽都无所谓。
	var vp_size: = get_viewport_rect().size
	top_bar.anchor_left = 0.0
	top_bar.anchor_top = 0.0
	top_bar.anchor_right = 0.0
	top_bar.anchor_bottom = 0.0
	top_bar.position = Vector2(20, 10)
	top_bar.size = Vector2(max(320.0, vp_size.x - 40.0), 45)

	var hbox = top_bar.get_node_or_null("HBoxContainer")
	if hbox:
		hbox.add_theme_constant_override("separation", 6)
		# 顶栏只保留「交流群 / 金币 / 元宝」。
		var group_label = hbox.get_node_or_null("QQGroupLabel")
		if group_label and group_label is CanvasItem:
			(group_label as CanvasItem).visible = true
		var gold = hbox.get_node_or_null("GoldLabel")
		if gold:
			gold_label = gold
			gold.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			gold.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
			gold.add_theme_font_size_override("font_size", TOP_BAR_CURRENCY_FONT_SIZE)
			gold.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		var yuanbao = hbox.get_node_or_null("YuanbaoLabel")
		if yuanbao:
			yuanbao_label = yuanbao
			yuanbao.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
			yuanbao.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
			yuanbao.add_theme_font_size_override("font_size", TOP_BAR_CURRENCY_FONT_SIZE)
			yuanbao.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		var sync_node = hbox.get_node_or_null("SyncStatusLabel")
		if sync_node and sync_node is Label:
			sync_status_label = sync_node
		elif sync_status_label == null or not is_instance_valid(sync_status_label):
			sync_status_label = Label.new()
			sync_status_label.name = "SyncStatusLabel"
			sync_status_label.size_flags_horizontal = Control.SIZE_SHRINK_END
			sync_status_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
			hbox.add_child(sync_status_label)
		if sync_status_label:
			sync_status_label.add_theme_font_size_override("font_size", TOP_BAR_VALUE_FONT_SIZE)
			sync_status_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			# 参考稿顶栏最右边就是「同步: 正常」，恢复显示（异常时会变红并写 tooltip）。
			sync_status_label.visible = true
		_refresh_sync_status_label()
	_apply_ink_chrome()


# =====================================================================
#  水墨皮肤：顶栏 + 底栏（与 1024×1536 设计稿对齐）
#  设计稿里顶栏只是一条 150 设计像素的压暗渐隐 + 一行字，没有深色胶囊；
#  底栏是一条渐变 + 5 枚方徽章。这里把原来的深色 StyleBox 全部换掉。
#  所有尺寸都按 s = viewport.x / 1024 换算，跟 CityInkLayer 同一套坐标。
# =====================================================================
