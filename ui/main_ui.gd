func _update_battle_unit_death_stamps() -> void :
	if not is_instance_valid(monster_container):
		return
	if is_instance_valid(_battle_pet_wrap):
		var pet = _get_battle_display_pet()
		var pet_dead = pet == null or pet.hp <= 0
		var pet_slot = _battle_pet_wrap.get_node_or_null("PetSpriteSlot") as Control
		var pet_sprite_ci: = _safe_battle_canvas_item(_battle_pet_sprite)
		if pet_sprite_ci != null:
			if pet_dead:
				if not _ally_pet_defeat_applied or not _is_ally_defeat_fx_present(_battle_pet_wrap):
					if _apply_ally_defeat_effect(
						_battle_pet_wrap, 
						pet_slot, 
						pet_sprite_ci, 
						ALLY_DEFEATED_STATIC_OFFSET_PET, 
						ALLY_DIZZY_OFFSET_PET, 
						null, 
						0.0, 
						null, 
						false, 
						_bt_ally_pet_mirror_x()
					):
						_ally_pet_defeat_applied = true
			else:
				if _ally_pet_defeat_applied or _is_ally_defeat_fx_present(_battle_pet_wrap):
					_clear_ally_defeat_effect(_battle_pet_wrap, pet_slot, pet_sprite_ci)
					_ally_pet_defeat_applied = false
				pet_sprite_ci.modulate = Color.WHITE
	if is_instance_valid(_battle_player_wrap):
		var player: = _get_battle_display_player()
		if player == null:
			return
		var player_dead = player.hp <= 0 or not player.is_alive()
		var player_sprite_ci: = _safe_battle_canvas_item(_battle_player_sprite)
		if player_sprite_ci != null:
			if player_dead:
				if not _ally_player_defeat_applied or not _is_ally_defeat_fx_present(_battle_player_wrap):
					_set_player_battle_halo_battle_visible(false)
					if _apply_ally_defeat_effect(
						_battle_player_wrap, 
						_battle_player_wrap, 
						player_sprite_ci, 
						ALLY_DEFEATED_STATIC_OFFSET_PLAYER, 
						ALLY_DIZZY_OFFSET_PLAYER, 
						_battle_player_name_label, 
						ALLY_DEFEATED_ANCHOR_ABOVE_NAME_Y_PLAYER, 
						_get_player_defeated_static_texture(), 
						false, 
						false
					):
						_ally_player_defeat_applied = true
			else:
				if _ally_player_defeat_applied or _is_ally_defeat_fx_present(_battle_player_wrap):
					_clear_ally_defeat_effect(_battle_player_wrap, _battle_player_wrap, player_sprite_ci)
					_ally_player_defeat_applied = false
				player_sprite_ci.modulate = Color.WHITE
				_set_player_battle_halo_battle_visible(true)
				_sync_player_battle_halo_modulate()

func _update_monster_hp_ui():
	_update_monster_hp_ui_optimized()

func _update_monster_hp_ui_optimized():
	if not game_manager or not game_manager.battle_system:
		return

	var monsters = game_manager.battle_system.monsters

	if _cached_monster_hp.size() != monsters.size():
		_cached_monster_hp.clear()
		for i in range(monsters.size()):
			_cached_monster_hp.append(-1)

	if monster_hp_bars.size() != monster_ui_nodes.size():
		monster_hp_bars.clear()
		for node in monster_ui_nodes:
			if is_instance_valid(node):
				var hp_bar = node.find_child("MonsterHPBar", true, false)
				monster_hp_bars.append(hp_bar)
			else:
				monster_hp_bars.append(null)

	for i in range(monster_ui_nodes.size()):
		if i < monsters.size():
			var monster = monsters[i]
			var monster_ui = monster_ui_nodes[i]
			if is_instance_valid(monster_ui):
				var monster_hp = _get_monster_property(monster, "hp", 0)
				var monster_max_hp = _get_monster_property(monster, "max_hp", 100)

				var prev_hp: int = _cached_monster_hp[i] if i < _cached_monster_hp.size() else -1
				var hp_bar = monster_hp_bars[i] if i < monster_hp_bars.size() else null
				if not is_instance_valid(hp_bar):
					hp_bar = monster_ui.find_child("MonsterHPBar", true, false) as ProgressBar
					if i < monster_hp_bars.size():
						monster_hp_bars[i] = hp_bar
				var bar_out_of_date: = is_instance_valid(hp_bar) and int(hp_bar.value) != int(monster_hp)
				if monster_hp != prev_hp or bar_out_of_date:
					if i >= _cached_monster_hp.size():
						_cached_monster_hp.append(monster_hp)
					else:
						_cached_monster_hp[i] = monster_hp
					if is_instance_valid(hp_bar):
						hp_bar.max_value = monster_max_hp
						hp_bar.value = monster_hp
						_set_battle_hp_bar_percent(hp_bar, int(monster_hp), int(monster_max_hp))
						if not _battle_wrap_is_lunging(monster_ui):
							hp_bar.visible = true
							if monster_ui.has_meta(BATTLE_LUNGE_HP_HIDDEN_META):
								monster_ui.remove_meta(BATTLE_LUNGE_HP_HIDDEN_META)
					if monster_hp <= 0 and (prev_hp > 0 or prev_hp < 0):
						_snap_monster_ui_to_battle_home(monster_ui)
						if _uses_arena_style_monster_defeat(monster):
							_apply_arena_monster_defeat_effect(monster_ui, monster)
						else:
							BattleMonsterDefeatEffect.apply_defeated(monster_ui)
						if i < _monster_defeat_fx_applied.size():
							_monster_defeat_fx_applied[i] = true
					elif monster_hp > 0:
						monster_ui.modulate = Color.WHITE
						BattleMonsterDefeatEffect.clear_defeated(monster_ui)
						if _uses_arena_style_monster_defeat(monster):
							_restore_arena_monster_sprite_layout(monster_ui, monster)
						if i < _monster_defeat_fx_applied.size():
							_monster_defeat_fx_applied[i] = false


