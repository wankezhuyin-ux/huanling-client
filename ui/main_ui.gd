		_battle_player_sprite = anim

func _clear_player_battle_visual_nodes(wrap: Control) -> void :
	if wrap == null:
		return
	var to_free: Array[Node] = []
	for child in wrap.get_children():
		if child.name in ["PlayerBattleAnim", "CoopPlayerBattleAnim", FootShadow.NODE_NAME]:
			to_free.append(child)
	for node in to_free:
		if is_instance_valid(node):
			node.free()
	if wrap == _battle_player_wrap:
		_battle_player_sprite = null
	elif wrap == _battle_coop_player_wrap:
		_battle_coop_player_sprite = null

func _recreate_player_battle_sprite_only() -> void :
	if not is_instance_valid(_battle_player_wrap):
		return
	_clear_player_battle_visual_nodes(_battle_player_wrap)
	_add_player_battle_visual_to_wrap(_battle_player_wrap)
	call_deferred("_ensure_player_battle_halo_after_visual_refresh")

func _recreate_coop_player_battle_sprite_only() -> void :
	if not is_instance_valid(_battle_coop_player_wrap):
		return
	_clear_player_battle_visual_nodes(_battle_coop_player_wrap)
	var coop_player = _get_coop_battle_unit("coop_player")
	if coop_player:
		_add_coop_player_battle_visual_to_wrap(_battle_coop_player_wrap, int(coop_player.player_character_id))

func _sync_disable_battle_anim_btn_text() -> void :
	if disable_battle_anim_btn:
		disable_battle_anim_btn.text = "开启动图" if not _battle_sprite_anim_enabled else "关闭动图"

func _on_disable_battle_anim_btn_pressed() -> void :
	_battle_sprite_anim_enabled = not _battle_sprite_anim_enabled
	_sync_disable_battle_anim_btn_text()
	_apply_battle_sprite_anim_mode()

func _apply_battle_sprite_anim_mode() -> void :
	_restore_all_battle_lunges()
	_cached_battle_pet_display_key = ""
	_cached_coop_pet_display_key = ""
	_cached_monster_sprite_signature = ""
	_ally_pet_defeat_applied = false
	_ally_player_defeat_applied = false
	_ally_coop_player_defeat_applied = false
	_ally_coop_pet_defeat_applied = false
	for wrap in [_battle_pet_wrap, _battle_player_wrap, _battle_coop_player_wrap, _battle_coop_pet_wrap]:
		if is_instance_valid(wrap):
			_force_clear_ally_defeat_fx_on_wrap(wrap)
	if is_instance_valid(_battle_player_wrap):
		_recreate_player_battle_sprite_only()
	if is_instance_valid(_battle_pet_wrap):
		_refresh_pet_battle_display()
	if is_instance_valid(_battle_coop_player_wrap):
		_recreate_coop_player_battle_sprite_only()
	if _is_bt_battle():
		_sync_bt_battle_sprite_refs()
		_mount_brother_tower_units_to_slots()
		_refresh_coop_pet_battle_display()
		_apply_brother_tower_death_stamps_from_state()
	else:
		_mount_battle_ally_units_to_slots()
		_refresh_player_battle_display()
		_refresh_pet_battle_display()
	if game_manager and game_manager.in_battle:
		_update_monster_ui()
		_refresh_active_battle_hud()
	_refresh_all_battle_sprite_playback_states()
	_ensure_player_battle_halo_after_visual_refresh()

func _refresh_all_battle_sprite_playback_states() -> void :
	if is_instance_valid(_battle_player_sprite) and _battle_player_sprite is AnimatedSprite2D:
		_apply_battle_sprite_playback_state(_battle_player_sprite as AnimatedSprite2D)
	if is_instance_valid(_battle_coop_player_sprite) and _battle_coop_player_sprite is AnimatedSprite2D:
		_apply_battle_sprite_playback_state(_battle_coop_player_sprite as AnimatedSprite2D)
	if is_instance_valid(_battle_pet_sprite) and _battle_pet_sprite is AnimatedSprite2D:
		_apply_battle_sprite_playback_state(_battle_pet_sprite as AnimatedSprite2D)
	if is_instance_valid(_battle_coop_pet_sprite) and _battle_coop_pet_sprite is AnimatedSprite2D:
		_apply_battle_sprite_playback_state(_battle_coop_pet_sprite as AnimatedSprite2D)
	for monster_ui in monster_ui_nodes:
		if not is_instance_valid(monster_ui):
			continue
		var slot = monster_ui.get_node_or_null("MonsterSpriteSlot")
		if slot == null:
			continue
		var sprite = slot.get_node_or_null("MonsterSprite")
		if sprite is AnimatedSprite2D:
			_apply_battle_sprite_playback_state(sprite as AnimatedSprite2D)

func _build_idle_anim_sprite_from_sheet(sprite_sheet: Texture2D, scale: Vector2, centered: bool = true) -> AnimatedSprite2D:
	if sprite_sheet == null:
		return null
	var anim = AnimatedSprite2D.new()
	anim.centered = centered
	anim.scale = scale
	var frames = SpriteFrames.new()
	frames.add_animation("idle")
	var frame_count = int(sprite_sheet.get_width() / 256)
	for fi in range(frame_count):
		var at = AtlasTexture.new()
		at.atlas = sprite_sheet
		at.region = Rect2(fi * 256, 0, 256, 256)
		frames.add_frame("idle", at)
	frames.set_animation_speed("idle", 8.0)
	frames.set_animation_loop("idle", true)
	anim.sprite_frames = frames
	anim.play("idle")
	return anim

