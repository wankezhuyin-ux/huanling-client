	skill_margin.add_child(skill_vbox)

	var skill_title = Label.new()
	skill_title.text = "【宠物技能】"
	skill_title.add_theme_font_size_override("font_size", 14)
	skill_title.add_theme_color_override("font_color", Color(0.72, 0.86, 1.0))
	skill_vbox.add_child(skill_title)

	var _is_festival_pet: = false
	if pet != null and GameManager.instance != null and GameManager.instance.pet_manager != null:
		_is_festival_pet = GameManager.instance.pet_manager.is_festival_pet_id(str(pet.pet_id).strip_edges())

	for i in range(skill_slot_n):
		var skill_name = "无"
		var skill_level = 0
		var slot_locked: = false
		if pet and pet.has_method("get_skill_slot"):
			var skill_slot: Dictionary = pet.get_skill_slot(i)
			skill_name = str(skill_slot.get("skill_name", "无")).strip_edges()
			skill_level = int(skill_slot.get("level", 0))
			slot_locked = bool(skill_slot.get("slot_locked", false))
			if not slot_locked and pet.has_method("is_skill_slot_locked"):
				slot_locked = bool(pet.is_skill_slot_locked(i))
		var row_hbox = HBoxContainer.new()
		row_hbox.add_theme_constant_override("separation", 6)
		var row_label = Label.new()
		if skill_name.is_empty() or skill_name == "无" or skill_level <= 0:
			row_label.text = ("技能%d：无（已锁）" % (i + 1)) if slot_locked else ("技能%d：无" % (i + 1))
			row_label.add_theme_color_override("font_color", Color(0.65, 0.7, 0.8))
		else:
			row_label.text = "技能%d：%slv%d" % [i + 1, skill_name, skill_level]
			row_label.add_theme_color_override("font_color", Color(1.0, 0.92, 0.62))
		row_label.add_theme_font_size_override("font_size", 13)
		row_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row_hbox.add_child(row_label)
		var show_unlearn: = false
		if pet != null and pet.has_method("can_unlearn_skill_slot"):
			show_unlearn = bool(pet.can_unlearn_skill_slot(i, _is_festival_pet))
		elif skill_level > 0 and not skill_name.is_empty() and skill_name != "无" and not _is_festival_pet:
			show_unlearn = true
		if show_unlearn:
			if not _is_block_unlearn_below_lv3() or skill_level >= 3:
				var slot_idx = i
				var unlearn_btn = Button.new()
				unlearn_btn.text = "卸"
				unlearn_btn.custom_minimum_size = Vector2(30, 22)
				unlearn_btn.add_theme_font_size_override("font_size", 11)
