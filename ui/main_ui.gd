		prefix_l.text = str(item.prefix)
		prefix_l.add_theme_font_size_override("font_size", 16)
		prefix_l.add_theme_color_override("font_color", Color(0.56, 0.72, 1.0))
		block.add_child(prefix_l)
		var content_l = RichTextLabel.new()
		content_l.bbcode_enabled = false
		content_l.scroll_active = false
		content_l.fit_content = true
