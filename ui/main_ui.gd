	_sync_battle_ally_wrap_hp_bars()

func _get_pet_battle_texture() -> Texture2D:
	var pet = _get_battle_display_pet()
	if pet:
		var pid = pet.get("pet_id") if pet is Dictionary else pet.pet_id
		if pid and pid != "":
			var am = AssetManager.get_instance()
			if am:
				var tex = am.get_pet_texture(pid)
				if tex:
					return tex
				var tex2 = am.get_monster_texture(pid)
				if tex2:
					return tex2
	return null

func _update_battle_sprites():
	if not $MainContent / BattleView / BattlePanel / SpriteField:
		return
	_refresh_player_battle_display()
	_refresh_pet_battle_display()

