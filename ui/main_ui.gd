		return

	var display_key: = _battle_pet_display_key(pet_id)
	var existing_sprite = slot.get_node_or_null("PetBattleSprite")
	if display_key == _cached_battle_pet_display_key and is_instance_valid(existing_sprite):
		_battle_pet_sprite = existing_sprite
		if _is_bt_battle():
			_enforce_bt_pet_sprites_mirror()
		return

	_cached_battle_pet_display_key = display_key
	_clear_pet_battle_sprite_slot()

	var pet_tex: Texture2D = _get_pet_battle_texture()
	var pet_slot_size: = _ally_pet_battle_slot_size()
	var pet_sprite: = _populate_battle_sprite_slot(
		slot, 
		pet_id, 
		_bt_ally_pet_mirror_x(), 
		pet_tex, 
		pet_slot_size, 
		PET_ATTACK_DURATION, 
		"PetBattleSprite", 
