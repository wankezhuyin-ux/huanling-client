	realm_section.add_child(_create_info_label("当前等级", str(player.level), 100, 18))
	realm_section.add_child(_create_info_label("投胎次数", str(player.reincarnation), 100, 18))

	var next_realm = GameData.get_next_realm(player.realm)
	if next_realm == "大罗金仙":
		var element_collection = {}
		if game_manager and game_manager.pet_collection_manager:
			element_collection = game_manager.pet_collection_manager.get_all_element_collection_counts()

		var collection_title = Label.new()
		collection_title.text = "五行图鉴进度:"
		collection_title.add_theme_font_size_override("font_size", 16)
		collection_title.add_theme_color_override("font_color", Color(0.8, 0.8, 0.8))
		realm_section.add_child(collection_title)

		var collection_grid = GridContainer.new()
		collection_grid.columns = 5
		collection_grid.add_theme_constant_override("h_separation", 10)
		collection_grid.add_theme_constant_override("v_separation", 5)

		var all_met = true
		for element in ["金", "木", "水", "火", "土"]:
			var count = element_collection.get(element, 0)
			var element_label = Label.new()
			if count >= 10:
