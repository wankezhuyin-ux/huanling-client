const INK_PAPER := Color(0.941, 0.910, 0.847)
const INK_GOLD := Color(0.788, 0.635, 0.294)
const INK_GOLD_HI := Color(1.0, 0.788, 0.290)
const INK_CINNABAR := Color(0.72, 0.34, 0.26)
const INK_CYAN := Color(0.470, 0.831, 0.949)
const INK_WHITE := Color(0.933, 0.957, 0.973)

var _ink_top_fade: TextureRect = null
var _ink_nav_done := false
var _ink_nav: Array = []          # [{btn, label, glow, key, active}]
## 内页统一底板：主城水墨景虚化 + 墨青罩 + 主题光晕 + 纸纹（全静态）
var _page_backdrop: InkPageBackdrop = null
