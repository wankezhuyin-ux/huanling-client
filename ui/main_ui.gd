func _ink_hero_vital_row(label_text: String, cur: float, maxv: float, fill: Color) -> Control:
	var s: = _ink_s()
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", int(round(10.0 * s)))
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(_ink_text(label_text, 18.0, Color(0.72, 0.68, 0.58), false))
