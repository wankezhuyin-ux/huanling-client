func _fabao_tier_id_from_fragment_name(item_name: String) -> String:
	var n: = item_name.strip_edges()
	for tid in FabaoConfig.all_template_ids():
		if FabaoConfig.fragment_item_name(tid) == n:
			return tid
	return ""


func _update_map_ui():
	if not game_manager:
		return

	var map_data = GameData.MAPS_DATA.get(game_manager.current_map, {})

	if map_data.is_empty():
		map_info_text.text = "地图数据加载失败"
		return

	var map_level = map_data.get("level", 1)
	var monsters = map_data.get("monsters", [])

	var monster_info = ""
	for monster in monsters:
		var monster_name = "未知"
		var level = 1
		var element = "普通"

		if monster.has("name") and monster.get("name", "") != "":
			monster_name = monster.get("name", "未知")
			level = monster.get("level", 1)
			element = monster.get("element", "普通")
		elif monster.has("pet_id"):
			var pet_id = monster.get("pet_id", "")
			level = monster.get("level", 1)
			var pet_data = PetDatabase.PET_DATA.get(pet_id, {})
			if not pet_data.is_empty():
				monster_name = pet_data.get("name", "未知")
				element = pet_data.get("element", "普通")
		elif monster.has("id"):
			var monster_id = monster.get("id", "")
			var db_monster = MonsterDatabase.get_monster(monster_id)
			if not db_monster.is_empty():
				monster_name = db_monster.get("name", "未知")
				level = db_monster.get("level", 1)
				element = Monster.element_from_map_monster_entry(monster)

		#   monster_info += "%s(lv.%d,%s)" % [monster_name, level, element]
		# 小写 lv.、怪与怪之间**直接拼接不加空格**。上一版我按截图猜成大写 Lv. 加空格，是错的。
		monster_info += "%s(lv.%d,%s)" % [monster_name, level, element]

	if monster_info.is_empty():
		monster_info = "无"

	var diff_name: = "普通"
	if game_manager.fabao_manager:
		diff_name = FabaoConfig.display_name(str(game_manager.fabao_manager.current_difficulty))
	#   var raw_text = "%s | %s |[br]等级：%d[br]%s" % [...]
	# 也就是**三行**：地图 | 难度 | / 等级：N / 怪物列表。
	# 上一版我把它并成一行用 | 串起来，是错的 —— 面板窄，并成一行会从中间乱折行。
	var raw_text = "%s | %s |[br]等级：%d[br]%s" % [game_manager.current_map, diff_name, map_level, monster_info]
	map_info_text.text = raw_text

func _acupoint_seal_key(unit_type: String, unit_index: int) -> String:
	if unit_type == "player" or unit_type == "pet":
		return unit_type
	return "%s:%d" % [unit_type, unit_index]

func _strip_acupoint_seal_mark(text: String) -> String:
	return text.replace("[color=#ff4d4d]封[/color]", "")

func _battle_name_base(label: Label) -> String:
	if not is_instance_valid(label):
		return ""
	if label.has_meta("seal_base_name"):
		return str(label.get_meta("seal_base_name"))
	return _strip_acupoint_seal_mark(label.text)

func _paint_acupoint_seal(label: Label) -> void :
	if not is_instance_valid(label):
		return
	var base: = str(label.get_meta("seal_base_name", "")).strip_edges()
	if base.is_empty():
		base = _strip_acupoint_seal_mark(label.text).strip_edges()
		label.set_meta("seal_base_name", base)
	var key: = _acupoint_seal_key(str(label.get_meta("seal_unit_type", "")), int(label.get_meta("seal_unit_index", -1)))
	var sealed: = bool(_battle_acupoint_sealed.get(key, false))

	label.text = base
	var mark: = label.get_node_or_null("AcupointSealMark") as Label
	if not sealed:
		if mark != null:
			mark.visible = false
		return
	if mark == null:
		mark = Label.new()
		mark.name = "AcupointSealMark"
		mark.mouse_filter = Control.MOUSE_FILTER_IGNORE
		mark.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		mark.add_theme_color_override("font_color", Color(1.0, 0.302, 0.302))
		label.add_child(mark)
	mark.text = "封"
	mark.visible = true
	var font_size: = label.get_theme_font_size("font_size")
	if font_size <= 0:
		font_size = 12
	mark.add_theme_font_size_override("font_size", font_size)
	var font: = label.get_theme_font("font")
	var text_w: = float(base.length()) * float(font_size)
	var mark_w: = float(font_size)
	if font != null:
		text_w = font.get_string_size(base, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
		mark_w = font.get_string_size("封", HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
	var box_w: = label.size.x
	if box_w <= 1.0:
		box_w = label.custom_minimum_size.x
	var start_x: = text_w
	if label.horizontal_alignment == HORIZONTAL_ALIGNMENT_CENTER:
		start_x = (box_w - text_w) * 0.5 + text_w
	elif label.horizontal_alignment == HORIZONTAL_ALIGNMENT_RIGHT:
		start_x = box_w
	mark.position = Vector2(start_x, 0)
	mark.size = Vector2(maxf(mark_w + 2.0, 16.0), maxf(label.size.y, float(font_size) + 2.0))

func _assign_battle_unit_name(label: Label, base: String, unit_type: String, unit_index: int) -> void :
	if not is_instance_valid(label):
		return
	label.set_meta("seal_base_name", base)
	label.set_meta("seal_unit_type", unit_type)
	label.set_meta("seal_unit_index", unit_index)
	_paint_acupoint_seal(label)

func _coop_battle_unit_index(unit_type: String) -> int:
	if game_manager == null or game_manager.battle_system == null:
		return 0
	var units = game_manager.battle_system.coop_units
	for i in range(units.size()):
		var cu = units[i]
		if cu != null and str(cu.unit_type) == unit_type:
			return i
	return 0

func _acupoint_name_label(unit_type: String, unit_index: int) -> Label:
	match unit_type:
		"player":
			return _battle_player_name_label
		"pet":
			return _battle_pet_name_label
		"coop_player":
			return _battle_coop_player_name_label
		"coop_pet":
			return _battle_coop_pet_name_label
		"monster":
			if unit_index < 0 or unit_index >= monster_ui_nodes.size():
				return null
			var ui = monster_ui_nodes[unit_index]
			if not is_instance_valid(ui):
				return null
			return ui.get_node_or_null("MonsterName") as Label
	return null

func _on_acupoint_seal_changed(target_type: String, target_index: int, sealed: bool) -> void :
	var key: = _acupoint_seal_key(target_type, target_index)
	if sealed:
		_battle_acupoint_sealed[key] = true
	else:
		_battle_acupoint_sealed.erase(key)
	var label: = _acupoint_name_label(target_type, target_index)
	if label == null:
		return
	label.set_meta("seal_unit_type", target_type)
	label.set_meta("seal_unit_index", target_index)
	_paint_acupoint_seal(label)

func _bind_monster_acupoint_name_seals() -> void :
	for i in range(monster_ui_nodes.size()):
		var label: = _acupoint_name_label("monster", i)
		if label == null:
			continue
		if not label.has_meta("seal_base_name"):
			label.set_meta("seal_base_name", _strip_acupoint_seal_mark(label.text))
		label.set_meta("seal_unit_type", "monster")
		label.set_meta("seal_unit_index", i)
		_paint_acupoint_seal(label)

func _update_monster_ui():
	_cleanup_monster_killed_stamps()
	if not game_manager or not game_manager.battle_system:
		_pending_monster_entrance = false
		return

	var monsters = game_manager.battle_system.monsters
	var signature: = _build_monster_ui_sprite_signature(monsters)
	if signature == _cached_monster_sprite_signature\
	and monster_ui_nodes.size() == monsters.size()\
	and _can_reuse_monster_ui_nodes():
		_reset_monster_ui_for_new_battle(monsters)
		_bind_monster_acupoint_name_seals()
		_play_monster_entrance_from_right_if_pending()
		return

	_rebuild_monster_ui(monsters)
	_cached_monster_sprite_signature = signature
	_bind_monster_acupoint_name_seals()
	_play_monster_entrance_from_right_if_pending()

func _request_monster_entrance_slide() -> void :
	_pending_monster_entrance = true

func _kill_monster_entrance_tween(monster_ui: Control) -> void :
	if not is_instance_valid(monster_ui) or not monster_ui.has_meta("_entrance_tween"):
		return
	var old_tween = monster_ui.get_meta("_entrance_tween")
	monster_ui.remove_meta("_entrance_tween")
	if old_tween is Tween and is_instance_valid(old_tween):
		(old_tween as Tween).kill()

func _restore_monster_ui_home_pose(monster_ui: Control) -> void :
	if not is_instance_valid(monster_ui):
		return
	_kill_monster_entrance_tween(monster_ui)
	if monster_ui.has_meta("_battle_home_pos"):
		monster_ui.position = monster_ui.get_meta("_battle_home_pos")
	monster_ui.modulate = Color.WHITE

func _play_monster_entrance_from_right_if_pending() -> void :
	if not _pending_monster_entrance:
		return
	_pending_monster_entrance = false
	var valid_wraps: Array = []
	for monster_ui in monster_ui_nodes:
		if is_instance_valid(monster_ui) and monster_ui.is_inside_tree():
			valid_wraps.append(monster_ui)
	var n: = valid_wraps.size()
	var delays: Array = []
	for i in range(n):
		if n <= 1:
			delays.append(0.0)
		else:
			delays.append(float(i) / float(n - 1) * MONSTER_ENTRANCE_STAGGER_MAX)
	if n > 1:
		delays.shuffle()
	for i in range(n):
		var monster_ui: Control = valid_wraps[i]
		_kill_monster_entrance_tween(monster_ui)
		var target_pos: Vector2
		if monster_ui.has_meta("_battle_home_pos"):
			target_pos = monster_ui.get_meta("_battle_home_pos")
		else:
			target_pos = monster_ui.position
			monster_ui.set_meta("_battle_home_pos", target_pos)
		monster_ui.position = Vector2(target_pos.x + MONSTER_ENTRANCE_SLIDE_OFFSET, target_pos.y)
		monster_ui.modulate = Color(1.0, 1.0, 1.0, 0.0)
		var stagger_sec: = float(delays[i])
		var tween: Tween = monster_ui.create_tween()
		monster_ui.set_meta("_entrance_tween", tween)
		tween.set_ease(Tween.EASE_OUT)
		tween.set_trans(Tween.TRANS_QUAD)
		tween.tween_interval(stagger_sec)
		tween.tween_property(monster_ui, "position", target_pos, MONSTER_ENTRANCE_SLIDE_DURATION)
		tween.parallel().tween_property(monster_ui, "modulate:a", 1.0, MONSTER_ENTRANCE_SLIDE_DURATION)
		tween.chain().tween_callback(_on_monster_entrance_finished.bind(monster_ui, tween, target_pos))

func _on_monster_entrance_finished(monster_ui: Control, tween: Tween, target_pos: Vector2) -> void :
	if not is_instance_valid(monster_ui):
		return
	if monster_ui.has_meta("_entrance_tween") and monster_ui.get_meta("_entrance_tween") == tween:
		monster_ui.remove_meta("_entrance_tween")
		monster_ui.position = target_pos
		monster_ui.modulate = Color.WHITE

func _build_monster_ui_sprite_signature(monsters: Array) -> String:
	var parts: PackedStringArray = []
	for monster in monsters:
		var monster_id = str(_get_monster_property(monster, "monster_id", ""))
		parts.append(_get_monster_battle_sprite_id(monster, monster_id))
	return "%d:%d:%s" % [1 if _battle_sprite_anim_enabled else 0, monsters.size(), "|".join(parts)]

func _can_reuse_monster_ui_nodes() -> bool:
	if monster_ui_nodes.is_empty():
		return false
	for node in monster_ui_nodes:
		if not is_instance_valid(node):
			return false
	return true

func _rebuild_monster_ui(monsters: Array) -> void :
	_restore_all_battle_lunges()
	for node in monster_ui_nodes:
		if is_instance_valid(node):
			node.queue_free()
	monster_ui_nodes.clear()
	monster_hp_bars.clear()
	_cached_monster_hp.clear()
	_monster_defeat_fx_applied.clear()
	_pick_battle_monster_formation(true)
	var total_count: = monsters.size()
	for monster in monsters:
		var monster_ui = _create_monster_ui(monster)
		var slot_index: = monster_ui_nodes.size()
		if _is_world_boss_battle():
			monster_ui.position = _world_boss_monster_ui_position(WORLD_BOSS_BATTLE_CELL_SIZE.x)
			monster_ui.z_index = 20
		else:
			var arena_pos: = _place_arena_or_shengsi_monster_ui(monster, slot_index, total_count)
			if arena_pos != Vector2.INF:
				monster_ui.position = arena_pos
				monster_ui.z_index = 20
			else:
				monster_ui.position = _battle_grid_monster_slot_pos_formed(slot_index, total_count)
				monster_ui.z_index = _battle_monster_ui_z_index_for_pos(monster_ui.position)
				_apply_battle_slot_perspective(monster_ui)
		monster_ui.set_meta("_battle_home_pos", monster_ui.position)
		monster_container.add_child(monster_ui)
		monster_ui_nodes.append(monster_ui)
	call_deferred("_snapshot_battle_lunge_homes")

func _reset_monster_ui_for_new_battle(monsters: Array) -> void :
	_cached_monster_hp.clear()
	_monster_defeat_fx_applied.clear()
	monster_hp_bars.clear()
	_pick_battle_monster_formation(false)
	var total_count: = monsters.size()
	for i in range(monster_ui_nodes.size()):
		var monster_ui = monster_ui_nodes[i]
		if not is_instance_valid(monster_ui) or i >= monsters.size():
			continue
		var monster = monsters[i]
		var entrance_playing: = false
		if monster_ui.has_meta("_entrance_tween"):
			var playing_tween = monster_ui.get_meta("_entrance_tween")
			entrance_playing = playing_tween is Tween and is_instance_valid(playing_tween)
		if not entrance_playing:
			_restore_monster_ui_home_pose(monster_ui)
			BattleMonsterDefeatEffect.clear_defeated(monster_ui)
			monster_ui.modulate = Color.WHITE
			_clear_animated_sprite_finished_connections(_get_monster_battle_animated_sprite(i))

			if _is_world_boss_battle():
				monster_ui.position = _world_boss_monster_ui_position(WORLD_BOSS_BATTLE_CELL_SIZE.x)
				monster_ui.z_index = 20
			else:
				var arena_pos2: = _place_arena_or_shengsi_monster_ui(monster, i, total_count)
				if arena_pos2 != Vector2.INF:
					monster_ui.position = arena_pos2
					monster_ui.z_index = 20
				else:
					monster_ui.position = _battle_grid_monster_slot_pos_formed(i, total_count)
					monster_ui.z_index = _battle_monster_ui_z_index_for_pos(monster_ui.position)
					_apply_battle_slot_perspective(monster_ui)
			monster_ui.set_meta("_battle_home_pos", monster_ui.position)
		var monster_hp = _get_monster_property(monster, "hp", 100)
		var monster_max_hp = _get_monster_property(monster, "max_hp", 100)
		var hp_bar = monster_ui.find_child("MonsterHPBar", true, false)
		if hp_bar:
			hp_bar.max_value = monster_max_hp
			hp_bar.value = monster_hp
			monster_hp_bars.append(hp_bar)
		else:
			monster_hp_bars.append(null)
		var monster_level = _get_monster_property(monster, "level", 1)
		var level_lbl = monster_ui.get_node_or_null("MonsterLevel")
		if level_lbl:
			level_lbl.text = "Lv.%d" % monster_level
		var slot = monster_ui.get_node_or_null("MonsterSpriteSlot") as Control
		if slot:
			var sprite = slot.get_node_or_null("MonsterSprite")
			if is_instance_valid(sprite):
				if sprite is CanvasItem:
					var sprite_ci: = sprite as CanvasItem
					sprite_ci.visible = true
					sprite_ci.modulate = Color.WHITE
				if sprite is AnimatedSprite2D:
					var anim: = sprite as AnimatedSprite2D
					_apply_battle_sprite_playback_state(anim)
		if _is_arena_battle() and str(_get_monster_property(monster, "texture_id", "")) == "player_mirror":
			_restore_arena_monster_sprite_layout(monster_ui, monster)
		_cached_monster_hp.append(monster_hp)
		_monster_defeat_fx_applied.append(false)

func _create_monster_ui(monster) -> Control:
	var is_wb: = _is_world_boss_battle()
	var slot_size: = WORLD_BOSS_BATTLE_SPRITE_SIZE if is_wb else MONSTER_BATTLE_SPRITE_SLOT_SIZE
	var container = Control.new()
	container.custom_minimum_size = WORLD_BOSS_BATTLE_CELL_SIZE if is_wb else MONSTER_BATTLE_GRID_CELL_SIZE

	var monster_id = _get_monster_property(monster, "monster_id", "")
	var monster_name = _get_monster_property(monster, "monster_name", _get_monster_property(monster, "name", "怪物"))
	var monster_element = _get_monster_property(monster, "element", "普通")
	var monster_level = _get_monster_property(monster, "level", 1)
	var monster_hp = _get_monster_property(monster, "hp", 100)
	var monster_max_hp = _get_monster_property(monster, "max_hp", 100)
	var texture_id = _get_monster_property(monster, "texture_id", "")
	var display_name = monster_name
	if is_wb:
		var pet_id: = str(_get_monster_property(monster, "pet_id", monster_id)).strip_edges()
		if not pet_id.is_empty():
			display_name = str(WorldBossConfig.BOSS_DISPLAY_NAMES.get(pet_id, display_name))
	if texture_id == "player_mirror" and monster_name.length() > 4:
		display_name = monster_name.substr(0, 4)


	var monster_texture = _get_monster_texture_for_ui(monster, monster_id)
	var sprite_id: = _get_monster_battle_sprite_id(monster, monster_id)
	var sprite_slot = _create_battle_sprite_slot(slot_size)
	sprite_slot.name = "MonsterSpriteSlot"

	sprite_slot.position = Vector2(10, 0) if is_wb else Vector2(5, 18)
	var mirror_x: = _arena_opponent_sprite_mirror_x(texture_id)
	var monster_sprite: Node = null
	if texture_id == "player_mirror":
		var mirror_cid: = int(_get_monster_property(monster, "character_id", 0))
		monster_sprite = _create_arena_opponent_player_sprite(
			sprite_slot, _normalize_player_character_id(mirror_cid)
		)
	if monster_sprite == null:
		monster_sprite = _populate_battle_sprite_slot(
			sprite_slot, 
			sprite_id, 
			mirror_x, 
			monster_texture, 
			slot_size, 
			MONSTER_ATTACK_DURATION, 
			"MonsterSprite", 
			MONSTER_BATTLE_STATIC_SPRITE_SIZE if not is_wb else BATTLE_STATIC_SPRITE_SIZE
		)
	if monster_sprite:
		container.add_child(sprite_slot)

	var name_width: = 370.0 if is_wb else MONSTER_BATTLE_GRID_CELL_SIZE.x
	var name_y: = 355.0 if is_wb else 102.0
	var level_y: = 373.0 if is_wb else 120.0
	var hp_pos: = Vector2(95, 388) if is_wb else MONSTER_BATTLE_HP_BAR_POS
	var hp_size: = Vector2(180, 12) if is_wb else BT_SLOT_HP_BAR_SIZE


	var nl = Label.new()
	nl.name = "MonsterName"
	nl.text = display_name
	nl.position = Vector2(0, name_y)
	nl.size = Vector2(name_width, 18)
	nl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	nl.add_theme_font_size_override("font_size", 14 if is_wb else 12)
	nl.z_index = 21
	container.add_child(nl)


	var ll = Label.new()
	ll.name = "MonsterLevel"
	ll.text = "Lv.%d" % monster_level
	ll.position = Vector2(0, level_y)
	ll.size = Vector2(name_width, 15)
	ll.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	ll.add_theme_font_size_override("font_size", 11 if is_wb else 10)
	ll.z_index = 21
	container.add_child(ll)


	var hp = ProgressBar.new()
	hp.name = "MonsterHPBar"
	hp.max_value = monster_max_hp
	hp.value = monster_hp
	hp.show_percentage = false
	hp.position = hp_pos
	hp.z_index = 21
	_style_battle_slot_hp_bar(hp, BATTLE_SLOT_HP_BAR_MONSTER_FILL_COLOR, hp_size)
	container.add_child(hp)

	return container



func _get_monster_property(monster, property_name: String, default_value = null):
	if monster is Dictionary:
		return monster.get(property_name, default_value)
	elif monster.has_method("get"):
		return monster.get(property_name) if monster.get(property_name) != null else default_value
	elif monster.get(property_name) != null:
		return monster.get(property_name)
	return default_value


func _get_monster_texture_for_ui(monster, monster_id: String) -> Texture2D:
	var texture_id = _get_monster_property(monster, "texture_id", "")

	if texture_id == "player_mirror":
		var mirror_cid: = int(_get_monster_property(monster, "character_id", 0))
		if mirror_cid <= 0:
			mirror_cid = _get_player_character_id()
		var mirror_idle: = _get_player_idle_frame_texture(_normalize_player_character_id(mirror_cid))
		if mirror_idle:
			return mirror_idle

	if texture_id == "moxiu":
		var moxiu_texture = load("res://assets/pets/moxiu.png")
		if moxiu_texture:
			return moxiu_texture

	if texture_id == "pet_mirror":
		var mirror_pet_id: = str(_get_monster_property(monster, "pet_id", "")).strip_edges()
		if not mirror_pet_id.is_empty():
			var pet_tex_by_id = AssetManager.get_instance().get_pet(mirror_pet_id.to_lower())
			if pet_tex_by_id:
				return pet_tex_by_id
		var pet_name = _get_monster_property(monster, "monster_name", _get_monster_property(monster, "name", ""))
		if pet_name != "":
			var pet_texture = AssetManager.get_instance().get_pet(pet_name.to_lower())
			if pet_texture:
				return pet_texture

	var texture_path = _get_monster_property(monster, "texture", "")
	if texture_path != "":
		var file_name = texture_path.get_file().get_basename().to_lower()
		var texture = AssetManager.get_instance().get_monster_texture(file_name)
		if texture:
			return texture

	if monster_id != "":
		var tex: = AssetManager.get_instance().get_monster_texture(monster_id)
		if tex:
			return tex

	var monster_name: = str(_get_monster_property(monster, "monster_name", "")).strip_edges()
	if not monster_name.is_empty():
		var name_tex: = AssetManager.get_instance().get_pet(monster_name.to_lower())
		if name_tex:
			return name_tex

	return null

func _get_monster_battle_sprite_id(monster, monster_id: String) -> String:
	var texture_id: = str(_get_monster_property(monster, "texture_id", "")).strip_edges()
	if texture_id == "player_mirror":
		var mirror_cid: = int(_get_monster_property(monster, "character_id", 0))
		var sid: = PlayerCharacterConfig.get_sprite_id(_normalize_player_character_id(mirror_cid))
		if _has_creature_battle_sprite(sid):
			return sid
	if texture_id == "pet_mirror":
		var mirror_pet_id: = str(_get_monster_property(monster, "pet_id", "")).strip_edges()
		if not mirror_pet_id.is_empty() and _has_creature_battle_sprite(mirror_pet_id):
			return mirror_pet_id
	var candidates: Array[String] = []
	var mid: = str(monster_id).strip_edges()
	if not mid.is_empty():
		candidates.append(mid)
	var pet_id: = str(_get_monster_property(monster, "pet_id", "")).strip_edges()
	if not pet_id.is_empty() and pet_id not in candidates:
		candidates.append(pet_id)
	var monster_name: = str(_get_monster_property(monster, "monster_name", "")).strip_edges()
	if not monster_name.is_empty():
		var name_key: = monster_name.to_lower()
		if name_key not in candidates:
			candidates.append(name_key)
	var texture_path: = str(_get_monster_property(monster, "texture", "")).strip_edges()
	if not texture_path.is_empty():
		var tex_base: = texture_path.get_file().get_basename()
		if not tex_base.is_empty() and tex_base not in candidates:
			candidates.append(tex_base)
	for sid in candidates:
		if _has_creature_battle_sprite(sid):
			return sid
	return ""

func _get_animated_sprite_visual_rect(sprite: AnimatedSprite2D) -> Rect2:
	if not is_instance_valid(sprite) or sprite.sprite_frames == null:
		return Rect2(sprite.position if is_instance_valid(sprite) else Vector2.ZERO, Vector2.ZERO)
	var anim_names = sprite.sprite_frames.get_animation_names()
	if anim_names.is_empty():
		return Rect2(sprite.position, Vector2.ZERO)
	var anim_name = sprite.animation if sprite.animation != "" else anim_names[0]
	var frame_tex = sprite.sprite_frames.get_frame_texture(anim_name, sprite.frame)
	if frame_tex == null:
		return Rect2(sprite.position, Vector2.ZERO)
	var tex_size = frame_tex.get_size()
	var display_size = Vector2(absf(tex_size.x * sprite.scale.x), absf(tex_size.y * sprite.scale.y))
	var origin = sprite.position
	if not sprite.centered:
		if sprite.scale.x < 0:
			origin.x -= display_size.x
		if sprite.scale.y < 0:
			origin.y -= display_size.y
	else:
		origin -= display_size * 0.5
	return Rect2(origin, display_size)


var _player_defeated_static_by_cid: Dictionary = {}

func _normalize_player_character_id(character_id: int) -> int:
	var all_ids: = PlayerCharacterConfig.get_all_ids()
	if all_ids.is_empty():
		return 0
	if all_ids.has(character_id):
		return character_id
	return all_ids[0]

func _get_player_defeated_static_texture_for_character(character_id: int) -> Texture2D:
	var cid: = _normalize_player_character_id(character_id)
	if _player_defeated_static_by_cid.has(cid):
		return _player_defeated_static_by_cid[cid] as Texture2D
	var path: = PlayerCharacterConfig.get_defeated_path(cid)
	if not ResourceLoader.exists(path):
		path = PlayerCharacterConfig.get_defeated_path(0)
	var tex: = load(path) as Texture2D
	if tex != null:
		_player_defeated_static_by_cid[cid] = tex
	return tex

func _get_player_defeated_static_texture() -> Texture2D:
	return _get_player_defeated_static_texture_for_character(_get_player_character_id())

func _get_ally_defeated_anchor_above_name(name_label: Label, above_name_y: float) -> Vector2:
	if not is_instance_valid(name_label):
		return Vector2.ZERO
	var center_x: = name_label.position.x + name_label.size.x * 0.5
	var top_y: = name_label.position.y + above_name_y
	return Vector2(center_x, top_y)

func _get_ally_defeated_anchor_from_sprite(wrap: Control, slot: Control, sprite: CanvasItem) -> Vector2:
	if not is_instance_valid(wrap) or not is_instance_valid(slot) or sprite == null:
		return Vector2.ZERO
	var slot_origin: = Vector2.ZERO
	if slot != wrap:
		slot_origin = slot.position
	if sprite is AnimatedSprite2D:
		var rect: = _get_animated_sprite_visual_rect(sprite as AnimatedSprite2D)
		var origin: = slot_origin + rect.position
		return Vector2(origin.x + rect.size.x * 0.5, origin.y + rect.size.y)
	if sprite is TextureRect:
		var tr: = sprite as TextureRect
		var display: = Vector2(absf(tr.size.x * tr.scale.x), absf(tr.size.y * tr.scale.y))
		var origin: = slot_origin + tr.position
		if tr.scale.x < 0.0:
			origin.x -= display.x
		return Vector2(origin.x + display.x * 0.5, origin.y + display.y)
	return slot_origin + slot.size * 0.5

func _apply_ally_defeat_effect(
	wrap: Control, 
	slot: Control, 
	sprite: CanvasItem, 
	static_offset: Vector2, 
	dizzy_offset: Vector2, 
	name_label: Label = null, 
	anchor_above_name_y: float = 0.0, 
	override_texture: Texture2D = null, 
	use_animated_defeat_reference_scale: bool = false, 
	flip_horizontal: bool = true
) -> bool:
	if not is_instance_valid(wrap) or not is_instance_valid(slot) or sprite == null:
		return false
	var saved_defeat_scale_meta: Variant = null
	var restore_defeat_scale_meta: = false
	if use_animated_defeat_reference_scale and sprite.has_meta(BattleMonsterDefeatEffect.BASE_SCALE_META):
		saved_defeat_scale_meta = sprite.get_meta(BattleMonsterDefeatEffect.BASE_SCALE_META)
		sprite.set_meta(BattleMonsterDefeatEffect.BASE_SCALE_META, Vector2(1.0, 1.0))
		restore_defeat_scale_meta = true
	var anchor: Vector2
	if _is_battle_ally_wrap_slot_layout(wrap):
		anchor = _get_battle_ally_defeat_anchor_in_wrap(wrap)
	elif is_instance_valid(name_label):
		anchor = _get_ally_defeated_anchor_above_name(name_label, anchor_above_name_y)
	else:
		anchor = _get_ally_defeated_anchor_from_sprite(wrap, slot, sprite)
	var opts: = BattleMonsterDefeatEffect.build_ally_defeat_opts_from_anchor(
		sprite, wrap, anchor, static_offset, dizzy_offset, flip_horizontal, override_texture
	)
	if opts.is_empty():
		if restore_defeat_scale_meta:
			sprite.set_meta(BattleMonsterDefeatEffect.BASE_SCALE_META, saved_defeat_scale_meta)
		return false
	if _is_battle_ally_wrap_slot_layout(wrap):
		opts = BattleMonsterDefeatEffect.align_ally_defeat_center_y(opts, anchor.y, dizzy_offset)
	else:
		var unified_center_y: = ALLY_DEFEATED_STATIC_CENTER_FIELD_Y - wrap.position.y
		opts = BattleMonsterDefeatEffect.align_ally_defeat_center_y(opts, unified_center_y, dizzy_offset)
	BattleMonsterDefeatEffect.apply_defeated_on(wrap, slot, sprite, opts)
	if restore_defeat_scale_meta:
		sprite.set_meta(BattleMonsterDefeatEffect.BASE_SCALE_META, saved_defeat_scale_meta)
	if _is_bt_battle() and _is_ally_defeat_fx_present(wrap):
		var unit_key: = _unit_key_for_wrap(wrap)
		if unit_key != "":
			_set_bt_visual_state(unit_key, BT_ALLY_VIS_DEFEATED)
	return _is_ally_defeat_fx_present(wrap)

func _clear_ally_defeat_effect(wrap: Control, slot: Control, sprite: CanvasItem) -> void :
	if not is_instance_valid(wrap) or not is_instance_valid(slot):
		return
	BattleMonsterDefeatEffect.clear_defeated_on(wrap, slot, sprite)
	_restore_battle_sprite_layout_after_defeat(wrap, slot, sprite)
	if _is_bt_battle():
		var unit_key: = _unit_key_for_wrap(wrap)
		if unit_key != "" and _bt_visual_state(unit_key) == BT_ALLY_VIS_DEFEATED:
			_set_bt_visual_state(unit_key, BT_ALLY_VIS_IDLE)

func _restore_battle_sprite_layout_after_defeat(wrap: Control, slot: Control, sprite: CanvasItem) -> void :
	if not is_instance_valid(sprite):
		return
	if sprite.name in ["PlayerBattleAnim", "CoopPlayerBattleAnim"]:
		_layout_player_visual_in_current_scene(wrap)
		if sprite is AnimatedSprite2D:
			BattleMonsterDefeatEffect.remember_base_scale(sprite)
			_apply_battle_sprite_playback_state(sprite as AnimatedSprite2D)
	elif sprite.name in ["PetBattleSprite", "CoopPetBattleSprite"] and is_instance_valid(slot):
		_set_ally_pet_sprite_mirror(sprite, slot, _bt_ally_pet_mirror_x())
		if sprite is AnimatedSprite2D:
			_apply_battle_sprite_playback_state(sprite as AnimatedSprite2D)

func _set_player_battle_halo_battle_visible(show: bool) -> void :
	if not is_instance_valid(_battle_player_wrap):
		return
	var want_suppressed: = not show
	if _battle_player_halo_battle_suppressed == want_suppressed:
		return
	_battle_player_halo_battle_suppressed = want_suppressed
	var driver = _battle_player_wrap.get_node_or_null("RealmHaloDriver")
	if driver is BattleRealmHaloDriver:
		if want_suppressed:
			driver.set_battle_paused(true)
		else:
			driver.set_battle_paused(false)
	elif want_suppressed and is_instance_valid(_battle_player_halo):
		_battle_player_halo.visible = false
	elif show:
		_refresh_player_battle_halo()

func _apply_pet_avatar_mirror(tr: TextureRect, container: Control) -> void :
	if tr == null or container == null:
		return
	var box: Vector2 = container.custom_minimum_size
	if box.x <= 0.0 or box.y <= 0.0:
		box = Vector2(60.0, 60.0)
	tr.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tr.set_anchors_preset(Control.PRESET_CENTER)
	tr.offset_left = - box.x * 0.5
	tr.offset_top = - box.y * 0.5
	tr.offset_right = box.x * 0.5
	tr.offset_bottom = box.y * 0.5
	tr.custom_minimum_size = box
	tr.pivot_offset = box * 0.5
	tr.scale = Vector2(-1.0, 1.0)

