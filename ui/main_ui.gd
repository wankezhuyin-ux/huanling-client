func _talent_draft_sum() -> int:
	return _talent_draft_attack + _talent_draft_defense + _talent_draft_agility + _talent_draft_hp

func _talent_draft_has_pending() -> bool:
	if game_manager == null or game_manager.player == null:
		return false
	var p = game_manager.player
	return (
		_talent_draft_attack != int(p.talent_attack)
		or _talent_draft_defense != int(p.talent_defense)
		or _talent_draft_agility != int(p.talent_agility)
		or _talent_draft_hp != int(p.talent_hp)
	)

func _talent_sync_draft_from_player() -> void :
	if game_manager == null or game_manager.player == null:
		return
	var p = game_manager.player
	_talent_draft_attack = int(p.talent_attack)
	_talent_draft_defense = int(p.talent_defense)
	_talent_draft_agility = int(p.talent_agility)
	_talent_draft_hp = int(p.talent_hp)
	_talent_draft_ready = true


func _talent_sync_draft_floor_from_player() -> void :
	if game_manager == null or game_manager.player == null:
		return
	var p = game_manager.player
	if not _talent_draft_ready:
		_talent_sync_draft_from_player()
		return
	_talent_draft_attack = maxi(_talent_draft_attack, int(p.talent_attack))
	_talent_draft_defense = maxi(_talent_draft_defense, int(p.talent_defense))
	_talent_draft_agility = maxi(_talent_draft_agility, int(p.talent_agility))
	_talent_draft_hp = maxi(_talent_draft_hp, int(p.talent_hp))
	var earned: int = int(p.get_talent_points_earned())
	while _talent_draft_sum() > earned:
		if _talent_draft_hp > int(p.talent_hp):
			_talent_draft_hp -= 1
		elif _talent_draft_agility > int(p.talent_agility):
			_talent_draft_agility -= 1
		elif _talent_draft_defense > int(p.talent_defense):
			_talent_draft_defense -= 1
		elif _talent_draft_attack > int(p.talent_attack):
			_talent_draft_attack -= 1
		else:
			break

func _talent_draft_adjust(stat: String, delta: int) -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.player == null:
		return
	var player = game_manager.player
	_talent_sync_draft_floor_from_player()
	var earned: int = int(player.get_talent_points_earned())
	match stat:
		"attack":
			if delta < 0:
				_talent_draft_attack = maxi(int(player.talent_attack), _talent_draft_attack - 1)
			elif delta > 0:
				if _talent_draft_sum() >= earned:
					_add_log("[color=red]天赋点不足[/color]")
					return
				_talent_draft_attack = mini(GameData.TALENT_MAX_PER_STAT, _talent_draft_attack + 1)
		"defense":
			if delta < 0:
				_talent_draft_defense = maxi(int(player.talent_defense), _talent_draft_defense - 1)
			elif delta > 0:
				if _talent_draft_sum() >= earned:
					_add_log("[color=red]天赋点不足[/color]")
					return
				_talent_draft_defense = mini(GameData.TALENT_MAX_PER_STAT, _talent_draft_defense + 1)
		"agility":
			if delta < 0:
				_talent_draft_agility = maxi(int(player.talent_agility), _talent_draft_agility - 1)
			elif delta > 0:
				if _talent_draft_sum() >= earned:
					_add_log("[color=red]天赋点不足[/color]")
					return
				_talent_draft_agility = mini(GameData.TALENT_MAX_PER_STAT, _talent_draft_agility + 1)
		"hp":
			if delta < 0:
				_talent_draft_hp = maxi(int(player.talent_hp), _talent_draft_hp - 1)
			elif delta > 0:
				if _talent_draft_sum() >= earned:
					_add_log("[color=red]天赋点不足[/color]")
					return
				_talent_draft_hp = mini(GameData.TALENT_MAX_PER_STAT, _talent_draft_hp + 1)
		_:
			return
	_build_talent_view()

func _on_talent_apply_pressed() -> void :
	_talent_apply_async()

func _talent_apply_async() -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.player == null or game_manager.network == null:
		_add_log("[color=red]网络未连接，无法应用天赋[/color]")
		return
	_talent_sync_draft_floor_from_player()
	if not _talent_draft_has_pending():
		_add_log("[color=orange]没有待确认的加点[/color]")
		return
	var player = game_manager.player
	if _talent_draft_sum() > player.get_talent_points_earned():
		_add_log("[color=red]天赋点不足[/color]")
		return
	if (
		_talent_draft_attack < int(player.talent_attack)
		or _talent_draft_defense < int(player.talent_defense)
		or _talent_draft_agility < int(player.talent_agility)
		or _talent_draft_hp < int(player.talent_hp)
	):
		_add_log("[color=red]已确认的天赋点不能减少，请使用重置[/color]")
		_talent_sync_draft_from_player()
		_build_talent_view()
		return
	_player_attr_rpc_busy = true
	var res: Dictionary = await _await_player_talent_allocate(
		_talent_draft_attack, _talent_draft_defense, _talent_draft_agility, _talent_draft_hp
	)
	_player_attr_rpc_busy = false
	if not bool(res.get("ok", false)):
		_add_log("[color=red]%s[/color]" % str(res.get("error", "天赋应用失败")))
		_build_talent_view()
		return
	_finalize_player_attr_rpc_success(res.get("data", {}), true)
	_talent_sync_draft_from_player()
	_add_log("[color=green]天赋加点已确认生效[/color]")
	_build_talent_view()

func _on_talent_reset_pressed() -> void :
	_talent_reset_async()

func _talent_reset_async() -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.player == null or game_manager.network == null:
		_add_log("[color=red]网络未连接，无法重置天赋[/color]")
		return
	var cost: = GameData.TALENT_RESET_YUANBAO_COST
	if game_manager.player.get_talent_allocated_sum() <= 0:
		_add_log("[color=red]没有已确认的天赋点，无需重置[/color]")
		return
	if game_manager.player.yuanbao_currency < cost:
		_add_log("[color=red]元宝不足（需要%d）[/color]" % cost)
		return
	_player_attr_rpc_busy = true
	var res: Dictionary = await _await_player_talent_reset()
	_player_attr_rpc_busy = false
	if not bool(res.get("ok", false)):
		_add_log("[color=red]%s[/color]" % str(res.get("error", "天赋重置失败")))
		return
	_add_log("[color=green]天赋已重置，消耗%d元宝[/color]" % cost)
	_finalize_player_attr_rpc_success(res.get("data", {}), true)
	_talent_sync_draft_from_player()
	_build_talent_view()

func _await_player_talent_allocate(attack_v: int, defense_v: int, agility_v: int, hp_v: int) -> Dictionary:
	var net = game_manager.network if game_manager else null
	if net == null:
		return {"ok": false, "error": "网络未初始化"}
	var state: = {"done": false, "ok": false, "data": {}, "error": ""}
	var on_ok = func(d: Dictionary):
		state["done"] = true
		state["ok"] = true
		state["data"] = d
	var on_fail = func(err: String):
		state["done"] = true
		state["ok"] = false
		state["error"] = err
	net.player_talent_allocate_success.connect(on_ok, CONNECT_ONE_SHOT)
	net.player_talent_allocate_failed.connect(on_fail, CONNECT_ONE_SHOT)
	net.player_talent_allocate(_new_player_attr_operation_id(), attack_v, defense_v, agility_v, hp_v)
	var start_ms: = Time.get_ticks_msec()
	while not bool(state.get("done", false)):
		if Time.get_ticks_msec() - start_ms > _PLAYER_ATTR_RPC_WAIT_MS:
			if net.player_talent_allocate_success.is_connected(on_ok):
				net.player_talent_allocate_success.disconnect(on_ok)
			if net.player_talent_allocate_failed.is_connected(on_fail):
				net.player_talent_allocate_failed.disconnect(on_fail)
			return {"ok": false, "error": "天赋分配超时，请稍后重试"}
		await get_tree().process_frame
	if bool(state.get("ok", false)):
		return {"ok": true, "data": state.get("data", {})}
	return {"ok": false, "error": str(state.get("error", "天赋分配失败"))}

func _await_player_talent_reset() -> Dictionary:
	var net = game_manager.network if game_manager else null
	if net == null:
		return {"ok": false, "error": "网络未初始化"}
	var state: = {"done": false, "ok": false, "data": {}, "error": ""}
	var on_ok = func(d: Dictionary):
		state["done"] = true
		state["ok"] = true
		state["data"] = d
	var on_fail = func(err: String):
		state["done"] = true
		state["ok"] = false
		state["error"] = err
	net.player_talent_reset_success.connect(on_ok, CONNECT_ONE_SHOT)
	net.player_talent_reset_failed.connect(on_fail, CONNECT_ONE_SHOT)
	net.player_talent_reset(_new_player_attr_operation_id())
	var start_ms: = Time.get_ticks_msec()
	while not bool(state.get("done", false)):
		if Time.get_ticks_msec() - start_ms > _PLAYER_ATTR_RPC_WAIT_MS:
			if net.player_talent_reset_success.is_connected(on_ok):
				net.player_talent_reset_success.disconnect(on_ok)
			if net.player_talent_reset_failed.is_connected(on_fail):
				net.player_talent_reset_failed.disconnect(on_fail)
			return {"ok": false, "error": "天赋重置超时，请稍后重试"}
		await get_tree().process_frame
	if bool(state.get("ok", false)):
		return {"ok": true, "data": state.get("data", {})}
	return {"ok": false, "error": str(state.get("error", "天赋重置失败"))}

