func _is_block_unlearn_below_lv3() -> bool:
	var gm: = GameManager.instance
	if gm == null or not (gm.gameplay_runtime_config is Dictionary):
		return false
	var psl: Variant = gm.gameplay_runtime_config.get("petSkillLearn", {})
	if not (psl is Dictionary):
		return false
	return bool((psl as Dictionary).get("blockUnlearnBelowLv3", false))

func _request_pet_skill_slot_lock(pet, slot_index: int, locked: bool) -> void :
	if pet == null:
		_show_simple_dialog("操作失败", "宠物数据不存在")
		return
	var gm: = GameManager.instance
	if gm == null or gm.pet_skill_manager == null:
		_show_simple_dialog("操作失败", "技能管理器未初始化")
		return
	if gm.network == null or not gm.network.is_logged_in():
		_show_simple_dialog("操作失败", "锁定技能槽需要联网，请登录后重试")
		return
	var pid: = str(pet.id).strip_edges()
	if pid.is_empty():
		_show_simple_dialog("操作失败", "宠物数据不存在")
		return
	gm.pet_skill_manager.slot_lock_success.connect( func(data: Dictionary):
		var rid: = str(data.get("pet_id", "")).strip_edges()
		if not rid.is_empty():
			_refresh_open_pet_detail_for_pet(rid)
		_update_pet_view()
		var ok_msg: = str(data.get("message", "操作成功")).strip_edges()
		if ok_msg.is_empty():
			ok_msg = "已锁定技能槽" if locked else "已解锁技能槽"
		call_deferred("_show_simple_dialog", "提示", ok_msg)
	, CONNECT_ONE_SHOT)
	gm.pet_skill_manager.slot_lock_failed.connect( func(err: String):
		call_deferred("_show_simple_dialog", "操作失败", str(err).strip_edges() if not str(err).strip_edges().is_empty() else "操作失败，请稍后重试")
	, CONNECT_ONE_SHOT)
	gm.pet_skill_manager.request_lock_skill_slot(pid, slot_index, locked)

func _confirm_unlearn_skill(pet, slot_index: int):
	if pet == null:
		_show_simple_dialog("操作失败", "宠物数据不存在")
		return
	var skill_slot: Dictionary = pet.get_skill_slot(slot_index)
	var skill_name: = str(skill_slot.get("skill_name", "")).strip_edges()
	var skill_level: = int(skill_slot.get("level", 0))
	if skill_name.is_empty() or skill_level <= 0:
		_show_simple_dialog("操作失败", "该槽位没有技能")
		return
	if _is_block_unlearn_below_lv3() and skill_level < 3:
		_show_simple_dialog("操作失败", "lv1、lv2 技能不能卸载，升到 lv3 后才能卸载")
		return
	var gm: = GameManager.instance
	if gm == null or gm.pet_skill_manager == null:
		_show_simple_dialog("操作失败", "技能管理器未初始化")
		return
	if gm.network == null or not gm.network.is_logged_in():
		_show_simple_dialog("操作失败", "卸载技能需要联网，请登录后重试")
		return
	var is_fest: = false
	if gm.pet_manager != null:
		is_fest = bool(gm.pet_manager.is_festival_pet_id(str(pet.pet_id).strip_edges()))
	if pet.has_method("can_unlearn_skill_slot") and not bool(pet.can_unlearn_skill_slot(slot_index, is_fest)):
		_show_simple_dialog("操作失败", "该技能为领悟/继承技能，无法卸载")
		return
	var popup: = Window.new()
	popup.title = ""
	popup.size = Vector2i(400, 280)
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true

	var main_panel: = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	var panel_style: = StyleBoxFlat.new()
	panel_style.bg_color = Color(0.08, 0.1, 0.16, 0.97)
	panel_style.border_width_left = 2
	panel_style.border_width_top = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel_style.border_color = Color(0.3, 0.45, 0.7, 0.9)
	panel_style.corner_radius_top_left = 8
	panel_style.corner_radius_top_right = 8
	panel_style.corner_radius_bottom_left = 8
	panel_style.corner_radius_bottom_right = 8
	main_panel.add_theme_stylebox_override("panel", panel_style)
	popup.add_child(main_panel)

	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 20
	vbox.offset_top = 20
	vbox.offset_right = -20
	vbox.offset_bottom = -20
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 14)
	main_panel.add_child(vbox)

	var title_label: = Label.new()
	title_label.text = "卸载技能确认"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 18)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title_label)

	var msg_label: = Label.new()
	var keep_lv: = 0
	var refund_text: = ""
	if skill_slot.has("book_refunds") and skill_slot.get("book_refunds") is Array:
		var refunds: Array = skill_slot.get("book_refunds")
		var counts: Dictionary = {}
		for one in refunds:
			var bn: = str(one).strip_edges()
			if bn.is_empty():
				continue
			counts[bn] = int(counts.get(bn, 0)) + 1
		var parts: Array = []
		for bn in counts.keys():
			var c: = int(counts[bn])
			parts.append("%s×%d" % [bn, c] if c > 1 else bn)
		refund_text = "、".join(parts)
	if skill_slot.has("locked_level"):
		keep_lv = maxi(0, int(skill_slot.get("locked_level", 0)))
	var msg_text: = ""
	if not refund_text.is_empty():
		if keep_lv > 0:
			msg_text = "确定要卸下 %s 技能「%s」上的技能书吗？\n将扣除500元宝，退回：%s\n卸后保留领悟/自带：%slv%d" % [str(pet.pet_name), str(skill_name), refund_text, str(skill_name), keep_lv]
		else:
			msg_text = "确定要卸载 %s 的技能「%s」吗？\n将扣除500元宝，并把技能书退回背包：%s" % [str(pet.pet_name), str(skill_name), refund_text]
	else:
		var tier_cn: = "第%d阶" % skill_level
		match clampi(skill_level, 1, 3):
			1:
				tier_cn = "一阶"
			2:
				tier_cn = "二阶"
			3:
				tier_cn = "三阶"
			_:
				pass
		msg_text = "确定要卸载 %s 的技能「%s」（%s）吗？\n将扣除500元宝，并把对应技能书退回背包" % [str(pet.pet_name), str(skill_name), tier_cn]
	msg_label.text = msg_text
	msg_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	msg_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	msg_label.add_theme_font_size_override("font_size", 15)
	msg_label.add_theme_color_override("font_color", Color(0.85, 0.8, 0.75))
	vbox.add_child(msg_label)

	var btn_hbox: = HBoxContainer.new()
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	btn_hbox.add_theme_constant_override("separation", 20)
	vbox.add_child(btn_hbox)

	var confirm_btn: = Button.new()
	confirm_btn.text = "确定卸载"
	confirm_btn.custom_minimum_size = Vector2(110, 40)
	confirm_btn.add_theme_font_size_override("font_size", 16)
	confirm_btn.add_theme_color_override("font_color", Color(1, 0.5, 0.4))
	confirm_btn.pressed.connect( func():
		popup.queue_free()
		gm.pet_skill_manager.unlearn_success.connect( func(data: Dictionary):

			var pid: = str(data.get("pet_id", "")).strip_edges()
			if not pid.is_empty():
				_refresh_open_pet_detail_for_pet(pid)
			_update_pet_view()
			var ok_msg: = str(data.get("message", "技能已卸载"))
			var refunded: = str(data.get("refunded_book", "")).strip_edges()
			if not refunded.is_empty() and ok_msg.find(refunded) < 0 and ok_msg.find("技能书") < 0:
				ok_msg = "%s\n已退回：%s" % [ok_msg, refunded]
			call_deferred("_show_simple_dialog", "卸载成功", ok_msg)
		, CONNECT_ONE_SHOT)
		gm.pet_skill_manager.unlearn_failed.connect( func(err: String):
			call_deferred("_show_simple_dialog", "卸载失败", str(err))
		, CONNECT_ONE_SHOT)
		gm.pet_skill_manager.request_unlearn_skill(str(pet.id).strip_edges(), slot_index)
	)
	btn_hbox.add_child(confirm_btn)

	var cancel_btn: = Button.new()
	cancel_btn.text = "取消"
	cancel_btn.custom_minimum_size = Vector2(110, 40)
	cancel_btn.add_theme_font_size_override("font_size", 16)
	cancel_btn.pressed.connect( func(): popup.queue_free())
	btn_hbox.add_child(cancel_btn)

	var scene_root = Engine.get_main_loop().current_scene
	if scene_root:
		scene_root.add_child(popup)
	else:
		add_child(popup)
	popup.popup_centered()


func _show_release_pet_confirm_popup(pet, popup_ref, parent_release_btn: Button = null) -> bool:
	var popup_key = "pet_release_confirm:%s" % str(pet.id)
	if _focus_existing_popup(popup_key):
		if is_instance_valid(parent_release_btn) and is_instance_valid(popup_ref):
			var existing_pet = _resolve_live_pet(pet)
			if existing_pet != null:
				var ap = game_manager.pet_manager.get_active_pet() if game_manager and game_manager.pet_manager else null
				var pet_active = ap != null and str(ap.id) == str(existing_pet.id)
				if pet_active:
					parent_release_btn.disabled = true
					parent_release_btn.text = "出战中"
				elif existing_pet.locked:
					parent_release_btn.disabled = true
					parent_release_btn.text = "已锁定"
				else:
					parent_release_btn.disabled = false
					parent_release_btn.text = "放生"
		return false
	var popup_closed: = false
	var _restore_parent_release_btn: = func() -> void :
		if not is_instance_valid(parent_release_btn) or not is_instance_valid(popup_ref):
			return
		var current_pet = _resolve_live_pet(pet)
		if current_pet == null:
			return
		var active_pet = game_manager.pet_manager.get_active_pet() if game_manager and game_manager.pet_manager else null
		var pet_is_active = active_pet != null and str(active_pet.id) == str(current_pet.id)
		if pet_is_active:
			parent_release_btn.disabled = true
			parent_release_btn.text = "出战中"
		elif current_pet.locked:
			parent_release_btn.disabled = true
			parent_release_btn.text = "已锁定"
		else:
			parent_release_btn.disabled = false
			parent_release_btn.text = "放生"
	var _mark_release_popup_closed: = func() -> void :
		popup_closed = true
		_restore_parent_release_btn.call()
	var popup = Window.new()
	_mark_popup_key(popup, popup_key)
	popup.title = ""
	popup.size = Vector2i(400, 320)
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true
	popup.close_requested.connect( func():
		_mark_release_popup_closed.call()
		if is_instance_valid(popup):
			popup.queue_free()
	)

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	popup.add_child(main_panel)

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 25
	vbox.offset_top = 25
	vbox.offset_right = -25
	vbox.offset_bottom = -25
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 20)
	main_panel.add_child(vbox)

	var title_label = Label.new()
	title_label.text = "放生确认"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 22)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title_label)

	var pet_texture = AssetManager.get_instance().get_pet_texture(pet.pet_id)
	var icon_rect
	if pet_texture:
		icon_rect = TextureRect.new()
		icon_rect.texture = pet_texture
		icon_rect.custom_minimum_size = Vector2(60, 60)
		icon_rect.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
		icon_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	else:
		icon_rect = ColorRect.new()
		icon_rect.custom_minimum_size = Vector2(60, 60)
		icon_rect.color = Color(0.3, 0.3, 0.3)
	icon_rect.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	vbox.add_child(icon_rect)

	var pet_name_label = Label.new()
	pet_name_label.text = pet.pet_name
	pet_name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	pet_name_label.add_theme_font_size_override("font_size", 18)
	pet_name_label.add_theme_color_override("font_color", Color(1, 0.9, 0.5))
	vbox.add_child(pet_name_label)

	var msg_label = Label.new()
	msg_label.text = "确定要放生吗？\n此操作不可恢复！"
	msg_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	msg_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	msg_label.add_theme_font_size_override("font_size", 16)
	msg_label.add_theme_color_override("font_color", Color(0.9, 0.7, 0.7))
	vbox.add_child(msg_label)

	var btn_hbox = HBoxContainer.new()
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	btn_hbox.add_theme_constant_override("separation", 20)
	vbox.add_child(btn_hbox)

	var cancel_btn = Button.new()
	cancel_btn.text = "取消"
	UIStyle.style_popup_button(cancel_btn, false)
	cancel_btn.pressed.connect( func():
		_mark_release_popup_closed.call()
		if is_instance_valid(popup):
			popup.queue_free()
	)
	btn_hbox.add_child(cancel_btn)

	var confirm_btn = Button.new()
	confirm_btn.text = "确认放生"
	UIStyle.style_popup_button(confirm_btn, true)
	if DiscardProtection.needs_release_countdown(pet):
		confirm_btn.disabled = true
		confirm_btn.text = "确认放生(3)"
	var _release_popup_open: = func() -> bool:
		return not popup_closed and is_instance_valid(popup) and is_instance_valid(confirm_btn)
	var _reset_release_confirm_btn: = func() -> void :
		if is_instance_valid(confirm_btn):
			confirm_btn.disabled = false
			confirm_btn.text = "确认放生"

	var _fail_release: = func(title: String, msg: String) -> void :
		_restore_parent_release_btn.call()
		if _release_popup_open.call():
			_reset_release_confirm_btn.call()
		_show_simple_dialog(title, msg)
	confirm_btn.pressed.connect( func():
		if not game_manager or not game_manager.pet_manager:
			_show_simple_dialog("操作失败", "宠物管理器未初始化")
			_mark_release_popup_closed.call()
			if is_instance_valid(popup):
				popup.queue_free()
			if popup_ref and is_instance_valid(popup_ref):
				popup_ref.queue_free()
			return
		confirm_btn.disabled = true
		confirm_btn.text = "放生中..."
		var live_pet = _resolve_live_pet(pet)
		if live_pet == null:
			_mark_release_popup_closed.call()
			if is_instance_valid(popup):
				popup.queue_free()
			if popup_ref and is_instance_valid(popup_ref):
				popup_ref.queue_free()
			_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
			return
		if game_manager.pet_manager.has_method("is_pet_in_assist") and game_manager.pet_manager.is_pet_in_assist(live_pet):
			_fail_release.call("操作失败", "请先从助战槽取出该宠物，再放生")
			return
		if not game_manager.network or not game_manager.network.is_logged_in():
			_fail_release.call("操作失败", "需要联网后才能放生宠物")
			return
		if not bool(game_manager.is_cloud_sync_ready()):
			_fail_release.call("操作失败", "出战宠物状态同步中，请稍后再试")
			return

		var state: = {"done": false, "ok": false, "message": "", "data": {}}
		var op_id: = "pet_release_%d_%s" % [Time.get_ticks_usec(), str(live_pet.id)]
		var on_success = func(data: Dictionary):
			state.done = true
			state.ok = true
			state.data = data if data is Dictionary else {}
			state.message = str(state.data.get("message", "宠物已放生"))
		var on_failed = func(error: String):
			state.done = true
			state.ok = false
			state.message = error
		game_manager.network.pet_release_success.connect(on_success, CONNECT_ONE_SHOT)
		game_manager.network.pet_release_failed.connect(on_failed, CONNECT_ONE_SHOT)
		if game_manager.has_method("begin_pet_bag_op_cloud_sync"):
			game_manager.begin_pet_bag_op_cloud_sync()
		game_manager.network.pet_release(str(live_pet.id), op_id)
		var deadline: = Time.get_ticks_msec() + 20000
		while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
			await game_manager.get_tree().process_frame
		if game_manager.network.pet_release_success.is_connected(on_success):
			game_manager.network.pet_release_success.disconnect(on_success)
		if game_manager.network.pet_release_failed.is_connected(on_failed):
			game_manager.network.pet_release_failed.disconnect(on_failed)
		if game_manager.has_method("end_pet_bag_op_cloud_sync"):
			game_manager.end_pet_bag_op_cloud_sync()
		if not bool(state.done):
			_fail_release.call("放生失败", "服务器响应超时，请稍后重试。")
			return
		if not bool(state.ok):
			_fail_release.call("放生失败", str(state.message))
			return

		if state.data.has("saveData") and state.data.get("saveData") is Dictionary:
			game_manager.apply_cloud_save(state.data.get("saveData"), {"pets_authoritative": true, "skip_deferred_cloud_save": true, "skip_pet_collection_trim": true})
			game_manager.save_game(false)
		else:
			var rid: = str(live_pet.id)
			var res_v: Variant = state.data.get("result")
			if res_v is Dictionary:
				var rpid: = str((res_v as Dictionary).get("petId", "")).strip_edges()
				if not rpid.is_empty():
					rid = rpid
			if game_manager.pet_manager:
				game_manager.pet_manager.remove_pet_by_id(rid)
			game_manager.save_game(false)
		_update_pet_ui()
		_update_pet_view()
		_mark_release_popup_closed.call()
		if popup_ref and is_instance_valid(popup_ref):
			popup_ref.queue_free()
		if is_instance_valid(popup):
			popup.queue_free()
		_show_simple_dialog("放生成功", str(state.message))
	)
	btn_hbox.add_child(confirm_btn)

	add_child(popup)
	popup.popup_centered()
	UIStyle.animate_window_popup(popup)
	if DiscardProtection.needs_release_countdown(pet):
		_run_release_confirm_countdown(popup, confirm_btn)
	return true

func _run_release_confirm_countdown(popup: Window, confirm_btn: Button) -> void :
	var remain: = 3
	while remain > 0:
		await get_tree().create_timer(1.0).timeout
		if not is_instance_valid(popup) or not is_instance_valid(confirm_btn):
			return
		remain -= 1
		if remain <= 0:
			confirm_btn.disabled = false
			confirm_btn.text = "确认放生"
		else:
			confirm_btn.text = "确认放生(%d)" % remain


func _show_discard_dialog(item):
	if DiscardProtection.cannot_discard_inventory_item(item):
		_show_game_alert(DiscardProtection.blocked_message(), "无法丢弃")
		return
	_show_discard_material_confirm_popup(item)

func _show_limit_material_aggregate_popup(aggregate_entry: Dictionary) -> void :
	_update_bag_detail_bar_item(aggregate_entry)
	var item_name: = str(aggregate_entry.get("name", "极限材料"))
	var total_count: = int(aggregate_entry.get("count", 0))
	var source_key: = str(aggregate_entry.get("source_key", "bag"))
	var is_bag_source: = source_key == "bag"
	var popup_key = "limit_material_aggregate:%s:%s" % [source_key, item_name]
	var shell: = _open_styled_popup(popup_key, INVENTORY_DETAIL_POPUP_GROUP, Vector2i(500, 430), 12)
	if shell.is_empty():
		return
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox

	var title = Label.new()
	title.text = "%s x%d" % [item_name, total_count]
	title.add_theme_font_size_override("font_size", 24)
	title.add_theme_color_override("font_color", Color(1, 0.9, 0.35))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vbox.add_child(title)

	var desc_label = Label.new()
	desc_label.text = "可用于装备极限锻造的材料"
	desc_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	desc_label.add_theme_font_size_override("font_size", 16)
	desc_label.add_theme_color_override("font_color", Color(0.7, 0.7, 0.8))
	desc_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vbox.add_child(desc_label)

	var count_label = Label.new()
	count_label.text = "当前总数量：%d" % total_count
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	count_label.add_theme_font_size_override("font_size", 18)
	count_label.add_theme_color_override("font_color", Color(0.85, 0.9, 1.0))
	vbox.add_child(count_label)

	var sep = HSeparator.new()
	vbox.add_child(sep)

	var popup_ref = popup
	var close_popup_ref_once: = func():
		if not is_instance_valid(popup_ref):
			return
		if popup_ref.has_meta("closed"):
			return
		popup_ref.set_meta("closed", true)
		popup_ref.queue_free()

	var amount_box = HBoxContainer.new()
	amount_box.alignment = BoxContainer.ALIGNMENT_CENTER
	amount_box.add_theme_constant_override("separation", 12)
	vbox.add_child(amount_box)

	var amount_text = Label.new()
	amount_text.text = "存仓数量：" if is_bag_source else "取出数量："
	amount_text.add_theme_font_size_override("font_size", 18)
	amount_box.add_child(amount_text)

	var amount_spin = SpinBox.new()
	amount_spin.min_value = 1
	amount_spin.max_value = max(1, total_count)
	amount_spin.step = 1
	amount_spin.value = max(1, total_count)
	amount_spin.custom_minimum_size = Vector2(120, 42)
	amount_box.add_child(amount_spin)

	var button_row = HBoxContainer.new()
	button_row.alignment = BoxContainer.ALIGNMENT_CENTER
	button_row.add_theme_constant_override("separation", 10)
	vbox.add_child(button_row)

	var primary_btn = Button.new()
	primary_btn.text = "按数量存仓" if is_bag_source else "按数量取出"
	primary_btn.custom_minimum_size = Vector2(180, 45)
	primary_btn.add_theme_font_size_override("font_size", 18)
	var primary_style = StyleBoxFlat.new()
	primary_style.bg_color = Color(0.2, 0.4, 0.6) if is_bag_source else Color(0.2, 0.5, 0.3)
	primary_style.corner_radius_top_left = 6
	primary_style.corner_radius_top_right = 6
	primary_style.corner_radius_bottom_left = 6
	primary_style.corner_radius_bottom_right = 6
	primary_btn.add_theme_stylebox_override("normal", primary_style)
	var primary_hover = primary_style.duplicate()
	primary_hover.bg_color = Color(0.3, 0.5, 0.7) if is_bag_source else Color(0.3, 0.6, 0.4)
	primary_btn.add_theme_stylebox_override("hover", primary_hover)
	primary_btn.pressed.connect( func():
		if not game_manager or not game_manager.inventory_manager:
			_show_simple_dialog("操作失败", "背包管理器未初始化")
			return
		if game_manager.network == null or not game_manager.network.is_logged_in():
			_show_simple_dialog("操作失败", "请先登录账号后再进行此操作。")
			return
		var request_count: = clampi(int(amount_spin.value), 1, total_count)
		var picked_items: Array = game_manager.inventory_manager.get_limit_material_aggregate_pick_items(aggregate_entry, request_count)
		if picked_items.size() < request_count:
			_show_simple_dialog("操作失败", "可用实例数量不足，请刷新后重试。")
			return
		var picked_ids: Array = []
		for entry in picked_items:
			var live_item = entry
			if live_item == null:
				continue
			picked_ids.append(str(live_item.id))
		if picked_ids.size() < request_count:
			_show_simple_dialog("操作失败", "材料实例不存在，操作已中止")
			return
		primary_btn.disabled = true
		primary_btn.text = "存仓中..." if is_bag_source else "取出中..."
		var state: = {"done": false, "ok": false, "message": ""}
		var op_id: = "%s_%d_%d" % ["inventory_store_warehouse_batch" if is_bag_source else "equipment_retrieve_warehouse_batch_item", Time.get_unix_time_from_system(), Time.get_ticks_msec()]
		var on_success = func(data: Dictionary):
			state.done = true
			state.ok = true
			state.message = str(data.get("message", "已完成操作"))
			if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
				game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
		var on_failed = func(error: String):
			state.done = true
			state.ok = false
			state.message = error
		if is_bag_source:
			game_manager.network.inventory_store_warehouse_batch_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.inventory_store_warehouse_batch_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_inventory_store_warehouse_batch(picked_ids, op_id, item_name, "material")
		else:
			game_manager.network.equipment_retrieve_warehouse_batch_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.equipment_retrieve_warehouse_batch_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_equipment_retrieve_warehouse_batch(picked_ids, "item", op_id)
		var deadline: = Time.get_ticks_msec() + 20000
		while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
			await game_manager.get_tree().process_frame
		if not bool(state.done):
			primary_btn.disabled = false
			primary_btn.text = "按数量存仓" if is_bag_source else "按数量取出"
			_show_simple_dialog("操作失败", "服务器响应超时，请稍后重试。")
			return
		if not bool(state.ok):
			primary_btn.disabled = false
			primary_btn.text = "按数量存仓" if is_bag_source else "按数量取出"
			_show_simple_dialog("操作失败", str(state.message))
			return
		close_popup_ref_once.call()
		_show_simple_dialog("操作成功", ("已将 %s x%d 存入仓库" if is_bag_source else "已将 %s x%d 从仓库取出") % [item_name, request_count])
		_update_bag_view()
	)
	button_row.add_child(primary_btn)

	var cancel_btn = _popup_fixed_btn("关闭", POPUP_ACTION_BTN_SIZE)
	cancel_btn.pressed.connect( func():
		close_popup_ref_once.call()
	)
	button_row.add_child(cancel_btn)

	_finish_styled_popup(popup)


func _show_game_alert(message: String, title: String = "提示"):
	var popup_key = "game_alert:%s:%s" % [title, message]
	if _focus_existing_popup(popup_key):
		return
	var dialog = Window.new()
	_mark_popup_key(dialog, popup_key)
	dialog.title = ""
	var line_count = message.split("\n").size()
	var content_height = max(80, line_count * 28)
	var total_height = 200 + content_height
	dialog.size = Vector2i(420, total_height)
	dialog.transparent = true
	dialog.borderless = true
	dialog.unresizable = true
	var close_alert_once: = func():
		if not is_instance_valid(dialog):
			return
		if dialog.has_meta("closed"):
			return
		dialog.set_meta("closed", true)
		dialog.queue_free()
	dialog.close_requested.connect(close_alert_once)

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	dialog.add_child(main_panel)

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 25
	vbox.offset_top = 25
	vbox.offset_right = -25
	vbox.offset_bottom = -25
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 20)
	main_panel.add_child(vbox)

	var title_label = Label.new()
	title_label.text = title
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 24)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title_label)

	var content_label = Label.new()
	content_label.text = message
	content_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	content_label.add_theme_font_size_override("font_size", 18)
	content_label.add_theme_color_override("font_color", Color(0.9, 0.9, 0.95))
	content_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vbox.add_child(content_label)

	var spacer = Control.new()
	spacer.custom_minimum_size = Vector2(0, 10)
	vbox.add_child(spacer)

	var ok_btn = Button.new()
	ok_btn.text = "确定"
	UIStyle.style_popup_button(ok_btn, true)
	ok_btn.pressed.connect(close_alert_once)
	vbox.add_child(ok_btn)

	var scene_root = Engine.get_main_loop().current_scene
	if scene_root:
		scene_root.add_child(dialog)
		dialog.popup_centered()


const _PLAYER_ATTR_RPC_WAIT_MS: = 45000
const _PLAYER_ATTR_AUTO_RETRY_DEBOUNCE_MS: = 30000
const _PLAYER_ATTR_AUTO_FAIL_RETRY_DEBOUNCE_MS: = 3000
const _PLAYER_ATTR_AUTO_FAIL_RETRY_MAX: = 3
const _PLAYER_ATTR_AUTO_RETRY_GLOBAL_KEY: = "_global"
const _PLAYER_ATTR_AUTO_RPC_SOURCES: Array[String] = ["battle_loot", "post_combat"]

func _can_spend_player_attr_via_server() -> bool:
	return game_manager != null and game_manager.network != null and game_manager.network.is_logged_in()

func _player_attr_meets_auto_allocate_threshold(player_ref) -> bool:
	if player_ref == null or not player_ref.auto_allocation_enabled:
		return false
	if player_ref.pending_auto_points < player_ref.AUTO_ALLOCATE_THRESHOLD:
		return false
	var plan_total: int = player_ref._auto_allocation_plan_total()
	if plan_total <= 0 or player_ref.pending_auto_points < plan_total:
		return false
	return true

func _is_player_attr_auto_allocate_sync_pending_error(err: String) -> bool:
	var detail: = str(err).strip_edges()
	return detail == "待分配点数不足一整轮方案" or detail == "没有待分配属性点"

func _new_player_attr_operation_id() -> String:
	return "%s_%s" % [str(Time.get_unix_time_from_system()), str(randi())]

func _can_player_attr_auto_retry(source: String) -> bool:
	if _player_attr_rpc_busy:
		return false
	if game_manager == null or game_manager.player == null:
		return false
	if not _can_spend_player_attr_via_server():
		return false
	if source == "battle_loot":
		return true
	var now_ms: = Time.get_ticks_msec()
	if int(_player_attr_auto_retry_until_ms.get(_PLAYER_ATTR_AUTO_RETRY_GLOBAL_KEY, 0)) > now_ms:
		return false
	return true

func _mark_player_attr_auto_success_debounce() -> void :
	_player_attr_auto_retry_until_ms[_PLAYER_ATTR_AUTO_RETRY_GLOBAL_KEY] = Time.get_ticks_msec() + _PLAYER_ATTR_AUTO_RETRY_DEBOUNCE_MS

func _schedule_player_attr_auto_allocate_check(source: String) -> void :
	if source not in _PLAYER_ATTR_AUTO_RPC_SOURCES:
		return
	if game_manager == null or game_manager.player == null:
		return
	var player_ref = game_manager.player
	if not _player_attr_meets_auto_allocate_threshold(player_ref):
		return
	if not _can_spend_player_attr_via_server():
		return
	_player_attr_auto_check_source = source
	if _player_attr_auto_check_pending:
		return
	_player_attr_auto_check_pending = true
	call_deferred("_run_player_attr_auto_allocate_check")

func _run_player_attr_auto_allocate_check() -> void :
	_player_attr_auto_check_pending = false
	var source: = _player_attr_auto_check_source
	if not _can_player_attr_auto_retry(source):
		return
	if game_manager == null or game_manager.player == null:
		return
	var player_ref = game_manager.player
	if not _player_attr_meets_auto_allocate_threshold(player_ref):
		return
	var now_ms: = Time.get_ticks_msec()
	if now_ms < _player_attr_auto_fail_retry_until_ms:
		if get_tree() == null:
			return
		var wait_sec: = float(_player_attr_auto_fail_retry_until_ms - now_ms) / 1000.0 + 0.05
		get_tree().create_timer(wait_sec).timeout.connect(
			func(): _schedule_player_attr_auto_allocate_check(source), 
			CONNECT_ONE_SHOT
		)
		return
	_try_player_attr_auto_allocate_after_level_up()

func _maybe_retry_player_attr_auto_allocate(source: String) -> void :
	_schedule_player_attr_auto_allocate_check(source)

func _handle_player_attr_auto_allocate_failure(err: String) -> void :
	var detail: = str(err).strip_edges()
	if _is_player_attr_auto_allocate_sync_pending_error(detail):
		print("[player_attr] auto-allocate sync pending: %s" % detail)
		_notify_player_attr_changed("auto_allocate_failed")
		return
	if detail.is_empty():
		detail = "待分配点数同步中"
		print("[player_attr] auto-allocate sync pending: %s" % detail)
		_notify_player_attr_changed("auto_allocate_failed")
		return
	var msg: = "[color=orange]自动分配暂未生效：%s（稍后将重试）[/color]" % detail
	if game_manager != null and game_manager.in_battle:
		_pending_battle_attr_log_lines.append(msg)
	else:
		_add_log(msg)
	_notify_player_attr_changed("auto_allocate_failed")
	if _player_attr_auto_fail_retry_count >= _PLAYER_ATTR_AUTO_FAIL_RETRY_MAX:
		return
	_player_attr_auto_fail_retry_count += 1
	_player_attr_auto_fail_retry_until_ms = Time.get_ticks_msec() + _PLAYER_ATTR_AUTO_FAIL_RETRY_DEBOUNCE_MS
	if get_tree() == null:
		return
	get_tree().create_timer(float(_PLAYER_ATTR_AUTO_FAIL_RETRY_DEBOUNCE_MS) / 1000.0).timeout.connect(
		func(): _schedule_player_attr_auto_allocate_check("battle_loot"), 
		CONNECT_ONE_SHOT
	)

const _PLAYER_ATTR_SLICE_KEYS: Array = [
	"vitality", "magic", "attack_base", "defense_base", "agility_base", 
	"points", "pending_auto_points", "permanent_points", 
	"talent_attack", "talent_defense", "talent_agility", "talent_hp", 
	"yuanbao_currency", "yuanbao", 
]

func _apply_local_auto_allocation_settings(enabled: bool, plan: Dictionary) -> void :
	if game_manager == null or game_manager.player == null:
		return
	var player_ref = game_manager.player
	player_ref.auto_allocation_enabled = enabled
	for key in ["vitality", "attack", "defense", "magic", "agility"]:
		player_ref.auto_allocation_plan[key] = maxi(0, int(plan.get(key, 0)))

func _extract_attr_slice_from_dict(pd: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for key in _PLAYER_ATTR_SLICE_KEYS:
		if pd.has(key):
			out[key] = pd[key]
	if pd.has("auto_allocation_enabled"):
		out["auto_allocation_enabled"] = bool(pd.get("auto_allocation_enabled", false))
	if pd.has("auto_allocation_plan") and pd.get("auto_allocation_plan") is Dictionary:
		out["auto_allocation_plan"] = (pd.get("auto_allocation_plan") as Dictionary).duplicate(true)
	return out

func _extract_attr_slice_from_rpc_data(data: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	if data.has("attrSlice") and data.get("attrSlice") is Dictionary:
		out = _extract_attr_slice_from_dict(data.get("attrSlice") as Dictionary)
	if data.has("saveData") and data.get("saveData") is Dictionary:
		var pd: Variant = (data.get("saveData") as Dictionary).get("playerData", {})
		if pd is Dictionary:
			var from_save: Dictionary = _extract_attr_slice_from_dict(pd as Dictionary)
			for key in from_save.keys():
				if not out.has(key):
					out[key] = from_save[key]

	if data.has("allocated") and data.get("allocated") is Dictionary:
		var alloc: Dictionary = data.get("allocated") as Dictionary
		for key in ["talent_attack", "talent_defense", "talent_agility", "talent_hp"]:
			if alloc.has(key):
				out[key] = alloc[key]
	if data.has("autoAllocationEnabled"):
		out["auto_allocation_enabled"] = bool(data.get("autoAllocationEnabled", false))
	if data.has("autoAllocationPlan") and data.get("autoAllocationPlan") is Dictionary:
		out["auto_allocation_plan"] = (data.get("autoAllocationPlan") as Dictionary).duplicate(true)
	return out

func _apply_player_attr_authoritative_save(data: Dictionary) -> void :
	if game_manager == null or data.is_empty():
		return
	var pd: Dictionary = _extract_attr_slice_from_rpc_data(data)
	if pd.is_empty():
		push_warning("[MainUI] 属性点 RPC 回包缺少 attrSlice/saveData.playerData，未写入内存")
		return
	var save_rev: = int(data.get("saveRevision", -1))
	var rpc_save_data: Dictionary = {}
	if data.has("saveData") and data.get("saveData") is Dictionary:
		rpc_save_data = (data.get("saveData") as Dictionary).duplicate(true)
	if save_rev < 0 and not rpc_save_data.is_empty():
		save_rev = game_manager._extract_save_revision_from_save_data(rpc_save_data)
	var battle_light: bool = game_manager.in_battle
	game_manager.apply_player_attr_authoritative_from_rpc(rpc_save_data, pd, save_rev, battle_light)
	if game_manager.is_field_combat_hp_merge_blocked():
		_deferred_attr_authoritative_save = {
			"playerData": pd.duplicate(true), 
			"saveRevision": save_rev, 
		}

