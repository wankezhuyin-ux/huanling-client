	tool_row.add_theme_constant_override("separation", int(round(10.0 * s)))
	tool_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tool_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pet_list_container.add_child(tool_row)

	tool_row.add_child(_ink_text("灵兽名录", 29.0, INK_GOLD_HI, true, true))
	tool_row.add_child(_ink_text("%d / %d" % [pet_manager.get_pet_count(), pet_manager.max_pets],
		20.0, Color(0.74, 0.69, 0.58), false))

	var spacer: = Control.new()
	spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	spacer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tool_row.add_child(spacer)

	var sort_option = OptionButton.new()
	sort_option.add_item("等级降序")
	sort_option.add_item("等级升序")
	sort_option.add_item("成长降序")
	sort_option.add_item("成长升序")
	sort_option.add_item("代数降序")
	sort_option.add_item("代数升序")
	sort_option.selected = pet_list_sort_mode
	# 二级按钮统一抬到 68 设计高 / 24 号字：40 高那版在 1080 宽手机上只有 42 物理像素
	# （约 14dp），远低于安卓 48dp 的最小可点区，手指根本压不准。
	sort_option.custom_minimum_size = Vector2(196.0, 68.0) * s
	sort_option.size_flags_vertical = Control.SIZE_FILL
	sort_option.add_theme_font_size_override("font_size", _ink_font(24.0))
	sort_option.item_selected.connect( func(idx):
		pet_list_sort_mode = idx
		_refresh_pet_list_view()
	)
	_ink_option_button(sort_option, _ink_font(24.0))
	tool_row.add_child(sort_option)

	var batch_release_btn: = _popup_fixed_btn("批量放生", Vector2(160.0, 68.0) * s)
	batch_release_btn.size_flags_vertical = Control.SIZE_FILL
	_ink_outline_button(batch_release_btn, _ink_font(24.0), Color(0.72, 0.34, 0.26))
	batch_release_btn.pressed.connect( func(): _show_pet_batch_release_popup())
	tool_row.add_child(batch_release_btn)

	var batch_store_btn: = _popup_fixed_btn("批量存袋", Vector2(160.0, 68.0) * s)
	batch_store_btn.size_flags_vertical = Control.SIZE_FILL
	_ink_outline_button(batch_store_btn, _ink_font(24.0), Color(0.60, 0.68, 0.62))
	batch_store_btn.pressed.connect( func(): _show_pet_batch_store_popup())
	tool_row.add_child(batch_store_btn)

	# 图鉴入口：设计稿是一整页，实装原来只有角色页一行五行进度，没有入口
	var atlas_btn: = _popup_fixed_btn("图 鉴", Vector2(128.0, 68.0) * s)
	atlas_btn.size_flags_vertical = Control.SIZE_FILL
	_ink_outline_button(atlas_btn, _ink_font(24.0))
	atlas_btn.pressed.connect( func(): _show_pet_atlas_page())
	tool_row.add_child(atlas_btn)

	var sorted_pets = _get_filtered_pets_for_list(pet_manager, null)

	for i in range(sorted_pets.size()):
		pet_list_container.add_child(_create_pet_item_ui(sorted_pets[i], i))

	if pet_manager.get_pet_count() == 0:
		pet_list_container.add_child(_create_placeholder_label("暂无灵兽\n战斗胜利后自动捕捉"))
	else:
		var tip_row: = HBoxContainer.new()
		tip_row.add_theme_constant_override("separation", int(round(8.0 * s)))
		tip_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
		tip_row.add_child(_ink_text("战斗胜利后自动捕捉 · 成长值低于设定阈值的灵兽自动喂入图鉴",
			18.0, Color(0.50, 0.47, 0.40), false))
		pet_list_container.add_child(tip_row)

	_setup_mouse_filter(pet_list_container)

func _get_filtered_pets_for_list(pet_manager, exclude_pet) -> Array:
	var pets = []
	var active_pet = pet_manager.get_active_pet()

	for i in range(pet_manager.get_pet_count()):
		var pet = pet_manager.get_pet(i)
		if exclude_pet and pet.id == exclude_pet.id:
			continue
		pets.append(pet)

	match pet_list_sort_mode:
		0:
			pets.sort_custom( func(a, b): return a.level > b.level)
		1:
			pets.sort_custom( func(a, b): return a.level < b.level)
		2:
			pets.sort_custom( func(a, b): return a.total_growth > b.total_growth)
		3:
			pets.sort_custom( func(a, b): return a.total_growth < b.total_growth)
		4:
			pets.sort_custom( func(a, b): return a.generation > b.generation)
		5:
			pets.sort_custom( func(a, b): return a.generation < b.generation)

	if active_pet:
		var active_idx = -1
		for i in range(pets.size()):
			if pets[i].id == active_pet.id:
				active_idx = i
				break
		if active_idx >= 0:
			var active_pet_item = pets[active_idx]
			pets.remove_at(active_idx)
			pets.insert(0, active_pet_item)

	return pets

func _refresh_pet_list_view():
	_clear_container_immediate(pet_list_container)
	_build_pet_list_view()

func _close_window_popups_by_key(popup_key: String) -> bool:

	var closed: = false
	while true:
		var existing = _find_existing_window_popup(popup_key)
		if existing == null or not is_instance_valid(existing):
			break
		if existing.has_meta("popup_key"):
			existing.remove_meta("popup_key")
		existing.hide()
		var parent_node = existing.get_parent()
		if parent_node != null:
			parent_node.remove_child(existing)
		existing.queue_free()
		closed = true
	return closed

func _refresh_open_pet_detail_for_pet(pet_id: String) -> void :
	var pid = str(pet_id).strip_edges()
	if pid.is_empty():
		return
	var popup_key = "pet_detail:%s" % pid
	if not _close_window_popups_by_key(popup_key):
		return
	var live_pet = _find_live_pet_by_id(pid)
	if live_pet != null:
		_show_pet_detail_popup(live_pet)

func _refresh_pet_roster_after_authority_reward() -> void :
	_refresh_pet_list_view()
	if pet_bag_scroll != null and pet_bag_scroll.visible:
		_refresh_pet_bag_view()
	_update_pet_ui()
	if game_manager != null and game_manager.pet_manager != null:
		var active_pet = game_manager.pet_manager.get_active_pet()
		if active_pet != null:
			_refresh_open_pet_detail_for_pet(str(active_pet.id))

