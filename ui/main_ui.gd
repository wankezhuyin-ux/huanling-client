	skill_panel_style.corner_radius_bottom_left = 6
	skill_panel_style.corner_radius_bottom_right = 6
	skill_panel.add_theme_stylebox_override("panel", skill_panel_style)
	avatar_vbox.add_child(skill_panel)

	var skill_margin = MarginContainer.new()
	skill_margin.set_anchors_preset(Control.PRESET_FULL_RECT)
