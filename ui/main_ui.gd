func _fabao_fill_reset_compare_lines(host: Control, pending: Dictionary) -> void :
	var tier: = str(pending.get("tier", "normal"))
	var exp_v: = float(pending.get("exp_pct", 0))
	host.add_child(_fabao_make_rtl_line("[color=#ffd24d]经验提升+%.1f%%（上限%.1f%%）[/color]" % [exp_v, exp_v]))
	var before_list: Array = pending.get("currentAffixes", []) if pending.get("currentAffixes", []) is Array else []
	var after_list: Array = pending.get("previewAffixes", []) if pending.get("previewAffixes", []) is Array else []
	var lock_set: Dictionary = {}
	var locked_raw: Variant = pending.get("lockedGroups", pending.get("locked_groups", []))
	if locked_raw is Array:
		for g0 in locked_raw:
			lock_set[str(g0)] = true
	var n: = maxi(before_list.size(), after_list.size())
	for i in range(n):
		var before_aff: Dictionary = before_list[i] if i < before_list.size() and before_list[i] is Dictionary else {}
		var after_aff: Dictionary = after_list[i] if i < after_list.size() and after_list[i] is Dictionary else {}
		if before_aff.is_empty() and after_aff.is_empty():
			continue
		var bg: = str(before_aff.get("group", ""))
		var ag: = str(after_aff.get("group", ""))
		var kept: = ( not bg.is_empty()) and bg == ag and (bool(lock_set.get(bg, false)) or FabaoConfig.is_memorial_protected_group(tier, bg))
		var line: = ""
		if kept:
			line = "[color=#ffb347][已保留][/color] " + _fabao_affix_bbcode(tier, before_aff, bool(lock_set.get(bg, false)))
		elif after_aff.is_empty():
			line = _fabao_affix_bbcode(tier, before_aff, bool(lock_set.get(bg, false)))
		elif before_aff.is_empty():
			line = _fabao_affix_bbcode(tier, after_aff)
		else:
			var old_s: = _fabao_affix_bbcode(tier, before_aff)
			var new_s: = _fabao_affix_bbcode(tier, after_aff)
			line = "%s [color=#9aa0b0]->[/color] %s" % [old_s, new_s]
		host.add_child(_fabao_make_rtl_line(line))

