func _remove_all_player_battle_halo_nodes(wrap: Control) -> void :
	if wrap == null:
		return
	var to_free: Array[Node] = []
	for child in wrap.get_children():
		if child.name == "RealmHalo" or child.name == "RealmHaloDriver":
			to_free.append(child)
	for node in to_free:
		if is_instance_valid(node):
			node.free()
	if _battle_player_halo != null and not is_instance_valid(_battle_player_halo):
		_battle_player_halo = null

func _setup_player_battle_halo(wrap: Control, realm: String) -> void :
	var realm_key: = BattleRealmHalo.normalize_realm(realm)
	if wrap == null or not BattleRealmHalo.has_halo_for_realm(realm_key):
		return
	var existing_halo = wrap.get_node_or_null("RealmHalo") as AnimatedSprite2D
	var existing_driver = wrap.get_node_or_null("RealmHaloDriver")
	if existing_halo != null and existing_driver != null and realm_key == _battle_player_halo_realm and is_instance_valid(_battle_player_halo) and _battle_player_halo == existing_halo:
		_sync_player_battle_halo_modulate()
		return
	_remove_all_player_battle_halo_nodes(wrap)
	_clear_player_battle_halo_refs()
	var halo: AnimatedSprite2D = BattleRealmHalo.create_halo_node(realm_key)
	if halo == null:
		return
	halo.position = _get_battle_ally_slot_center_in_wrap(wrap)
	halo.z_index = BattleRealmHalo.get_halo_z_index(realm_key)
	wrap.add_child(halo)
	if BattleRealmHalo.is_halo_below_character(realm_key):
		wrap.move_child(halo, 0)
	BattleRealmHalo.attach_periodic_play(halo, wrap, realm_key)
	_battle_player_halo = halo
	_battle_player_halo_realm = realm_key
	_sync_player_battle_halo_modulate()

func _refresh_player_battle_halo() -> void :
	if not is_instance_valid(_battle_player_wrap):
		_clear_player_battle_halo_refs()
		return
	var display_player: = _get_battle_display_player()
	if display_player == null:
		_remove_all_player_battle_halo_nodes(_battle_player_wrap)
		_clear_player_battle_halo_refs()
		return
	var realm: String = BattleRealmHalo.normalize_realm(display_player.realm)
	if realm == _battle_player_halo_realm and is_instance_valid(_battle_player_halo):
		var tracked_halo = _battle_player_wrap.get_node_or_null("RealmHalo")
		if tracked_halo == _battle_player_halo:
			_sync_player_battle_halo_modulate()
			return
	_remove_all_player_battle_halo_nodes(_battle_player_wrap)
	_clear_player_battle_halo_refs()
	BattleRealmHalo.reset_play_schedule()
	if BattleRealmHalo.has_halo_for_realm(realm):
		_setup_player_battle_halo(_battle_player_wrap, realm)

func _ensure_player_battle_halo_after_visual_refresh() -> void :
	if not is_instance_valid(_battle_player_wrap) or not game_manager or not game_manager.player:
		return
	var realm: = BattleRealmHalo.normalize_realm(game_manager.player.realm)
	if not BattleRealmHalo.has_halo_for_realm(realm):
		return
	var halo_node: = _battle_player_wrap.get_node_or_null("RealmHalo") as AnimatedSprite2D
	var driver_node: = _battle_player_wrap.get_node_or_null("RealmHaloDriver")
	if halo_node == null or driver_node == null or not is_instance_valid(_battle_player_halo) or _battle_player_halo != halo_node:
		_refresh_player_battle_halo()
	else:
		_sync_player_battle_halo_modulate()
	_sync_player_battle_halo_position()
	var player = game_manager.player
	var player_dead: bool = player.hp <= 0 or not player.is_alive()
	if player_dead:
		_set_player_battle_halo_battle_visible(false)
	elif not _battle_player_halo_battle_suppressed:
		var driver = _battle_player_wrap.get_node_or_null("RealmHaloDriver")
		if driver is BattleRealmHaloDriver:
			driver.resume_if_stalled()

