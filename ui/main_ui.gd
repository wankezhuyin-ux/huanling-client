func _on_player_character_switch_popup_confirm_pressed() -> void :
	if _player_character_switch_busy:
		return
	var preview_id: = PlayerCharacterConfig.normalize_id(_player_character_popup_preview_id)
	var current_id: = _get_player_character_id()
	if preview_id == current_id:
		_show_tip_popup("当前已是该角色")
		return
	if not game_manager or not game_manager.player:
		return
	if game_manager.player.gold < PlayerCharacterConfig.SWITCH_COST_GOLD:
		_show_tip_popup("金币不足，切换角色需要5亿金币")
		return
	var target_name: = PlayerCharacterConfig.get_display_name(preview_id)
	_show_player_character_switch_confirm_popup(preview_id, target_name)

func _execute_player_character_switch(target_id: int) -> void :
	if _player_character_switch_busy:
		return
	if not game_manager or not game_manager.network:
		_show_tip_popup("网络未就绪，请稍后重试")
		return
	_player_character_switch_busy = true
	var confirm_btn: Button = _player_character_popup_state.get("confirm_btn")
	if is_instance_valid(confirm_btn):
		confirm_btn.disabled = true
	var op_id: = "player_switch_%s_%s" % [str(Time.get_unix_time_from_system()), str(randi())]
	var er: Dictionary = await game_manager.wait_economy("economy_player_switch_character", func():
		game_manager.network.economy_player_switch_character(target_id, op_id)
	, op_id)
	_player_character_switch_busy = false
	if is_instance_valid(confirm_btn):
		confirm_btn.disabled = false
	if not bool(er.get("ok", false)):
		var err_msg: = str(er.get("err", "切换失败，请稍后重试"))
		_show_tip_popup(err_msg)
		return
	var er_data: Dictionary = er.get("data", {})
	if er_data.has("saveData") and er_data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(er_data.get("saveData"), {
			"cosmetic_slice": true, 
			"currency_slice": true, 
		})
	elif er_data.has("saveData"):
		pass
	if er_data.has("saveRevision"):
		var srv_rev: = int(er_data.get("saveRevision", -1))
		if srv_rev >= 0:
			game_manager._set_cloud_save_revision(srv_rev)
	if game_manager.player:
		if er_data.has("newGold"):
			game_manager.player.gold = int(er_data.get("newGold", game_manager.player.gold))
		game_manager.player.player_character_id = PlayerCharacterConfig.normalize_id(
			er_data.get("playerCharacterId", target_id)
		)
		game_manager.gold_changed.emit(game_manager.player.gold)
	_close_player_character_switch_popup()
	_refresh_all_player_visuals()
	_show_tip_popup("角色切换成功")

func _on_active_pet_changed(pet):
	_cached_pet_texture = ""

	if pet and pet_avatar_rect:
		pet_name_label.text = "%s%s Lv.%d" % [pet.pet_name, ("(%d)" % pet.reincarnation_count) if pet.reincarnation_count > 0 else "", pet.level]
		var final_max_hp = pet.get_final_max_hp_with_equipment()
		pet_hp_bar.max_value = final_max_hp
		pet_hp_bar.value = pet.hp
		pet_hp_label.text = "%d%%" % int(float(pet.hp) / final_max_hp * 100)
		var pet_req_exp: = maxi(1, pet.get_required_exp())
		pet_exp_bar.max_value = pet_req_exp
		pet_exp_bar.value = mini(pet.experience, pet_req_exp)
		pet_exp_label.text = "%d%%" % int(clampf(pet.get_exp_percent(), 0.0, 1.0) * 100.0)
		_force_update_pet_avatar(pet.pet_id)
		_refresh_pet_battle_display()
	else:
		_update_pet_ui()

	if pet_view and pet_view.visible:
		if pet_list_scroll and pet_list_scroll.visible:
			_refresh_pet_list_view()
		elif pet_bag_scroll and pet_bag_scroll.visible and pet_bag_container:
			_clear_container_immediate(pet_bag_container)
			_build_pet_bag_view()
		elif pet_equipment_scroll and pet_equipment_scroll.visible:
			_refresh_pet_equipment_view()

func _force_update_pet_avatar(pet_id: String):
	_cached_pet_texture = ""

	var texture = AssetManager.get_instance().get_pet_texture(pet_id)
	if texture and pet_avatar_rect:
		var texture_rect_name = "AvatarTexture"
		var existing_texture = pet_avatar_rect.get_node_or_null(texture_rect_name)
		var avatar_size: Vector2 = pet_avatar_rect.custom_minimum_size
		if avatar_size.x <= 0.0 or avatar_size.y <= 0.0:
			avatar_size = Vector2(60, 60)

		if existing_texture:
			existing_texture.texture = texture
			existing_texture.custom_minimum_size = avatar_size
			existing_texture.mouse_filter = Control.MOUSE_FILTER_IGNORE
			_apply_pet_avatar_mirror(existing_texture, pet_avatar_rect)
		else:
			var new_texture_rect = TextureRect.new()
			new_texture_rect.name = texture_rect_name
			new_texture_rect.texture = texture
			new_texture_rect.custom_minimum_size = avatar_size
			new_texture_rect.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
			new_texture_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			new_texture_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
			pet_avatar_rect.add_child(new_texture_rect)
			_apply_pet_avatar_mirror(new_texture_rect, pet_avatar_rect)
	else:
		pass

func _chat_cache_channel_of(msg_data: Dictionary) -> String:
	var channel_type: = str(msg_data.get("channel_type", msg_data.get("channelType", ""))).strip_edges()
	return channel_type if not channel_type.is_empty() else "world"

func _chat_cache_gang_id_of(msg_data: Dictionary) -> int:
	return int(msg_data.get("gang_id", msg_data.get("gangId", 0)))

func _get_gang_chat_cache(gang_id: int) -> Array:
	var key: = str(maxi(0, gang_id))
	if not _cached_gang_messages.has(key):
		_cached_gang_messages[key] = []
	return _cached_gang_messages[key]

func _get_city_chat_cache_for_ui(city_ui: Node) -> Array:
	if city_ui and city_ui.has_method("get_active_chat_channel"):
		if String(city_ui.get_active_chat_channel()) == "gang":
			var gid: = 0
			if city_ui.has_method("get_active_chat_gang_id"):
				gid = int(city_ui.get_active_chat_gang_id())
			return _get_gang_chat_cache(gid).duplicate()
	return _cached_world_messages.duplicate()

func _trim_chat_cache(cache: Array, max_size: int = 100) -> void :
	while cache.size() > max_size:
		cache.pop_front()

func _append_to_chat_cache(d: Dictionary) -> void :
	var channel: = _chat_cache_channel_of(d)
	var gang_id: = _chat_cache_gang_id_of(d)
	var cache: Array
	if channel == "gang" and gang_id > 0:
		cache = _get_gang_chat_cache(gang_id)
	else:
		d["channel_type"] = "world"
		cache = _cached_world_messages
	_append_feed_dict_if_absent_to_cache(d, cache)

func _append_feed_dict_if_absent_to_cache(d: Dictionary, cache: Array) -> void :
	var bid: = int(d.get("broadcast_id", 0))
	if bid > 0:
		for cm in cache:
			if cm is Dictionary and int(cm.get("broadcast_id", 0)) == bid:
				return
	var mid: = int(d.get("id", 0))
	if mid > 0:
		for cm in cache:
			if cm is Dictionary and int(cm.get("id", 0)) == mid:
				return
	var pn = str(d.get("player_name", d.get("sender", "")))
	var ms = str(d.get("message", "")).strip_edges()
	if ms.is_empty():
		return
	var ev = str(d.get("event_type", "chat"))
	if ev != "chat":
		for cm in cache:
			if not cm is Dictionary:
				continue
			if str(cm.get("event_type", "chat")) == "chat":
				continue
			if str(cm.get("message", "")).strip_edges() == ms:
				return
	for cm in cache:
		if not cm is Dictionary:
			continue
		if str(cm.get("player_name", cm.get("sender", ""))) == pn and str(cm.get("message", "")) == ms and str(cm.get("event_type", "chat")) == ev:
			return
	cache.append(d)
	_trim_chat_cache(cache)

func _feed_sort_key_from_row(row: Dictionary, is_chat: bool) -> String:
	var raw: = str(row.get("created_at", row.get("createdAt", row.get("Created_at", "")))).strip_edges()
	var rid: = int(row.get("id", 0))
	if not raw.is_empty():
		return raw + "|" + ("c" if is_chat else "b") + str(rid)

	return "0|" + ("%012d" % rid) + "|" + ("c" if is_chat else "b") + str(rid)

func _append_feed_dict_if_absent(d: Dictionary) -> void :
	_append_to_chat_cache(d)



func _supplement_world_feed_rows_from_cache(chat_rows: Array, broadcast_rows: Array) -> void :
	var has_server_broadcast_snapshot: = not broadcast_rows.is_empty()
	var seen_bids: Dictionary = {}
	for b in broadcast_rows:
		if b is Dictionary:
			var bid: = int((b as Dictionary).get("id", 0))
			if bid > 0:
				seen_bids[bid] = true
	var seen_mids: Dictionary = {}
	for row in chat_rows:
		if row is Dictionary:
			var mid: = int((row as Dictionary).get("id", 0))
			if mid > 0:
				seen_mids[mid] = true
	for cm in _cached_world_messages:
		if not cm is Dictionary:
			continue
		var d: Dictionary = cm as Dictionary
		var cached_bid: = int(d.get("broadcast_id", 0))
		if cached_bid > 0:

			if has_server_broadcast_snapshot:
				continue

			var cached_at: = str(d.get("created_at", d.get("createdAt", ""))).strip_edges()
			if cached_at.is_empty():
				continue
			if not seen_bids.has(cached_bid):
				seen_bids[cached_bid] = true
				broadcast_rows.append({
					"id": cached_bid, 
					"content": String(d.get("message", "")), 
					"nickname": String(d.get("player_name", "系统")), 
					"created_at": cached_at, 
				})
			continue
		var cached_mid: = int(d.get("id", 0))
		if cached_mid > 0 and not seen_mids.has(cached_mid):
			seen_mids[cached_mid] = true
			chat_rows.append(d.duplicate(true))


func _cap_broadcast_rows_to_latest(broadcast_rows: Array, max_count: int = CITY_FEED_BROADCAST_HISTORY_MAX) -> Array:
	var wrapped: Array = []
	for b in broadcast_rows:
		if not b is Dictionary:
			continue
		var br: Dictionary = b as Dictionary
		wrapped.append({"t": _feed_sort_key_from_row(br, false), "b": br})
	if wrapped.is_empty():
		return []
	wrapped.sort_custom( func(a, b): return str(a["t"]) < str(b["t"]))
	var start: = maxi(0, wrapped.size() - maxi(1, max_count))
	var out: Array = []
	for i in range(start, wrapped.size()):
		out.append(wrapped[i]["b"])
	return out

func _merge_recent_world_feed_to_cache(chat_rows: Array, broadcast_rows: Array, max_items: int = 30) -> void :
	var chat: = chat_rows.duplicate()
	var broadcast: = broadcast_rows.duplicate()
	_supplement_world_feed_rows_from_cache(chat, broadcast)
	broadcast = _cap_broadcast_rows_to_latest(broadcast, CITY_FEED_BROADCAST_HISTORY_MAX)
	var entries: Array = []
	for row in chat:
		if not row is Dictionary:
			continue
		var d: Dictionary = (row as Dictionary).duplicate(true)
		d["channel_type"] = "world"
		var t: = _feed_sort_key_from_row(d, true)
		entries.append({"t": t, "d": d})
	for b in broadcast:
		if not b is Dictionary:
			continue
		var br: Dictionary = b as Dictionary
		var content: = BrotherTowerManager.format_clear_broadcast_message(str(br.get("content", "")).strip_edges(), br)
		if content.is_empty():
			continue
		var nick: = str(br.get("nickname", "系统")).strip_edges()
		if nick.is_empty():
			nick = "系统"
		var created_at: = str(br.get("created_at", br.get("createdAt", ""))).strip_edges()
		var d2: = {
			"player_name": nick, 
			"message": content, 
			"event_type": "world_event", 
			"broadcast_id": int(br.get("id", 0)), 
			"id": int(br.get("id", 0)), 
			"channel_type": "world", 
		}
		if not created_at.is_empty():
			d2["created_at"] = created_at
		var t2: = _feed_sort_key_from_row(br, false)
		entries.append({"t": t2, "d": d2})
	if entries.is_empty():
		return
	entries.sort_custom( func(a, b): return str(a["t"]) < str(b["t"]))
	var n: = entries.size()
	var start: = maxi(0, n - maxi(1, max_items))
	var rebuilt: Array = []
	var seen_mid: Dictionary = {}
	var seen_bid: Dictionary = {}
	var seen_fingerprint: Dictionary = {}
	for i in range(start, n):
		var wrap: Dictionary = entries[i]
		var item: Dictionary = wrap["d"]
		var bid: = int(item.get("broadcast_id", 0))
		if bid > 0:
			if seen_bid.has(bid):
				continue
			seen_bid[bid] = true
		var mid: = int(item.get("id", 0))
		if mid > 0:
			if seen_mid.has(mid):
				continue
			seen_mid[mid] = true
		var fp: = "%s|%s" % [
			String(item.get("player_name", item.get("sender", ""))), 
			String(item.get("message", "")), 
		]
		if seen_fingerprint.has(fp):
			continue
		seen_fingerprint[fp] = true
		rebuilt.append(item)
	if not rebuilt.is_empty():
		_cached_world_messages = rebuilt

func _on_chat_message_received(msg_data: Dictionary):
	var channel: = _chat_cache_channel_of(msg_data)
	var gang_id: = _chat_cache_gang_id_of(msg_data)
	var cache: Array = _get_gang_chat_cache(gang_id) if channel == "gang" and gang_id > 0 else _cached_world_messages
	var mid: = int(msg_data.get("id", 0))
	var event_type: = String(msg_data.get("event_type", "chat"))
	var msg_text: = String(msg_data.get("message", ""))
	if mid > 0:
		for cached_msg in cache:
			if cached_msg is Dictionary and int(cached_msg.get("id", 0)) == mid:
				return
	if event_type != "chat" and not msg_text.is_empty():
		for cached_msg in cache:
			if not (cached_msg is Dictionary):
				continue
			var ce: = String(cached_msg.get("event_type", ""))
			if (ce == "world_event" or ce != "chat") and String(cached_msg.get("message", "")) == msg_text:
				return
	for cached_msg in cache:
		if cached_msg.get("player_name") == msg_data.get("player_name")\
		and cached_msg.get("message") == msg_data.get("message")\
		and String(cached_msg.get("title", "")) == String(msg_data.get("title", ""))\
		and String(cached_msg.get("event_type", "chat")) == String(msg_data.get("event_type", "chat")):
			return
	_append_feed_dict_if_absent_to_cache(msg_data, cache)

func cache_chat_message(msg_data: Dictionary) -> void :
	_append_to_chat_cache(msg_data)

func _on_world_announcement(message: String):
	var msg_data = {
		"player_name": game_manager.player.player_name if game_manager.player else "系统", 
		"message": message, 
		"event_type": "world_event", 
		"channel_type": "world", 
	}
	for cached_msg in _cached_world_messages:
		if cached_msg.get("message") == message:
			return
	_append_feed_dict_if_absent_to_cache(msg_data, _cached_world_messages)

