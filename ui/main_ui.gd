	var btn_hbox = HBoxContainer.new()
	btn_hbox.add_theme_constant_override("separation", 15)
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER

	var ascend_btn = Button.new()
	ascend_btn.text = "开始飞升"
	ascend_btn.custom_minimum_size = Vector2(132, 44)
	ascend_btn.add_theme_font_size_override("font_size", 19)
	_apply_action_button_style(ascend_btn)
	ascend_btn.pressed.connect(_on_character_realm_ascend_pressed.bind(ascend_btn))
	btn_hbox.add_child(ascend_btn)

	var reincarnate_btn = Button.new()
	reincarnate_btn.text = "开始投胎"
	reincarnate_btn.custom_minimum_size = Vector2(132, 44)
	reincarnate_btn.add_theme_font_size_override("font_size", 19)
	_apply_action_button_style(reincarnate_btn)
	reincarnate_btn.pressed.connect(_on_character_realm_reincarnate_pressed.bind(reincarnate_btn))
	btn_hbox.add_child(reincarnate_btn)

	realm_section.add_child(btn_hbox)

	double_exp_privilege_checkbox = CheckBox.new()
	double_exp_privilege_checkbox.custom_minimum_size = Vector2(0, 38)
	double_exp_privilege_checkbox.add_theme_font_size_override("font_size", 15)
	double_exp_privilege_checkbox.add_theme_color_override("font_color", Color(1.0, 0.92, 0.5))
	double_exp_privilege_checkbox.add_theme_color_override("font_hover_color", Color(1.0, 0.96, 0.7))
	double_exp_privilege_checkbox.add_theme_color_override("font_pressed_color", Color(1.0, 0.96, 0.7))
	var privilege_checkbox_normal = StyleBoxFlat.new()
	privilege_checkbox_normal.bg_color = Color(0.043, 0.052, 0.055, 0.70)
	privilege_checkbox_normal.border_width_left = 1
	privilege_checkbox_normal.border_width_top = 1
	privilege_checkbox_normal.border_width_right = 1
	privilege_checkbox_normal.border_width_bottom = 1
