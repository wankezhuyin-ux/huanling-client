func _on_pet_soul_commit_batch_success(data: Dictionary) -> void :
	if game_manager == null:
		return
	if not _pending_soul_commit_pet_ids.is_empty() and game_manager.pet_manager:
		for pid in _pending_soul_commit_pet_ids:
			game_manager.pet_manager.remove_pet_by_id(str(pid))
		_pending_soul_commit_pet_ids.clear()
	if data.has("saveData") and data.saveData is Dictionary:
		var save_data: Dictionary = data.saveData
		game_manager.apply_cloud_save(save_data, {"pets_authoritative": true, "preserve_local_pets_not_in_cloud": true, "debug_tag": "pet_soul_commit_batch"})
	_build_pet_soul_view()
	_update_pet_ui()
	var result_var: Variant = data.get("result", {})
	if result_var is Dictionary:
		_show_pet_soul_batch_result_popup(result_var)
		var rebirth_var: Variant = result_var.get("rebirthRewards", [])
		if rebirth_var is Array:
			for reward_var in rebirth_var:
				if not reward_var is Dictionary:
					continue
				var reward: Dictionary = reward_var
				if not bool(reward.get("triggered", false)):
					continue
				var pet_name: = str(reward.get("petName", "")).strip_edges()
				var growth_val: = float(reward.get("growth", 0.0))
				if game_manager.player and not pet_name.is_empty() and growth_val >= 6.0:
					game_manager.broadcast_event("pet_egg_high_growth", game_manager.player.player_name, {
						"pet_name": pet_name, 
						"growth": growth_val, 
						"egg_source": "宠物魂魄玩法", 
					})

func _on_pet_soul_commit_batch_failed(error: String) -> void :
	_pending_soul_commit_pet_ids.clear()
	_show_simple_dialog("投入失败", str(error))

func _on_pet_soul_commit_success(data: Dictionary) -> void :
	if game_manager == null:
		return

	if not _pending_soul_commit_pet_ids.is_empty() and game_manager.pet_manager:
		for pid in _pending_soul_commit_pet_ids:
			game_manager.pet_manager.remove_pet_by_id(str(pid))
		_pending_soul_commit_pet_ids.clear()
	if data.has("saveData") and data.saveData is Dictionary:
		var save_data: Dictionary = data.saveData
		game_manager.apply_cloud_save(save_data, {"pets_authoritative": true, "preserve_local_pets_not_in_cloud": true, "debug_tag": "pet_soul_commit"})
	_build_pet_soul_view()
	_update_pet_ui()
	var added_pts: int = int(data.get("result", {}).get("addedPoints", 0)) if data.get("result") is Dictionary else 0
	_show_simple_dialog("投入成功", "魂魄投入成功，增加了 %d 点" % added_pts)
	var rebirth_var: Variant = data.get("result", {}).get("rebirthReward", null) if data.get("result") is Dictionary else null
	if rebirth_var is Dictionary and bool(rebirth_var.get("triggered", false)):
		var pet_name: = str(rebirth_var.get("petName", "")).strip_edges()
		var growth_val: = float(rebirth_var.get("growth", 0.0))
		_show_simple_dialog("魂魄重生", "恭喜获得【%s】，成长 %.3f\n已发送至邮箱，请前往领取" % [pet_name, growth_val])
		if game_manager.player and not pet_name.is_empty() and growth_val >= 6.0:
			game_manager.broadcast_event("pet_egg_high_growth", game_manager.player.player_name, {
				"pet_name": pet_name, 
				"growth": growth_val, 
				"egg_source": "宠物魂魄玩法", 
			})

func _on_pet_soul_commit_failed(error: String) -> void :
	_pending_soul_commit_pet_ids.clear()
	_show_simple_dialog("投入失败", str(error))

func _update_bag_view():

	if _equipment_op_light_ui:
		_schedule_character_equipment_refresh()
		return

	_setup_bag_view_nodes()

	if bag_material_container == null or bag_item_container == null:
		push_error("背包视图节点未初始化")
		return

	_bag_view_build_token += 1
	var build_token: = _bag_view_build_token

	if _measure_equip_scroll_raw_width(_get_visible_bag_scroll()) <= 1.0 and is_inside_tree():
		await get_tree().process_frame
		if build_token != _bag_view_build_token:
			return
		if bag_material_container == null or not is_instance_valid(bag_material_container):
			return
		if bag_item_container == null or not is_instance_valid(bag_item_container):
			return
	if build_token != _bag_view_build_token:
		return

	if bag_equipment_container:
		_clear_container_immediate(bag_equipment_container)
	_clear_container_immediate(bag_material_container)
	_clear_container_immediate(bag_item_container)
	_build_bag_material_view()
	_build_bag_item_view()
	# 仓库页只在正在看的时候重建：仓库面板要铺满一屏格子，每帧都重建就白烧性能
	if bag_store_scroll != null and is_instance_valid(bag_store_scroll) and bag_store_scroll.visible:
		_build_bag_store_view()
	_refresh_character_equipment_if_visible()

func _refresh_all_inventory_views_if_needed():
	_update_bag_view()
	_refresh_pet_equipment_view()

func _refresh_character_equipment_if_visible() -> void :
	if character_equipment_container == null:
		return
	var equipment_scroll = get_node_or_null("MainContent/CharacterView/ContentArea/Body/RightStack/EquipmentContainer")
	if equipment_scroll and equipment_scroll.visible:
		_clear_container_immediate(character_equipment_container)
		_build_character_equipment_view()

func _build_bag_equipment_view():
	if bag_equipment_container == null:
		return

	var equip_manager = game_manager.equipment_manager
	var inventory_manager = game_manager.inventory_manager

	var sealed_suits = []
	for item in inventory_manager.items:
		if item.item_type == "sealed_suit" and item.custom_data.size() > 0:
			var sealed_custom_data: Dictionary = item.custom_data.duplicate(true)
			sealed_custom_data["_source_item_id"] = str(item.id)
			var sealed_equipment = equip_manager.create_sealed_suit_equipment(sealed_custom_data)
			if sealed_equipment:
				sealed_equipment.id = str(item.id)
			sealed_suits.append(sealed_equipment)

	var character_equipment = []
	for item in equip_manager.inventory:
		if not item.is_pet_equipment:
			character_equipment.append(item)

	var total_count = character_equipment.size() + sealed_suits.size()

	var bag_title = Label.new()
	bag_title.text = "背包 (%d/%d)" % [total_count, equip_manager.max_inventory]
	bag_title.add_theme_font_size_override("font_size", 22)
	bag_title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	bag_equipment_container.add_child(bag_title)

	for item in character_equipment:
		bag_equipment_container.add_child(_create_equipment_item_ui(item, "", false))

	for sealed_item in sealed_suits:
		bag_equipment_container.add_child(_create_equipment_item_ui(sealed_item, "", false))

	if total_count == 0:
		bag_equipment_container.add_child(_create_placeholder_label("背包为空\n击败怪物可获得装备"))

func _build_bag_filter_row(options: Array, current_key: String, on_select: Callable) -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	for opt in options:
		var key: = str(opt.get("key", "all"))
		var label: = str(opt.get("label", key))
		var btn: = Button.new()
		btn.text = label
		btn.focus_mode = Control.FOCUS_NONE
		btn.custom_minimum_size = Vector2(0, 34)
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.add_theme_font_size_override("font_size", 16)
		_apply_sub_button_style(btn, key == current_key)
		var captured_key: = key
		btn.pressed.connect( func(): on_select.call(captured_key))
		row.add_child(btn)
	return row

func _set_bag_item_filter(filter_key: String) -> void :
	_bag_item_filter = filter_key if not filter_key.is_empty() else "all"
	if bag_item_container == null:
		return
	call_deferred("_rebuild_bag_item_view_only")

func _set_bag_material_filter(filter_key: String) -> void :
	_bag_material_filter = filter_key if not filter_key.is_empty() else "all"
	if bag_material_container == null:
		return
	call_deferred("_rebuild_bag_material_view_only")

func _rebuild_bag_item_view_only() -> void :
	if bag_item_container == null:
		return
	_clear_container_immediate(bag_item_container)
	_build_bag_item_view()

func _rebuild_bag_material_view_only() -> void :
	if bag_material_container == null:
		return
	_clear_container_immediate(bag_material_container)
	_build_bag_material_view()

func _build_bag_material_view():
	if bag_material_container == null:
		return
	bag_material_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if bag_material_scroll:
		TouchScrollUtils.configure_scroll(bag_material_scroll)

	var inventory = game_manager.inventory_manager
	var max_slots: int = inventory.get_max_slots_by_category("material")
	var used_slots: int = inventory.get_used_slots_by_category("material")

	bag_material_container.add_child(_ink_page_head_row("材料背包", "%d / %d" % [used_slots, max_slots]))

	var filter_opts: = [
		{"key": "all", "label": "全部"}, 
		{"key": "forge", "label": "锻造"}, 
		{"key": "herb", "label": "草药"}, 
		{"key": "token", "label": "令牌"}, 
		{"key": "limit", "label": "极限"}, 
		{"key": "other", "label": "其它"}, 
	]
	bag_material_container.add_child(_build_bag_filter_row(filter_opts, _bag_material_filter, Callable(self, "_set_bag_material_filter")))

	var scroll_w: = _get_bag_page_content_width(bag_material_scroll)
	var side: = InventoryGridCell.calc_bag_cell_side(scroll_w, 6)
	var grid: = InventoryGridCell.make_grid(6)

	bag_material_container.add_child(grid)

	var materials: Array = InventoryBagSort.sort_and_filter_materials(
		inventory.get_material_bag_display_entries(), _bag_material_filter
	)
	for item in materials:
		grid.add_child(_make_bag_inventory_grid_cell(side, item))
	if _bag_material_filter == "all":
		var remain: = maxi(0, max_slots - materials.size())
		for _i in range(remain):
			grid.add_child(InventoryGridCell.make_empty(side))

func _build_bag_item_view():
	if bag_item_container == null:
		return
	bag_item_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if bag_item_scroll:
		TouchScrollUtils.configure_scroll(bag_item_scroll)

	var inventory = game_manager.inventory_manager

	var items = []
	for item in inventory.items:

		var item_type: = _get_bag_item_type(item)
		if item_type == "item":
			items.append(item)
	items = InventoryBagSort.sort_and_filter_items(items, _bag_item_filter)

	var max_slots: int = inventory.get_max_slots_by_category("item")
	var used_slots: int = inventory.get_used_slots_by_category("item")

	bag_item_container.add_child(_ink_page_head_row("道具背包", "%d / %d" % [used_slots, max_slots]))

	var filter_opts: = [
		{"key": "all", "label": "全部"}, 
		{"key": "gift", "label": "礼包"}, 
		{"key": "skill_book", "label": "技能书"}, 
		{"key": "pill", "label": "丹药"}, 
		{"key": "other", "label": "其它"}, 
	]
	bag_item_container.add_child(_build_bag_filter_row(filter_opts, _bag_item_filter, Callable(self, "_set_bag_item_filter")))

	var scroll_w: = _get_bag_page_content_width(bag_item_scroll)
	var side: = InventoryGridCell.calc_bag_cell_side(scroll_w, 6)
	var grid: = InventoryGridCell.make_grid(6)

	bag_item_container.add_child(grid)

	for item in items:
		grid.add_child(_make_bag_inventory_grid_cell(side, item))
	if _bag_item_filter == "all":
		var remain: = maxi(0, max_slots - items.size())
		for _i in range(remain):
			grid.add_child(InventoryGridCell.make_empty(side))


