func _show_pet_equipment_action_popup(equipment, slot: String, is_equipped: bool, on_warehouse_done: Callable = Callable()) -> void :
	var equip_id = _get_pet_equip_value(equipment, "id")
	var popup_key: = "pet_equip_action:%s:%s:%s" % [str(equip_id), slot, str(is_equipped)]
	var shell: = _open_styled_popup(popup_key, INVENTORY_DETAIL_POPUP_GROUP, Vector2i(440, 520))
	if shell.is_empty():
		return
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox
	var popup_ref = popup
	var pet_btns: Array = []

	vbox.add_child(_build_pet_equipment_detail_header(equipment, slot, is_equipped))
	var sep: = HSeparator.new()
	vbox.add_child(sep)

	var is_warehouse_item: = slot == "warehouse"
	var is_bag_item: = (slot == "") and not is_equipped and not is_warehouse_item
	var equip_slot = _get_pet_equip_value(equipment, "slot")
	var effective_slot: = str(slot if is_equipped else equip_slot)
	var equip_name = _get_pet_equip_value(equipment, "name")

	if is_equipped:
		var unequip_btn = _popup_fixed_btn("卸下", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		unequip_btn.pressed.connect( func():
			if game_manager.has_method("local_equipment_op"):
				var result: Dictionary = game_manager.local_equipment_op(true, "unequip", str(_get_pet_equip_value(equipment, "id")), effective_slot)
				if bool(result.get("success", false)):
					popup_ref.queue_free()
				_notify_player_attr_changed("local_equipment")
				_update_pet_ui()
				_refresh_pet_equipment_view()
				_show_simple_dialog("本地装备", str(result.get("message", "")))
				return
			if not game_manager.network or not game_manager.network.is_logged_in():
				_show_simple_dialog("无法卸下", "当前网络不可用，宠物装备卸下需联网并由服务器确认。")
				return
			if game_manager.inventory_manager.pet_equipment_items.size() >= game_manager.inventory_manager.MAX_PET_EQUIPMENT_INVENTORY:
				_show_simple_dialog("无法卸下", "宠物装备背包已满，无法卸下装备，请先清理背包")
				return
			unequip_btn.disabled = true
			var op_id: = "pet_equipment_unequip_%s_%d_%d" % [effective_slot, Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			var on_success: Callable
			var on_failed: Callable
			on_failed = func(error: String):
				var net = game_manager.network if game_manager else null
				if net and net.pet_equipment_unequip_success.is_connected(on_success):
					net.pet_equipment_unequip_success.disconnect(on_success)
				if is_instance_valid(unequip_btn):
					unequip_btn.disabled = false
				_show_simple_dialog("卸下失败", error)
			on_success = func(data: Dictionary):
				var net = game_manager.network if game_manager else null
				if net and net.pet_equipment_unequip_failed.is_connected(on_failed):
					net.pet_equipment_unequip_failed.disconnect(on_failed)
				if is_instance_valid(unequip_btn):
					unequip_btn.disabled = false
				if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(data.get("saveData"), {
						"authoritative_equipment_inventory": true, 
						"skip_deferred_cloud_save": true, 
						"reconcile_treasure_chests": false, 
						"skip_title_gang_refresh": true, 
					})
				_sync_pet_equipment_from_authority(data)
				if is_instance_valid(popup_ref):
					popup_ref.queue_free()
				_refresh_pet_equipment_view()
				_show_simple_dialog("卸下成功", str(data.get("message", "已卸下宠物装备")))
			game_manager.network.pet_equipment_unequip_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.pet_equipment_unequip_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_pet_equipment_unequip(effective_slot, op_id)
		)
		pet_btns.append(unequip_btn)
	elif is_bag_item:
		var equip_btn = _popup_fixed_btn("穿戴", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		equip_btn.pressed.connect( func():
			if game_manager.has_method("local_equipment_op"):
				var result: Dictionary = game_manager.local_equipment_op(true, "equip", str(_get_pet_equip_value(equipment, "id")), slot)
				if bool(result.get("success", false)):
					popup_ref.queue_free()
				_notify_player_attr_changed("local_equipment")
				_update_pet_ui()
				_refresh_pet_equipment_view()
				_show_simple_dialog("本地装备", str(result.get("message", "")))
				return
			if not game_manager.network or not game_manager.network.is_logged_in():
				_show_simple_dialog("操作失败", "当前网络不可用，宠物装备穿戴需联网并由服务器确认。")
				return
			equip_btn.disabled = true
			var op_id: = "pet_equipment_equip_%s_%d_%d" % [str(equip_id), Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			var on_success = func(data: Dictionary):
				equip_btn.disabled = false
				if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(data.get("saveData"), {
						"skip_deferred_cloud_save": true, 
						"reconcile_treasure_chests": false, 
						"skip_title_gang_refresh": true, 
					})
				_sync_pet_equipment_from_authority(data)
				if is_instance_valid(popup_ref):
					popup_ref.queue_free()
				_refresh_pet_equipment_view()
				_show_simple_dialog("操作成功", str(data.get("message", "已穿戴宠物装备")))
			var on_failed = func(error: String):
				equip_btn.disabled = false
				_show_simple_dialog("操作失败", error)
			var connected_success: = false
			var connected_failed: = false
			if not game_manager.network.pet_equipment_equip_success.is_connected(on_success):
				game_manager.network.pet_equipment_equip_success.connect(on_success, CONNECT_ONE_SHOT)
				connected_success = true
			if not game_manager.network.pet_equipment_equip_failed.is_connected(on_failed):
				game_manager.network.pet_equipment_equip_failed.connect(on_failed, CONNECT_ONE_SHOT)
				connected_failed = true
			var pet_equip_owner_id: = ""
			if game_manager and game_manager.pet_manager:
				var owner_pet = game_manager.pet_manager.get_active_pet()
				if owner_pet:
					pet_equip_owner_id = str(owner_pet.id)
			game_manager.network.request_pet_equipment_equip(str(equip_id), effective_slot, op_id, _pet_equip_snapshot(equipment), pet_equip_owner_id)
			await get_tree().process_frame
			if equip_btn.disabled and game_manager.network._current_action_type != "pet_equipment_equip":
				if connected_success and game_manager.network.pet_equipment_equip_success.is_connected(on_success):
					game_manager.network.pet_equipment_equip_success.disconnect(on_success)
				if connected_failed and game_manager.network.pet_equipment_equip_failed.is_connected(on_failed):
					game_manager.network.pet_equipment_equip_failed.disconnect(on_failed)
				equip_btn.disabled = false
				_show_simple_dialog("操作失败", "宠物装备请求未发出，可能有其他联网操作占用了请求通道，请稍后重试。")
		)
		var store_btn = _popup_fixed_btn("存仓库", POPUP_ACTION_BTN_SIZE, _apply_store_button_style)
		store_btn.pressed.connect( func():
			if _try_local_inventory_action("store_pet_equipment", str(_get_pet_equip_value(equipment, "id")), popup_ref):
				return
			if not game_manager.network or not game_manager.network.is_logged_in():
				_show_simple_dialog("操作失败", "当前网络不可用，宠装存仓需联网并由服务器确认。")
				return
			store_btn.disabled = true
			var op_id: = "pet_equipment_store_warehouse_%s_%d_%d" % [str(equip_id), Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			var on_success = func(data: Dictionary):
				store_btn.disabled = false
				if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
				if is_instance_valid(popup_ref):
					popup_ref.queue_free()
				_refresh_pet_equipment_view()
				_show_simple_dialog("操作成功", str(data.get("message", "已存入宠装仓库")))
			var on_failed = func(error: String):
				store_btn.disabled = false
				_show_simple_dialog("操作失败", error)
			game_manager.network.pet_equipment_store_warehouse_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.pet_equipment_store_warehouse_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_pet_equipment_store_warehouse(str(equip_id), op_id)
		)
		pet_btns.append(equip_btn)
		pet_btns.append(store_btn)

		var row2_btns: Array = []
		if PetEquipmentEnhance.can_dismantle(equipment):
			var dismantle_btn = _popup_fixed_btn("分解", POPUP_ACTION_BTN_SIZE, _apply_dismantle_button_style)
			dismantle_btn.pressed.connect( func():
				if not game_manager.network or not game_manager.network.is_logged_in():
					_show_simple_dialog("分解失败", "当前网络不可用，宠装分解需联网并由服务器确认。")
					return
				dismantle_btn.disabled = true
				var op_id: = "pet_equipment_dismantle_%s_%d_%d" % [str(equip_id), Time.get_unix_time_from_system(), Time.get_ticks_msec()]
				var on_success = func(data: Dictionary):
					if is_instance_valid(dismantle_btn):
						dismantle_btn.disabled = false
					if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
						game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
					if is_instance_valid(popup_ref):
						popup_ref.queue_free()
					_refresh_pet_equipment_view()
					_show_simple_dialog("分解成功", str(data.get("message", "宠物装备分解成功")))
				var on_failed = func(error: String):
					if is_instance_valid(dismantle_btn):
						dismantle_btn.disabled = false
					_show_simple_dialog("分解失败", error)
				game_manager.network.pet_equipment_dismantle_success.connect(on_success, CONNECT_ONE_SHOT)
				game_manager.network.pet_equipment_dismantle_failed.connect(on_failed, CONNECT_ONE_SHOT)
				game_manager.network.request_pet_equipment_dismantle(str(equip_id), op_id)
			)
			row2_btns.append(dismantle_btn)
		var drop_btn = _popup_fixed_btn("丢弃", POPUP_ACTION_BTN_SIZE, _apply_drop_button_style)
		var drop_equip_id = equip_id
		var drop_equip_name = equip_name
		drop_btn.pressed.connect( func():
			_show_drop_equipment_confirm_popup(drop_equip_id, drop_equip_name)
		)
		row2_btns.append(drop_btn)
		pet_btns.append_array(row2_btns)
	elif is_warehouse_item:
		var retrieve_btn = _popup_fixed_btn("取出", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		retrieve_btn.pressed.connect( func():
			if _try_local_inventory_action("withdraw_pet_equipment", str(_get_pet_equip_value(equipment, "id")), popup_ref):
				return
			if not game_manager.network or not game_manager.network.is_logged_in():
				_show_simple_dialog("操作失败", "当前网络不可用，宠装取出需联网并由服务器确认。")
				return
			retrieve_btn.disabled = true
			var op_id: = "pet_equipment_retrieve_warehouse_%s_%d_%d" % [str(equip_id), Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			var on_success = func(data: Dictionary):
				if is_instance_valid(retrieve_btn):
					retrieve_btn.disabled = false
				if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
				if is_instance_valid(popup_ref):
					popup_ref.queue_free()
				if on_warehouse_done.is_valid():
					on_warehouse_done.call()
				else:
					_refresh_pet_equipment_view()
				_show_simple_dialog("操作成功", str(data.get("message", "已从宠装仓库取出")))
			var on_failed = func(error: String):
				if is_instance_valid(retrieve_btn):
					retrieve_btn.disabled = false
				_show_simple_dialog("操作失败", error)
			game_manager.network.pet_equipment_retrieve_warehouse_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.pet_equipment_retrieve_warehouse_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_pet_equipment_retrieve_warehouse(str(equip_id), op_id)
		)
		pet_btns.append(retrieve_btn)

	var close_btn = _popup_fixed_btn("取消", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	close_btn.pressed.connect( func(): popup_ref.queue_free())
	pet_btns.append(close_btn)
	_popup_add_btn_grid(vbox, pet_btns)
	_finish_styled_popup(popup)

func _build_pet_equipment_detail_header(equipment, slot: String, is_equipped: bool) -> Panel:
	return _create_pet_equipment_item_ui(equipment, slot, is_equipped)

func _create_pet_equipment_item_ui(equipment, slot: String, is_equipped: bool) -> Panel:
	var panel = Panel.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.custom_minimum_size = Vector2(0, 150)

	var panel_style = StyleBoxFlat.new()
	panel_style.bg_color = Color(0.035, 0.043, 0.045, 0.74)
	panel_style.set_border_width_all(0)
	panel_style.set_corner_radius_all(8)
	panel.add_theme_stylebox_override("panel", panel_style)

	var root = VBoxContainer.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.offset_left = 12
	root.offset_top = 10
	root.offset_right = -12
	root.offset_bottom = -10
	root.add_theme_constant_override("separation", 8)
	panel.add_child(root)

	var hbox = HBoxContainer.new()
	hbox.add_theme_constant_override("separation", 12)
	hbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.add_child(hbox)

	var rarity_colors = {
		"common": Color(0.7, 0.7, 0.7), 
		"uncommon": Color(0.2, 0.9, 0.2), 
		"rare": Color(0.2, 0.5, 1), 
		"epic": Color(0.8, 0.2, 0.9), 
		"legendary": Color(1, 0.5, 0), 
		"mythic": Color(1, 0.2, 0.2), 
		"divine": Color(1, 0.8, 0), 
		"suit": Color(1, 0.6, 0), 
		"normal": Color(0.75, 0.75, 0.8), 
		"bronze": Color(0.8, 0.52, 0.25), 
		"silver": Color(0.78, 0.82, 0.9), 
		"gold": Color(1.0, 0.84, 0.25)
	}

	var equip_slot = _get_pet_equip_value(equipment, "slot")
	var equip_rarity = _get_pet_equip_value(equipment, "rarity")
	var equip_name = _get_pet_equip_value(equipment, "name")
	var equip_attack = _get_pet_equip_value(equipment, "attack")
	var equip_defense = _get_pet_equip_value(equipment, "defense")
	var equip_agility = _get_pet_equip_value(equipment, "agility")
	var equip_hp = _get_pet_equip_value(equipment, "hp")
	var enh_lv: = int(_get_pet_equip_value(equipment, "pet_enhance_level"))

	var icon_texture = InventoryIconHelper.resolve_equipment_icon(equipment)
	if icon_texture == null:
		icon_texture = _get_equipment_icon(equip_slot)
	var icon
	if icon_texture:
		icon = TextureRect.new()
		icon.texture = icon_texture
		icon.custom_minimum_size = Vector2(72, 72)
		icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		icon.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	else:
		icon = ColorRect.new()
		icon.custom_minimum_size = Vector2(72, 72)
		icon.color = rarity_colors.get(str(equip_rarity), Color(0.7, 0.7, 0.7))
	hbox.add_child(icon)

	var info_vbox = VBoxContainer.new()
	info_vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info_vbox.add_theme_constant_override("separation", 4)

	var slot_names = {
		"weapon": "武器", 
		"armor": "防具", 
		"helmet": "头盔", 
		"accessory": "饰品", 
		"boots": "鞋子", 
		"pet_weapon": "武器", 
		"pet_armor": "防具", 
		"pet_helmet": "头盔", 
		"pet_accessory": "饰品", 
		"pet_boots": "鞋子"
	}

	var name_label = Label.new()
	name_label.text = PetEquipmentEnhance.format_display_name(str(equip_name), enh_lv)
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.add_theme_font_size_override("font_size", 22)
	name_label.add_theme_color_override("font_color", rarity_colors.get(str(equip_rarity), Color(0.9, 0.9, 1)))
	info_vbox.add_child(name_label)

	var meta_label = Label.new()
	var slot_cn: = str(slot_names.get(str(equip_slot), PetEquipmentData.SLOTS.get(str(equip_slot), {}).get("name", equip_slot)))
	var rarity_key: = str(equip_rarity).strip_edges()
	var rarity_cn_map: = {
		"normal": "普通", "common": "普通", 
		"bronze": "青铜", "silver": "白银", "gold": "黄金", 
		"普通": "普通", "青铜": "青铜", "白银": "白银", "黄金": "黄金", 
	}
	var rarity_cn: = str(rarity_cn_map.get(rarity_key, rarity_key))
	meta_label.text = "%s ｜ %s ｜ %s" % [slot_cn, rarity_cn, ("已装备" if is_equipped else "未装备")]
	meta_label.add_theme_font_size_override("font_size", 14)
	meta_label.add_theme_color_override("font_color", Color(0.72, 0.74, 0.82))
	info_vbox.add_child(meta_label)
	hbox.add_child(info_vbox)

	var stats_text: = PetEquipmentEnhance.format_effective_stats_line(equipment)
	if stats_text.is_empty():
		stats_text = "暂无属性"

	var stats_label = Label.new()
	stats_label.text = stats_text
	stats_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	stats_label.add_theme_font_size_override("font_size", 16)
	stats_label.add_theme_color_override("font_color", Color(0.85, 0.9, 1.0))
	root.add_child(stats_label)

	return panel

func _sync_pet_equipment_from_authority(data: Dictionary) -> void:
	# 宠装穿戴/卸下的权威结果直接写在回包的 `equipped` 里（{slot: item}），
	# 这是 `PetEquipmentManager.to_dict()` 的同款结构。
	#
	# 之所以除了 `apply_cloud_save(saveData)` 之外还要单独吃一份：
	# 老服务端的 `saveData` 里没有 `petEquipmentData` 键（只有 playerData/
	# inventoryData/petsData/equipmentData），客户端 `apply_cloud_save` 的
	# 宠装分支是 `if save_data.has("petEquipmentData")`，缺键就整块跳过 ——
	# 于是「提示已穿戴，但装备框还是空的、加成全是 0、出战宠物也没吃到加成」。
	# 服务端已经补上这个键了，这里再兜一层，任何版本的服务器都不会漏刷。
	if not game_manager or not game_manager.pet_equipment_manager:
		return
	var worn = data.get("equipped", null)
	if worn is Dictionary:
		game_manager.pet_equipment_manager.from_dict({"equipped": worn})
		_reconcile_pet_equipment_bag(worn, data.get("item", null))
	_notify_player_attr_changed("pet_equipment")
	_update_pet_ui()

func _reconcile_pet_equipment_bag(worn: Dictionary, changed_item) -> void:
	# 宠装背包以客户端本地为准，但「身上穿着的」不能在背包里留一份。
	#
	# 服务端的宠装背包是后来才接管的（老账号那边一直是空表），所以
	# `_authority_save` 对空表选择**不发** `pet_equipment_items` ——
	# 发一个空数组会让客户端 `inventory_manager.from_dict` 把整格清空，
	# 玩家点一次穿戴，背包里剩下的几件就没了。
	# 不发就意味着「穿上后从背包里拿走」这一步得客户端自己补上，
	# 否则同一件装备会既占背包格又挂在身上（穿满五件后背包里全是幽灵）。
	var im = game_manager.inventory_manager
	if im == null:
		return
	var worn_ids: Dictionary = {}
	for slot_key in worn.keys():
		var worn_item = worn[slot_key]
		var wid: = ""
		if worn_item is Dictionary:
			wid = str((worn_item as Dictionary).get("id", "")).strip_edges()
		if wid != "":
			worn_ids[wid] = true

	var bag: Array = im.pet_equipment_items
	var removed_any: = false
	for i in range(bag.size() - 1, -1, -1):
		var it = bag[i]
		var iid: = ""
		if it is Dictionary:
			iid = str((it as Dictionary).get("id", "")).strip_edges()
		if iid != "" and worn_ids.has(iid):
			bag.remove_at(i)
			removed_any = true

	# 卸下：回包里带上刚脱下来的那件，背包里没有就补回去。
	if changed_item is Dictionary:
		var cid: = str((changed_item as Dictionary).get("id", "")).strip_edges()
		if cid != "" and not worn_ids.has(cid):
			var present: = false
			for it2 in bag:
				if it2 is Dictionary and str((it2 as Dictionary).get("id", "")).strip_edges() == cid:
					present = true
					break
			if not present:
				bag.append((changed_item as Dictionary).duplicate(true))
				removed_any = true

	if removed_any:
		im.pet_equipment_inventory_changed.emit()

