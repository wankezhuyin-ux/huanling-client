	spinbox.value = mini(item.count, batch_cap)
	spinbox.custom_minimum_size = Vector2(100, 30)
	count_hbox.add_child(spinbox)

	var max_label = Label.new()
	if InventoryManager.CULTIVATION_PILL_WHITELIST_KEYS.has(item_name_for_cap):
		max_label.text = "(本世剩余最多%d颗)" % mini(item.count, batch_cap)
	else:
		max_label.text = "(最多%d个)" % mini(item.count, batch_cap)
