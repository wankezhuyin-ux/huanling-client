	confirm_btn.text = "确认投入"
	UIStyle.style_popup_button(confirm_btn, true)
	confirm_btn.pressed.connect( func():
		var commit_ids: Array = []
		var commit_pets: Array = []
		for pet in live_pets:
			var resolved = _resolve_live_pet(pet)
			if resolved == null:
				continue
			commit_pets.append(resolved)
			commit_ids.append(str(resolved.id))
		if commit_ids.is_empty():
			_show_simple_dialog("投入失败", "宠物已不存在，请刷新后重试。")
