		if item.is_sealed:
			icon.color = Color(0.5, 0.5, 0.5)
		else:
			icon.color = item.get_rarity_color()
	hbox.add_child(icon)

	var info_vbox = VBoxContainer.new()
	info_vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info_vbox.add_theme_constant_override("separation", 2)

	var slot_name = GameData.EQUIPMENT_SLOTS.get(slot, slot) if is_equipped else ""
	var slot_text = "[%s] " % slot_name if is_equipped else ""
	var equipped_mark = " ★已装备" if is_equipped else ""
	var display_name: = str(item.name)
	if item.is_suit and not item.is_sealed:
		display_name = SuitEquipmentEnhance.format_display_name(display_name, SuitEquipmentEnhance.get_level_from_equipment(item))
	var name_label = Label.new()
	name_label.text = "%s%s%s" % [slot_text, display_name, equipped_mark]
	name_label.add_theme_font_size_override("font_size", 20)
	if item.is_sealed:
		name_label.add_theme_color_override("font_color", Color(0.5, 0.5, 0.5))
	else:
		name_label.add_theme_color_override("font_color", item.get_rarity_color())
	info_vbox.add_child(name_label)

	var type_label = Label.new()
	var display_slot_name: String = str(GameData.EQUIPMENT_SLOTS.get(display_slot, item.get_slot_name()))
	type_label.text = "%s | %s" % [display_slot_name, item.get_rarity_name()]
	type_label.add_theme_font_size_override("font_size", 16)
	type_label.add_theme_color_override("font_color", Color(0.6, 0.6, 0.7))
	info_vbox.add_child(type_label)

	var stats_text = ""
	if item.is_suit and not item.is_sealed:
		stats_text = SuitEquipmentEnhance.format_equipment_stats_line(item)
	else:
		if item.attack != 0:
			stats_text += "攻击%+d " % item.attack
		if item.defense != 0:
			stats_text += "防御%+d " % item.defense
		if item.hp != 0:
			stats_text += "生命%+d " % item.hp
		if item.mp != 0:
			stats_text += "内力%+d " % item.mp
		if item.agility != 0:
			stats_text += "敏捷%+d " % item.agility
	var stats_label = Label.new()
