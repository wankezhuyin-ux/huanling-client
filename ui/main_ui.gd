func _get_player_character_preview_sprite_frames(sprite_id: String) -> SpriteFrames:
	if sprite_id == "":
		return null
	var cache_key: = sprite_id.to_lower()
	if _player_character_preview_frames_cache.has(cache_key):
		return _player_character_preview_frames_cache[cache_key]
	var base_frames: = _build_creature_battle_sprite_frames(sprite_id, PLAYER_ATTACK_DURATION)
	if base_frames == null:
		return null
	var preview_frames: = base_frames.duplicate(true)
	if preview_frames.has_animation("idle"):
		preview_frames.set_animation_loop("idle", true)
	if preview_frames.has_animation("attack"):
		preview_frames.set_animation_loop("attack", true)
	_player_character_preview_frames_cache[cache_key] = preview_frames
	return preview_frames

func _update_player_character_popup_preview(preview_id: int) -> void :
	if _player_character_popup_state.is_empty():
		return
	_player_character_popup_preview_id = PlayerCharacterConfig.normalize_id(preview_id)
	for item in _player_character_popup_state.get("avatar_cells", []):
		if not item is Dictionary:
			continue
		var cell: PanelContainer = item.get("cell")
		var cid: = int(item.get("id", 0))
		if not is_instance_valid(cell):
			continue
		cell.add_theme_stylebox_override("panel", UIStyle.create_selectable_item_style(cid == _player_character_popup_preview_id))
	_refresh_player_character_popup_sprites(_player_character_popup_preview_id)

func _refresh_player_character_popup_sprites(preview_id: int, state: Dictionary = {}) -> void :
	var st: Dictionary = state if not state.is_empty() else _player_character_popup_state
	if st.is_empty():
		return
	var sprite_id: = PlayerCharacterConfig.get_sprite_id(preview_id)
	var frames: = _get_player_character_preview_sprite_frames(sprite_id)
	var idle_panel: PanelContainer = st.get("idle_panel")
	var attack_panel: PanelContainer = st.get("attack_panel")
	_set_player_character_popup_sprite(idle_panel, frames, "idle", "idle_anim", st)
	_set_player_character_popup_sprite(attack_panel, frames, "attack", "attack_anim", st)

func _set_player_character_popup_sprite(panel: PanelContainer, frames: SpriteFrames, anim_name: String, state_key: String, state: Dictionary = {}) -> void :
	var st: Dictionary = state if not state.is_empty() else _player_character_popup_state
	if not is_instance_valid(panel) or st.is_empty():
		return
	var host: = panel.find_child("SpriteHost", true, false) as Control
	if host == null:
		return
	var anim: AnimatedSprite2D = st.get(state_key)
	if anim == null or not is_instance_valid(anim):
		anim = AnimatedSprite2D.new()
		anim.centered = true
		anim.position = Vector2(100.0, 110.0)
		anim.scale = Vector2(0.85, 0.85)
		host.add_child(anim)
		st[state_key] = anim
	if frames == null or not frames.has_animation(anim_name):
		anim.visible = false
		FootShadow.set_visible_on(host, false)
		return
	anim.visible = true
	if anim.sprite_frames != frames or anim.animation != anim_name or not anim.is_playing():
		anim.sprite_frames = frames
		anim.play(anim_name)

	FootShadow.ensure_under_animated_sprite(
		host, 
		anim, 
		FootShadow.UNDER_SPRITE_FEET_NUDGE_Y, 
		Vector2(200.0, 220.0), 
		UIConstants.FOOT_SHADOW_PLAYER_BODY_OFFSET_Y, 
		FootShadow.Style.SPRITE2D
	)

