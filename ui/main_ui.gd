func _char_create_is_online() -> bool:
	return network != null and String(network.auth_token).strip_edges() != ""


## 真机兜底：Window 内的 LineEdit 聚焦后如果输入法没弹出来，手动弹一次
func _ensure_char_create_keyboard(input: LineEdit) -> void :
	if OS.get_name() != "Android" or not is_instance_valid(input):
		return
	await get_tree().create_timer(0.35).timeout
	if not is_instance_valid(input) or not input.has_focus():
		return
	if not DisplayServer.has_feature(DisplayServer.FEATURE_VIRTUAL_KEYBOARD):
		return
	if DisplayServer.virtual_keyboard_get_height() > 0:
		return
	DisplayServer.virtual_keyboard_show(input.text, input.get_global_rect(),
			DisplayServer.KEYBOARD_TYPE_DEFAULT)


## 角色名校验：和服务器 handlers_account._valid_nickname 同一套规则
func _character_name_error(raw: String) -> String:
	var name: = str(raw).strip_edges()
	if name.length() < 2 or name.length() > 16:
		return "角色名需要 2~16 个字符"
	for i in name.length():
		var c: = name.unicode_at(i)
		var is_digit: = c >= 48 and c <= 57
		var is_alpha: = (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
		var is_han: = c >= 19968 and c <= 40959
		if not (is_digit or is_alpha or is_han):
			return "角色名只能使用汉字、英文和数字"
	return ""


func _set_char_create_hint(text: String, col: Color = Color(0.62, 0.58, 0.50)) -> void :
	if _char_create_state.is_empty():
		return
	var hint: Label = _char_create_state.get("hint")
	if hint != null and is_instance_valid(hint):
		hint.text = text
		hint.add_theme_color_override("font_color", col)


func _set_char_create_confirm_enabled(on: bool) -> void :
	if _char_create_state.is_empty():
		return
	var btn: Button = _char_create_state.get("confirm_btn")
	if btn != null and is_instance_valid(btn):
		btn.disabled = not on


func _on_char_create_name_changed(text: String) -> void :
	_char_create_last_text = str(text)
	_char_create_name_ok = false
	_set_char_create_confirm_enabled(false)
	_char_create_check_seq += 1
	var seq: = _char_create_check_seq
	var name: = str(text).strip_edges()
	if name == "":
		_set_char_create_hint("名字确认后全服唯一，不能与他人重复")
		return
	var err: = _character_name_error(name)
	if err != "":
		_set_char_create_hint(err, Color(0.85, 0.42, 0.32))
		return
	if not _char_create_is_online():
		_char_create_name_ok = true
		_set_char_create_confirm_enabled(true)
		_set_char_create_hint("离线模式：名字只保存在本机")
		return
	_set_char_create_hint("正在核对名字…", Color(0.80, 0.74, 0.56))
	# 名字格式没问题就先放行按钮：就算后台核验卡住，点下去也会现场再核一次，
	# 不能出现「名字填好了、按钮永远点不动」的死局。
	_set_char_create_confirm_enabled(true)
	_char_create_check_after_pause(seq, name)


## 原生虚拟键盘兜底：文字直接写进 LineEdit 时不会发 text_changed，靠轮询发现变化
func _char_create_poll_input_text() -> void :
	if _char_create_state.is_empty():
		return
	var input: LineEdit = _char_create_state.get("input")
	if input == null or not is_instance_valid(input):
		return
	var cur: = String(input.text)
	if cur == _char_create_last_text:
		return
	_on_char_create_name_changed(cur)


## 边打边查：停手 0.45 秒再发请求，避免每敲一个字都打服务器
func _char_create_check_after_pause(seq: int, name: String) -> void :
	await get_tree().create_timer(0.45).timeout
	if seq != _char_create_check_seq or not is_instance_valid(self):
		return
	if _char_create_state.is_empty():
		return
	var input: LineEdit = _char_create_state.get("input")
	if input == null or not is_instance_valid(input):
		return
	if str(input.text).strip_edges() != name:
		return
	var op: = "namechk_%s_%s" % [str(Time.get_unix_time_from_system()), str(randi())]
	var er: Dictionary = await game_manager.wait_economy("economy_player_name_available", func():
		network.economy_player_name_available(name, op)
	, op, 8000)
	if seq != _char_create_check_seq:
		return
	if bool(er.get("ok", false)):
		_char_create_name_ok = true
		_set_char_create_confirm_enabled(true)
		_set_char_create_hint("✓ 「%s」可以使用" % name, Color(0.55, 0.86, 0.52))
	else:
		_char_create_name_ok = false
		_set_char_create_confirm_enabled(false)
		var why: = str(er.get("err", ""))
		if why.is_empty():
			why = "这个名字不可用，换一个试试"
		_set_char_create_hint(why, Color(0.85, 0.42, 0.32))


func _build_char_create_avatar_cell(character_id: int, selected: bool) -> Control:
	var wrap: = PanelContainer.new()
	wrap.custom_minimum_size = Vector2(70, 92)
	wrap.add_theme_stylebox_override("panel", UIStyle.create_selectable_item_style(selected))
	var vbox: = VBoxContainer.new()
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 4)
	vbox.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wrap.add_child(vbox)
	var tex_rect: = TextureRect.new()
	tex_rect.custom_minimum_size = Vector2(60, 60)
	tex_rect.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	tex_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tex_rect.texture = _get_player_avatar_texture(character_id)
	tex_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(tex_rect)
	var tag: = Label.new()
	tag.text = "默认" if character_id == 0 else "角色%d" % character_id
	tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	tag.add_theme_font_size_override("font_size", 12)
	tag.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
	tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(tag)
	wrap.gui_input.connect( func(event: InputEvent) -> void :
		if event is InputEventMouseButton:
			var mb: = event as InputEventMouseButton
			if mb.pressed and mb.button_index == MOUSE_BUTTON_LEFT:
				_update_char_create_preview(character_id)
		elif event is InputEventScreenTouch:
			if (event as InputEventScreenTouch).pressed:
				_update_char_create_preview(character_id)
	)
	wrap.set_meta("character_id", character_id)
	return wrap


func _update_char_create_preview(character_id: int) -> void :
	_char_create_selected_id = PlayerCharacterConfig.normalize_id(character_id)
	if _char_create_state.is_empty():
		return
	for item in _char_create_state.get("avatar_cells", []):
		if not item is Dictionary:
			continue
		var cell: PanelContainer = item.get("cell")
		var cid: = int(item.get("id", 0))
		if is_instance_valid(cell):
			cell.add_theme_stylebox_override("panel",
					UIStyle.create_selectable_item_style(cid == _char_create_selected_id))
	_refresh_player_character_popup_sprites(_char_create_selected_id, _char_create_state)


func _on_char_create_confirm_pressed() -> void :
	if _char_create_busy or _char_create_state.is_empty():
		return
	var input: LineEdit = _char_create_state.get("input")
	if input == null or not is_instance_valid(input):
		return
	var name: = str(input.text).strip_edges()
	var err: = _character_name_error(name)
	if err != "":
		_set_char_create_hint(err, Color(0.85, 0.42, 0.32))
		return
	if _char_create_is_online() and not _char_create_name_ok:
		# 后台核验还没回来（弱网/请求排队）：点下去当场再核一次，别把人挡在门外
		if _char_create_busy:
			return
		_char_create_busy = true
		_set_char_create_confirm_enabled(false)
		_set_char_create_hint("正在核对名字…", Color(0.80, 0.74, 0.56))
		var vop: = "namechk_%s_%s" % [str(Time.get_unix_time_from_system()), str(randi())]
		var ver: Dictionary = await game_manager.wait_economy("economy_player_name_available", func():
			network.economy_player_name_available(name, vop)
		, vop, 8000)
		_char_create_busy = false
		if not bool(ver.get("ok", false)):
			var vwhy: = str(ver.get("err", ""))
			if vwhy.is_empty():
				vwhy = "这个名字不可用，换一个试试"
			_set_char_create_hint(vwhy, Color(0.85, 0.42, 0.32))
			_set_char_create_confirm_enabled(true)
			return
		_char_create_name_ok = true
		_set_char_create_confirm_enabled(true)

	_char_create_busy = true
	var btn: Button = _char_create_state.get("confirm_btn")
	if btn != null and is_instance_valid(btn):
		btn.disabled = true
		btn.text = "创建中…"
	var cid: = PlayerCharacterConfig.normalize_id(_char_create_selected_id)

	if not _char_create_is_online():
		_apply_created_character(name, cid, {})
		return

	var op: = "charcreate_%s_%s" % [str(Time.get_unix_time_from_system()), str(randi())]
	var er: Dictionary = await game_manager.wait_economy("economy_player_create_character", func():
		network.economy_player_create_character(name, cid, op)
	, op)
	_char_create_busy = false
	if btn != null and is_instance_valid(btn) and not _char_create_state.is_empty():
		btn.text = "创建角色"
		btn.disabled = not _char_create_name_ok
	if not bool(er.get("ok", false)):
		var why: = str(er.get("err", ""))
		if why.is_empty():
			why = "创建失败，请稍后重试"
		_set_char_create_hint(why, Color(0.85, 0.42, 0.32))
		return
	var data: Dictionary = er.get("data", {}) if er.get("data") is Dictionary else {}
	_apply_created_character(
		str(data.get("nickname", name)).strip_edges(),
		int(data.get("playerCharacterId", cid)),
		data)


func _apply_created_character(name: String, character_id: int, data: Dictionary) -> void :
	_char_create_busy = false
	var has_save: bool = data.has("saveData") and data.get("saveData") is Dictionary
	var save_applied: = false
	if game_manager and has_save and game_manager.initialized:
		game_manager.apply_cloud_save(data.get("saveData"), {
			"cosmetic_slice": true, 
			"currency_slice": true, 
		})
		save_applied = true
	# 离线新档这条路上 game_manager 还没初始化过（参考稿是等玩家点「开始冒险」才 init），
	# 所以要先 init 再写名字，否则 player 对象还不存在，名字会丢。
	if game_manager and not game_manager.initialized:
		game_manager.initialize()
	if game_manager and has_save and not save_applied:
		game_manager.apply_cloud_save(data.get("saveData"), {
			"cosmetic_slice": true, 
			"currency_slice": true, 
		})
	var player = game_manager.player if game_manager else null
	if player:
		player.player_name = name
		player.player_character_id = PlayerCharacterConfig.normalize_id(character_id)
	nickname = name
	network_nickname = name
	_registered_character_name = name
	if network:
		network.nickname = name
	if game_manager:
		game_manager.set_session_nickname(name)
	if is_instance_valid(startup_dialog):
		startup_dialog.queue_free()
	startup_dialog = null
	_char_create_state = {}
	_char_create_check_seq += 1
	_refresh_all_player_visuals()
	_update_player_ui()
	if not _game_started:
		_start_game()
	else:
		_restore_game_hud_after_startup()
	_show_tip_popup("角色创建成功，「%s」欢迎来到幻灵修真世界" % name)


## 登录回包里昵称为空 = 这个账号还没建角色，进游戏要先走创建角色面板
func _needs_character_creation() -> bool:
	if network == null or String(network.auth_token).strip_edges() == "":
		return false
	return str(network_nickname).strip_edges() == ""


## 欢迎面板的头像框：外框 + 玩家当前角色头像（playertxN.png）。
## 头像图 128×128 带浅底，按方框裁切（COVERED）显示，像一张小像卡；
## 取图失败（资源缺失 / 还没进存档）时才退回原来的 👤 占位符。
func _build_login_avatar_frame(px: float) -> Control:
	var frame: = Panel.new()
	frame.custom_minimum_size = Vector2(px, px)
	frame.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	frame.clip_contents = true
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.075, 0.066, 0.050, 0.68)
	st.border_color = Color(0.788, 0.635, 0.294, 0.85)
	st.set_border_width_all(2)
	st.set_corner_radius_all(0)
	frame.add_theme_stylebox_override("panel", st)
	var tex: = _get_player_avatar_texture()
	if tex != null:
		var pic: = TextureRect.new()
		pic.texture = tex
		pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
		pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pic.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		pic.offset_left = 2
		pic.offset_top = 2
		pic.offset_right = -2
		pic.offset_bottom = -2
		frame.add_child(pic)
	else:
		var icon_label: = Label.new()
		icon_label.set_anchors_preset(Control.PRESET_FULL_RECT)
		icon_label.text = "👤"
		icon_label.add_theme_font_size_override("font_size", int(round(px * 0.46)))
		icon_label.add_theme_color_override("font_color", Color(0.72, 0.64, 0.46))
		icon_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		icon_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		frame.add_child(icon_label)
	return frame


## 给启动弹窗套上金属包边 + 投影。
##
## 做法：面板相对 Window 四边各内缩 pad（给投影留出绘制空间，否则会被 Window 裁掉），
## Window 尺寸同步加大 pad*2 —— 面板实际尺寸不变，里面的排版一个像素都不用动。
## 然后在面板里垫一层 MetalFrame（画在最底下，被内容压住）。
func _attach_metal_frame(dialog: Window, panel: Panel, pad: float = METAL_PAD) -> void:
	if dialog == null or panel == null:
		return
	panel.offset_left = pad
	panel.offset_top = pad
	panel.offset_right = -pad
	panel.offset_bottom = -pad
	panel.add_theme_stylebox_override("panel", UIStyle.create_metal_popup_style())
	var frame = MetalFrameScript.new()
	frame.name = "MetalFrame"
	frame.set_anchors_preset(Control.PRESET_FULL_RECT)
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.band = 5.0
	frame.hairline_inset = 9.0
	panel.add_child(frame)
	panel.move_child(frame, 0)
	# Window.size 是 Vector2i，不能用 Vector2 直接加
	dialog.size = dialog.size + Vector2i(int(pad * 2.0), int(pad * 2.0))


