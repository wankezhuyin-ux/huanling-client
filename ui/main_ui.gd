		list.add_child(_make_assist_picker_pet_row(pick, func():
			popup.hide()
			popup.queue_free()
			_sync_pet_assist_equip(slot_put, pick)
		))
	var cancel_btn: = _make_assist_popup_action_btn("取消", false, Vector2(160, 46))
	cancel_btn.pressed.connect( func():
		popup.hide()
		popup.queue_free()
	)
	root.add_child(cancel_btn)
	popup.close_requested.connect( func(): popup.queue_free())
	_popup_assist_fixed(popup)

func _await_pet_assist_server_op(op: String, slot_index: int, pet_id: String = "") -> Dictionary:
	var state: = {"done": false, "ok": false, "message": "", "data": {}}
	if not game_manager or not game_manager.network:
		state.message = "网络未初始化"
		return state
	var op_id: = "pet_assist_%s_%d_%d_%s" % [op, slot_index, Time.get_ticks_usec(), pet_id]
	var on_success = func(data: Dictionary):
		state.done = true
		state.ok = true
		state.data = data if data is Dictionary else {}
		state.message = str(state.data.get("message", "操作成功"))
	var on_failed = func(error: String):
		state.done = true
		state.ok = false
		state.message = error
	var net = game_manager.network
	var sig_ok = net.pet_assist_equip_success if op == "equip" else net.pet_assist_unequip_success
	var sig_fail = net.pet_assist_equip_failed if op == "equip" else net.pet_assist_unequip_failed
	sig_ok.connect(on_success, CONNECT_ONE_SHOT)
	sig_fail.connect(on_failed, CONNECT_ONE_SHOT)
	if op == "equip":
		net.pet_assist_equip(pet_id, slot_index, op_id)
	else:
		net.pet_assist_unequip(slot_index, op_id, pet_id)
	var deadline: = Time.get_ticks_msec() + 20000
	while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
		await game_manager.get_tree().process_frame
	if sig_ok.is_connected(on_success):
		sig_ok.disconnect(on_success)
	if sig_fail.is_connected(on_failed):
		sig_fail.disconnect(on_failed)
	if not bool(state.done):
		state.ok = false
		state.message = "服务器响应超时，请稍后重试"
	elif bool(state.ok) and state.data.has("saveData") and state.data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(state.data.get("saveData"), {"pets_authoritative": true, "skip_deferred_cloud_save": true})
		game_manager.save_game(false)
	return state

func _sync_pet_assist_equip(slot_index: int, store_pet) -> void :
	if not game_manager or not game_manager.pet_manager:
		_show_simple_dialog("操作失败", "宠物管理器未初始化")
		return
	if not game_manager.network or not game_manager.network.is_logged_in():
		_show_simple_dialog("操作失败", "需要联网后才能放入助战槽")
		return
	var live_pet = _resolve_live_pet(store_pet)
	if live_pet == null:
		_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
		return
	var pm = game_manager.pet_manager
	if not pm.is_assist_slot_unlocked(slot_index):
		_show_simple_dialog("操作失败", "该助战槽尚未开启")
		return
	if pm.active_pet and str(pm.active_pet.id) == str(live_pet.id):
		_show_simple_dialog("操作失败", "出战宠物不能放入助战槽")
		return
	var need_el: = PetAssistBonus.slot_element(slot_index)
	var pet_el: = str(live_pet.element).strip_edges()
	if pet_el != need_el and pet_el != "天":
		_show_simple_dialog("操作失败", "该槽位仅可放入%s属性宠物（天系除外）" % need_el)
		return
	if not bool(game_manager.is_cloud_sync_ready()):
		_show_simple_dialog("操作失败", "宠物状态同步中，请稍后再试")
		return
	game_manager.begin_pet_bag_op_cloud_sync()
	var state: Dictionary = await _await_pet_assist_server_op("equip", slot_index, str(live_pet.id))
	game_manager.end_pet_bag_op_cloud_sync()
	if not bool(state.get("ok", false)):
		_show_simple_dialog("操作失败", str(state.get("message", "放入失败，请重试")))
		return
	_refresh_pet_assist_after_op()

func _sync_pet_assist_unequip(slot_index: int) -> void :
	if not game_manager or not game_manager.pet_manager:
		_show_simple_dialog("操作失败", "宠物管理器未初始化")
		return
	if not game_manager.network or not game_manager.network.is_logged_in():
		_show_simple_dialog("操作失败", "需要联网后才能取出助战宠")
		return
	var pm = game_manager.pet_manager
	var assist_pet = pm.get_assist_pet_at(slot_index)
	if assist_pet == null:
		_show_simple_dialog("操作失败", "该助战槽为空")
		return
	if pm.pets.size() >= pm.max_pets:
		_show_simple_dialog("操作失败", "宠物列表已满，请先腾出一个位置")
		return
	if not bool(game_manager.is_cloud_sync_ready()):
		_show_simple_dialog("操作失败", "宠物状态同步中，请稍后再试")
		return
	game_manager.begin_pet_bag_op_cloud_sync()
	var state: Dictionary = await _await_pet_assist_server_op("unequip", slot_index, str(assist_pet.id))
	game_manager.end_pet_bag_op_cloud_sync()
	if not bool(state.get("ok", false)):
		_show_simple_dialog("操作失败", str(state.get("message", "取出失败，请重试")))
		return
	_refresh_pet_assist_after_op()

func _get_filtered_pets_for_bag(pet_manager) -> Array:
	var pets = []
	var bag_pets = pet_manager.get_all_pets_in_bag()

	for pet in bag_pets:
		pets.append(pet)

	match pet_bag_sort_mode:
		0:
			pets.sort_custom( func(a, b): return a.level > b.level)
		1:
			pets.sort_custom( func(a, b): return a.level < b.level)
		2:
			pets.sort_custom( func(a, b): return a.total_growth > b.total_growth)
		3:
			pets.sort_custom( func(a, b): return a.total_growth < b.total_growth)
		4:
			pets.sort_custom( func(a, b): return a.generation > b.generation)
		5:
			pets.sort_custom( func(a, b): return a.generation < b.generation)

	return pets

