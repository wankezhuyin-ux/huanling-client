func _update_player_ui_optimized():
	if not game_manager or not game_manager.player:
		return

	var player = game_manager.player

	var max_hp = player.get_max_hp()
	if player.hp != _cached_player_hp or max_hp != _cached_player_max_hp:
		var current_hp = clamp(player.hp, 0, max_hp)
		if current_hp != player.hp:
			player.hp = current_hp
		_cached_player_hp = current_hp
		_cached_player_max_hp = max_hp
		player_hp_bar.max_value = max_hp
		player_hp_bar.value = current_hp
		player_hp_bar_label.text = "%d%%" % int(float(current_hp) / max_hp * 100)
		player_hp_text_label.text = "HP: %d/%d" % [current_hp, max_hp]
		if game_manager.in_battle and is_instance_valid(_battle_player_hp_bar) and not game_manager.is_brother_tower_battle:
			_update_battle_ally_wrap_hp_bar(_battle_player_hp_bar, current_hp, max_hp)

	if player.mp != _cached_player_mp:
		var max_mp = player.get_max_mp()
		var current_mp = clamp(player.mp, 0, max_mp)
		if current_mp != player.mp:
			player.mp = current_mp
		_cached_player_mp = current_mp
		player_mp_text_label.text = "MP: %d/%d" % [current_mp, max_mp]

	if player.experience != _cached_player_exp:
		_cached_player_exp = player.experience
		var exp_required: = maxi(1, player.get_required_exp())
		player_exp_bar.max_value = exp_required
		player_exp_bar.value = mini(player.experience, exp_required)
		player_exp_label.text = "%d%%" % int(clampf(player.get_exp_percent(), 0.0, 1.0) * 100.0)

	if player.gold != _cached_player_gold:
		_cached_player_gold = player.gold
		gold_label.text = "%d" % player.gold
	if player.yuanbao_currency != _cached_player_yuanbao:
		_cached_player_yuanbao = player.yuanbao_currency
		yuanbao_label.text = "%d" % player.yuanbao_currency

	if player.player_name != _cached_battle_player_name:
		player_name_label.text = player.player_name
		_cached_battle_player_name = player.player_name
	if player.level != _cached_battle_player_level:
		player_level_label.text = "Lv.%d" % player.level
		_cached_battle_player_level = player.level
	if player.realm != _cached_battle_player_realm:
		player_realm_label.text = player.realm
		_cached_battle_player_realm = player.realm
	if game_manager.in_battle and is_instance_valid(_battle_player_name_label) and not game_manager.is_brother_tower_battle:
		if player.player_name != _battle_name_base(_battle_player_name_label)\
		or (is_instance_valid(_battle_player_level_label)\
		and _battle_player_level_label.text != _format_ally_battle_level_text(int(player.level))):
			_refresh_player_battle_display()

func _update_player_ui():
	if not game_manager or not game_manager.player:
		return

	var player = game_manager.player
	player_name_label.text = player.player_name
	player_level_label.text = "Lv.%d" % player.level
	player_realm_label.text = player.realm

	var max_hp = player.get_max_hp()
	var current_hp = clamp(player.hp, 0, max_hp)
	if current_hp != player.hp:
		player.hp = current_hp
	player_hp_bar.max_value = max_hp
	player_hp_bar.value = current_hp
	player_hp_bar_label.text = "%d%%" % int(float(current_hp) / max_hp * 100)
	player_hp_text_label.text = "HP: %d/%d" % [current_hp, max_hp]

	var max_mp = player.get_max_mp()
	var current_mp = clamp(player.mp, 0, max_mp)
	if current_mp != player.mp:
		player.mp = current_mp
	player_mp_text_label.text = "MP: %d/%d" % [current_mp, max_mp]

	var exp_required: = maxi(1, player.get_required_exp())
	player_exp_bar.max_value = exp_required
	player_exp_bar.value = mini(player.experience, exp_required)
	player_exp_label.text = "%d%%" % int(clampf(player.get_exp_percent(), 0.0, 1.0) * 100.0)

	gold_label.text = "%d" % player.gold
	_cached_player_gold = player.gold
	yuanbao_label.text = "%d" % player.yuanbao_currency
	_cached_player_yuanbao = player.yuanbao_currency

	_update_player_battle_panel_avatar()

	_update_ascend_reincarnate_buttons()
	_refresh_sync_status_label()

func _setup_button_animation(btn: Button):
	btn.pivot_offset = btn.size / 2
	btn.resized.connect( func(): btn.pivot_offset = btn.size / 2)
	btn.button_down.connect( func(): _animate_button_scale(btn, 0.9))
	btn.button_up.connect( func(): _animate_button_scale(btn, 1.0))

func _setup_bottom_nav_button_style(btn: Button) -> void :
	if btn == null:
		return
	btn.flat = true
	btn.focus_mode = Control.FOCUS_NONE
	var empty_style: = StyleBoxEmpty.new()
	btn.add_theme_stylebox_override("normal", empty_style)
	btn.add_theme_stylebox_override("hover", empty_style)
	btn.add_theme_stylebox_override("pressed", empty_style)
	btn.add_theme_stylebox_override("focus", empty_style)
	btn.add_theme_stylebox_override("disabled", empty_style)
	var normal_icon: = Color(0.9, 0.9, 0.95, 1.0)
	var hover_icon: = Color(1.0, 0.94, 0.58, 1.0)
	var pressed_icon: = Color(1.0, 0.84, 0.32, 1.0)
	btn.add_theme_color_override("icon_normal_color", normal_icon)
	btn.add_theme_color_override("icon_hover_color", hover_icon)
	btn.add_theme_color_override("icon_pressed_color", pressed_icon)
	btn.add_theme_color_override("icon_focus_color", hover_icon)
	var label: Label = null
	var parent: = btn.get_parent()
	if parent:
		for child in parent.get_children():
			if child is Label:
				label = child
				break
	if label == null:
		return
	var normal_label: = Color(0.92, 0.92, 0.96, 1.0)
	var hover_label: = Color(1.0, 0.94, 0.58, 1.0)
	label.add_theme_color_override("font_color", normal_label)
	btn.mouse_entered.connect( func(): label.add_theme_color_override("font_color", hover_label))
	btn.mouse_exited.connect( func(): label.add_theme_color_override("font_color", normal_label))

func _animate_button_scale(btn: Button, target_scale: float):
	var tween = create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_BACK)
	tween.tween_property(btn, "scale", Vector2(target_scale, target_scale), 0.1)

func _create_ascend_reincarnate_buttons():
	var player_panel = $MainContent / BattleView / PlayerPanel

	ascend_btn = Button.new()
	ascend_btn.text = "飞升"
	ascend_btn.custom_minimum_size = Vector2(70, 35)
	ascend_btn.position = Vector2(520, 100)
	ascend_btn.add_theme_font_size_override("font_size", 16)
	ascend_btn.pressed.connect(_on_ascend_pressed)
	player_panel.add_child(ascend_btn)

	reincarnate_btn = Button.new()
	reincarnate_btn.text = "投胎"
	reincarnate_btn.custom_minimum_size = Vector2(70, 35)
	reincarnate_btn.position = Vector2(600, 100)
	reincarnate_btn.add_theme_font_size_override("font_size", 16)
	reincarnate_btn.pressed.connect(_on_reincarnate_pressed)
	player_panel.add_child(reincarnate_btn)
	_refresh_challenge_nav_lock()

func _update_ascend_reincarnate_buttons():
	if not ascend_btn or not reincarnate_btn:
		return

	var player = game_manager.player

	var ec3 = {}
	if game_manager and game_manager.pet_collection_manager:
		ec3 = game_manager.pet_collection_manager.get_all_element_collection_counts()
	var can_ascend = player.can_ascend(ec3).can_ascend
	if can_ascend:
		ascend_btn.modulate = Color(1, 0.84, 0)
	else:
		ascend_btn.modulate = Color(0.5, 0.5, 0.5)

	var can_reincarnate = player.can_reincarnate()
	if can_reincarnate:
		reincarnate_btn.modulate = Color(1, 0.5, 0.8)
	else:
		reincarnate_btn.modulate = Color(0.5, 0.5, 0.5)

	if _is_challenge_view_locked():
		ascend_btn.disabled = true
		reincarnate_btn.disabled = true

func _on_ascend_pressed():
	if _is_challenge_view_locked():
		_show_simple_dialog("无法操作", "挑战进行中，请先完成或停止当前挑战")
		return
	var player = game_manager.player

	var ec4 = {}
	if game_manager and game_manager.pet_collection_manager:
		ec4 = game_manager.pet_collection_manager.get_all_element_collection_counts()
	var ascend_check = player.can_ascend(ec4)
	if not ascend_check.can_ascend:
		if ascend_check.missing_elements.size() > 0:
			_add_log("[color=red]五行图鉴不足，飞升大罗金仙需要每个属性至少10个图鉴！[/color]")
		else:
			var required_level = GameData.ASCENSION_CONDITIONS.get(player.realm, {}).get("required_level", 0)
			if player.realm == "幻灵天神":
				_add_log("[color=red]已经达到最高境界, 无法继续飞升![/color]")
			else:
				_add_log("[color=red]等级不足, 需要达到%d级才能飞升![/color]" % required_level)
		return
	var can_commit_battle_ascend: = false
	var battle_ascend_sync_msg: = "当前网络同步异常，暂时无法执行飞升。\n请等待网络恢复后再试，避免进度回滚。"
	if game_manager and game_manager.network and game_manager.network.has_method("can_commit_critical_op"):
		can_commit_battle_ascend = bool(game_manager.network.can_commit_critical_op())
		if game_manager.network.has_method("get_sync_status_message"):
			battle_ascend_sync_msg = str(game_manager.network.get_sync_status_message()) + "\n请等待网络恢复后再试，避免进度回滚。"
	else:
		battle_ascend_sync_msg = "未连接网络服务，暂时无法执行飞升。\n请登录后重试。"
	if not can_commit_battle_ascend:
		_add_log("[color=red]%s[/color]" % battle_ascend_sync_msg)
		_show_simple_dialog("同步异常", battle_ascend_sync_msg)
		return

	var anim_panel = _show_process_animation("飞升中", "天地灵气汇聚...")
	var anim_label = anim_panel.get_meta("anim_label") as Label
	var desc_label = anim_panel.get_meta("desc_label") as Label

	await get_tree().create_timer(0.7).timeout
	if anim_label and desc_label and is_instance_valid(anim_panel):
		anim_label.text = "飞升中··"
		desc_label.text = "突破境界瓶颈..."

	await get_tree().create_timer(0.7).timeout
	if anim_label and desc_label and is_instance_valid(anim_panel):
		anim_label.text = "飞升中···"
		desc_label.text = "即将踏入新境界..."

	await get_tree().create_timer(0.6).timeout
	if is_instance_valid(anim_panel):
		anim_panel.queue_free()

	var old_realm = player.realm
	# 同 _on_character_realm_ascend_pressed：记下飞升前的属性点总量，弹窗里报增量
	var attr_points_before: int = int(player.points) + int(player.pending_auto_points)
	var snapshot = game_manager.create_secure_op_snapshot()
	var asc_commit_result: Dictionary = await game_manager.commit_realm_transition(snapshot, "飞升", func() -> Dictionary:
		return player.ascend(ec4)
	)

	if not bool(asc_commit_result.get("success", false)):
		_add_log("[color=red]%s[/color]" % str(asc_commit_result.get("message", "飞升结果同步失败，已回滚。")))
		return
	var result: Dictionary = asc_commit_result.get("transition_result", {}) if asc_commit_result.get("transition_result") is Dictionary else {}
	if bool(result.get("success", false)):
		var announce_msg = ""
		var popup_poem = ""
		var popup_msg = ""

		if str(result.get("poem", "")) == "SPECIAL":
			announce_msg = "夫唯不争，故天下莫能与之争。\n恭喜【%s】一心向武，从破中求立，终于突破自身极限，晋升幻灵天神。等级:%d" % [player.player_name, player.level]
			popup_poem = "夫唯不争，故天下莫能与之争。\n一心向武，从破中求立，终于突破自身极限！"
			popup_msg = "恭喜晋升幻灵天神！"
		else:
			var realm_msgs = {
				"散仙": "得道飞升成仙！", 
				"地仙": "得道晋升地仙！", 
				"天仙": "修为更上一层，晋升天仙！", 
				"大罗金仙": "修为更上一层，晋升大罗金仙！"
			}
			announce_msg = "%s\n恭喜【%s】%s 等级:%d" % [str(result.get("poem", "")), player.player_name, realm_msgs.get(player.realm, "晋升" + player.realm), player.level]
			popup_poem = str(result.get("poem", ""))
			popup_msg = "恭喜晋升【%s】！" % player.realm

		var attr_gained: int = int(player.points) + int(player.pending_auto_points) - attr_points_before
		if attr_gained > 0:
			if int(player.points) > 0:
				popup_msg += "\n本次飞升获得 %d 点属性点" % attr_gained
			else:
				popup_msg += "\n本次飞升获得 %d 点属性点（已勾选自动加点，进入待分配池，满 %d 点自动分配）" % [attr_gained, player.AUTO_ALLOCATE_THRESHOLD]

		game_manager.broadcast_event("ascend", player.player_name, {"old_realm": old_realm, "new_realm": player.realm, "level": player.level}, announce_msg)
		_show_result_popup(
			"飞升成功", 
			popup_poem, 
			popup_msg, 
			func():
				_update_player_ui()
				_clear_container(character_basic_stats_container)
				_build_basic_stats_view()
		)
	else:
		_add_log("[color=red]%s[/color]" % str(result.get("message", "飞升失败")))

func _on_reincarnate_pressed():
	if _is_challenge_view_locked():
		_show_simple_dialog("无法操作", "挑战进行中，请先完成或停止当前挑战")
		return
	var player = game_manager.player

	if not player.can_reincarnate():
		if player.realm != "幻灵天神":
			_add_log("[color=red]只有幻灵天神才能投胎![/color]")
		elif player.level < GameData.MAX_LEVEL_EVOLUTION:
			_add_log("[color=red]等级不足, 需要达到%d级才能投胎![/color]" % GameData.MAX_LEVEL_EVOLUTION)
		else:
			_add_log("[color=red]已经达到最大投胎次数![/color]")
		return
	var can_commit_battle_reincarnate: = false
	var battle_reincarnate_sync_msg: = "当前网络同步异常，暂时无法执行投胎。\n请等待网络恢复后再试，避免进度回滚。"
	if game_manager and game_manager.network and game_manager.network.has_method("can_commit_critical_op"):
		can_commit_battle_reincarnate = bool(game_manager.network.can_commit_critical_op())
		if game_manager.network.has_method("get_sync_status_message"):
			battle_reincarnate_sync_msg = str(game_manager.network.get_sync_status_message()) + "\n请等待网络恢复后再试，避免进度回滚。"
	else:
		battle_reincarnate_sync_msg = "未连接网络服务，暂时无法执行投胎。\n请登录后重试。"
	if not can_commit_battle_reincarnate:
		_add_log("[color=red]%s[/color]" % battle_reincarnate_sync_msg)
		_show_simple_dialog("同步异常", battle_reincarnate_sync_msg)
		return

	var anim_panel = _show_process_animation("投胎中", "凝聚无上法力...")
	var anim_label = anim_panel.get_meta("anim_label") as Label
	var desc_label = anim_panel.get_meta("desc_label") as Label

	await get_tree().create_timer(0.7).timeout
	if anim_label and desc_label and is_instance_valid(anim_panel):
		anim_label.text = "投胎中··"
		desc_label.text = "灵魂蜕变转化..."

	await get_tree().create_timer(0.7).timeout
	if anim_label and desc_label and is_instance_valid(anim_panel):
		anim_label.text = "投胎中···"
		desc_label.text = "即将重入凡尘..."

	await get_tree().create_timer(0.6).timeout
	if is_instance_valid(anim_panel):
		anim_panel.queue_free()

	var snapshot = game_manager.create_secure_op_snapshot()
	var re_commit_result: Dictionary = await game_manager.commit_realm_transition(snapshot, "投胎", func() -> Dictionary:
		return player.reincarnate()
	)

	if not bool(re_commit_result.get("success", false)):
		_add_log("[color=red]%s[/color]" % str(re_commit_result.get("message", "投胎结果同步失败，已回滚。")))
		return
	var result: Dictionary = re_commit_result.get("transition_result", {}) if re_commit_result.get("transition_result") is Dictionary else {}
	if bool(result.get("success", false)):
		var player_name = str(result.get("message", player.player_name))
		var announce_msg = _verse_broadcast_star_first_line(REINCARNATE_BROADCAST_POEM, player_name, " 转世次数:%d" % player.reincarnation)
		var popup_poem = REINCARNATE_BROADCAST_POEM
		var perm_gain: = GameData.permanent_delta_on_reincarnate(player.reincarnation)
		var popup_msg = "第%d次投胎成功！获得%d点永久属性点！" % [player.reincarnation, perm_gain]
		game_manager.broadcast_event("reincarnate", player.player_name, {"reincarnation_count": player.reincarnation}, announce_msg)
		_show_result_popup(
			"投胎成功", 
			popup_poem, 
			popup_msg, 
			func():
				_update_player_ui()
				_clear_container(character_basic_stats_container)
				_build_basic_stats_view()
		)
	else:
		_add_log("[color=red]%s[/color]" % str(result.get("message", "投胎失败")))

