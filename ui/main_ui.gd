func _summarize_suit_dismantle_rewards(items: Array) -> Dictionary:
	var totals: Dictionary = {}
	for item in items:
		var reward: Dictionary = _get_suit_dismantle_reward_preview(item)
		if not bool(reward.get("success", false)):
			continue
		var stone: = str(reward.get("stone_name", ""))
		var count: = int(reward.get("count", 0))
		if stone.is_empty() or count <= 0:
			continue
		totals[stone] = int(totals.get(stone, 0)) + count
	return totals

func _confirm_suit_batch_dismantle(items: Array, on_close_parent: Callable = Callable()) -> void :
	var targets: Array = []
	for item in items:
		var target: = _resolve_suit_dismantle_batch_target(item)
		if target.is_empty():
			continue
		targets.append(target)
	if targets.is_empty():
		_show_simple_dialog("分解失败", "没有可分解的套装")
		return
	var totals: = _summarize_suit_dismantle_rewards(items)
	var reward_parts: Array = []
	for stone in totals.keys():
		reward_parts.append("%s x%d" % [str(stone), int(totals[stone])])
	var reward_text: = "、".join(reward_parts) if not reward_parts.is_empty() else "无"
	_show_batch_dismantle_confirm_popup(
		"套装批量分解确认", 
		"将分解 %d 件套装，预计获得：%s" % [targets.size(), reward_text], 
		func():
			if on_close_parent.is_valid():
				on_close_parent.call()
			_pending_suit_dismantle_targets = targets.duplicate(true)
			var op_id: = "equipment_dismantle_suit_batch_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			game_manager.network.request_equipment_dismantle_suit_batch(targets, op_id)
	)

func _show_suit_batch_dismantle_result(result: Dictionary) -> void :
	var count: = int(result.get("committedCount", 0))
	var totals_var: Variant = result.get("rewardTotals", {})
	var parts: Array = []
	if totals_var is Dictionary:
		for stone in totals_var.keys():
			parts.append("%s x%d" % [str(stone), int(totals_var[stone])])
	var summary: = "成功分解 %d 件" % count
	if not parts.is_empty():
		summary += "，共获得：" + "、".join(parts)
	_show_batch_dismantle_result_popup("套装分解结果", summary, result.get("items", []), func(item: Dictionary) -> String:
		return "· %s  +%s x%d" % [str(item.get("sourceName", "")), str(item.get("stoneName", "")), int(item.get("count", 0))]
	)

func _on_equipment_dismantle_suit_batch_success(data: Dictionary) -> void :
	if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
		for target in _pending_suit_dismantle_targets:
			if target is Dictionary:
				game_manager.strip_local_after_authoritative_suit_dismantle(
					str(target.get("equipment_id", "")), 
					str(target.get("sealed_item_id", ""))
				)
	_pending_suit_dismantle_targets.clear()
	_schedule_character_equipment_refresh()
	_update_bag_view()
	var result_var: Variant = data.get("result", {})
	if result_var is Dictionary:
		_show_suit_batch_dismantle_result(result_var)

func _on_equipment_dismantle_suit_batch_failed(error: String) -> void :
	_pending_suit_dismantle_targets.clear()
	_show_simple_dialog("分解失败", str(error))

