func _refresh_character_attr_panel(full_character_view: bool = false) -> void :
	if game_manager == null or game_manager.player == null:
		return
	if not _should_refresh_character_attr_ui():
		_mark_character_attr_ui_dirty()
		return
	if full_character_view:
		if character_basic_stats_container.get_child_count() > 0:
			_clear_container_immediate(character_basic_stats_container)
			_build_basic_stats_view()
		if character_combat_stats_container.get_child_count() > 0:
			_clear_container_immediate(character_combat_stats_container)
			_build_combat_stats_view()
		if character_equipment_container.get_child_count() > 0:
			_clear_container_immediate(character_equipment_container)
			_build_character_equipment_view()
	else:
		_clear_container_immediate(character_basic_stats_container)
		_build_basic_stats_view()
		var combat_scroll: Control = $MainContent / CharacterView / ContentArea / Body / RightStack / CombatStatsContainer
		if combat_scroll != null and combat_scroll.visible:
			_clear_container_immediate(character_combat_stats_container)
			_build_combat_stats_view()
		var talent_scroll: Control = $MainContent / CharacterView / ContentArea / Body / RightStack / TalentContainer
		if talent_scroll != null and talent_scroll.visible:
			_build_talent_view()
	_update_player_ui()
	_character_attr_panel_stale = false

