func _begin_replay_skip_wait() -> void :
	_replay_skip_gen += 1
	_replay_skip_unlocked = false
	_refresh_replay_skip_button()
	if not _is_skippable_server_replay():
		return
	var gen: = _replay_skip_gen
	var timer: = get_tree().create_timer(5.0)
	timer.timeout.connect( func():
		if gen != _replay_skip_gen:
			return
		if not _is_skippable_server_replay():
			return
		_replay_skip_unlocked = true
		_refresh_replay_skip_button()
	, CONNECT_ONE_SHOT)

func _cancel_replay_skip_wait() -> void :
	_replay_skip_gen += 1
	_replay_skip_unlocked = false
	_refresh_replay_skip_button()

