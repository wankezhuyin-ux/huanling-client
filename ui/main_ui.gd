		if game_manager:
			game_manager.post_login_offline_rewards_ready.connect(_on_post_login_offline_rewards_ready, CONNECT_ONE_SHOT)
			game_manager.post_login_offline_claim_applied.connect(_on_post_login_offline_claim_applied, CONNECT_ONE_SHOT)
			if network:
				network.merge_pending_into_downloaded_save(save_data)
			game_manager.apply_cloud_save(save_data, {"pets_authoritative": true, "skip_deferred_cloud_save": true})
			if network:
				network.discard_pending_saves_after_cloud_applied()
			_begin_post_login_broadcast_sync(save_data)
			# 离线奖励要先弹，所以这里挂上「待弹」标志，下面不再立刻弹欢迎面板。
			_startup_offline_pending = true
			print("[STARTUP] 进入待弹离线面板状态，开始异步结算")
			_startup_offline_watchdog()
			game_manager.call_deferred("run_post_login_offline_claim_async", save_data.duplicate(true))
			_request_title_sync_now()
			_request_post_login_sync()
			_update_login_dialog_info()
			_cached_pet_texture = ""
			_update_player_ui()
			_update_pet_ui()
	elif network and network.is_logged_in():
		print("[MAIN_UI] 已登录：优先从服务器下载存档，避免跨账号误加载本地存档")
		_download_save_from_server()

	if not startup_dialog and not _game_started:
		if _startup_offline_pending:
			# 等离线奖励弹窗走完（点了「领取奖励」）再弹「欢迎回来」，顺序和参考稿一致。
			_hide_game_hud_for_startup_dialog()
		elif is_new_game or _needs_character_creation():
			# 本地新档 / 刚注册还没建角色的账号：都要先创建角色
			_show_character_creation_dialog()
		else:
			_show_login_dialog()

func _download_save_from_server():
	if network and network.is_logged_in():

		network.check_pending_uploads(false)
		network.download_save()

