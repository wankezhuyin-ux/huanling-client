func _ensure_battle_banner_layer() -> void :
	if _battle_banner_layer and is_instance_valid(_battle_banner_layer):
		return
	var panel = $MainContent / BattleView / BattlePanel
	if not panel:
		return
	_battle_banner_layer = Control.new()
	_battle_banner_layer.name = "BattleBannerLayer"
	_battle_banner_layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	_battle_banner_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_battle_banner_layer.z_index = BATTLE_BANNER_LAYER_Z_INDEX
	panel.add_child(_battle_banner_layer)
	panel.move_child(_battle_banner_layer, panel.get_child_count() - 1)

func _battle_panel_local_to_global(panel_local: Vector2) -> Vector2:
	var panel: = $MainContent / BattleView / BattlePanel as Control
	if panel == null:
		return panel_local
	return panel.get_global_transform() * panel_local

func _clear_battle_banners(full_clear: bool = true) -> void :
	if not full_clear:

		return
	_battle_popup_stack.clear()
	_battle_damage_popup_stack.clear()
	if _battle_banner_layer and is_instance_valid(_battle_banner_layer):
		for child in _battle_banner_layer.get_children():
			child.queue_free()
		_battle_banner_layer.queue_free()
	_battle_banner_layer = null

func _field_local_to_panel_pos(field_local: Vector2) -> Vector2:
	if not is_instance_valid(monster_container):
