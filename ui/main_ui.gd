func _close_atlas_feed_settings() -> void:
	if _atlas_feed_layer != null and is_instance_valid(_atlas_feed_layer):
		_atlas_feed_layer.queue_free()
	_atlas_feed_layer = null


## 按 layer 上记的当前值刷一遍控件（开关按钮换样式、成长率换数字）
func _atlas_feed_sync() -> void:
	if _atlas_feed_layer == null or not is_instance_valid(_atlas_feed_layer):
		return
	var on: bool = bool(_atlas_feed_layer.get_meta("auto", false))
	var growth: float = float(_atlas_feed_layer.get_meta("growth", 6.0))
	var auto_btn: Button = _atlas_feed_layer.get_meta("auto_btn")
	if is_instance_valid(auto_btn):
		auto_btn.text = "已开启" if on else "已关闭"
		if on:
			_ink_solid_gold_button(auto_btn, _ink_font(26.0))
		else:
			_ink_outline_button(auto_btn, _ink_font(26.0), Color(0.62, 0.58, 0.48))
	var growth_label: Label = _atlas_feed_layer.get_meta("growth_label")
	if is_instance_valid(growth_label):
		growth_label.text = "%.1f" % growth
	var save_btn: Button = _atlas_feed_layer.get_meta("save_btn")
	if is_instance_valid(save_btn):
		save_btn.disabled = false
		save_btn.text = "保存设置"


func _on_atlas_feed_toggle_auto() -> void:
	if _atlas_feed_layer == null or not is_instance_valid(_atlas_feed_layer):
		return
	_atlas_feed_layer.set_meta("auto", not bool(_atlas_feed_layer.get_meta("auto", false)))
	_atlas_feed_sync()


func _on_atlas_feed_growth_step(delta: float) -> void:
	if _atlas_feed_layer == null or not is_instance_valid(_atlas_feed_layer):
		return
	var v: float = float(_atlas_feed_layer.get_meta("growth", 6.0)) + delta
	v = clampf(snappedf(v, 0.1), 0.5, 99.0)
	_atlas_feed_layer.set_meta("growth", v)
	_atlas_feed_sync()


func _on_atlas_feed_save_pressed() -> void:
	if _atlas_feed_layer == null or not is_instance_valid(_atlas_feed_layer) or game_manager == null:
		return
	var want_auto: bool = bool(_atlas_feed_layer.get_meta("auto", false))
	var want_growth: float = float(_atlas_feed_layer.get_meta("growth", 6.0))
	var save_btn: Button = _atlas_feed_layer.get_meta("save_btn")
	if is_instance_valid(save_btn):
		save_btn.disabled = true
		save_btn.text = "保存中…"
	if game_manager.network == null or not game_manager.network.is_logged_in():
		game_manager.auto_capture_enabled = want_auto
		game_manager.min_growth_threshold = want_growth
		game_manager.save_game()
		_close_atlas_feed_settings()
		_show_tip_popup("设置已保存\n当前未登录，仅保存在本设备，登录后再改一次即可上云。")
		return
	var prev_auto: bool = game_manager.auto_capture_enabled
	var prev_growth: float = game_manager.min_growth_threshold
	game_manager.auto_capture_enabled = want_auto
	game_manager.min_growth_threshold = want_growth
	var res: Dictionary = await game_manager.request_capture_settings_authority(want_auto, want_growth)
	if not bool(res.get("ok", false)):
		# 失败回滚：服务端权威值才是准的，界面不能停在"看起来改了"的状态
		game_manager.auto_capture_enabled = prev_auto
		game_manager.min_growth_threshold = prev_growth
		if _atlas_feed_layer != null and is_instance_valid(_atlas_feed_layer):
			_atlas_feed_layer.set_meta("auto", prev_auto)
			_atlas_feed_layer.set_meta("growth", prev_growth)
			_atlas_feed_sync()
			var status: Label = _atlas_feed_layer.get_meta("status")
			if is_instance_valid(status):
				status.visible = true
				status.text = str(res.get("error", "保存失败，请稍后重试"))
		return
	var now_auto: bool = game_manager.auto_capture_enabled
	var now_growth: float = game_manager.min_growth_threshold
	_close_atlas_feed_settings()
	_show_tip_popup("投喂设置已同步\n自动捕捉：%s ｜ 最低成长率：%.1f" % ["开启" if now_auto else "关闭", now_growth])


## 图鉴整页的占地：宽度铺满，高度只到「底部导航顶边」。
##
## 这一页是 MOUSE_FILTER_STOP 的全屏浮层，z_index 又高于 BottomNav（120 > 40），
## 一旦铺满整屏，底部那排「战斗/角色/主城/宠物/背包」的点击会全部落在这一页上，
## 表现就是「图鉴打开后，除了返回键什么都点不动」。所以把高度收到底栏上方，
## 让 dock 区域完全不属于这一页 —— 点击、悬停、视觉都回到 dock 自己身上。
func _fit_atlas_page() -> void:
	if _atlas_page == null or not is_instance_valid(_atlas_page):
		return
	_atlas_page.position = Vector2.ZERO
	var vp_size: = get_viewport_rect().size
	var h: = vp_size.y
	if bottom_nav != null and is_instance_valid(bottom_nav) and bottom_nav.is_visible_in_tree():
		# 用 global 坐标差算高度：BottomNav 挂在 MainUI 根上、有自己的 anchor/offset，
		# 直接读 position 会在缩放/安全区变化时对不上。
		var nav_top: float = bottom_nav.get_global_rect().position.y
		var page_top: float = _atlas_page.get_global_rect().position.y
		var limit: float = nav_top - page_top
		# 兜底：dock 还没布好（或被藏起来）时算出来是 0 或负数，别把整页压没
		if limit > vp_size.y * 0.4:
			h = limit
	_atlas_page.size = Vector2(vp_size.x, h)


func _atlas_all_ids() -> Array:
	if game_manager == null or game_manager.pet_collection_manager == null:
		return []
	return game_manager.pet_collection_manager.get_all_pet_ids()


func _close_pet_atlas_page() -> void:
	# 详情弹层 / 投喂设置弹层都是页面的子节点，只把页面藏起来的话
	# 下次打开会连带它们一起冒出来
	_close_atlas_detail()
	_close_atlas_feed_settings()
	if _atlas_page != null and is_instance_valid(_atlas_page):
		_atlas_page.visible = false


## 图鉴筛选标签（全部 / 已收录 / 未收录）：选中给金边 + 淡金底，未选中只留暗金细边。
## 字号按画布像素算（见 _show_pet_atlas_page 开头的口径说明）：
## 27 设计 px ≈ 19 画布 px，和主城各页 20 号字持平。
func _apply_atlas_chip_style(btn: Button, selected: bool) -> void:
	_apply_atlas_chip_box(btn, selected, 27.0, 22.0, 9.0)


## 五行标签：尺寸照旧图鉴（宠物园那版）—— 60×35 画布像素、20 号字。
## 六个字一排放得下，所以不做"小一号"处理。
func _apply_atlas_element_chip_style(btn: Button, selected: bool) -> void:
	_apply_atlas_chip_box(btn, selected, 28.0, 14.0, 7.0)


func _apply_atlas_chip_box(btn: Button, selected: bool, font_px: float, pad_x: float, pad_y: float) -> void:
	if btn == null:
		return
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	btn.add_theme_font_size_override("font_size", _ink_font(font_px))
	btn.add_theme_color_override("font_color", INK_GOLD_HI if selected else Color(0.66, 0.62, 0.52))
	btn.add_theme_color_override("font_hover_color", Color(1.0, 0.94, 0.78))
	btn.add_theme_color_override("font_pressed_color", INK_GOLD_HI)
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.088, 0.075, 0.045, 0.92) if selected else Color(0.030, 0.027, 0.020, 0.72)
	st.border_color = Color(0.930, 0.800, 0.440, 0.80) if selected else Color(0.788, 0.635, 0.294, 0.28)
	st.set_border_width_all(hair)
	st.set_corner_radius_all(0)
	st.content_margin_left = pad_x * s
	st.content_margin_right = pad_x * s
	st.content_margin_top = pad_y * s
	st.content_margin_bottom = pad_y * s
	for st_name in ["normal", "hover", "pressed", "disabled", "focus"]:
		btn.add_theme_stylebox_override(st_name, st if st_name != "focus" else StyleBoxEmpty.new())


func _set_atlas_filter(key: String) -> void:
	if _atlas_filter == key:
		return
	_atlas_filter = key
	for b in _atlas_filter_buttons:
		if is_instance_valid(b):
			_apply_atlas_chip_style(b, str(b.get_meta("filter_key", "")) == key)
	_rebuild_pet_atlas_grid()


func _set_atlas_element_filter(element: String) -> void:
	if _atlas_element_filter == element:
		return
	_atlas_element_filter = element
	for b in _atlas_element_buttons:
		if is_instance_valid(b):
			_apply_atlas_element_chip_style(b, str(b.get_meta("element", "")) == element)
	_rebuild_pet_atlas_grid()


func _rebuild_pet_atlas_grid() -> void:
	if _atlas_grid == null or not is_instance_valid(_atlas_grid):
		return
	for c in _atlas_grid.get_children():
		c.queue_free()
	if game_manager == null or game_manager.pet_collection_manager == null:
		return
	var pcm = game_manager.pet_collection_manager
	var ids: = _atlas_all_ids()
	var total: = ids.size()
	var collected: = 0
	var shown: = 0
	for pet_id in ids:
		var info: Dictionary = pcm.get_collection_info(str(pet_id))
		var cnt: = int(info.get("count", 0))
		if cnt > 0:
			collected += 1
		if _atlas_filter == "collected" and cnt <= 0:
			continue
		if _atlas_filter == "missing" and cnt > 0:
			continue
		# 五行筛选按图鉴/宠物数据里的 element 走
		var pet_data: Dictionary = GameData.PET_DATA.get(str(pet_id), {})
		if _atlas_element_filter != "全部":
			if str(pet_data.get("element", "")) != _atlas_element_filter:
				continue
		_atlas_grid.add_child(_make_atlas_card(str(pet_id), info))
		shown += 1
	if _atlas_progress_label != null:
		_atlas_progress_label.text = "收录进度 %d / %d" % [collected, total]
	if _atlas_progress_pct != null:
		_atlas_progress_pct.text = "%.1f%%" % (float(collected) * 100.0 / maxf(1.0, float(total)))
	if _atlas_progress_fill != null:
		_atlas_progress_fill.anchor_right = clampf(float(collected) / maxf(1.0, float(total)), 0.0, 1.0)
		_atlas_progress_fill.set_anchors_and_offsets_preset(Control.PRESET_LEFT_WIDE)
		_atlas_progress_fill.anchor_right = clampf(float(collected) / maxf(1.0, float(total)), 0.0, 1.0)
		_atlas_progress_fill.offset_right = 0
	if _atlas_bonus_label != null:
		_atlas_bonus_label.text = _atlas_bonus_text(pcm)
	if shown == 0 and _atlas_grid.get_child_count() == 0:
		var empty: = _ink_text("没有符合条件的灵兽", 16.0, Color(0.55, 0.52, 0.45), false)
		empty.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_atlas_grid.add_child(empty)


## 图鉴总加成（只对出战宠生效）：旧图鉴底部那条，现在挂在进度条同一行
func _atlas_bonus_text(pcm) -> String:
	if pcm == null:
		return ""
	var bonuses: Dictionary = pcm.get_total_bonuses()
	var parts: Array = []
	var pairs: = [["attack", "攻"], ["defense", "防"], ["agility", "敏"], ["hp", "血"]]
	for pair in pairs:
		var val: = float(bonuses.get(pair[0], 0.0))
		if val > 0.0:
			parts.append("%s%s" % [pair[1], PetCollectionData.format_bonus_percent_signed(val)])
	if parts.is_empty():
		return "总加成 暂无"
	return "总加成 " + " ".join(parts)


## 图鉴卡片：灵兽图 + 名字 + 五行 + 收录数（未收录走剪影）
func _make_atlas_card(pet_id: String, info: Dictionary) -> Control:
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	var cnt: = int(info.get("count", 0))
	var max_cnt: = int(info.get("max_count", 50))
	var unlocked: bool = cnt > 0
	var card: = Panel.new()
	card.custom_minimum_size = Vector2(0, 196.0 * s)
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.mouse_filter = Control.MOUSE_FILTER_PASS
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.058, 0.050, 0.036, 0.72) if unlocked else Color(0.036, 0.032, 0.026, 0.62)
	st.border_color = Color(0.788, 0.635, 0.294, 0.42 if unlocked else 0.16)
	st.set_border_width_all(hair)
	st.set_corner_radius_all(0)
	card.add_theme_stylebox_override("panel", st)

	var col: = VBoxContainer.new()
	col.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	col.offset_left = 6.0 * s
	col.offset_top = 6.0 * s
	col.offset_right = -6.0 * s
	col.offset_bottom = -6.0 * s
	col.add_theme_constant_override("separation", int(round(3.0 * s)))
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(col)

	var pic: = TextureRect.new()
	pic.custom_minimum_size = Vector2(0, 108.0 * s)
	pic.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var tex = AssetManager.get_instance().get_pet_texture(pet_id) if AssetManager.get_instance() != null else null
	pic.texture = tex
	if not unlocked:
		# 未收录：留着剪影但压成墨色，玩家能看出"这里有货"又不给画面
		pic.modulate = Color(0.13, 0.12, 0.10, 0.92)
	col.add_child(pic)

	var pet_data: Dictionary = GameData.PET_DATA.get(pet_id, {})
	var pet_name: = str(pet_data.get("name", pet_id))
	var elem: = str(pet_data.get("element", ""))
	var name_lbl: = _ink_text(pet_name if unlocked else pet_name, 18.0,
		INK_GOLD_HI if unlocked else Color(0.44, 0.42, 0.37), false, unlocked)
	name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(name_lbl)

	var meta_row: = HBoxContainer.new()
	meta_row.alignment = BoxContainer.ALIGNMENT_CENTER
	meta_row.add_theme_constant_override("separation", int(round(6.0 * s)))
	meta_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(meta_row)
	if elem != "":
		meta_row.add_child(_ink_text(elem, 14.0, _get_element_color(elem), false))
	meta_row.add_child(_ink_text("%d/%d" % [cnt, max_cnt] if unlocked else "未收录", 14.0,
		Color(0.78, 0.72, 0.58) if unlocked else Color(0.42, 0.40, 0.35), false))

	var line: = Control.new()
	line.custom_minimum_size = Vector2(0, 4.0 * s)
	line.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(line)
	var line_bg: = ColorRect.new()
	line_bg.color = Color(0.02, 0.018, 0.013, 0.9)
	line_bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	line.add_child(line_bg)
	line_bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var line_fg: = ColorRect.new()
	line_fg.color = Color(0.788, 0.635, 0.294, 0.92)
	line_fg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	line.add_child(line_fg)
	line_fg.set_anchors_and_offsets_preset(Control.PRESET_LEFT_WIDE)
	line_fg.anchor_right = clampf(float(cnt) / maxf(1.0, float(max_cnt)), 0.0, 1.0)
	line_fg.offset_right = 0

	if cnt >= max_cnt:
		var chip: = _ink_tag_chip("满", INK_GOLD_HI)
		chip.position = Vector2(card.custom_minimum_size.x - 34.0 * s, 4.0 * s)
		chip.set_anchors_preset(Control.PRESET_TOP_RIGHT)
		chip.offset_left = -36.0 * s
		chip.offset_right = -6.0 * s
		chip.offset_top = 5.0 * s
		chip.offset_bottom = 27.0 * s
		card.add_child(chip)
	# 点卡片看详情：1级属性 / 属性比例 / 图鉴进度与加成，原来只有宠物园旧图鉴能看到
	card.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	card.gui_input.connect( func(ev):
		if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT:
			_show_atlas_pet_detail(pet_id)
		elif ev is InputEventScreenTouch and ev.pressed:
			_show_atlas_pet_detail(pet_id)
	)
	return card


func _close_atlas_detail() -> void:
	if _atlas_detail != null and is_instance_valid(_atlas_detail):
		_atlas_detail.queue_free()
	_atlas_detail = null


## 灵兽详情：图鉴卡片点开。信息口径与旧图鉴详情完全一致（1级属性取 pet 基础数据，
## 进度/加成取 PetCollectionManager），只是换了水墨底板。
func _show_atlas_pet_detail(pet_id: String) -> void:
	if _atlas_page == null or not is_instance_valid(_atlas_page):
		return
	if game_manager == null or game_manager.pet_collection_manager == null:
		return
	_close_atlas_detail()
	var pcm = game_manager.pet_collection_manager
	var info: Dictionary = pcm.get_collection_info(pet_id)
	var base: Dictionary = pcm.get_pet_base_data(pet_id)
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	var cnt: = int(info.get("count", 0))

	var layer: = Control.new()
	layer.name = "AtlasDetail"
	layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	layer.mouse_filter = Control.MOUSE_FILTER_STOP
	_atlas_page.add_child(layer)
	_atlas_detail = layer

	var scrim: = ColorRect.new()
	scrim.color = Color(0.010, 0.009, 0.006, 0.80)
	scrim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	scrim.mouse_filter = Control.MOUSE_FILTER_STOP
	layer.add_child(scrim)
	# 点空白处关闭（弹层里的按钮会先吃掉点击，不会误关）
	scrim.gui_input.connect( func(ev):
		if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT:
			_close_atlas_detail()
		elif ev is InputEventScreenTouch and ev.pressed:
			_close_atlas_detail()
	)

	var center: = CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(center)

	# ⚠️ 必须用 PanelContainer：Panel 不是容器，子节点不会把高度顶起来，
	# 锚 FULL_RECT 的 MarginContainer 又只吃父节点尺寸 → 面板高度 0，底板整个不显示。
	var panel: = PanelContainer.new()
	panel.custom_minimum_size = Vector2(minf(700.0 * s, get_viewport_rect().size.x - 44.0 * s), 0)
	panel.mouse_filter = Control.MOUSE_FILTER_STOP
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.045, 0.039, 0.028, 0.985)
	st.border_color = Color(0.788, 0.635, 0.294, 0.60)
	st.set_border_width_all(hair)
	st.set_corner_radius_all(0)
	panel.add_theme_stylebox_override("panel", st)
	center.add_child(panel)
	_ink_add_inner_line(panel, 5.0, 0.26)

	var mc: = MarginContainer.new()
	mc.add_theme_constant_override("margin_left", int(round(22.0 * s)))
	mc.add_theme_constant_override("margin_right", int(round(22.0 * s)))
	mc.add_theme_constant_override("margin_top", int(round(16.0 * s)))
	mc.add_theme_constant_override("margin_bottom", int(round(18.0 * s)))
	panel.add_child(mc)
	var vb: = VBoxContainer.new()
	vb.add_theme_constant_override("separation", int(round(7.0 * s)))
	mc.add_child(vb)

	# 标题行
	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", int(round(8.0 * s)))
	vb.add_child(head)
	var pet_name: = str(base.get("name", pet_id))
	head.add_child(_ink_text(pet_name, 34.0, INK_GOLD_HI, true, true))
	var hsp: = Control.new()
	hsp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head.add_child(hsp)
	var close_x: = Button.new()
	close_x.text = "✕"
	close_x.focus_mode = Control.FOCUS_NONE
	close_x.custom_minimum_size = Vector2(50.0 * s, 48.0 * s)
	_ink_outline_button(close_x, _ink_font(24.0))
	close_x.pressed.connect(_close_atlas_detail)
	head.add_child(close_x)

	# 立绘（未收录压成剪影，和网格里的卡一致）
	var pic_row: = CenterContainer.new()
	vb.add_child(pic_row)
	var pic: = TextureRect.new()
	pic.custom_minimum_size = Vector2(230.0 * s, 230.0 * s)
	pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if AssetManager.get_instance() != null:
		pic.texture = AssetManager.get_instance().get_pet_texture(pet_id)
	if cnt <= 0:
		pic.modulate = Color(0.16, 0.15, 0.12, 0.95)
	pic_row.add_child(pic)

	# 五行 · 类型 · 属性比例
	var elem: = str(base.get("element", ""))
	var meta: = HBoxContainer.new()
	meta.alignment = BoxContainer.ALIGNMENT_CENTER
	meta.add_theme_constant_override("separation", int(round(10.0 * s)))
	vb.add_child(meta)
	if elem != "":
		meta.add_child(_ink_text(elem, 26.0, _get_element_color(elem), false, true))
	var type_txt: = str(base.get("type", ""))
	if type_txt != "":
		meta.add_child(_ink_text(type_txt, 22.0, Color(0.72, 0.68, 0.58), false))
	var ratio: Array = base.get("ratio", [])
	if ratio.size() >= 3:
		meta.add_child(_ink_text("攻%s%% 防%s%% 敏%s%%" % [str(ratio[0]), str(ratio[1]), str(ratio[2])],
			22.0, Color(0.72, 0.68, 0.58), false))

	var div1: = ColorRect.new()
	div1.color = Color(0.788, 0.635, 0.294, 0.34)
	div1.custom_minimum_size = Vector2(0, maxi(1, int(round(1.0 * s))))
	div1.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vb.add_child(div1)

	# 1 级属性
	vb.add_child(_ink_text("1 级属性", 24.0, Color(0.86, 0.83, 0.75), false, true))
	var grid: = GridContainer.new()
	grid.columns = 3
	grid.add_theme_constant_override("h_separation", int(round(14.0 * s)))
	grid.add_theme_constant_override("v_separation", int(round(4.0 * s)))
	vb.add_child(grid)
	var stat_pairs: = [["攻击", "attack"], ["防御", "defense"], ["敏捷", "agility"],
		["生命", "hp"], ["成长", "growth"], ["生命成长", "hp_growth"]]
	for pair in stat_pairs:
		var cell: = HBoxContainer.new()
		cell.add_theme_constant_override("separation", int(round(6.0 * s)))
		cell.add_child(_ink_text(str(pair[0]), 22.0, Color(0.60, 0.57, 0.48), false))
		cell.add_child(_ink_text(str(base.get(pair[1], 0)), 23.0, Color(0.92, 0.90, 0.85), false))
		grid.add_child(cell)

	# 图鉴进度 + 加成
	var div2: = ColorRect.new()
	div2.color = Color(0.788, 0.635, 0.294, 0.34)
	div2.custom_minimum_size = Vector2(0, maxi(1, int(round(1.0 * s))))
	div2.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vb.add_child(div2)

	var bonus_name: = str(info.get("bonus_type_name", "加成"))
	var cur_bonus: = float(info.get("current_bonus", 0.0))
	var inc_bonus: = float(info.get("bonus_increase", 0.0))
	var mut_n: = int(info.get("mutation_count", 0))
	var mut_max: = int(info.get("mutation_max", 0))
	var prog_line: = ""
	if cnt <= 0:
		prog_line = "未激活 · 投入灵兽可激活图鉴"
	else:
		prog_line = "图鉴 %d / 50 · %s%s" % [cnt, bonus_name, PetCollectionData.format_bonus_percent_signed(cur_bonus)]
		if inc_bonus > 0.0:
			prog_line += "（下级 +%.2f%%）" % (inc_bonus * 100.0)
		if mut_n > 0:
			prog_line += "　变异 %d/%d" % [mut_n, mut_max]
	var prog_col: = Color(0.78, 0.74, 0.62) if cnt <= 0 else Color(0.55, 0.78, 0.58)
	var prog_lbl: = _ink_text(prog_line, 22.0, prog_col, false, cnt > 0)
	prog_lbl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vb.add_child(prog_lbl)

	var flavor: = str(base.get("collection_flavor", "")).strip_edges()
	if flavor != "":
		var fl: = _ink_text(flavor, 21.0, Color(0.62, 0.55, 0.42), false)
		fl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		vb.add_child(fl)

	vb.add_child(_ink_text("图鉴加成只对出战灵兽生效", 19.0, Color(0.52, 0.49, 0.41), false))

	var btn_row: = HBoxContainer.new()
	btn_row.alignment = BoxContainer.ALIGNMENT_CENTER
	vb.add_child(btn_row)
	var close_btn: = Button.new()
	close_btn.text = "关闭"
	close_btn.focus_mode = Control.FOCUS_NONE
	close_btn.custom_minimum_size = Vector2(190.0 * s, 54.0 * s)
	_ink_outline_button(close_btn, _ink_font(24.0))
	close_btn.pressed.connect(_close_atlas_detail)
	btn_row.add_child(close_btn)


