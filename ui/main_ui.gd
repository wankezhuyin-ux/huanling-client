func _setup_mouse_filter(container: Control):
	for child in container.get_children():
		if child is Control:
			if child is Button:
				child.mouse_filter = Control.MOUSE_FILTER_STOP
			else:
				child.mouse_filter = Control.MOUSE_FILTER_IGNORE
			if child is Container:
				_setup_mouse_filter(child)

## 成长值分档 —— 设计稿"头像框分色"的语言：让玩家扫一眼列表就知道哪只值得留。
##   灰白  <5.0       普通
##   绿    5.0-6.99
##   蓝    7.0-8.49
##   紫    8.5-9.99   稀有（比蓝高一档、比金低一档，正好卡在"差一点满成长"）
##   金    >=10.0     满成长
## 同一档的色同时用于：头像八角框描边、成长数字、列表左侧竖条，三处必须一致。
const GROWTH_TIER_GOLD := Color(0.847, 0.686, 0.325)
const GROWTH_TIER_PURPLE := Color(0.647, 0.478, 0.851)
const GROWTH_TIER_BLUE := Color(0.404, 0.616, 0.784)
const GROWTH_TIER_GREEN := Color(0.400, 0.655, 0.420)
const GROWTH_TIER_PLAIN := Color(0.760, 0.745, 0.710)


func _growth_tier_index(growth: float) -> int:
	if growth >= 10.0:
		return 4
	elif growth >= 8.5:
		return 3
	elif growth >= 7.0:
		return 2
	elif growth >= 5.0:
		return 1
	return 0


func _growth_tier_color(growth: float) -> Color:
	match _growth_tier_index(growth):
		4:
			return GROWTH_TIER_GOLD
		3:
			return GROWTH_TIER_PURPLE
		2:
			return GROWTH_TIER_BLUE
		1:
			return GROWTH_TIER_GREEN
		_:
			return GROWTH_TIER_PLAIN


func _get_growth_color(growth: float) -> Color:
	return _growth_tier_color(growth)

