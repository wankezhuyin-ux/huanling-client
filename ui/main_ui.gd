	var ec2 = {}
	if game_manager and game_manager.pet_collection_manager:
		ec2 = game_manager.pet_collection_manager.get_all_element_collection_counts()
	var can_ascend = player.can_ascend(ec2).can_ascend
	var can_reincarnate = player.can_reincarnate()
