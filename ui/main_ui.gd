func _on_fight_log_prev() -> void :
	if _fight_log_history == null:
		return
	var n: int = _fight_log_history.get_history_count()
	if _log_popup_view_index >= n:
		return
	_log_popup_view_index += 1
	_refresh_fight_log_popup_content()


func _on_fight_log_next() -> void :
	if _log_popup_view_index <= 0:
		return
	_log_popup_view_index -= 1
	_refresh_fight_log_popup_content()


func _sanitize_fight_log_bbcode(raw: String) -> String:
	if raw.is_empty():
		return raw

	var placeholders: Array = []
	var out: = raw
	var re_color: = RegEx.new()
	re_color.compile("\\[color=[^\\]]+\\]|\\[/color\\]")
	var matches: = re_color.search_all(out)

	for i in range(matches.size() - 1, -1, -1):
		var m: RegExMatch = matches[i]
		var token: = "C%d" % placeholders.size()
		placeholders.append(m.get_string())
		out = out.substr(0, m.get_start()) + token + out.substr(m.get_end())
	out = out.replace("[", "【")
	out = out.replace("]", "】")
	for i in range(placeholders.size()):
		out = out.replace("C%d" % i, str(placeholders[i]))
	return out


func _refresh_fight_log_popup_content() -> void :
	if _log_popup_view == null or not is_instance_valid(_log_popup_view):
		return
	if _fight_log_history == null:
		_log_popup_view.clear()
		_log_popup_view.append_text("[color=#888888]暂无战斗日志[/color]")
		return
	var hist_n: int = _fight_log_history.get_history_count()
	_log_popup_view_index = clampi(_log_popup_view_index, 0, hist_n)
	var data: Dictionary = _fight_log_history.get_view(
		_log_popup_view_index, 
		_get_current_fight_log_title(), 
		_log_lines, 
		_current_fight_log_finished, 
		_last_fight_log_victory
	)
	var title: = str(data.get("title", ""))
	var body: = str(data.get("body", ""))
	var label: = str(data.get("label", ""))
	if _log_popup_meta_label:
		if _log_popup_view_index == 0:
			_log_popup_meta_label.text = "当前场 · 可往前查看最多 5 场\n%s" % title
		else:
			_log_popup_meta_label.text = "%s · 可往前查看最多 5 场\n%s" % [label, title]
	_log_popup_view.clear()
	if body.strip_edges().is_empty():
		_log_popup_view.append_text("[color=#888888]暂无战斗日志[/color]")
	else:
		_log_popup_view.append_text(_sanitize_fight_log_bbcode(body))
	if _log_popup_prev_btn:
		_log_popup_prev_btn.disabled = _log_popup_view_index >= hist_n
	if _log_popup_next_btn:
		_log_popup_next_btn.disabled = _log_popup_view_index <= 0
	if _log_popup_view_index == 0 and _log_popup_scroll != null:
		call_deferred("_scroll_battle_log_popup_to_bottom", _log_popup_scroll)
	call_deferred("_fit_fight_log_popup_width")


func _fit_fight_log_popup_width() -> void :
	if _log_popup_view == null or not is_instance_valid(_log_popup_view):
		return
	if _log_popup_scroll == null or not is_instance_valid(_log_popup_scroll):
		return
	var w: float = _log_popup_scroll.size.x - 8.0
	if w < 32.0:
		return
	if absf(_log_popup_view.custom_minimum_size.x - w) < 1.0:
		return
	_log_popup_view.custom_minimum_size.x = w


func _scroll_battle_log_popup_to_bottom(scroll: ScrollContainer) -> void :
	if not is_instance_valid(scroll):
		return
	await get_tree().process_frame
	if not is_instance_valid(scroll):
		return
	var vbar = scroll.get_v_scroll_bar()
	if vbar:
		scroll.scroll_vertical = int(vbar.max_value)

func _try_local_inventory_action(kind: String, id: String, popup) -> bool:
	if game_manager == null or not game_manager.has_method("local_feature_action"):
		return false
	var result: Dictionary = game_manager.local_feature_action(kind, {"id": id})
	if bool(result.get("success", false)) and is_instance_valid(popup):
		popup.queue_free()
	_update_pet_ui()
	_notify_player_attr_changed("local_inventory")
	_show_simple_dialog("本地仓库", str(result.get("message", "")))
	return true
