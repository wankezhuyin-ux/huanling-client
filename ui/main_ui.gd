func _battle_wrap_is_lunging(wrap: Control) -> bool:
	if not is_instance_valid(wrap) or not wrap.has_meta(BATTLE_LUNGE_TWEEN_META):
		return false
	var tw = wrap.get_meta(BATTLE_LUNGE_TWEEN_META)
	return tw is Tween and is_instance_valid(tw)

func _reveal_idle_battle_hp_bars() -> void :
	var wraps: Array = [
		_battle_player_wrap, 
		_battle_pet_wrap, 
		_battle_coop_player_wrap, 
		_battle_coop_pet_wrap, 
	]
	for node in monster_ui_nodes:
		wraps.append(node)
	for wrap in wraps:
		if not is_instance_valid(wrap) or _battle_wrap_is_lunging(wrap):
			continue
		if wrap.has_meta(BATTLE_LUNGE_HP_HIDDEN_META):
			wrap.remove_meta(BATTLE_LUNGE_HP_HIDDEN_META)
		var hp_bar: = _find_battle_wrap_hp_bar(wrap)
		if is_instance_valid(hp_bar):
			hp_bar.visible = true

func _shift_battle_wrap_to_new_home(wrap: Control, new_home: Vector2) -> void :
	if not is_instance_valid(wrap):
		return
	var old_home: = wrap.position
	if wrap.has_meta("_battle_home_pos"):
		old_home = wrap.get_meta("_battle_home_pos")
	var delta: = new_home - old_home
	wrap.set_meta("_battle_home_pos", new_home)
	if wrap.has_meta(BATTLE_LUNGE_HOME_POS_META):
		wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, new_home)
	if wrap.position.distance_to(old_home) <= 1.0:
		wrap.position = new_home
	elif delta != Vector2.ZERO:
		wrap.position += delta

func _relayout_battle_units_keep_playback() -> void :
	if not game_manager or not game_manager.battle_system:
		return
	var monsters: Array = game_manager.battle_system.monsters
	var total_count: = monsters.size()
	for i in range(mini(monster_ui_nodes.size(), total_count)):
		var monster_ui: Control = monster_ui_nodes[i]
		if not is_instance_valid(monster_ui):
			continue
		var monster = monsters[i]
		var arena_pos: = Vector2.INF
		var new_home: = monster_ui.position
		if _is_world_boss_battle():
			new_home = _world_boss_monster_ui_position(WORLD_BOSS_BATTLE_CELL_SIZE.x)
		else:
			arena_pos = _place_arena_or_shengsi_monster_ui(monster, i, total_count)
			if arena_pos != Vector2.INF:
				new_home = arena_pos
			else:
				new_home = _battle_grid_monster_slot_pos_formed(i, total_count)
		_shift_battle_wrap_to_new_home(monster_ui, new_home)
		if _is_world_boss_battle() or arena_pos != Vector2.INF:
			monster_ui.z_index = 20
		else:
			monster_ui.z_index = _battle_monster_ui_z_index_for_pos(new_home)
			_apply_battle_slot_perspective(monster_ui)
	if is_instance_valid(_battle_player_wrap) and not _is_battle_ally_wrap_slot_layout(_battle_player_wrap):
		_shift_battle_wrap_to_new_home(_battle_player_wrap, _get_player_battle_wrap_pos())
	if is_instance_valid(_battle_pet_wrap) and not _is_battle_ally_wrap_slot_layout(_battle_pet_wrap):
		_shift_battle_wrap_to_new_home(_battle_pet_wrap, _get_pet_battle_wrap_pos())

func _apply_root_layout():
	var screen_size = get_viewport().get_visible_rect().size

	if screen_size.x < 320 or screen_size.y < 480:
		return
	var bg_node = get_node_or_null("Background")
	if bg_node is Control:
		bg_node.position = Vector2.ZERO
		bg_node.size = screen_size
		bg_node.custom_minimum_size = Vector2.ZERO
	var safe_bottom: float = _ink_safe_bottom_px() if INK_CHROME else 0.0
	if main_content:
		var dock_h2: = 216.0 * _ink_s() if INK_CHROME else 140.0
		main_content.position = Vector2(0, 70)
		main_content.size = Vector2(screen_size.x, screen_size.y - 70 - dock_h2 - safe_bottom)
	if bottom_nav:
		var dock_h: = 140.0
		if INK_CHROME:
			# 设计稿底栏 216 设计像素（徽章 164 + 文字 27）→ 按宽度换算，别写死 140
			dock_h = 216.0 * _ink_s()
		bottom_nav.position = Vector2(0, screen_size.y - safe_bottom - dock_h)
		bottom_nav.size = Vector2(screen_size.x, dock_h)
		if INK_CHROME:
			_apply_ink_dock()
			_ink_update_safe_fill(safe_bottom, screen_size)

