func _show_arena_result_dialog() -> void :
	var settle: Dictionary = {}
	if game_manager.has_method("get_arena_last_settle"):
		settle = game_manager.get_arena_last_settle()
	var victory: = bool(settle.get("victory", false))
	var confirm_ok: = bool(settle.get("confirm_ok", false))
	var score_delta: = int(settle.get("score_delta", 0))
	var weekly_pts: = int(settle.get("weekly_arena_points", 0))
	var balance_pts: = int(settle.get("balance_arena_points", settle.get("spendable_arena_points", 0)))
	var my_rank: = int(settle.get("my_rank", 0))
	var win_streak: = int(settle.get("win_streak", 0))
	var err_text: = str(settle.get("error", "")).strip_edges()

	var dialog: = Window.new()
	dialog.title = ""
	dialog.size = Vector2i(500, 420)
	dialog.transparent = true
	dialog.borderless = true
	dialog.unresizable = true
	var close_dialog: = func():
		if is_instance_valid(dialog):
			dialog.queue_free()
	dialog.close_requested.connect(close_dialog)

	var main_panel: = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_panel_style())
	dialog.add_child(main_panel)

	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 28
	vbox.offset_top = 28
	vbox.offset_right = -28
	vbox.offset_bottom = -28
	vbox.add_theme_constant_override("separation", 18)
	main_panel.add_child(vbox)

	var title: = Label.new()
	title.text = "🎉 竞技场胜利！" if victory else "😢 竞技场失败"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 30)
	title.add_theme_color_override("font_color", Color(0.35, 0.9, 0.55) if victory else Color(0.95, 0.45, 0.45))
	vbox.add_child(title)

	var body_lines: PackedStringArray = PackedStringArray()
	if confirm_ok:
		var delta_text: = "+%d" % score_delta if score_delta >= 0 else str(score_delta)
		body_lines.append("当周竞技点变化：%s" % delta_text)
		body_lines.append("当周竞技点：%d" % weekly_pts)
		body_lines.append("上周结余竞技点：%d" % balance_pts)
		var rank_text: = "100+" if my_rank <= 0 or my_rank > 100 else str(my_rank)
		body_lines.append("当前排名：%s" % rank_text)
		if win_streak > 0:
			body_lines.append("本周连胜：%d" % win_streak)
	else:
		body_lines.append("结果确认失败，请稍后重试")
		if not err_text.is_empty():
			body_lines.append(err_text)
	body_lines.append("完整过程可在挑战记录里查看")

	var content: = Label.new()
	content.text = "\n".join(body_lines)
	content.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	content.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	content.add_theme_font_size_override("font_size", 20)
	vbox.add_child(content)

	var btn_row: = CenterContainer.new()
	vbox.add_child(btn_row)
	var return_btn: = Button.new()
	return_btn.text = "返回竞技场"
	return_btn.custom_minimum_size = Vector2(180, 52)
	return_btn.add_theme_font_size_override("font_size", 20)
	UIStyle.apply_button_style(return_btn)
	return_btn.pressed.connect( func():
		close_dialog.call()
		_show_city_ui_with_arena(true)
	)
	btn_row.add_child(return_btn)
	_present_modal_window(dialog)

func _show_suit_dungeon_result_dialog(victory: bool, level: int):
	var dialog = Window.new()
	dialog.title = ""
	var viewport_h: = int(get_viewport().get_visible_rect().size.y)
	dialog.transparent = true
	dialog.borderless = true
	dialog.unresizable = true
	var close_dialog: = func():
		if is_instance_valid(dialog):
			dialog.queue_free()
		if victory:
			_refresh_suit_dungeon_hub_if_visible()
	dialog.close_requested.connect(close_dialog)
	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_panel_style())
	dialog.add_child(main_panel)
	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 30
	vbox.offset_top = 30
	vbox.offset_right = -30
	vbox.offset_bottom = -30
	vbox.add_theme_constant_override("separation", 25)
	main_panel.add_child(vbox)


	var title = Label.new()
	if victory:
		title.text = "🎉 套装副本通关！"
		title.add_theme_color_override("font_color", Color(0.3, 0.9, 0.5))
	else:
		title.text = "😢 挑战失败"
		title.add_theme_color_override("font_color", Color(0.9, 0.3, 0.3))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 32)
	vbox.add_child(title)

	var reward_text: = ""
	if victory:
		var exp_reward = 2000 * level
		var gold_line: String
		if game_manager.last_suit_dungeon_clear_gold >= 0:
			gold_line = str(game_manager.last_suit_dungeon_clear_gold)
		else:
			gold_line = "由服务器结算（请查看战斗记录）"
		reward_text = "通关第 %d 层套装副本\n\n获得奖励：\n经验：%d\n金币：%s" % [level, exp_reward, gold_line]

		var drops = game_manager.last_suit_dungeon_drops
		var has_drops = false

		if drops.get("sealed_suits", []).size() > 0:
			reward_text += "\n\n[封印套装]"
			for suit_name in drops["sealed_suits"]:
				reward_text += "\n  %s" % suit_name
			has_drops = true

		if drops.get("stones", []).size() > 0:
			reward_text += "\n\n[解封石]"
			for stone_name in drops["stones"]:
				reward_text += "\n  %s" % stone_name
			has_drops = true

		if not has_drops:
			reward_text += "\n\n本次未获得额外物品"
	else:
		reward_text = "未能在20回合内击败所有敌人\n\n第 %d 层挑战失败" % level

	var line_count: = 1
	for segment in reward_text.split("\n"):
		if segment.is_empty():
			line_count = maxi(line_count, 1)
		else:
			line_count = maxi(line_count, int(ceil(float(segment.length()) / 16.0)))
	var content_height: = maxi(80, line_count * 28)
	var max_body_h: = int(float(viewport_h) * 0.5)
	var body_h: = mini(content_height, max_body_h)
	const CHROME_H: = 200
	var dialog_h: = clampi(CHROME_H + body_h, 280, int(float(viewport_h) * 0.85))
	dialog.size = Vector2i(500, dialog_h)

	var scroll = ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.custom_minimum_size = Vector2(0, body_h)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	vbox.add_child(scroll)

	var content = Label.new()
	content.text = reward_text
	content.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	content.add_theme_font_size_override("font_size", 20)
	content.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	content.custom_minimum_size = Vector2(420, 0)
	content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(content)


	var btn_hbox = HBoxContainer.new()
	btn_hbox.add_theme_constant_override("separation", 30)
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_child(btn_hbox)

	if victory:

		var continue_btn = Button.new()
		continue_btn.text = "继续挑战"
		continue_btn.custom_minimum_size = Vector2(160, 55)
		continue_btn.add_theme_font_size_override("font_size", 20)
		UIStyle.apply_button_style(continue_btn)
		continue_btn.pressed.connect( func():
			close_dialog.call()

			_show_city_ui_with_suit_dungeon(level + 1)
		)
		btn_hbox.add_child(continue_btn)
	else:

		var confirm_btn = Button.new()
		confirm_btn.text = "确认"
		confirm_btn.custom_minimum_size = Vector2(160, 55)
		confirm_btn.add_theme_font_size_override("font_size", 20)
		UIStyle.apply_button_style(confirm_btn)
		confirm_btn.pressed.connect(close_dialog)
		btn_hbox.add_child(confirm_btn)
	_present_modal_window(dialog)


