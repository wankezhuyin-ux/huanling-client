func _resolve_suit_dismantle_batch_target(item) -> Dictionary:
	if item == null:
		return {}
	var sealed_ref: Dictionary = _resolve_sealed_suit_ref(item)
	if str(sealed_ref.get("source", "none")) == "item_bag":
		return {"equipment_id": "", "sealed_item_id": str(sealed_ref.get("item_id", ""))}
	if str(sealed_ref.get("source", "none")) == "equip_bag":
		var equip = sealed_ref.get("equipment", item)
		if equip:
			return {"equipment_id": str(equip.id), "sealed_item_id": ""}
	if bool(item.is_suit) and not bool(item.is_sealed):
		return {"equipment_id": str(item.id), "sealed_item_id": ""}
	return {}

func _suit_dismantle_selection_key(item) -> String:
	var target: = _resolve_suit_dismantle_batch_target(item)
	var sealed_id: = str(target.get("sealed_item_id", "")).strip_edges()
	if not sealed_id.is_empty():
		return "s:%s" % sealed_id
	var equip_id: = str(target.get("equipment_id", "")).strip_edges()
	if not equip_id.is_empty():
		return "e:%s" % equip_id
	return ""

func _get_suit_dismantle_reward_preview(item) -> Dictionary:
	if not game_manager or not game_manager.inventory_manager:
		return {"success": false}
	var inv: InventoryManager = game_manager.inventory_manager
	var sealed_ref: Dictionary = _resolve_sealed_suit_ref(item)
	if str(sealed_ref.get("source", "none")) == "item_bag":
		return inv.get_sealed_suit_item_dismantle_reward(str(sealed_ref.get("item_id", "")))
	return inv.get_suit_equipment_dismantle_reward(item)

func _get_eligible_suit_dismantle_candidates() -> Array:
	var out: Array = []
	for item in _collect_character_bag_equipments():
		if item == null or not bool(item.is_suit):
			continue
		if bool(item.locked):
			continue
		var reward: Dictionary = _get_suit_dismantle_reward_preview(item)
		if bool(reward.get("success", false)):
			out.append(item)
	return out

func _rebuild_suit_dismantle_candidate_list(
	list_box: VBoxContainer, 
	eligible: Array, 
	selected_map: Dictionary, 
	selection_label: Label, 
	confirm_btn: Button
) -> void :
	if list_box == null or not is_instance_valid(list_box):
		return
	for child in list_box.get_children():
		child.queue_free()
	if eligible.is_empty():
		var empty_l: = Label.new()
		empty_l.text = "背包内暂无可分解套装"
		empty_l.add_theme_font_size_override("font_size", 15)
		empty_l.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
		list_box.add_child(empty_l)
		return
	for item in eligible:
		var key: = _suit_dismantle_selection_key(item)
		var is_selected: = bool(selected_map.get(key, false))
		var reward: Dictionary = _get_suit_dismantle_reward_preview(item)
		var detail_text: = "+%s x%d" % [str(reward.get("stone_name", "")), int(reward.get("count", 0))]
		var card: = _create_batch_dismantle_candidate_row(str(item.name), detail_text, is_selected)
		TouchScrollUtils.bind_tap(card, func():
			if selected_map.has(key):
				selected_map.erase(key)
			else:
				selected_map[key] = true
			if is_instance_valid(selection_label):
				selection_label.text = "已选 %d 件" % selected_map.size()
			if is_instance_valid(confirm_btn):
				confirm_btn.disabled = selected_map.size() <= 0
			_rebuild_suit_dismantle_candidate_list(list_box, eligible, selected_map, selection_label, confirm_btn)
		)
		list_box.add_child(card)

