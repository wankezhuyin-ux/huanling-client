func _confirm_pet_batch_release(pet_list: Array, on_close_parent: Callable = Callable()) -> void :
	var ids: Array = []
	for pet in pet_list:
		if pet == null:
			continue
		var pid: = _pet_batch_selection_key(pet)
		if pid.is_empty():
			continue
		ids.append(pid)
	if ids.is_empty():
		_show_simple_dialog("放生失败", "没有可放生的宠物")
		return
	for pet in pet_list:
		if pet != null and not DiscardProtection.is_batch_release_pet_allowed(pet):
			_show_simple_dialog("放生失败", "批量放生仅允许选择1级且成长低于6的宠物")
			return
	var total_owned: = _get_total_owned_pet_count()
	if ids.size() >= total_owned:
		_show_simple_dialog("放生失败", "至少需要保留一只宠物")
		return
	if not game_manager.network or not game_manager.network.is_logged_in():
		_show_simple_dialog("放生失败", "需要联网后才能放生宠物")
		return
	if not bool(game_manager.is_cloud_sync_ready()):
		_show_simple_dialog("放生失败", "出战宠物状态同步中，请稍后再试")
		return
	var on_confirm: = func():
		if on_close_parent.is_valid():
			on_close_parent.call()
		_pending_pet_release_ids = ids.duplicate()
		if game_manager.has_method("begin_pet_bag_op_cloud_sync"):
			game_manager.begin_pet_bag_op_cloud_sync()
		var op_id: = "pet_release_batch_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
		game_manager.network.request_pet_release_batch(ids, op_id)
	_show_batch_dismantle_confirm_popup(
		"宠物批量放生确认", 
		"将放生 %d 只宠物，此操作不可恢复" % ids.size(), 
		on_confirm, 
		"确认放生", 
		"⚠ 放生后不可恢复"
	)

func _show_pet_batch_release_result(result: Dictionary) -> void :
	var count: = int(result.get("committedCount", 0))
	var summary: = "成功放生 %d 只宠物" % count
	_show_batch_dismantle_result_popup("放生结果", summary, result.get("items", []), func(item: Dictionary) -> String:
		return "· %s" % str(item.get("petName", ""))
	)

func _on_pet_release_batch_success(data: Dictionary) -> void :
	if game_manager and game_manager.has_method("end_pet_bag_op_cloud_sync"):
		game_manager.end_pet_bag_op_cloud_sync()
	if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(data.get("saveData"), {"pets_authoritative": true, "skip_deferred_cloud_save": true, "skip_pet_collection_trim": true})
		game_manager.save_game(false)
	_pending_pet_release_ids.clear()
	_refresh_pet_list_view()
	_update_pet_view()
	var result_var: Variant = data.get("result", {})
	if result_var is Dictionary:
		_show_pet_batch_release_result(result_var)

func _on_pet_release_batch_failed(error: String) -> void :
	if game_manager and game_manager.has_method("end_pet_bag_op_cloud_sync"):
		game_manager.end_pet_bag_op_cloud_sync()
	_pending_pet_release_ids.clear()
	_show_simple_dialog("放生失败", str(error))

