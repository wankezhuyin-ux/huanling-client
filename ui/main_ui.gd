func _build_player_character_avatar_cell(character_id: int, current_id: int, preview_id: int) -> Control:
	var wrap: = PanelContainer.new()
	wrap.custom_minimum_size = Vector2(68, 88)
	wrap.add_theme_stylebox_override("panel", UIStyle.create_selectable_item_style(character_id == preview_id))
	var vbox: = VBoxContainer.new()
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 2)
	# 子节点不吃点击：Container / Label 默认可能 STOP，把点击揽住后
	# 外面 wrap 的 gui_input 就永远收不到 —— 表现为"点了头像框没反应"。
	vbox.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wrap.add_child(vbox)
	var tex_rect: = TextureRect.new()
	tex_rect.custom_minimum_size = Vector2(56, 56)
	tex_rect.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	tex_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tex_rect.texture = _get_player_avatar_texture(character_id)
	tex_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(tex_rect)
	var tag: = Label.new()
	if character_id == current_id:
		tag.text = "当前"
	else:
		tag.text = PlayerCharacterConfig.get_display_name(character_id)
	tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	tag.add_theme_font_size_override("font_size", 12)
	tag.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
	tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(tag)
	# 真机是触摸事件（InputEventScreenTouch），只认 InputEventMouseButton 的话
	# 手机点头像格可能没反应；两种都收。
	wrap.gui_input.connect( func(event: InputEvent) -> void :
		if event is InputEventMouseButton:
			var mb: = event as InputEventMouseButton
			if mb.pressed and mb.button_index == MOUSE_BUTTON_LEFT:
				_update_player_character_popup_preview(character_id)
		elif event is InputEventScreenTouch:
			if (event as InputEventScreenTouch).pressed:
				_update_player_character_popup_preview(character_id)
	)
	wrap.set_meta("character_id", character_id)
	return wrap

