func _get_eligible_pet_soul_candidates(element: String) -> Array:
	var out: Array = []
	if not game_manager or not game_manager.pet_manager:
		return out
	for pet in game_manager.pet_manager.pets:
		if pet == null:
			continue
		if str(pet.element) != element:
			continue
		if pet.locked:
			continue
		if game_manager.pet_manager.active_pet == pet:
			continue
		if not _is_pet_soul_candidate(pet):
			continue
		out.append(pet)
	out.sort_custom( func(a, b): return float(a.total_growth) > float(b.total_growth))
	return out

func _get_pet_soul_runtime_cfg() -> Dictionary:
	if game_manager and game_manager.has_method("get_pet_soul_runtime_config"):
		return game_manager.get_pet_soul_runtime_config()
	return {}

func _is_pet_soul_rule_b(pet) -> bool:
	if pet == null:
		return false
	var cfg: = _get_pet_soul_runtime_cfg()
	var lv: = int(pet.level)
	var gen: = int(pet.generation)
	var growth: = float(pet.total_growth)
	var is_evolution_pet: = bool(pet.is_evolution_pet)
	var max_lv: int = pet.get_effective_max_level()
	var growth_min_rule: float = float(cfg.get("ruleBGrowthMinEvolution", 50.0)) if is_evolution_pet else float(cfg.get("ruleBGrowthMinNormal", 45.0))
	var growth_max_rule: float = float(cfg.get("ruleBGrowthMax", 100.0))
	if is_evolution_pet and str(pet.form).strip_edges() != "终极":
		return false
	return gen == 3 and lv == max_lv and growth >= growth_min_rule and growth <= growth_max_rule

func _is_pet_soul_candidate(pet) -> bool:
	if pet == null:
		return false
	var cfg: = _get_pet_soul_runtime_cfg()
	var lv: = int(pet.level)
	var gen: = int(pet.generation)
	var growth: = float(pet.total_growth)
	var is_evolution_pet: = bool(pet.is_evolution_pet)
	var form_text: = str(pet.form).strip_edges()
	var is_juvenile_evolution_pet: = is_evolution_pet and form_text == "幼年"
	var is_non_evolution_pet: = not is_evolution_pet
	var rule_a_min: float = float(cfg.get("ruleAGrowthMin", 6.0))
	var rule_a: = (lv == 1 and gen == 0 and growth >= rule_a_min and (is_juvenile_evolution_pet or is_non_evolution_pet))
	return rule_a or _is_pet_soul_rule_b(pet)

func _create_pet_soul_candidate_item(pet, is_selected: bool = false) -> Control:
	var is_rule_b: = _is_pet_soul_rule_b(pet)
	var element_color: = _pet_soul_element_color(str(pet.element))
	var card: = PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.custom_minimum_size = Vector2(0, 78)
	var card_style: = UIStyle.create_item_style()
	if is_selected:
		card_style = UIStyle.create_selectable_item_style(true)
		card_style.border_color = Color(0.35, 0.85, 1.0, 0.95)
	elif is_rule_b:
		card_style = UIStyle.create_selectable_item_style(false)
		card_style.border_color = Color(0.75, 0.62, 0.28, 0.85)
	card_style.content_margin_left = 10
	card_style.content_margin_right = 10
	card_style.content_margin_top = 8
	card_style.content_margin_bottom = 8
	card.add_theme_stylebox_override("panel", card_style)

	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(row)

	var check_box: = CheckBox.new()
	check_box.button_pressed = is_selected
	check_box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	check_box.focus_mode = Control.FOCUS_NONE
	row.add_child(check_box)

	var pet_texture = AssetManager.get_instance().get_pet_texture(pet.pet_id)
	if pet_texture:
		var icon: = TextureRect.new()
		icon.texture = pet_texture
		icon.custom_minimum_size = Vector2(56, 56)
		icon.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		row.add_child(icon)
	else:
		var icon_fallback: = ColorRect.new()
		icon_fallback.custom_minimum_size = Vector2(56, 56)
		icon_fallback.color = element_color
		row.add_child(icon_fallback)

	var info_v: = VBoxContainer.new()
	info_v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info_v.add_theme_constant_override("separation", 4)

	var cfg: = _get_pet_soul_runtime_cfg()
	var growth: = float(pet.total_growth)
	var pts_min: = int(cfg.get("ruleBPointsMin", 40))
	var pts_max: = int(cfg.get("ruleBPointsMax", 60))
	var points_preview_text: = ""
	if is_rule_b:
		points_preview_text = "随机 +%d~%d 魂点" % [pts_min, pts_max]
		if bool(cfg.get("rebirthEnabled", true)):
			points_preview_text += " · 可能触发重生"
	elif game_manager and game_manager.pet_soul_manager:
		points_preview_text = "+%d 魂点" % int(game_manager.pet_soul_manager.growth_to_points(growth))
	else:
		points_preview_text = "+0 魂点"

	var quality_text: = _get_pet_quality_bracket_text(pet)
	var name_row: = HBoxContainer.new()
	name_row.add_theme_constant_override("separation", 6)
	var name_l: = Label.new()
	name_l.text = "%s%s Lv.%d %d代" % [pet.pet_name, quality_text, int(pet.level), int(pet.generation)]
	name_l.add_theme_font_size_override("font_size", 16)
	if _get_pet_mutation_count(pet) > 0:
		name_l.add_theme_color_override("font_color", _get_pet_name_quality_color(pet))
	else:
		name_l.add_theme_color_override("font_color", element_color)
	name_row.add_child(name_l)
	if is_rule_b:
		var tag: = Label.new()
		tag.text = "成品"
		tag.add_theme_font_size_override("font_size", 12)
		tag.add_theme_color_override("font_color", Color(1, 0.82, 0.35))
		name_row.add_child(tag)
		if bool(cfg.get("rebirthEnabled", true)):
			var rebirth_tag: = Label.new()
			rebirth_tag.text = "可重生"
			rebirth_tag.add_theme_font_size_override("font_size", 12)
			rebirth_tag.add_theme_color_override("font_color", Color(0.65, 0.85, 1.0))
			name_row.add_child(rebirth_tag)
	info_v.add_child(name_row)

	var detail_l: = Label.new()
	detail_l.text = "成长 %.3f  ·  %s" % [growth, points_preview_text]
	detail_l.add_theme_font_size_override("font_size", 13)
	detail_l.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
	info_v.add_child(detail_l)
	row.add_child(info_v)
	return card

func _confirm_pet_soul_commit_batch(pets: Array, element: String, on_close_parent: Callable = Callable()) -> void :
	var live_pets: Array = []
	for pet in pets:
		var live_pet = _resolve_live_pet(pet)
		if live_pet != null:
			live_pets.append(live_pet)
	if live_pets.is_empty():
		_show_simple_dialog("投入失败", "宠物已不存在，请刷新后重试。")
		return
	if not network or not network.is_logged_in():
