func _load_assist_ui_texture(path: String) -> Texture2D:
	if path.is_empty():
		return null

	var tex: Texture2D = load(path) as Texture2D
	if tex != null:
		return tex
	if FileAccess.file_exists(path):
		var img: = Image.new()
		if img.load(path) == OK:
			return ImageTexture.create_from_image(img)
	push_warning("[Assist] 背景加载失败: %s" % path)
	return null


