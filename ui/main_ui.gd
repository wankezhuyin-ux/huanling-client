## 把选中物品的摘要写进详情条。item 可以是背包物品 / 装备对象 / 聚合 Dictionary
func _update_bag_detail_bar_item(item) -> void:
	if _bag_detail_bar == null or not is_instance_valid(_bag_detail_bar):
		return
	_bag_detail_item = item
	var display_name: = ""
	var count: = 1
	var rarity: = "common"
	var desc: = ""
	var tex: Texture2D = null
	var meta: = ""
	var is_aggregate: bool = item is Dictionary and str(item.get("entry_kind", "")) == "limit_material_aggregate"

	if is_aggregate:
		display_name = str(item.get("name", "极限材料"))
		count = int(item.get("count", 0))
		var rep = item.get("representative_item", null)
		rarity = str(rep.get("rarity", "common")) if rep is Dictionary else "common"
		desc = "同源极限材料聚合，点「详情」拆开使用"
		tex = InventoryIconHelper.category_icon_for_inventory_item(rep)
		meta = "聚合材料 · ×%d" % count
	elif item is Dictionary:
		display_name = str(item.get("name", ""))
		count = int(item.get("count", 1))
		tex = InventoryIconHelper.category_icon_for_inventory_item(item)
		meta = "物品 · ×%d" % count
	elif "slot" in item or "is_suit" in item:
		# 装备对象：属性加成拼一句描述
		display_name = str(item.name)
		count = 1
		rarity = str(item.rarity) if "rarity" in item else "common"
		tex = InventoryIconHelper.resolve_equipment_icon(item)
		var parts: = PackedStringArray()
		if "attack" in item and item.attack != 0:
			parts.append("攻击%+d" % item.attack)
		if "defense" in item and item.defense != 0:
			parts.append("防御%+d" % item.defense)
		if "hp" in item and item.hp != 0:
			parts.append("生命%+d" % item.hp)
		if "mp" in item and item.mp != 0:
			parts.append("内力%+d" % item.mp)
		if "agility" in item and item.agility != 0:
			parts.append("敏捷%+d" % item.agility)
		desc = " ".join(parts) if parts.size() > 0 else "装备"
		if "is_sealed" in item and item.is_sealed:
			desc = "封印套装 · " + desc
		meta = "装备" + (" · ×%d" % count if count > 1 else "")
	else:
		# 普通背包物品
		display_name = str(item.name)
		count = int(item.count) if "count" in item else 1
		var item_data = GameData.ALL_ITEMS.get(item.name, {})
		if item_data is Dictionary:
			if item_data.has("name"):
				display_name = str(item_data.get("name", display_name))
			rarity = str(item_data.get("rarity", "common"))
			desc = str(item_data.get("desc", ""))
		if "rarity" in item:
			rarity = str(item.rarity)
		meta = "物品 · ×%d" % count

	var accent: = InventoryIconHelper.rarity_border_color(rarity)
	if tex == null and item != null:
		tex = InventoryIconHelper.category_icon_for_item_type(_get_bag_item_type(item))
	_bag_detail_icon.texture = tex
	_bag_detail_icon.visible = tex != null
	_bag_detail_name.text = display_name
	_bag_detail_name.add_theme_color_override("font_color", accent)
	_bag_detail_meta.text = meta
	_bag_detail_desc.text = desc
	_bag_detail_more.visible = item != null
	_bag_detail_bar.visible = true
## 战斗统计条：设计稿在战斗区下方、战报上方那条四格数据。
## 只做展示，不参与结算；数值全部从本节点累计（不写进 battle_system，避免存档污染）。
func _ensure_battle_stats_strip(battle_panel: Panel) -> void:
	if _bst_bar != null and is_instance_valid(_bst_bar):
		return
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	# 放在"⚔ 战斗区域"标题条右侧的空白里：不进战斗区，就不会压住最下面那只怪的血条。
	# 之前试过横跨底部（设计稿的位置），9:16 屏上战斗区太矮，一定会盖住单位。
	_bst_bar = Panel.new()
	_bst_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_bst_bar.z_index = 30
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.052, 0.046, 0.033, 0.62)
	st.border_color = Color(0.788, 0.635, 0.294, 0.26)
	st.set_border_width_all(hair)
	st.set_corner_radius_all(0)
	_bst_bar.add_theme_stylebox_override("panel", st)
	battle_panel.add_child(_bst_bar)
	_bst_bar.anchor_left = 1.0
	_bst_bar.anchor_right = 1.0
	_bst_bar.anchor_top = 0.0
	_bst_bar.anchor_bottom = 0.0
	_bst_bar.offset_left = -486.0
	_bst_bar.offset_right = -12.0
	_bst_bar.offset_top = 4.0
	_bst_bar.offset_bottom = 44.0

	var row: = HBoxContainer.new()
	row.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	row.offset_left = 8.0 * s
	row.offset_right = -8.0 * s
	row.alignment = BoxContainer.ALIGNMENT_END
	row.add_theme_constant_override("separation", 0)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_bst_bar.add_child(row)

	_bst_labels.clear()
	var specs: = [["累计输出", "0"], ["每秒伤害", "0"], ["战斗时长", "00:00"], ["累计经验", "0"]]
	for i in range(specs.size()):
		if i > 0:
			var sep: = ColorRect.new()
			sep.color = Color(0.788, 0.635, 0.294, 0.16)
			sep.custom_minimum_size = Vector2(hair, 0)
			sep.mouse_filter = Control.MOUSE_FILTER_IGNORE
			row.add_child(sep)
		var cell: = HBoxContainer.new()
		cell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		cell.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cell.alignment = BoxContainer.ALIGNMENT_CENTER
		cell.add_theme_constant_override("separation", int(round(5.0 * s)))
		cell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row.add_child(cell)
		cell.add_child(_ink_text(specs[i][0], 14.0, Color(0.60, 0.56, 0.46), false))
		var val: = _ink_text(specs[i][1], 19.0, INK_GOLD_HI, true, true)
		cell.add_child(val)
		_bst_labels.append(val)


func _refresh_battle_stats() -> void:
	if _bst_bar == null or not is_instance_valid(_bst_bar) or _bst_labels.size() < 4:
		return
	if game_manager == null or game_manager.battle_system == null:
		return
	var bs = game_manager.battle_system
	var round_now: = int(bs.current_round)
	# 新一场：回合从 1 重新开始，把上一场的累计清零
	if round_now <= 1 and _bst_round > 1:
		_bst_damage = 0
		_bst_exp_total = 0
		_bst_exp_last = -1
		_bst_start_ms = Time.get_ticks_msec()
	if _bst_start_ms <= 0:
		_bst_start_ms = Time.get_ticks_msec()
	_bst_round = round_now
	var elapsed: = maxf(0.0, float(Time.get_ticks_msec() - _bst_start_ms) / 1000.0)
	var dps: = int(float(_bst_damage) / elapsed) if elapsed >= 1.0 else 0
	_bst_labels[0].text = _format_big_number(_bst_damage)
	_bst_labels[1].text = _format_big_number(dps)
	_bst_labels[2].text = "%02d:%02d" % [int(elapsed) / 60, int(elapsed) % 60]
	# 第 4 格按设计稿的"经验·分钟"来：这场仗已经吃到多少经验。
	# 升级会把 experience 清零，所以只累加非负增量，掉级/清零时重设基准不累加。
	var player = game_manager.player
	if player != null:
		var cur_exp: = int(player.experience)
		if cur_exp >= _bst_exp_last and _bst_exp_last >= 0:
			_bst_exp_total += cur_exp - _bst_exp_last
		_bst_exp_last = cur_exp
		_bst_labels[3].text = _format_big_number(_bst_exp_total)


## ── 灵兽图鉴 ─────────────────────────────────────────────────────────
## 设计稿里这是一整页（收录进度 + 总进度条 + 四列卡片），实装原本只有角色页
## 一行「五行图鉴进度」。数据现成：PetCollectionManager 里每只灵兽的 count/50。
func _show_pet_atlas_page() -> void:
	if _atlas_page != null and is_instance_valid(_atlas_page):
		_atlas_page.visible = true
		_atlas_page.move_to_front()
		_rebuild_pet_atlas_grid()
		return
	var s: = _ink_s()
	_atlas_page = Control.new()
	_atlas_page.name = "PetAtlasPage"
	# 60 会被战斗飘字/横幅（BATTLE_BANNER_LAYER_Z_INDEX=100）盖住 ——
	# 挂机打着怪点开图鉴，伤害气泡和「溅射」会浮在这一页上面。整页浮层要压过 100。
	_atlas_page.z_index = 120
	_atlas_page.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(_atlas_page)
	# ⚠️ MainUI 根的 size 可能是 (0,0)（跟弹窗遮罩同一个坑）：
	# FULL_RECT 算出来是 0×0，表现就是"打开了一片透明的空气"。按视口定尺寸。
	_atlas_page.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	_atlas_page.position = Vector2.ZERO
	_fit_atlas_page()
	var vp: = get_viewport()
	if vp != null and not vp.size_changed.is_connected(_fit_atlas_page):
		vp.size_changed.connect(_fit_atlas_page)

	var shell: = Panel.new()
	shell.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	shell.offset_left = 10.0 * s
	shell.offset_top = 8.0 * s
	shell.offset_right = -10.0 * s
	# 底部只留 2 设计像素缝隙：页面本身已经铺到底栏顶边（见 _fit_atlas_page），
	# 这里不用再让一整个 dock 的高度，否则面板会浮在半空、底下空一大块。
	shell.offset_bottom = -2.0 * s
	var st: = StyleBoxFlat.new()
	# 整页必须不透明：0.965 的底会把下面的灵兽名录透出来（八角头像 + 等级），
	# 从宠物页进来时看着像残影；图鉴是独立一页，没有透背景的需求。
	st.bg_color = Color(0.040, 0.036, 0.026, 1.0)
	st.border_color = Color(0.788, 0.635, 0.294, 0.55)
	st.set_border_width_all(maxi(1, int(round(1.0 * s))))
	st.set_corner_radius_all(0)
	shell.add_theme_stylebox_override("panel", st)
	_atlas_page.add_child(shell)
	_ink_add_inner_line(shell, 5.0, 0.24)

	var root: = VBoxContainer.new()
	root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.offset_left = 14.0 * s
	root.offset_top = 10.0 * s
	root.offset_right = -14.0 * s
	root.offset_bottom = -10.0 * s
	root.add_theme_constant_override("separation", int(round(8.0 * s)))
	shell.add_child(root)

	# ① 标题行：返回 / 标题 / 共 N 种 / 投喂设置
	# ⚠️ 尺寸口径：_ink_s() 在 720 宽的视口里恒为 0.70（设计稿按 1024 画），
	# 所以这里的设计字号比"看着像 20 号"要大 1.45 倍，换算成画布像素才等于
	# 旧图鉴 / 主城各页的 20 号字。之前按 18/15 写，真机上只有 12 号，字小到看不清。
	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", int(round(14.0 * s)))
	root.add_child(head)
	var back: = Button.new()
	back.text = "‹ 返回"
	back.focus_mode = Control.FOCUS_NONE
	# 和主城各二级页的返回键同尺寸（110×40 画布像素）
	back.custom_minimum_size = Vector2(150.0 * s, 56.0 * s)
	_ink_outline_button(back, _ink_font(28.0))
	back.pressed.connect( func(): _close_pet_atlas_page())
	head.add_child(back)
	var title_lbl: = _ink_text("灵兽图鉴", 42.0, INK_GOLD_HI, true, true)
	title_lbl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(title_lbl)
	var head_sp: = Control.new()
	head_sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head.add_child(head_sp)
	var total_ids: = _atlas_all_ids()
	var total_label: = _ink_text("共 %d 种" % total_ids.size(), 25.0, Color(0.62, 0.58, 0.48), false)
	total_label.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(total_label)
	var feed_cfg: = Button.new()
	feed_cfg.text = "投喂设置"
	feed_cfg.focus_mode = Control.FOCUS_NONE
	feed_cfg.custom_minimum_size = Vector2(196.0 * s, 56.0 * s)
	_ink_outline_button(feed_cfg, _ink_font(27.0))
	feed_cfg.pressed.connect( func(): _show_pet_atlas_feed_settings())
	head.add_child(feed_cfg)

	# ② 收录进度 + 三个筛选项
	var prow: = HBoxContainer.new()
	prow.add_theme_constant_override("separation", int(round(14.0 * s)))
	root.add_child(prow)
	_atlas_progress_label = _ink_text("收录进度 0 / %d" % total_ids.size(), 32.0, INK_GOLD_HI, true)
	_atlas_progress_label.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	prow.add_child(_atlas_progress_label)
	var psp: = Control.new()
	psp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	prow.add_child(psp)
	_atlas_filter_buttons.clear()
	for spec in [["all", "全部"], ["collected", "已收录"], ["missing", "未收录"]]:
		var key: String = spec[0]
		var b: = Button.new()
		b.text = spec[1]
		b.focus_mode = Control.FOCUS_NONE
		b.toggle_mode = false
		b.set_meta("filter_key", key)
		b.custom_minimum_size = Vector2(0, 56.0 * s)
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		_apply_atlas_chip_style(b, key == _atlas_filter)
		b.pressed.connect( func(): _set_atlas_filter(key))
		prow.add_child(b)
		_atlas_filter_buttons.append(b)

	# ③ 五行筛选：288 种灵兽，只靠"已收录/未收录"翻不动。
	# 尺寸照旧图鉴（宠物园那版）的 60×35 / 20 号，六个一排放得下。
	var frow: = HBoxContainer.new()
	frow.add_theme_constant_override("separation", int(round(8.0 * s)))
	root.add_child(frow)
	# 两行里都有「全部」，前面加个「五行」说明这两个全是不同维度
	var el_cap: = _ink_text("五行", 24.0, Color(0.62, 0.58, 0.48), false)
	el_cap.size_flags_vertical = Control.SIZE_SHRINK_CENTER
