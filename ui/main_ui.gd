	if game_manager == null or game_manager.player == null:
		return
	var popup_key: = "battle_stance"
	if _focus_existing_popup(popup_key):
		_refresh_battle_stance_popup_buttons(_find_existing_window_popup(popup_key))
		return
	var dialog: = Window.new()
	_mark_popup_key(dialog, popup_key)
	dialog.title = ""
	dialog.size = Vector2i(460, 420)
	dialog.transparent = true
	dialog.borderless = true
	dialog.unresizable = true
	var close_dialog_once: = func():
		if not is_instance_valid(dialog):
			return
		if dialog.has_meta("closed"):
			return
		dialog.set_meta("closed", true)
		dialog.queue_free()
	dialog.close_requested.connect(close_dialog_once)

	var main_panel: = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	dialog.add_child(main_panel)

	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 22
	vbox.offset_top = 22
	vbox.offset_right = -22
	vbox.offset_bottom = -22
	vbox.add_theme_constant_override("separation", 16)
	main_panel.add_child(vbox)

	var title_label: = Label.new()
	title_label.text = "战斗策略"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 24)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title_label)

	var hint: = Label.new()
	hint.name = "StanceHint"
	hint.text = "人物和宠物可分别攻击或防御，同时只能有一方防御。"
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	hint.add_theme_font_size_override("font_size", 16)
	hint.add_theme_color_override("font_color", Color(0.85, 0.88, 0.92))
	vbox.add_child(hint)

	var choice_map: = {}
	vbox.add_child(_make_battle_stance_row("人物", "player", choice_map, hint))
	vbox.add_child(_make_battle_stance_row("宠物", "pet", choice_map, hint))
	dialog.set_meta("stance_choice_map", choice_map)
	dialog.set_meta("stance_hint", hint)

	var close_wrap: = CenterContainer.new()
	close_wrap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_child(close_wrap)
	var close_btn: = Button.new()
	close_btn.text = "关闭"
	UIStyle.style_popup_button(close_btn, true)
	close_btn.pressed.connect(close_dialog_once)
	close_wrap.add_child(close_btn)

	_refresh_battle_stance_popup_buttons(dialog)
	_present_modal_window(dialog)

func _make_battle_stance_row(title: String, side: String, choice_map: Dictionary, hint: Label) -> VBoxContainer:
	var row: = VBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	var name_lbl: = Label.new()
	name_lbl.text = title
	name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_lbl.add_theme_font_size_override("font_size", 18)
	name_lbl.add_theme_color_override("font_color", Color(1.0, 0.96, 0.82))
	row.add_child(name_lbl)
	var hbox: = HBoxContainer.new()
	hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	hbox.add_theme_constant_override("separation", 16)
	row.add_child(hbox)
	var attack_btn: = Button.new()
	attack_btn.text = "攻击"
	attack_btn.custom_minimum_size = Vector2(160, 52)
	attack_btn.pressed.connect(_on_battle_stance_choice_pressed.bind(side, Player.BATTLE_STANCE_ATTACK, hint))
	hbox.add_child(attack_btn)
	var defend_btn: = Button.new()
	defend_btn.text = "防御"
	defend_btn.custom_minimum_size = Vector2(160, 52)
	defend_btn.pressed.connect(_on_battle_stance_choice_pressed.bind(side, Player.BATTLE_STANCE_DEFEND, hint))
	hbox.add_child(defend_btn)
	choice_map[side] = {"attack": attack_btn, "defend": defend_btn}
	return row

func _on_battle_stance_choice_pressed(side: String, stance: String, hint: Label) -> void :
	if game_manager == null or game_manager.player == null:
		return
	var blocked: = _battle_stance_blocked_reason()
	if not blocked.is_empty():
		_show_simple_dialog("策略", blocked)
		return
	var switched: bool = bool(game_manager.player.set_battle_stance(side, stance))
	game_manager.save_game(true, "battle_stance")
	if switched and hint != null and is_instance_valid(hint):
		hint.text = "同时只能有一方防御"
		hint.add_theme_color_override("font_color", Color(1.0, 0.82, 0.35))
	_refresh_battle_stance_popup_buttons(_find_existing_window_popup("battle_stance"))

func _refresh_battle_stance_popup_buttons(dialog: Window) -> void :
	if dialog == null or not is_instance_valid(dialog) or game_manager == null or game_manager.player == null:
		return
	var p = game_manager.player
	p.clamp_battle_stances()
	var choice_map = dialog.get_meta("stance_choice_map", {})
	if not choice_map is Dictionary:
		return
	_style_battle_stance_choice_pair(choice_map.get("player", {}), str(p.battle_stance_player))
	_style_battle_stance_choice_pair(choice_map.get("pet", {}), str(p.battle_stance_pet))

func _style_battle_stance_choice_pair(pair, selected: String) -> void :
	if not pair is Dictionary:
		return
	var attack_btn = pair.get("attack")
	var defend_btn = pair.get("defend")
	if attack_btn is Button:
		_style_battle_stance_choice_button(attack_btn, str(selected) != Player.BATTLE_STANCE_DEFEND)
	if defend_btn is Button:
		_style_battle_stance_choice_button(defend_btn, str(selected) == Player.BATTLE_STANCE_DEFEND)

func _style_battle_stance_choice_button(btn: Button, is_active: bool) -> void :
	if btn == null:
		return
	btn.custom_minimum_size = Vector2(160, 52)
	btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	btn.add_theme_font_size_override("font_size", 18)
	var style: = StyleBoxFlat.new()
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.corner_radius_top_left = 10
	style.corner_radius_top_right = 10
	style.corner_radius_bottom_left = 10
	style.corner_radius_bottom_right = 10
	if is_active:
		style.bg_color = Color(0.78, 0.56, 0.12, 0.96)
		style.border_color = Color(1.0, 0.86, 0.32, 1)
		btn.add_theme_color_override("font_color", Color(1.0, 0.97, 0.82, 1))
		btn.add_theme_color_override("font_hover_color", Color(1.0, 0.98, 0.9, 1))
		btn.add_theme_color_override("font_pressed_color", Color(1.0, 0.94, 0.75, 1))
	else:
		style.bg_color = Color(0.055, 0.065, 0.068, 0.35)
		style.border_color = Color(0.42, 0.44, 0.48, 0.35)
		btn.add_theme_color_override("font_color", Color(0.62, 0.64, 0.68, 0.85))
		btn.add_theme_color_override("font_hover_color", Color(0.78, 0.8, 0.84, 0.95))
		btn.add_theme_color_override("font_pressed_color", Color(0.7, 0.72, 0.76, 0.9))
	var hover: = style.duplicate() as StyleBoxFlat
	if is_active:
		hover.bg_color = Color(0.86, 0.64, 0.16, 0.98)
	else:
		hover.bg_color = Color(0.22, 0.24, 0.28, 0.5)
	btn.add_theme_stylebox_override("normal", style)
	btn.add_theme_stylebox_override("hover", hover)
	btn.add_theme_stylebox_override("pressed", hover)
	btn.add_theme_stylebox_override("disabled", style)

