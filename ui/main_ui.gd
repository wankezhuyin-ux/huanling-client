	_fabao_fill_reroll_compare_lines(cols, pending)
	var popup_ref = popup
	var apply_btn = _popup_fixed_btn("应用本次洗练", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	apply_btn.pressed.connect( func():
		if not _fabao_reroll_ui.is_empty():
