func _show_batch_use_dialog(item):
	if item != null and item.item_type in ["pet_skill_book", "martial_skill_book"]:
		_show_simple_dialog("提示", "技能书请逐本使用")
		return
	if game_manager == null or game_manager.network == null or not game_manager.network.is_logged_in():
		_show_simple_dialog("无法使用", "使用道具需登录并联网，请先登录后再试")
		return
	if _inventory_item_disallows_batch_use(item):
		var n: = str(item.name).strip_edges() if item else ""
		_show_simple_dialog("提示", "%s不支持批量使用，请逐个点击「使用」。" % n)
		return
	var item_name_for_cap: = str(item.name).strip_edges() if item else ""
	if InventoryManager.CULTIVATION_PILL_WHITELIST_KEYS.has(item_name_for_cap):
		if game_manager.player == null:
			_show_simple_dialog("无法使用", "玩家数据未初始化")
			return
		var life_left: = maxi(0, int(game_manager.player.MAX_CULTIVATION_PILLS_PER_LIFE) - int(game_manager.player.cultivation_pills_used))
		if life_left <= 0:
			_show_simple_dialog(item_name_for_cap, "本世额度已用尽（每世最多5颗），本次未使用。\n投胎后可继续服用。")
			return
	var dialog = Window.new()
	dialog.title = "批量使用 %s" % item.name
	dialog.size = Vector2(350, 250)
	dialog.borderless = true
	dialog.transparent = true
	dialog.unresizable = true
	dialog.close_requested.connect( func(): dialog.queue_free())

	var panel = Panel.new()
	panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())

	var vbox = VBoxContainer.new()
