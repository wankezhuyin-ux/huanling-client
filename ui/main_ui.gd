	popup.set_meta("fabao_reroll_id", str(pending.get("fabaoId", pending.get("fabao_id", ""))))
	var title: = Label.new()
	title.text = "法宝洗练预览"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	vbox.add_child(title)
	var hint: = Label.new()
	hint.text = "已消耗1枚法宝洗练石。应用后覆盖词条数值，放弃则保持原数值（石头不退）。\n%s" % _fabao_reroll_stone_remain_text()
	hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	hint.add_theme_font_size_override("font_size", 13)
	hint.add_theme_color_override("font_color", Color(0.75, 0.76, 0.82))
	vbox.add_child(hint)
	var scroll: = ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
