func _assist_help_rate_pcts() -> Dictionary:
	var rates: Dictionary = PetAssistBonus._get_rates()
	var base_pct: float = float(rates.get("baseRate", PetAssistBonus.DEFAULT_BASE_RATE)) * 100.0
	var special_extra_pct: float = float(rates.get("specialTypeRate", PetAssistBonus.DEFAULT_SPECIAL_TYPE_RATE)) * 100.0
	var custom_extra_pct: float = float(rates.get("sponsorCustomRate", PetAssistBonus.DEFAULT_SPONSOR_CUSTOM_RATE)) * 100.0
	var mut_pct: float = float(rates.get("mutationRatePerCount", PetAssistBonus.DEFAULT_MUTATION_RATE_PER_COUNT)) * 100.0
	return {
		"base": base_pct, 
		"special_extra": special_extra_pct, 
		"special_total": base_pct + special_extra_pct, 
		"custom_extra": custom_extra_pct, 
		"custom_total": base_pct + custom_extra_pct, 
		"mutation": mut_pct, 
	}

