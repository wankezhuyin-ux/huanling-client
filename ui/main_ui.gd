func _ensure_modal_canvas_layer() -> CanvasLayer:
	if _modal_canvas_layer and is_instance_valid(_modal_canvas_layer):
		return _modal_canvas_layer
	_modal_canvas_layer = CanvasLayer.new()
	_modal_canvas_layer.name = "ModalCanvasLayer"
	_modal_canvas_layer.layer = MODAL_CANVAS_LAYER
	add_child(_modal_canvas_layer)
	return _modal_canvas_layer

func _center_control_in_viewport(control: Control) -> void :
	control.reset_size()
	var viewport_size: = get_viewport().get_visible_rect().size
	control.global_position = (viewport_size - control.size) / 2

func _present_modal_panel(panel: Control) -> void :
	var layer: = _ensure_modal_canvas_layer()
	layer.add_child(panel)
