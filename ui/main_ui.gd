		content_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		content_l.add_theme_font_size_override("normal_font_size", 15)
		content_l.add_theme_color_override("default_color", Color(0.84, 0.9, 1.0))
		content_l.text = str(item.content)
		block.add_child(content_l)
		rules_box.add_child(block)

	add_child(popup)
	popup.popup_centered()

func _build_pet_soul_view() -> void :
	if pet_soul_container == null:
		return
	_clear_container_immediate(pet_soul_container)
	_pet_soul_element_buttons.clear()
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	var usable_width: float = max(320.0, viewport_size.x - 80.0)
	var stage_width: float = min(760.0, usable_width)
	var stage_height: float = 640.0
	var root = VBoxContainer.new()
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.size_flags_vertical = Control.SIZE_EXPAND_FILL
	root.add_theme_constant_override("separation", 12)
	pet_soul_container.add_child(root)

	var title = Label.new()
	title.text = "宠物魂魄"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 22)
	title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	root.add_child(title)

	var stage_center = CenterContainer.new()
	stage_center.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	stage_center.size_flags_vertical = Control.SIZE_EXPAND_FILL
	root.add_child(stage_center)

	var graph_panel = Control.new()
	graph_panel.custom_minimum_size = Vector2(stage_width, stage_height)
	graph_panel.size = Vector2(stage_width, stage_height)
	stage_center.add_child(graph_panel)

	var stage_bg = TextureRect.new()
	stage_bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	stage_bg.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	stage_bg.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	stage_bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var stage_bg_tex = load("res://assets/icons/pet_soul/bg_soul_stage.png")
	if stage_bg_tex:
		stage_bg.texture = stage_bg_tex
	graph_panel.add_child(stage_bg)

	var center: Vector2 = Vector2(stage_width / 2.0, stage_height / 2.0)
	var radius: float = min(210.0, stage_width * 0.3)
	var core_size: Vector2 = Vector2(140, 140)
	if stage_width < 620.0:
		core_size = Vector2(120, 120)
	var core_panel = Panel.new()
	core_panel.position = center - core_size / 2.0
	core_panel.custom_minimum_size = core_size
	var core_style: = StyleBoxFlat.new()
	core_style.bg_color = Color(0.065, 0.056, 0.042, 0.72)
	core_style.border_width_left = 2
	core_style.border_width_top = 2
	core_style.border_width_right = 2
	core_style.border_width_bottom = 2
	core_style.border_color = Color(0.45, 0.58, 0.82, 0.9)
	core_style.set_corner_radius_all(int(core_size.x / 2.0))
	core_panel.add_theme_stylebox_override("panel", core_style)
	graph_panel.add_child(core_panel)

	var core_icon = TextureRect.new()
	core_icon.set_anchors_preset(Control.PRESET_FULL_RECT)
	core_icon.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	core_icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	var core_tex = load("res://assets/icons/chongwuhunpo.png")
	if core_tex:
		core_icon.texture = core_tex
	core_panel.add_child(core_icon)

	if core_tex == null:
		var core_fallback = Label.new()
		core_fallback.text = "魂魄核心\n(占位)"
		core_fallback.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		core_fallback.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		core_fallback.set_anchors_preset(Control.PRESET_FULL_RECT)
		core_fallback.add_theme_font_size_override("font_size", 18)
		core_panel.add_child(core_fallback)

	var node_size: float = 106.0
	var node_half: float = node_size / 2.0
	var elements: = [
		{"name": "金", "angle": -90.0}, 
		{"name": "水", "angle": -18.0}, 
		{"name": "土", "angle": 54.0}, 
		{"name": "火", "angle": 126.0}, 
		{"name": "木", "angle": 198.0}
	]
	for item in elements:
		var element: String = item["name"]
		var angle_rad = deg_to_rad(float(item["angle"]))
		var pos = center + Vector2(cos(angle_rad), sin(angle_rad)) * radius
		var btn = Button.new()
		btn.text = ""
