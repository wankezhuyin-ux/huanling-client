func _measure_equip_scroll_raw_width(scroll: Control) -> float:
	if scroll != null and is_instance_valid(scroll) and scroll.size.x > 1.0:
		return float(scroll.size.x)
	if scroll != null and is_instance_valid(scroll):
		var parent_ctrl = scroll.get_parent()
		if parent_ctrl is Control and (parent_ctrl as Control).size.x > 1.0:
			return float((parent_ctrl as Control).size.x)
	return 0.0


func _get_equip_page_content_width(scroll: Control) -> float:
	var raw: = _measure_equip_scroll_raw_width(scroll)
	if raw <= 1.0:
		raw = 360.0
	var usable: = raw - float(EQUIP_PAGE_H_MARGIN * 2) - 14.0
	return maxf(120.0, usable)


func _get_bag_page_content_width(scroll: Control) -> float:
	var raw: = _measure_equip_scroll_raw_width(scroll)
	if raw <= 1.0:
		raw = 360.0
	return maxf(120.0, raw - 14.0)

func _get_visible_bag_scroll() -> Control:
	if bag_item_scroll and bag_item_scroll.visible:
		return bag_item_scroll
	return bag_material_scroll


func _calc_equip_grid_cell_side(available_width: float, cols: int = 6, gap: float = 8.0) -> int:
	return InventoryGridCell.calc_bag_cell_side(available_width, cols, gap)


func _calc_equip_doll_sizes(available_width: float, slot_side: int = -1) -> Dictionary:
	var sep: = 12.0
	var slot: = slot_side if slot_side > 0 else InventoryGridCell.calc_bag_cell_side(available_width, 6)

	var ref_slot: = 72
	if available_width < 380.0:
		ref_slot = 64
	if available_width < 340.0:
		ref_slot = 56
	var reserve: = float(ref_slot * 2) + sep * 2.0 + 8.0
	var center: = int(available_width - reserve)
	center = clampi(center, 160, 256)
	while center > 120 and float(ref_slot * 2) + sep * 2.0 + float(center) > available_width + 0.5:
		center -= 4
	return {"slot": slot, "center": maxi(center, 120)}

## 弹窗外壳：参考稿蓝灰 2px 描边 + 亮色渐变，和墨底金线两套语言。
## 这里保留 UIStyle 的圆角/内边距，只把底、边、影换成宣纸墨色 + 金线。
func _make_popup_outer_style() -> StyleBoxFlat:
	var st: = UIStyle.create_popup_style()
	st.set_border_width_all(maxi(1, int(round(1.0 * _ink_s()))))
	st.border_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.62)
	st.bg_color = Color(0.098, 0.086, 0.063, 0.96)
	st.corner_radius_top_left = 0
	st.corner_radius_top_right = 0
	st.corner_radius_bottom_right = 0
	st.corner_radius_bottom_left = 0
	st.shadow_color = Color(0.0, 0.0, 0.0, 0.55)
	st.shadow_size = 10
	return st

func _iter_popup_search_roots() -> Array:
	var roots: Array = []
	var layer: = _modal_canvas_layer if _modal_canvas_layer and is_instance_valid(_modal_canvas_layer) else null
	if layer:
		roots.append(layer)
	roots.append(self)
	var scene_root = Engine.get_main_loop().current_scene
	if scene_root and scene_root != self:
		roots.append(scene_root)
	return roots

func _close_popups_in_group(group: String) -> void :
	if group.strip_edges().is_empty():
		return
	for root in _iter_popup_search_roots():
		if root == null:
			continue
		for child in root.get_children():
			if child is Window and is_instance_valid(child) and str(child.get_meta("popup_group", "")) == group:
				child.queue_free()

func _open_styled_popup(popup_key: String, group: String, size: Vector2i, content_sep: int = 10) -> Dictionary:
	if _focus_existing_popup(popup_key):
		return {}
	_close_popups_in_group(group)
	var popup: = Window.new()
	_mark_popup_key(popup, popup_key)
	popup.set_meta("popup_group", group)
	popup.title = ""
	popup.size = size
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true
	popup.close_requested.connect( func():
		if is_instance_valid(popup):
			popup.queue_free()
	)
	var main_panel: = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", _make_popup_outer_style())
	popup.add_child(main_panel)
	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 16
	vbox.offset_top = 16
	vbox.offset_right = -16
	vbox.offset_bottom = -16
	vbox.add_theme_constant_override("separation", content_sep)
	main_panel.add_child(vbox)
	return {"popup": popup, "vbox": vbox, "panel": main_panel}

func _popup_fixed_btn(text: String, min_size: Vector2 = POPUP_ACTION_BTN_SIZE, style_cb: Callable = Callable()) -> Button:
	var btn: = Button.new()
