const DEFAULT_BATTLE_BG_PATH: = "res://assets/backgrounds/morenzhandoubj.jpg"
const DEFAULT_BATTLE_BG_TEX: Texture2D = preload("res://assets/backgrounds/morenzhandoubj.jpg")
const TOWER_BATTLE_BG_PATH: = "res://assets/backgrounds/天关.jpg"
const DUNGEON_BATTLE_BG_PATH: = "res://assets/backgrounds/副本.jpg"
const BATTLE_BG_VIGNETTE_EDGE_ALPHA: = 0.55
const BATTLE_BG_VIGNETTE_CENTER_ALPHA: = 0.05
const BATTLE_BG_VIGNETTE_CENTER_RADIUS: = 0.1
const BATTLE_BG_VIGNETTE_SOFTNESS: = 0.8

var _battle_bg_vignette_texture: GradientTexture2D = null
var _battle_bg_tex_cache: Dictionary = {}


func _create_battle_bg_vignette_texture() -> GradientTexture2D:
	var gradient: = Gradient.new()

	gradient.set_color(0, Color(0, 0, 0, BATTLE_BG_VIGNETTE_CENTER_ALPHA))
	gradient.add_point(BATTLE_BG_VIGNETTE_CENTER_RADIUS, Color(0, 0, 0, BATTLE_BG_VIGNETTE_CENTER_ALPHA))
	var fade_span: = 1.0 - BATTLE_BG_VIGNETTE_CENTER_RADIUS
	var transition_length: = fade_span * clampf(BATTLE_BG_VIGNETTE_SOFTNESS, 0.01, 1.0)
	var trans_end: = minf(BATTLE_BG_VIGNETTE_CENTER_RADIUS + transition_length, 1.0)
	var trans_span: = trans_end - BATTLE_BG_VIGNETTE_CENTER_RADIUS
	if trans_span > 0.001:
		gradient.add_point(BATTLE_BG_VIGNETTE_CENTER_RADIUS + trans_span * 0.35, Color(0, 0, 0, BATTLE_BG_VIGNETTE_EDGE_ALPHA * 0.35))
		gradient.add_point(BATTLE_BG_VIGNETTE_CENTER_RADIUS + trans_span * 0.72, Color(0, 0, 0, BATTLE_BG_VIGNETTE_EDGE_ALPHA * 0.72))
	var edge_idx: = gradient.get_point_count() - 1
	gradient.set_color(edge_idx, Color(0, 0, 0, BATTLE_BG_VIGNETTE_EDGE_ALPHA))
	var tex: = GradientTexture2D.new()
	tex.gradient = gradient
	tex.fill = GradientTexture2D.FILL_RADIAL
	tex.fill_from = Vector2(0.5, 0.5)
	tex.fill_to = Vector2(1.0, 0.5)
	tex.width = 512
	tex.height = 512
	return tex


func _get_battle_bg_vignette_texture() -> GradientTexture2D:
	if _battle_bg_vignette_texture == null:
		_battle_bg_vignette_texture = _create_battle_bg_vignette_texture()
	return _battle_bg_vignette_texture


func _apply_battle_background_vignette_mask(mask: TextureRect) -> void :
	if mask == null:
		return
	mask.material = null
	mask.modulate = Color.WHITE
	mask.texture = _get_battle_bg_vignette_texture()
	mask.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	mask.stretch_mode = TextureRect.STRETCH_SCALE


func _remove_battle_panel_child_immediate(panel: Panel, node: Node) -> void :
	if not is_instance_valid(node):
		return
	if node.get_parent() == panel:
		panel.remove_child(node)
	node.free()


func _ensure_battle_background_layers(battle_panel: Panel) -> void :
	if battle_panel == null:
		return
	var bg = battle_panel.get_node_or_null("BattleBackground")
	if not is_instance_valid(bg) or not bg is TextureRect:
		if is_instance_valid(bg):
			_remove_battle_panel_child_immediate(battle_panel, bg)
		bg = TextureRect.new()
		bg.name = "BattleBackground"
		bg.set_anchors_preset(Control.PRESET_FULL_RECT)
		bg.offset_left = 0
		bg.offset_top = 0
		bg.offset_right = 0
		bg.offset_bottom = 0
		bg.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		bg.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
		bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bg.z_index = 12
		battle_panel.add_child(bg)
	var bg_tex = _load_battle_background_texture()
	if bg_tex:
		bg.texture = bg_tex
	battle_panel.move_child(bg, 0)

	var bg_mask = battle_panel.get_node_or_null("BattleBackgroundMask")
	if not is_instance_valid(bg_mask) or not bg_mask is TextureRect:
		if is_instance_valid(bg_mask):
			_remove_battle_panel_child_immediate(battle_panel, bg_mask)
		for child in battle_panel.get_children():
			if child.name == "BattleBackgroundMask" and child != bg:
				_remove_battle_panel_child_immediate(battle_panel, child)
		bg_mask = TextureRect.new()
		bg_mask.name = "BattleBackgroundMask"
		bg_mask.set_anchors_preset(Control.PRESET_FULL_RECT)
		bg_mask.offset_left = 0
		bg_mask.offset_top = 0
		bg_mask.offset_right = 0
		bg_mask.offset_bottom = 0
		bg_mask.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bg_mask.z_index = 13
		battle_panel.add_child(bg_mask)
	_apply_battle_background_vignette_mask(bg_mask)
	if bg_mask.get_index() != 1 and battle_panel.get_child_count() > 1:
		battle_panel.move_child(bg_mask, 1)

	var bp_style = StyleBoxFlat.new()
	bp_style.bg_color = Color(0, 0, 0, 0)
	battle_panel.add_theme_stylebox_override("panel", bp_style)


func _resolve_battle_background_path() -> String:
	if not game_manager:
		return DEFAULT_BATTLE_BG_PATH
	if game_manager.is_tower_battle:
		return TOWER_BATTLE_BG_PATH
	if game_manager.is_suit_dungeon_battle or game_manager.is_five_elements_battle or game_manager.is_atlas_dungeon_battle or game_manager.is_brother_tower_battle:
		return DUNGEON_BATTLE_BG_PATH
	var split: = _split_map_title_and_coords(game_manager.current_map)
	var title: String = str(split.get("title", "")).strip_edges()
	if title.is_empty():
		return DEFAULT_BATTLE_BG_PATH

	var jpg_path: = "res://assets/backgrounds/%s.jpg" % title
	if ResourceLoader.exists(jpg_path):
		return jpg_path
	return "res://assets/backgrounds/%s.png" % title


func _load_battle_background_texture() -> Texture2D:
	var path: = _resolve_battle_background_path()
	if _battle_bg_tex_cache.has(path):
		return _battle_bg_tex_cache[path] as Texture2D
	var tex: Texture2D = ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_REUSE) as Texture2D
	if tex == null and path != DEFAULT_BATTLE_BG_PATH:
		tex = ResourceLoader.load(DEFAULT_BATTLE_BG_PATH, "", ResourceLoader.CACHE_MODE_REUSE) as Texture2D
	if tex == null:
		tex = DEFAULT_BATTLE_BG_TEX
	_battle_bg_tex_cache[path] = tex
	return tex

