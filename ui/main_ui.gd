func _await_player_attr_auto_allocate() -> Dictionary:
	var net = game_manager.network if game_manager else null
	if net == null:
		return {"ok": false, "error": "网络未初始化"}
	var state: = {"done": false, "ok": false, "data": {}, "error": ""}
	var on_ok = func(d: Dictionary):
		state["done"] = true
		state["ok"] = true
		state["data"] = d
	var on_fail = func(err: String):
		state["done"] = true
		state["ok"] = false
		state["error"] = err
	net.player_attr_auto_allocate_success.connect(on_ok, CONNECT_ONE_SHOT)
	net.player_attr_auto_allocate_failed.connect(on_fail, CONNECT_ONE_SHOT)
	var client_hint: Dictionary = _build_player_attr_auto_allocate_client_hint()
	net.player_attr_auto_allocate(_new_player_attr_operation_id(), client_hint)
	var start_ms: = Time.get_ticks_msec()
	while not bool(state.get("done", false)):
		if Time.get_ticks_msec() - start_ms > _PLAYER_ATTR_RPC_WAIT_MS:
			if net.player_attr_auto_allocate_success.is_connected(on_ok):
				net.player_attr_auto_allocate_success.disconnect(on_ok)
			if net.player_attr_auto_allocate_failed.is_connected(on_fail):
				net.player_attr_auto_allocate_failed.disconnect(on_fail)
			return {"ok": false, "error": "自动分配超时，请稍后重试"}
		await get_tree().process_frame
	if bool(state.get("ok", false)):
		return {"ok": true, "data": state.get("data", {})}
	return {"ok": false, "error": str(state.get("error", "自动分配失败"))}

