func _on_stop_or_start_battle_pressed():
	if not game_manager:
		return
	if _is_skippable_server_replay():
		if _replay_skip_unlocked:
			_on_replay_skip_pressed()
		else:
			_add_log("[color=yellow]请稍候，5秒后可跳过[/color]")
		return
	var instanced: = false
	if game_manager.has_method("is_in_instanced_challenge"):
		instanced = bool(game_manager.is_in_instanced_challenge())

	if auto_battle or instanced:
		auto_battle = false
		game_manager.set_auto_battle_enabled(false, true)
		_battle_countdown_active = false
		_last_battle_countdown_second_announced = -1
		if game_manager.is_tower_battle or game_manager.is_tower_settling or bool(game_manager.get("is_tower_run_active")):
			game_manager.force_stop_tower_battle()
			game_manager.stop_tower_requested = true
		elif game_manager.is_suit_dungeon_battle:
			game_manager.force_stop_suit_dungeon_battle()
		elif game_manager.is_atlas_dungeon_battle:
			game_manager.force_stop_atlas_dungeon_battle()
		elif game_manager.is_brother_tower_battle:
			game_manager.force_stop_brother_tower_battle()
		elif game_manager.is_five_elements_battle:
			game_manager.force_stop_fe_dungeon_battle()
		elif game_manager.is_tower_settling or game_manager.last_battle_was_tower:
			game_manager.stop_tower_requested = true
			game_manager.force_stop_field_battle()
		else:
			game_manager.force_stop_field_battle()
		_refresh_stop_or_start_battle_btn_text()
		_add_log("[color=yellow]已停止自动战斗[/color]")
	else:
		auto_battle = true
		game_manager.set_auto_battle_enabled(true)
		battle_cooldown = 0.0
		_battle_cooldown_deadline_ms = 0
		_refresh_stop_or_start_battle_btn_text()
		_add_log("[color=green]已开始自动战斗[/color]")

func _auto_change_to_level_map():
	if not game_manager or not game_manager.player:
		return

	var player_level = game_manager.player.level
	var active_pet = game_manager.pet_manager.get_active_pet()
	var pet_level = player_level
	if active_pet:
		pet_level = active_pet.level

	var min_level = mini(player_level, pet_level)

	var maps_data = GameData.MAPS_DATA

	var suitable_maps = []
	for map_name in maps_data.keys():
		var map_data = maps_data[map_name]
		var map_level = map_data.get("level", 1)
		if map_level >= min_level - 5 and map_level <= min_level + 10:
			if map_name != game_manager.current_map:
				suitable_maps.append({"name": map_name, "level": map_level})

	if suitable_maps.is_empty():
		_add_log("[color=yellow]没有找到等级相近的地图，尝试选择最接近的地图...[/color]")
		var closest_map = null
		var closest_diff = 999999

		for map_name in maps_data.keys():
			if map_name == game_manager.current_map:
				continue
			var map_data = maps_data[map_name]
			var map_level = map_data.get("level", 1)
			var diff = abs(map_level - min_level)
			if diff < closest_diff:
				closest_diff = diff
				closest_map = map_name

		if closest_map == null:
			_add_log("[color=red]没有可用的地图[/color]")
			return

		game_manager.previous_map = game_manager.current_map
		if game_manager.change_map(closest_map):
			_add_log("[color=cyan]自动换图（最接近）：%s[/color]" % closest_map)
			_update_map_ui()
		return

	var selected = suitable_maps[randi() % suitable_maps.size()]
	var new_map = selected.name

	game_manager.previous_map = game_manager.current_map

	if game_manager.change_map(new_map):
		_add_log("[color=cyan]自动换图：%s[/color]" % new_map)
		_update_map_ui()


func _upgrade_map_for_auto_change():
	var current_map_data = GameData.MAPS_DATA.get(game_manager.current_map, {})
	var current_level = current_map_data.get("level", 1)


	if current_level >= 1500:
		_add_log("[color=yellow]已达到最高等级地图（1500级），无法继续升级[/color]")
		return


	var target_level = mini(1500, current_level + 5 + randi() % 6)


	var target_maps = []
	var closest_level = 9999
	for map_name in GameData.MAPS_DATA.keys():
		var map_data = GameData.MAPS_DATA[map_name]
		var map_level = map_data.get("level", 1)

		if map_level > current_level and map_level <= target_level:
			if map_name != game_manager.current_map:

				if map_level < closest_level:
					closest_level = map_level
					target_maps = [map_name]
				elif map_level == closest_level:
					target_maps.append(map_name)


	if target_maps.is_empty():
		for map_name in GameData.MAPS_DATA.keys():
			var map_data = GameData.MAPS_DATA[map_name]
			var map_level = map_data.get("level", 1)
			if map_level > current_level and map_level < closest_level:
				if map_name != game_manager.current_map:
					closest_level = map_level
					target_maps = [map_name]
				elif map_level == closest_level:
					target_maps.append(map_name)

	if target_maps.is_empty():
		_add_log("[color=yellow]未找到合适的升级地图[/color]")
	else:
		var new_map = target_maps[randi() % target_maps.size()]
		game_manager.previous_map = game_manager.current_map
		var change_result = game_manager.change_map(new_map)
		if change_result:
			_add_log("[color=cyan]自动升级地图到：%s（等级 %d）[/color]" % [new_map, closest_level])
			_update_map_ui()


