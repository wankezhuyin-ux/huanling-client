func _get_or_create_map_filter_button_group() -> ButtonGroup:
	if _map_dialog_filter_button_group == null:
		_map_dialog_filter_button_group = ButtonGroup.new()
	return _map_dialog_filter_button_group

func _count_maps_in_range(min_lvl: int, max_lvl: int) -> int:
	var count = 0
	for lvl in _maps_by_level_cache.keys():
		if lvl >= min_lvl and lvl <= max_lvl:
			count += _maps_by_level_cache[lvl].size()
	return count

func _update_map_filter_button_styles():
	for btn_data in _map_level_buttons:
		var btn = btn_data.button
		var name = btn_data.name
		if name == _current_map_filter:
			btn.add_theme_color_override("font_color", Color(1, 0.84, 0))
			btn.add_theme_color_override("font_hover_color", Color(1, 0.9, 0.5))
		else:
			btn.add_theme_color_override("font_color", Color(0.8, 0.8, 0.8))
			btn.add_theme_color_override("font_hover_color", Color(1, 1, 1))

func _refresh_map_list(min_lvl: int, max_lvl: int) -> void :
	_map_list_refresh_token += 1
	var token: int = _map_list_refresh_token
	_refresh_map_list_async(min_lvl, max_lvl, token)

func _refresh_map_list_async(min_lvl: int, max_lvl: int, token: int) -> void :
	if token != _map_list_refresh_token:
		return
	if not is_instance_valid(_map_content_container):
		return

	while _map_content_container.get_child_count() > 0:
		var child = _map_content_container.get_child(0)
		_map_content_container.remove_child(child)
		child.queue_free()

	if token != _map_list_refresh_token:
		return
	if not is_instance_valid(_map_content_container):
		return

	var maps_to_show: Array = []
	for lvl in _maps_by_level_cache.keys():
		if lvl >= min_lvl and lvl <= max_lvl:
			for map_name in _maps_by_level_cache[lvl]:
				maps_to_show.append({"name": map_name, "level": lvl})

	maps_to_show.sort_custom( func(a, b): return a.level < b.level)

	if maps_to_show.size() == 0:
		if token != _map_list_refresh_token:
			return
		if not is_instance_valid(_map_content_container):
			return
		var empty_label = Label.new()
		empty_label.text = "没有找到符合条件的地图"
		empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty_label.add_theme_font_size_override("font_size", 16)
		empty_label.add_theme_color_override("font_color", Color(0.6, 0.6, 0.6))
		empty_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_map_content_container.add_child(empty_label)
		return

	if token != _map_list_refresh_token:
		return
	if not is_instance_valid(_map_content_container):
		return

	var loading_l: = Label.new()
	loading_l.text = "加载中…"
	loading_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	loading_l.add_theme_font_size_override("font_size", 16)
	loading_l.add_theme_color_override("font_color", Color(0.65, 0.65, 0.65))
	loading_l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_map_content_container.add_child(loading_l)

	var current_level: int = -1
	var grid: GridContainer = null
	var built_since_yield: int = 0

	for map_info in maps_to_show:
		if token != _map_list_refresh_token:
			return
		if not is_instance_valid(_map_content_container):
			return

		var map_name: String = map_info.name
		var map_level: int = map_info.level

		if map_level != current_level:
			current_level = map_level

			var level_panel = Panel.new()
			level_panel.add_theme_stylebox_override("panel", _map_dialog_style_level_panel)
			level_panel.custom_minimum_size = Vector2(0, 35)

			level_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

			var level_hbox = HBoxContainer.new()
			level_hbox.set_anchors_preset(Control.PRESET_FULL_RECT)
			level_hbox.offset_left = 15
			level_hbox.offset_top = 5
			level_hbox.offset_right = -15
			level_hbox.offset_bottom = -5
			level_hbox.mouse_filter = Control.MOUSE_FILTER_IGNORE

			var level_icon = Label.new()
			level_icon.text = "⚔"
			level_icon.add_theme_font_size_override("font_size", 18)
			level_icon.add_theme_color_override("font_color", Color(1, 0.8, 0.2))
			level_icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
			level_hbox.add_child(level_icon)

			var level_label = Label.new()
			level_label.text = "Lv.%d" % map_level
			level_label.add_theme_font_size_override("font_size", 18)
			level_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
			level_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
			level_hbox.add_child(level_label)

			level_panel.add_child(level_hbox)
			_map_content_container.add_child(level_panel)

			grid = GridContainer.new()
			grid.columns = 2
			grid.add_theme_constant_override("h_separation", 10)
			grid.add_theme_constant_override("v_separation", 8)
			grid.mouse_filter = Control.MOUSE_FILTER_IGNORE
			_map_content_container.add_child(grid)

		var btn = Button.new()
		btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		btn.custom_minimum_size = Vector2(0, 54)
		btn.focus_mode = Control.FOCUS_NONE
		btn.add_theme_font_size_override("font_size", 16)
		btn.add_theme_color_override("font_color", Color(0.9, 0.9, 0.9))
		var map_data_row: Dictionary = _maps_data_cache.get(map_name, {})
		_apply_map_select_button_content(btn, map_name, map_data_row, 16, Color(0.9, 0.9, 0.9), Color(1, 1, 1), "  ")
		btn.add_theme_stylebox_override("normal", _map_dialog_style_list_normal)
		btn.add_theme_stylebox_override("hover", _map_dialog_style_list_hover)

		var captured_map_name = map_name

		TouchScrollUtils.bind_tap(btn, func():
			if game_manager.change_map(captured_map_name):
				_map_list_refresh_token += 1
				_add_log("[color=yellow]进入地图：%s[/color]" % captured_map_name)
				if _map_window and is_instance_valid(_map_window):
					_map_window.queue_free()
					_map_window = null
					_map_content_container = null
					_map_level_buttons.clear()
			else:
				_add_log("[color=red]等级不足, 无法进入 %s[/color]" % captured_map_name)
		)

		if grid:
			grid.add_child(btn)

		if is_instance_valid(loading_l) and loading_l.get_parent() == _map_content_container:
			loading_l.queue_free()
			loading_l = null

		built_since_yield += 1
		if built_since_yield >= MAP_LIST_REFRESH_BATCH:
			built_since_yield = 0
			await get_tree().process_frame
			if token != _map_list_refresh_token:
				return
			if not is_instance_valid(_map_content_container):
				return
	if token != _map_list_refresh_token:
		return
	if is_instance_valid(_map_content_container):

		TouchScrollUtils.enable_touch_drag_passthrough(_map_content_container)

func _create_inventory_item_ui(item) -> Panel:
	var is_limit_aggregate: = item is Dictionary and str(item.get("entry_kind", "")) == "limit_material_aggregate"
	var representative_item = item.get("representative_item", null) if is_limit_aggregate else item
	var display_item = representative_item
	var display_item_type: = str(item.get("item_type", "material")) if is_limit_aggregate else str(item.item_type)
	var display_name: = str(item.get("name", "")) if is_limit_aggregate else str(item.name)
	var display_count: = int(item.get("count", 0)) if is_limit_aggregate else int(item.count)
	var display_desc = "可用于装备极限锻造的材料" if is_limit_aggregate else display_item.get_desc()
	var display_color: Color = display_item.get_rarity_color()

	var panel = Panel.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	panel.custom_minimum_size = Vector2(0, 102)
	panel.mouse_filter = Control.MOUSE_FILTER_PASS

	var panel_style = StyleBoxFlat.new()
	panel_style.bg_color = Color(0.040, 0.050, 0.052, 0.74)
	panel_style.border_width_left = 2
	panel_style.border_width_top = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel_style.border_color = Color(0.3, 0.35, 0.4)
	panel_style.corner_radius_top_left = 8
	panel_style.corner_radius_top_right = 8
	panel_style.corner_radius_bottom_left = 8
	panel_style.corner_radius_bottom_right = 8
	panel.add_theme_stylebox_override("panel", panel_style)

	var hbox = HBoxContainer.new()
	hbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	hbox.offset_left = 15
	hbox.offset_top = 10
	hbox.offset_right = -15
	hbox.offset_bottom = -10
	hbox.mouse_filter = Control.MOUSE_FILTER_PASS

	var icon_container = Panel.new()
	icon_container.custom_minimum_size = Vector2(70, 70)
	icon_container.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	icon_container.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var icon_style = StyleBoxFlat.new()
	icon_style.bg_color = display_color
	icon_style.corner_radius_top_left = 10
	icon_style.corner_radius_top_right = 10
	icon_style.corner_radius_bottom_left = 10
	icon_style.corner_radius_bottom_right = 10
	icon_container.add_theme_stylebox_override("panel", icon_style)

	var bg_color = display_color
	var brightness = bg_color.r * 0.299 + bg_color.g * 0.587 + bg_color.b * 0.114
	var text_color = Color(1, 1, 1) if brightness < 0.5 else Color(0.1, 0.1, 0.1)

	var icon_label = Label.new()
	icon_label.set_anchors_preset(Control.PRESET_FULL_RECT)
	icon_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	icon_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	icon_label.add_theme_font_size_override("font_size", 28)
	icon_label.add_theme_color_override("font_color", text_color)

	var icon_text = "物"
	if display_item_type == "pill":
		icon_text = "丹"
	elif display_item_type == "material":
		icon_text = "材"
	elif display_item_type == "sealed_suit":
		icon_text = "封"
	elif display_item_type == "limit_equip" or is_limit_aggregate:
		icon_text = "极"
	icon_label.text = icon_text
	icon_container.add_child(icon_label)
	hbox.add_child(icon_container)

	var info_vbox = VBoxContainer.new()
	info_vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info_vbox.add_theme_constant_override("separation", 2)
	info_vbox.mouse_filter = Control.MOUSE_FILTER_PASS

	var name_label = Label.new()

	if not is_limit_aggregate and display_item_type == "sealed_suit" and display_item.custom_data.size() > 0:
		var suit_name = _get_sealed_suit_display_name(display_item.custom_data)
		name_label.text = "%s x%d" % [suit_name, display_count]
		name_label.add_theme_font_size_override("font_size", 20)
		name_label.add_theme_color_override("font_color", Color(0.5, 0.5, 0.5))
		name_label.autowrap_mode = TextServer.AUTOWRAP_OFF
		name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		name_label.clip_text = true
		name_label.max_lines_visible = 1
		info_vbox.add_child(name_label)

		var desc_label = Label.new()
		desc_label.text = "封印状态的套装装备，需要解封石解封后才能使用"
		desc_label.add_theme_font_size_override("font_size", 16)
		desc_label.add_theme_color_override("font_color", Color(0.6, 0.6, 0.7))
		desc_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		desc_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		desc_label.max_lines_visible = 2
		desc_label.custom_minimum_size = Vector2(0, 36)
		info_vbox.add_child(desc_label)
	else:
		name_label.text = "%s x%d" % [display_name, display_count]
		name_label.add_theme_font_size_override("font_size", 20)
		name_label.add_theme_color_override("font_color", display_color)
		name_label.autowrap_mode = TextServer.AUTOWRAP_OFF
		name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		name_label.clip_text = true
		name_label.max_lines_visible = 1
		info_vbox.add_child(name_label)

		var desc_label = Label.new()
		desc_label.text = display_desc
		desc_label.add_theme_font_size_override("font_size", 16)
		desc_label.add_theme_color_override("font_color", Color(0.6, 0.6, 0.7))
		desc_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		desc_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		desc_label.max_lines_visible = 2
		desc_label.custom_minimum_size = Vector2(0, 36)
		info_vbox.add_child(desc_label)

	hbox.add_child(info_vbox)

	var click_hint = Button.new()
	click_hint.text = "点击操作"
	click_hint.custom_minimum_size = Vector2(100, 40)
	click_hint.size_flags_horizontal = Control.SIZE_SHRINK_END
	click_hint.add_theme_font_size_override("font_size", 18)
	click_hint.add_theme_color_override("font_color", Color(0.5, 0.5, 0.5))
	hbox.add_child(click_hint)

	click_hint.pressed.connect( func():
		_show_item_action_popup(item)
	)

	panel.add_child(hbox)
	return panel

func _show_item_action_popup(item):
	var is_limit_aggregate: = item is Dictionary and str(item.get("entry_kind", "")) == "limit_material_aggregate"
	if is_limit_aggregate:
		_show_limit_material_aggregate_popup(item)
		return
	_update_bag_detail_bar_item(item)
	var item_key = str(item.id) if "id" in item else str(item.name)
	var popup_key = "item_action:%s" % item_key
	var shell: = _open_styled_popup(popup_key, INVENTORY_DETAIL_POPUP_GROUP, Vector2i(460, 400))
	if shell.is_empty():
		return
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox


	var detail: = Panel.new()
	detail.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	detail.size_flags_vertical = Control.SIZE_EXPAND_FILL
	detail.custom_minimum_size = Vector2(0, 180)
	var detail_st: = StyleBoxFlat.new()
	detail_st.bg_color = Color(0.030, 0.037, 0.040, 0.82)
	# 细金线：弹窗底和内层卡片是同一族墨色，没有这道线就分不出层次
	detail_st.set_border_width_all(maxi(1, int(round(1.0 * _ink_s()))))
	detail_st.border_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.34)
	detail_st.set_corner_radius_all(0)
	detail.add_theme_stylebox_override("panel", detail_st)
	vbox.add_child(detail)

	var detail_box: = VBoxContainer.new()
	detail_box.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	detail_box.offset_left = 12
	detail_box.offset_top = 10
	detail_box.offset_right = -12
	detail_box.offset_bottom = -10
	detail_box.add_theme_constant_override("separation", 8)
	detail.add_child(detail_box)

	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", 12)
	detail_box.add_child(head)

	var icon: = TextureRect.new()
	icon.custom_minimum_size = Vector2(72, 72)
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var item_tex: = InventoryIconHelper.category_icon_for_inventory_item(item)
	if item_tex:
		icon.texture = item_tex
	head.add_child(icon)

	var title = Label.new()
	if item.item_type == "sealed_suit" and item.custom_data.size() > 0:
		title.text = _get_sealed_suit_display_name(item.custom_data) + " x%d" % item.count
		title.add_theme_color_override("font_color", Color(0.5, 0.5, 0.5))
	else:
		title.text = "%s x%d" % [item.name, item.count]
		title.add_theme_color_override("font_color", item.get_rarity_color())
	title.add_theme_font_size_override("font_size", 22)
	title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	head.add_child(title)

	var desc_scroll: = ScrollContainer.new()
	desc_scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	desc_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	desc_scroll.custom_minimum_size = Vector2(0, 90)
	desc_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	detail_box.add_child(desc_scroll)

	var desc_label = Label.new()
	if item.item_type == "sealed_suit" and item.custom_data.size() > 0:
		desc_label.text = "封印状态的套装装备"
	else:
		desc_label.text = item.get_desc()
	if str(desc_label.text).strip_edges().is_empty():
		desc_label.text = "暂无介绍"
	desc_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	desc_label.add_theme_font_size_override("font_size", 16)
	desc_label.add_theme_color_override("font_color", Color(0.82, 0.84, 0.9))
	desc_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc_scroll.add_child(desc_label)

	var sep = HSeparator.new()
	vbox.add_child(sep)

	var popup_ref = popup
	var close_popup_ref_once: = func():
		if not is_instance_valid(popup_ref):
			return
		if popup_ref.has_meta("closed"):
			return
		popup_ref.set_meta("closed", true)
		popup_ref.queue_free()
	var is_pet_fragment: bool = str(item.name) == PetEquipmentEnhance.FRAGMENT_ITEM
	var is_fabao_fragment: bool = FabaoConfig.is_fragment_name(str(item.name))
	var is_normal_seal_stone: bool = str(item.name) == InventoryManager.NORMAL_SEAL_STONE_ITEM
	var is_sealed_suit_item: bool = item.item_type == "sealed_suit"
	var item_btns: Array = []

	if item.can_use():
		var item_use_logged_in: bool = game_manager != null and (game_manager.has_method("local_use_item") or (game_manager.network != null and game_manager.network.is_logged_in()))

		var use_btn = Button.new()
		use_btn.text = "使用"
		use_btn.custom_minimum_size = Vector2(160, 45)
		use_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		use_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(use_btn)
		if not item_use_logged_in:
			use_btn.disabled = true
			use_btn.text = "需登录"
		use_btn.pressed.connect( func():
			if use_btn.disabled:
				return
			use_btn.disabled = true
			use_btn.text = "处理中..."
			var result = await game_manager.inventory_manager.use_item(item.id, game_manager.player)
			if result.success:
				var reward_sync_policy: = int(result.get("reward_sync_policy", InventoryManager.REWARD_SYNC_LOCAL_SAVE))
				var authoritative_already_applied: = bool(result.get("authoritative_save_applied", false))
				var persisted_ok: = true
				if authoritative_already_applied or bool(result.get("local_save_applied", false)):
					persisted_ok = true
				else:
					match reward_sync_policy:
						InventoryManager.REWARD_SYNC_AUTHORITY_COMPACT_UPLOAD:
							persisted_ok = await game_manager.force_cloud_upload_and_wait("reward_item_use", true, 20.0)
						InventoryManager.REWARD_SYNC_FULL_AUTHORITY_UPLOAD:
							persisted_ok = await game_manager.force_cloud_upload_and_wait("reward_item_use_full", false, 20.0)
						_:
							persisted_ok = game_manager.save_game()
				if not persisted_ok:
					game_manager.inventory_manager.rollback_used_item_reward_failure(item.id, result)
					if is_instance_valid(use_btn):
						use_btn.disabled = false
						use_btn.text = "使用"
					_update_bag_view()
					_update_player_ui()
					_update_pet_ui()
					_show_simple_dialog("同步失败", "奖励发放未完成，已回滚本地结果并恢复礼包，请稍后重试。")
					return
				close_popup_ref_once.call()
				if result.get("show_dialog", false):
					_show_simple_dialog(result.dialog_title, result.dialog_message)
				elif not bool(result.get("suppress_item_use_success_dialog", false)) and result.message != "":
					_show_simple_dialog("使用成功", result.message)
				_update_bag_view()
				_update_player_ui()
				if authoritative_already_applied:
					_refresh_pet_roster_after_authority_reward()
				else:
					_update_pet_ui()
			else:
				if result.message != "":
					_show_simple_dialog("使用失败", result.message)
				if result.get("show_dialog", false):
					_show_simple_dialog(result.dialog_title, result.dialog_message)
				if is_instance_valid(use_btn):
					use_btn.disabled = false
					use_btn.text = "使用"
		)
		item_btns.append(use_btn)

		if item.count > 1 and item.item_type != "pet_skill_book" and not _inventory_item_disallows_batch_use(item):
			var batch_btn = Button.new()
			batch_btn.text = "批量使用"
			batch_btn.custom_minimum_size = Vector2(160, 45)
			batch_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			batch_btn.add_theme_font_size_override("font_size", 18)
			_apply_action_button_style(batch_btn)
			if not item_use_logged_in:
				batch_btn.disabled = true
				batch_btn.text = "需登录"
			batch_btn.pressed.connect( func():
				close_popup_ref_once.call()
				_show_batch_use_dialog(item)
			)
			item_btns.append(batch_btn)

	if is_pet_fragment:
		var synth_btn = Button.new()
		synth_btn.text = "合成1次"
		synth_btn.custom_minimum_size = Vector2(160, 45)
		synth_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		synth_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(synth_btn)
		synth_btn.pressed.connect( func():
			_request_bag_pet_fragment_synthesize(1, close_popup_ref_once)
		)
		item_btns.append(synth_btn)
		var batch_btn = Button.new()
		batch_btn.text = "批量合成"
		batch_btn.custom_minimum_size = Vector2(160, 45)
		batch_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		batch_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(batch_btn)
		batch_btn.pressed.connect( func():
			_show_pet_fragment_batch_synthesize_dialog(close_popup_ref_once)
		)
		item_btns.append(batch_btn)

	if is_fabao_fragment:
		var fb_synth_btn = Button.new()
		fb_synth_btn.text = "合成"
		fb_synth_btn.custom_minimum_size = Vector2(160, 45)
		fb_synth_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		fb_synth_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(fb_synth_btn)
		var frag_name_cap: = str(item.name)
		var frag_count_cap: = int(item.count)
		fb_synth_btn.pressed.connect( func():
			var tid: = _fabao_tier_id_from_fragment_name(frag_name_cap)
			if tid.is_empty():
				_show_game_alert("无法识别法宝碎片", "合成失败")
				return
			var need: = int(FabaoConfig.SYNTH_FRAGMENT_COUNT)
			if frag_count_cap < need:
				_show_game_alert("需要%d个%s才能合成" % [need, frag_name_cap], "碎片不足")
				return
			close_popup_ref_once.call()
			_start_fabao_synthesize_flow(tid, FabaoConfig.fabao_item_name(tid))
		)
		item_btns.append(fb_synth_btn)

	if is_normal_seal_stone:
		var seal_synth_btn = Button.new()
		seal_synth_btn.text = "合成1次"
		seal_synth_btn.custom_minimum_size = Vector2(160, 45)
		seal_synth_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		seal_synth_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(seal_synth_btn)
		seal_synth_btn.pressed.connect( func():
			_request_bag_seal_stone_synthesize(1, close_popup_ref_once)
		)
		item_btns.append(seal_synth_btn)
		var seal_batch_btn = Button.new()
		seal_batch_btn.text = "批量合成"
		seal_batch_btn.custom_minimum_size = Vector2(160, 45)
		seal_batch_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		seal_batch_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(seal_batch_btn)
		seal_batch_btn.pressed.connect( func():
			_show_seal_stone_batch_synthesize_dialog(close_popup_ref_once)
		)
		item_btns.append(seal_batch_btn)


	var _skill_book_name: String = str(item.name).strip_edges()
	if _skill_book_name.is_empty() or _skill_book_name == "null":
		_skill_book_name = str(item.custom_data.get("book_name", "")).strip_edges()
	var _skill_book_total: int = 0
	if item.item_type == "pet_skill_book" and game_manager and game_manager.inventory_manager:
		_skill_book_total = game_manager.inventory_manager.count_item_total_in_bag_and_warehouse(_skill_book_name)
	var is_skill_book: bool = item.item_type == "pet_skill_book" and _skill_book_total >= 2
	if is_skill_book:
		var book_name: String = _skill_book_name if not _skill_book_name.is_empty() else str(item.custom_data.get("book_name", item.name))
		if book_name != "" and book_name != "null":
			var synth_btn2 = Button.new()
			synth_btn2.text = "2合1进阶"
			synth_btn2.custom_minimum_size = Vector2(160, 45)
			synth_btn2.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			synth_btn2.add_theme_font_size_override("font_size", 18)
			_apply_action_button_style(synth_btn2)
			synth_btn2.pressed.connect( func():
				var next_book_name: String = ""
				var lv_re: = RegEx.new()
				if lv_re.compile("lv(\\d+)") == OK:
					var lv_m: = lv_re.search(book_name)
					if lv_m:
						var cur_lv: = int(lv_m.get_string(1))
						if cur_lv > 0:
							next_book_name = book_name.replace("lv%d" % cur_lv, "lv%d" % (cur_lv + 1))
				var confirm_msg: String
				if next_book_name != "":
					confirm_msg = "将消耗 2 本【%s】，合成为 1 本【%s】。" % [book_name, next_book_name]
				else:
					confirm_msg = "将消耗 2 本【%s】，合成为高一级技能书。" % book_name
				_show_batch_dismantle_confirm_popup(
					"确认合成", 
					confirm_msg, 
					func():
						if not is_instance_valid(synth_btn2):
							return
						synth_btn2.disabled = true
						synth_btn2.text = "合成中..."
						var op_id = "pet_skill_synthetic_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
						var success_cb = func(data: Dictionary):
							if not is_instance_valid(synth_btn2):
								return
							synth_btn2.disabled = false
							synth_btn2.text = "2合1进阶"
							close_popup_ref_once.call()
							if game_manager:
								var sd: Variant = data.get("saveData", null)
								if sd is Dictionary and not (sd as Dictionary).is_empty():
									game_manager.apply_cloud_save(sd as Dictionary, {"preserve_local_pets_not_in_cloud": true, "skip_pet_collection_trim": true})
								elif game_manager.has_method("download_cloud_save"):
									game_manager.call_deferred("download_cloud_save")
							_show_simple_dialog("合成成功", str(data.get("message", "技能书合成成功")))
							_update_bag_view()
							_update_pet_ui()
						var failed_cb = func(error: String):
							if not is_instance_valid(synth_btn2):
								return
							synth_btn2.disabled = false
							synth_btn2.text = "2合1进阶"
							_show_simple_dialog("合成失败", error)
						game_manager.network.pet_skill_synthetic_success.connect(success_cb, CONNECT_ONE_SHOT)
						game_manager.network.pet_skill_synthetic_failed.connect(failed_cb, CONNECT_ONE_SHOT)
						game_manager.network.request_pet_skill_synthetic(book_name, 2, op_id), 
					"确认合成", 
					"合成后无法撤销。"
				)
			)
			item_btns.append(synth_btn2)

	var _skill_book_level: = 0
	if item.item_type == "pet_skill_book" and not _skill_book_name.is_empty() and _skill_book_name != "null":
		var split_lv_re: = RegEx.new()
		if split_lv_re.compile("lv(\\d+)") == OK:
			var split_lv_m: = split_lv_re.search(_skill_book_name)
			if split_lv_m:
				_skill_book_level = int(split_lv_m.get_string(1))
	if item.item_type == "pet_skill_book" and _skill_book_level >= 2 and _skill_book_level <= 5:
		var split_book_name: = _skill_book_name
		var split_gain: = 1 << (_skill_book_level - 1)
		var split_lv1_name: = split_book_name.replace("lv%d" % _skill_book_level, "lv1")
		if split_lv1_name != split_book_name and split_gain >= 2:
			var split_btn = Button.new()
			split_btn.text = "拆分"
			split_btn.custom_minimum_size = Vector2(160, 45)
			split_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			split_btn.add_theme_font_size_override("font_size", 18)
			_apply_action_button_style(split_btn)
			split_btn.pressed.connect( func():
				if split_btn.disabled:
					return
				var confirm_msg: = "将消耗 1 本【%s】，拆成 %d 本【%s】。" % [split_book_name, split_gain, split_lv1_name]
				_show_batch_dismantle_confirm_popup(
					"确认拆分", 
					confirm_msg, 
					func():
						if not is_instance_valid(split_btn):
							return
						if game_manager == null or game_manager.network == null:
							_show_simple_dialog("拆分失败", "网络未连接，请登录后重试")
							return
						split_btn.disabled = true
						split_btn.text = "拆分中..."
						var op_id = "pet_skill_split_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
						var success_cb: Callable
						var failed_cb: Callable
						success_cb = func(data: Dictionary):
							if game_manager and game_manager.network and game_manager.network.pet_skill_split_failed.is_connected(failed_cb):
								game_manager.network.pet_skill_split_failed.disconnect(failed_cb)
							if is_instance_valid(split_btn):
								split_btn.disabled = false
								split_btn.text = "拆分"
							close_popup_ref_once.call()
							if game_manager:
								var sd: Variant = data.get("saveData", null)
								if sd is Dictionary and not (sd as Dictionary).is_empty():
									game_manager.apply_cloud_save(sd as Dictionary, {"preserve_local_pets_not_in_cloud": true, "skip_pet_collection_trim": true})
								elif game_manager.has_method("download_cloud_save"):
									game_manager.call_deferred("download_cloud_save")
							_show_simple_dialog("拆分成功", str(data.get("message", "技能书拆分成功")))
							_update_bag_view()
							_update_pet_ui()
						failed_cb = func(error: String):
							if game_manager and game_manager.network and game_manager.network.pet_skill_split_success.is_connected(success_cb):
								game_manager.network.pet_skill_split_success.disconnect(success_cb)
							if is_instance_valid(split_btn):
								split_btn.disabled = false
								split_btn.text = "拆分"
							_show_simple_dialog("拆分失败", error)
						game_manager.network.pet_skill_split_success.connect(success_cb, CONNECT_ONE_SHOT)
						game_manager.network.pet_skill_split_failed.connect(failed_cb, CONNECT_ONE_SHOT)
						game_manager.network.request_pet_skill_split(split_book_name, op_id), 
					"确认拆分", 
					"确认后立即拆分，可再按 2合1 合回去。"
				)
			)
			item_btns.append(split_btn)

	if is_sealed_suit_item:
		var inv_manager: Variant = game_manager.inventory_manager if game_manager else null
		if inv_manager:
			var reward: Dictionary = inv_manager.get_sealed_suit_item_dismantle_reward(str(item.id))
			if reward.get("success", false):
				var dismantle_btn = Button.new()
				dismantle_btn.text = "分解"
				dismantle_btn.custom_minimum_size = Vector2(160, 45)
				dismantle_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
				dismantle_btn.add_theme_font_size_override("font_size", 18)
				_apply_action_button_style(dismantle_btn)
				dismantle_btn.pressed.connect( func():
					close_popup_ref_once.call()
					_show_suit_dismantle_confirm_popup(
						_get_sealed_suit_display_name(item.custom_data), 
						str(reward.get("stone_name", "")), 
						int(reward.get("count", 0)), 
						func():
							await _run_suit_dismantle_secure( func() -> Dictionary:
								return {"sealed_item_id": str(item.id)}
							)
					)
				)
				item_btns.append(dismantle_btn)

	var store_btn = Button.new()
	store_btn.text = "存仓库"
	store_btn.custom_minimum_size = Vector2(160, 45)
	store_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	store_btn.add_theme_font_size_override("font_size", 18)
	_apply_action_button_style(store_btn)
	store_btn.pressed.connect( func():
		if _try_local_inventory_action("store_item", str(item.id), popup_ref):
			return
		if not game_manager or not game_manager.inventory_manager:
			_show_simple_dialog("存入失败", "背包管理器未初始化")
			return
		if game_manager.network != null and game_manager.network.is_logged_in():
			store_btn.disabled = true
			var state: = {"done": false, "ok": false, "message": ""}
			var op_id: = "inventory_store_warehouse_%s_%d_%d" % [str(item.id), Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			var on_success = func(data: Dictionary):
				state.done = true
				state.ok = true
				state.message = str(data.get("message", "已存入仓库"))
				if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
			var on_failed = func(error: String):
				state.done = true
				state.ok = false
				state.message = error
			game_manager.network.inventory_store_warehouse_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.inventory_store_warehouse_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_inventory_store_warehouse(str(item.id), int(item.count), op_id, str(item.name), str(item.item_type))
			var deadline: = Time.get_ticks_msec() + 15000
			while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
				await game_manager.get_tree().process_frame
			if game_manager.network.inventory_store_warehouse_success.is_connected(on_success):
				game_manager.network.inventory_store_warehouse_success.disconnect(on_success)
			if game_manager.network.inventory_store_warehouse_failed.is_connected(on_failed):
				game_manager.network.inventory_store_warehouse_failed.disconnect(on_failed)
			if not bool(state.done):
				store_btn.disabled = false
				_show_simple_dialog("存入失败", "服务器响应超时，请稍后重试。")
				return
			if not bool(state.ok):
				store_btn.disabled = false
				_show_simple_dialog("存入失败", str(state.message))
				return
			close_popup_ref_once.call()
			_show_simple_dialog("存入成功", str(state.message))
			_update_bag_view()
			return
		_show_simple_dialog("无法存仓库", "请先登录账号后再进行此操作。")
	)
	item_btns.append(store_btn)

	if DiscardProtection.cannot_discard_inventory_item(item):
		pass
	else:
		var drop_btn = Button.new()
		drop_btn.text = "丢弃"
		drop_btn.custom_minimum_size = Vector2(160, 45)
		drop_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		drop_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(drop_btn)
		drop_btn.pressed.connect( func():
			close_popup_ref_once.call()
			_show_discard_dialog(item)
		)
		item_btns.append(drop_btn)

	var close_btn = _popup_fixed_btn("取消", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	close_btn.pressed.connect(close_popup_ref_once)
	item_btns.append(close_btn)
	_popup_add_btn_grid(vbox, item_btns)

	_finish_styled_popup(popup)


func _normalize_sealed_name(name: String) -> String:
	return name.replace("（封印）", "(封印)").strip_edges()

func _get_sealed_suit_display_name(sealed_data: Dictionary) -> String:
	var SuitDatabaseDetailed = load("res://scripts/data/suit_database_detailed.gd")
	var suit_level = int(sealed_data.get("suit_level", -1))
	var slot = String(sealed_data.get("slot", ""))
	if suit_level > 0 and slot != "":
		return SuitDatabaseDetailed.get_sealed_suit_display_name(suit_level, slot)
	return String(sealed_data.get("name", "未知封印套装"))

func _find_sealed_suit_item_id(target_sealed_data: Dictionary, items: Array) -> String:
	var target_level = int(target_sealed_data.get("suit_level", -1))
	var target_slot = String(target_sealed_data.get("slot", ""))
	var target_name = _normalize_sealed_name(String(target_sealed_data.get("name", "")))

	for inv_item in items:
		if inv_item.item_type != "sealed_suit":
			continue
		var data = inv_item.custom_data if inv_item.custom_data is Dictionary else {}
		if target_level > 0 and target_slot != "":
			if int(data.get("suit_level", -1)) == target_level and String(data.get("slot", "")) == target_slot:
				return String(inv_item.id)

	if target_name != "":
		for inv_item in items:
			if inv_item.item_type != "sealed_suit":
				continue
			var data = inv_item.custom_data if inv_item.custom_data is Dictionary else {}
			if _normalize_sealed_name(String(data.get("name", ""))) == target_name:
				return String(inv_item.id)
	return ""

func _find_sealed_suit_item_id_if_unique(target_sealed_data: Dictionary, items: Array) -> String:
	var target_level = int(target_sealed_data.get("suit_level", -1))
	var target_slot = String(target_sealed_data.get("slot", ""))
	var target_name = _normalize_sealed_name(String(target_sealed_data.get("name", "")))
	var matched: Array[String] = []
	for inv_item in items:
		if inv_item.item_type != "sealed_suit":
			continue
		var data = inv_item.custom_data if inv_item.custom_data is Dictionary else {}
		if target_level > 0 and target_slot != "":
			if int(data.get("suit_level", -1)) == target_level and String(data.get("slot", "")) == target_slot:
				matched.append(String(inv_item.id))
				continue
		if target_name != "" and _normalize_sealed_name(String(data.get("name", ""))) == target_name:
			matched.append(String(inv_item.id))
	if matched.size() == 1:
		return matched[0]
	return ""


func _find_sealed_equipment_ref(target_sealed_data: Dictionary, equipment_items: Array) -> Variant:
	var target_level = int(target_sealed_data.get("suit_level", -1))
	var target_slot = String(target_sealed_data.get("slot", ""))
	var target_name = _normalize_sealed_name(String(target_sealed_data.get("name", "")))

	for equip in equipment_items:
		if not (equip and equip.is_suit and equip.is_sealed):
			continue
		var data = equip.sealed_data if equip.sealed_data is Dictionary else {}
		if target_level > 0 and target_slot != "":
			if int(data.get("suit_level", -1)) == target_level and String(data.get("slot", "")) == target_slot:
				return equip

	if target_name != "":
		for equip in equipment_items:
			if not (equip and equip.is_suit and equip.is_sealed):
				continue
			var data = equip.sealed_data if equip.sealed_data is Dictionary else {}
			if _normalize_sealed_name(String(data.get("name", ""))) == target_name:
				return equip
	return null

func _equipment_has_matching_sealed_suit(target_sealed_data: Dictionary) -> bool:
	if not game_manager or not game_manager.equipment_manager:
		return false
	return _find_sealed_equipment_ref(target_sealed_data, game_manager.equipment_manager.inventory) != null

func _resolve_sealed_suit_ref(equipment_item) -> Dictionary:
	if not game_manager or not game_manager.inventory_manager or not game_manager.equipment_manager:
		return {"source": "none"}
	if equipment_item == null or not equipment_item.is_suit or not equipment_item.is_sealed:
		return {"source": "none"}
	var sealed_data: Dictionary = equipment_item.sealed_data if equipment_item.sealed_data is Dictionary else {}
	var items: Array = game_manager.inventory_manager.items
	var equips: Array = game_manager.equipment_manager.inventory
	var eq_id: = str(equipment_item.id).strip_edges()
	var tied_inv: = str(sealed_data.get("_source_item_id", "")).strip_edges()


	if equips.has(equipment_item):
		return {"source": "equip_bag", "equipment": equipment_item}


	var inv_try_ids: Array = []
	if tied_inv != "":
		inv_try_ids.append(tied_inv)
	if eq_id != "" and not inv_try_ids.has(eq_id):
		inv_try_ids.append(eq_id)
	for try_id in inv_try_ids:
		var sid: = str(try_id).strip_edges()
		if sid.is_empty():
			continue
		for inv_item in items:
			if inv_item.item_type == "sealed_suit" and str(inv_item.id) == sid:
				return {"source": "item_bag", "item_id": sid}



	if eq_id != "":
		for equip in equips:
			if equip and equip.is_suit and equip.is_sealed and str(equip.id) == eq_id:
				return {"source": "equip_bag", "equipment": equip}

	if sealed_data.is_empty():
		return {"source": "none"}

	var inv_id_unique = _find_sealed_suit_item_id_if_unique(sealed_data, game_manager.inventory_manager.items)
	if inv_id_unique != "":
		return {"source": "item_bag", "item_id": inv_id_unique}

	return {"source": "none"}

func _unseal_suit_item(item):
	if not game_manager or not game_manager.equipment_manager:
		_show_game_alert("系统错误：装备管理器未初始化", "错误")
		return

	var SuitDatabaseDetailed = load("res://scripts/data/suit_database_detailed.gd")
	var stone_name = SuitDatabaseDetailed.get_seal_stone_name(item.suit_id)
	var unseal_cost = SuitDatabaseDetailed.get_unseal_cost()

	if not game_manager.inventory_manager.has_item(stone_name, 1):
		_show_game_alert("缺少 %s\n\n解封需要：\n- %s x1\n- %d 万金币\n\n成功率：50%%" % [stone_name, stone_name, unseal_cost.gold / 10000], "无法解封")
		return

	if game_manager.player.gold < unseal_cost.gold:
		_show_game_alert("金币不足！\n\n解封需要：\n- %s x1\n- %d 万金币\n\n当前金币：%d\n成功率：50%%" % [stone_name, unseal_cost.gold / 10000, game_manager.player.gold], "无法解封")
		return

	_show_unseal_confirm_popup(item, stone_name, unseal_cost)

func _get_total_owned_pet_count() -> int:
	if not game_manager or not game_manager.pet_manager:
		return 0
	var pm = game_manager.pet_manager
	return pm.get_pet_count() + pm.pet_bag.size()

func _get_eligible_pet_batch_release_candidates() -> Array:
	var out: Array = []
	if not game_manager or not game_manager.pet_manager:
		return out
	var pm = game_manager.pet_manager
	var active_pet = pm.get_active_pet()
	var active_id: = str(active_pet.id) if active_pet != null else ""
	for i in range(pm.get_pet_count()):
		var pet = pm.get_pet(i)
		if pet == null:
			continue
		if pet.locked:
			continue
		if active_id != "" and str(pet.id) == active_id:
			continue
		if pm.has_method("is_pet_in_assist") and pm.is_pet_in_assist(pet):
			continue
		if not DiscardProtection.is_batch_release_pet_allowed(pet):
			continue
		out.append(pet)
	return out

func _get_remaining_pet_bag_slots() -> int:
	if not game_manager or not game_manager.pet_manager:
		return 0
	var pm = game_manager.pet_manager
	return maxi(0, pm.max_pet_bag - pm.pet_bag.size())

func _get_remaining_pet_roster_slots() -> int:
	if not game_manager or not game_manager.pet_manager:
		return 0
	var pm = game_manager.pet_manager
	return maxi(0, pm.max_pets - pm.get_pet_count())

func _sort_pets_by_growth_desc(pets: Array) -> void :
	pets.sort_custom( func(a, b): return float(a.total_growth) > float(b.total_growth))

func _get_eligible_pet_batch_store_candidates() -> Array:
	var out: Array = []
	if not game_manager or not game_manager.pet_manager:
		return out
	var pm = game_manager.pet_manager
	var active_pet = pm.get_active_pet()
	var active_id: = str(active_pet.id) if active_pet != null else ""
	for i in range(pm.get_pet_count()):
		var pet = pm.get_pet(i)
		if pet == null:
			continue
		if active_id != "" and str(pet.id) == active_id:
			continue
		out.append(pet)
	_sort_pets_by_growth_desc(out)
	return out

func _get_eligible_pet_batch_retrieve_candidates() -> Array:
	if not game_manager or not game_manager.pet_manager:
		return []
	var out: Array = game_manager.pet_manager.get_all_pets_in_bag().duplicate()
	_sort_pets_by_growth_desc(out)
	return out

func _pet_batch_selection_key(pet) -> String:
	return str(pet.id) if pet != null else ""

func _rebuild_pet_batch_candidate_list(
	list_box: VBoxContainer, 
	eligible: Array, 
	selected_map: Dictionary, 
	selection_label: Label, 
	confirm_btn: Button, 
	max_selectable: int, 
	empty_text: String
) -> void :
	if list_box == null or not is_instance_valid(list_box):
		return
	for child in list_box.get_children():
		child.queue_free()
	if eligible.is_empty():
		var empty_l: = Label.new()
		empty_l.text = empty_text
		empty_l.add_theme_font_size_override("font_size", 15)
		empty_l.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
		list_box.add_child(empty_l)
		return
	for pet in eligible:
		var key: = _pet_batch_selection_key(pet)
		var is_selected: = bool(selected_map.get(key, false))
		var name_text: = "%s%s" % [str(pet.pet_name), _get_pet_quality_bracket_text(pet)]
		var detail_text: = "Lv.%d  成长 %.3f" % [int(pet.level), float(pet.total_growth)]
		var card: = _create_batch_dismantle_candidate_row(name_text, detail_text, is_selected)
		TouchScrollUtils.bind_tap(card, func():
			if selected_map.has(key):
				selected_map.erase(key)
			else:
				if selected_map.size() >= max_selectable:
					return
				selected_map[key] = true
			if is_instance_valid(selection_label):
				selection_label.text = "已选 %d 只" % selected_map.size()
			if is_instance_valid(confirm_btn):
				confirm_btn.disabled = selected_map.size() <= 0
			_rebuild_pet_batch_candidate_list(list_box, eligible, selected_map, selection_label, confirm_btn, max_selectable, empty_text)
		)
		list_box.add_child(card)

func _show_pet_batch_multi_select_popup(
	title: String, 
	empty_text: String, 
	confirm_button_text: String, 
	max_selectable: int, 
	eligible: Array, 
	on_confirm_selected: Callable
) -> void :
	var popup: = Window.new()
	popup.title = ""
	popup.size = Vector2i(560, 680)
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true
	popup.close_requested.connect( func(): popup.queue_free())
	var panel: = Panel.new()
	panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	popup.add_child(panel)
	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 18
	vbox.offset_top = 14
	vbox.offset_right = -18
	vbox.offset_bottom = -14
	vbox.add_theme_constant_override("separation", 10)
	panel.add_child(vbox)
	vbox.add_child(_build_batch_dismantle_popup_title_row(title, func(): popup.queue_free()))
	var tool_row: = HBoxContainer.new()
	tool_row.add_theme_constant_override("separation", 10)
	tool_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var select_all_btn: = Button.new()
	select_all_btn.text = "全选"
	_style_batch_dismantle_popup_tool_button(select_all_btn, 88)
	tool_row.add_child(select_all_btn)
	var clear_all_btn: = Button.new()
	clear_all_btn.text = "取消全选"
	_style_batch_dismantle_popup_tool_button(clear_all_btn, 108)
	tool_row.add_child(clear_all_btn)
	var hint_l: = Label.new()
	hint_l.text = "最多可选 %d 只" % max_selectable
	hint_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hint_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	hint_l.add_theme_font_size_override("font_size", 13)
	hint_l.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
	tool_row.add_child(hint_l)
	vbox.add_child(tool_row)
	var list_frame: = PanelContainer.new()
	list_frame.size_flags_vertical = Control.SIZE_EXPAND_FILL
	list_frame.custom_minimum_size = Vector2(0, 360)
	var frame_st: = UIStyle.create_item_style()
	list_frame.add_theme_stylebox_override("panel", frame_st)
	vbox.add_child(list_frame)
	var list_scroll: = ScrollContainer.new()
	list_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	list_frame.add_child(list_scroll)
	TouchScrollUtils.configure_scroll(list_scroll)
	var list_box: = VBoxContainer.new()
	list_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	list_box.add_theme_constant_override("separation", 8)
	list_scroll.add_child(list_box)
	var bottom_row: = HBoxContainer.new()
	bottom_row.add_theme_constant_override("separation", 12)
	bottom_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_child(bottom_row)
	var selection_label: = Label.new()
	selection_label.text = "已选 0 只"
	selection_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	selection_label.add_theme_font_size_override("font_size", 16)
	selection_label.add_theme_color_override("font_color", Color(0.85, 0.92, 1.0))
	bottom_row.add_child(selection_label)
	var cancel_btn: = Button.new()
	_style_batch_dismantle_popup_cancel_button(cancel_btn)
	cancel_btn.pressed.connect( func(): popup.queue_free())
	bottom_row.add_child(cancel_btn)
	var confirm_btn: = Button.new()
	confirm_btn.text = confirm_button_text
	confirm_btn.disabled = true
	_style_batch_dismantle_popup_confirm_button(confirm_btn)
	bottom_row.add_child(confirm_btn)
	var selected_map: Dictionary = {}
	var refresh_list: = func():
		_rebuild_pet_batch_candidate_list(list_box, eligible, selected_map, selection_label, confirm_btn, max_selectable, empty_text)
	var update_selection: = func(select_all: bool):
		selected_map.clear()
		if select_all:
			var added: = 0
			for pet in eligible:
				if added >= max_selectable:
					break
				selected_map[_pet_batch_selection_key(pet)] = true
				added += 1
		selection_label.text = "已选 %d 只" % selected_map.size()
		confirm_btn.disabled = selected_map.size() <= 0
		refresh_list.call()
	select_all_btn.pressed.connect( func(): update_selection.call(true))
	clear_all_btn.pressed.connect( func(): update_selection.call(false))
	confirm_btn.pressed.connect( func():
		var selected: Array = []
		for pet in eligible:
			if bool(selected_map.get(_pet_batch_selection_key(pet), false)):
				selected.append(pet)
		if selected.is_empty():
			return
		if on_confirm_selected.is_valid():
			on_confirm_selected.call(selected, func(): popup.queue_free())
	)
	refresh_list.call()
	add_child(popup)
	popup.popup_centered()
	UIStyle.animate_window_popup(popup)

func _show_pet_batch_release_popup() -> void :
	if not game_manager or not game_manager.network:
		_show_simple_dialog("放生失败", "系统错误：网络模块未初始化")
		return
	if not game_manager.network.is_logged_in():
		_show_simple_dialog("放生失败", "需要联网后才能放生宠物")
		return
	var total_owned: = _get_total_owned_pet_count()
	if total_owned <= 1:
		_show_simple_dialog("放生失败", "至少需要保留一只宠物")
		return
	var max_selectable: = maxi(0, total_owned - 1)
	var eligible: = _get_eligible_pet_batch_release_candidates()
	_show_pet_batch_multi_select_popup(
		"批量放生宠物", 
		"列表内暂无可放生宠物", 
		"确认放生", 
		max_selectable, 
		eligible, 
		func(selected: Array, on_close_parent: Callable):
			_confirm_pet_batch_release(selected, on_close_parent)
	)

func _show_pet_batch_store_popup() -> void :
	if not game_manager or not game_manager.network:
		_show_simple_dialog("存袋失败", "系统错误：网络模块未初始化")
		return
	if not game_manager.network.is_logged_in():
		_show_simple_dialog("存袋失败", "需要联网后才能存入宠物袋")
		return
	var bag_slots: = _get_remaining_pet_bag_slots()
	if bag_slots <= 0:
		_show_simple_dialog("存袋失败", "宠物袋已满")
		return
	var eligible: = _get_eligible_pet_batch_store_candidates()
