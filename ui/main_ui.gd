func _refresh_pet_battle_display() -> void :
	if not is_instance_valid(_battle_pet_wrap):
		return
	var field = $MainContent / BattleView / BattlePanel / SpriteField
	if not field:
		return
	var slot = _battle_pet_wrap.get_node_or_null("PetSpriteSlot")
	if not slot:
		return

	var pet = _get_battle_display_pet()
	var pet_id: = ""
	var pet_name: = "宠物"
	var pet_level: = 0
	if pet:
		pet_id = pet.get("pet_id") if pet is Dictionary else str(pet.pet_id)
		pet_name = pet.get("pet_name") if pet is Dictionary else str(pet.pet_name)
		pet_level = int(pet.get("level", 0)) if pet is Dictionary else int(pet.level)

	if is_instance_valid(_battle_pet_name_label):
		_assign_battle_unit_name(_battle_pet_name_label, pet_name if pet else "宠物", "pet", -1)
	if is_instance_valid(_battle_pet_level_label):
		if pet:
			_battle_pet_level_label.text = _format_ally_battle_level_text(pet_level)
		else:
			_battle_pet_level_label.text = ""
	if pet and is_instance_valid(_battle_pet_hp_bar):
		var pet_max_hp: int
		var pet_hp: int
		if pet is Dictionary:
			pet_max_hp = int(pet.get("max_hp", 100))
			pet_hp = int(pet.get("hp", 0))
		else:
			pet_max_hp = pet.get_final_max_hp_with_equipment()
			pet_hp = int(pet.hp)
		_update_battle_ally_wrap_hp_bar(_battle_pet_hp_bar, pet_hp, pet_max_hp)

	if pet_id.is_empty():
		if _cached_battle_pet_display_key != "" or slot.get_node_or_null("PetBattleSprite"):
			_cached_battle_pet_display_key = ""
			_clear_pet_battle_sprite_slot()
