func _get_eligible_pet_equipment_dismantle_candidates() -> Array:
	var out: Array = []
	if not game_manager or not game_manager.inventory_manager:
		return out
	for equipment in game_manager.inventory_manager.pet_equipment_items:
		if equipment == null:
			continue
		if bool(_get_pet_equip_value(equipment, "locked")):
			continue
		if PetEquipmentEnhance.can_dismantle(equipment):
			out.append(equipment)
	return out

func _pet_equipment_dismantle_selection_key(equipment) -> String:
	return str(_get_pet_equip_value(equipment, "id"))

func _rebuild_pet_equipment_dismantle_candidate_list(
	list_box: VBoxContainer, 
	eligible: Array, 
	selected_map: Dictionary, 
	selection_label: Label, 
	confirm_btn: Button
) -> void :
	if list_box == null or not is_instance_valid(list_box):
		return
	for child in list_box.get_children():
		child.queue_free()
	if eligible.is_empty():
		var empty_l: = Label.new()
		empty_l.text = "背包内暂无可分解宠物装备"
		empty_l.add_theme_font_size_override("font_size", 15)
		empty_l.add_theme_color_override("font_color", UIStyle.COLORS.text_dim)
		list_box.add_child(empty_l)
		return
	for equipment in eligible:
		var key: = _pet_equipment_dismantle_selection_key(equipment)
		var is_selected: = bool(selected_map.get(key, false))
		var name_text: = PetEquipmentEnhance.format_display_name(str(_get_pet_equip_value(equipment, "name")), int(_get_pet_equip_value(equipment, "pet_enhance_level")))
		var frag: = PetEquipmentEnhance.dismantle_fragment_count(equipment)
		var detail_text: = "+%d 宠装碎片" % frag
		var card: = _create_batch_dismantle_candidate_row(name_text, detail_text, is_selected)
		TouchScrollUtils.bind_tap(card, func():
			if selected_map.has(key):
				selected_map.erase(key)
			else:
				selected_map[key] = true
			if is_instance_valid(selection_label):
				selection_label.text = "已选 %d 件" % selected_map.size()
			if is_instance_valid(confirm_btn):
				confirm_btn.disabled = selected_map.size() <= 0
			_rebuild_pet_equipment_dismantle_candidate_list(list_box, eligible, selected_map, selection_label, confirm_btn)
		)
		list_box.add_child(card)

