		if confirm_btn.disabled:
			return
		confirm_btn.disabled = true
		confirm_btn.text = "处理中…"
		spinbox.editable = false
		if cancel_btn != null:
			cancel_btn.disabled = true
		var item_name_s: = str(item.name).strip_edges() if item else ""
		var count: = InventoryManager.clamp_pet_batch_use_count(int(spinbox.value), int(item.count)) if InventoryManager.item_uses_pet_batch_cap(item_name_s) else clampi(int(spinbox.value), 1, mini(int(item.count), batch_cap))
		if item_name_s == "宠物补章器":
			count = InventoryManager.clamp_medal_batch_use_count(int(spinbox.value), int(item.count))


		if game_manager.inventory_manager.item_used.is_connected(_on_item_used):
			game_manager.inventory_manager.item_used.disconnect(_on_item_used)


		var total_results = []
		var has_error = false
		var total_gold = 0
		var total_exp = 0
		var total_hp = 0
		var total_mp = 0
		var items_gained = {}
		var pets_gained = []
		var failed_count = 0
		var custom_summary_lines: Array = []
		var batch_authoritative_applied: = false

		var batch_iter_limit: int = count
		var wudao_quota_skipped: int = 0
		var wudao_effective_used: int = 0
		var is_auth_cultivation_pill: = InventoryManager.CULTIVATION_PILL_WHITELIST_KEYS.has(item_name_s)
		if is_auth_cultivation_pill and game_manager != null and game_manager.player != null:
			var wudao_rem: int = game_manager.player.MAX_CULTIVATION_PILLS_PER_LIFE - game_manager.player.cultivation_pills_used
			wudao_rem = maxi(0, wudao_rem)
			batch_iter_limit = mini(count, wudao_rem)
			wudao_quota_skipped = maxi(0, count - batch_iter_limit)

		if is_auth_cultivation_pill and batch_iter_limit <= 0 and count > 0:
			if is_instance_valid(dialog):
				dialog.queue_free()
			_show_simple_dialog(item_name_s, "本世额度已用尽（每世最多5颗），本次未使用。\n投胎后可继续服用。")
			_setup_bag_view_nodes()
			_clear_container(bag_item_container)
			_build_bag_item_view()
			_update_player_ui()
			if not game_manager.inventory_manager.item_used.is_connected(_on_item_used):
				game_manager.inventory_manager.item_used.connect(_on_item_used)
			return

		var wudao_fast_batch_done: = false
		if is_auth_cultivation_pill and batch_iter_limit > 0:
			wudao_fast_batch_done = true
			var wb: Dictionary = await game_manager.inventory_manager.use_cultivation_pill_batch(game_manager.player, item_name_s, batch_iter_limit)
			if bool(wb.get("authoritative_save_applied", false)):
				batch_authoritative_applied = true
			if bool(wb.get("success", false)):
				wudao_effective_used = maxi(0, int(wb.get("cultivation_pill_consumed_amount", 0)))
				if str(wb.get("message", "")).strip_edges() != "":
					total_results.append(str(wb.message))
			else:
				has_error = true
				failed_count = 1
				if str(wb.get("message", "")).strip_edges() != "":
					total_results.append("[失败] " + str(wb.message))

		var double_exp_fast_batch_done: = false
		if not wudao_fast_batch_done and InventoryManager.DOUBLE_EXP_WHITELIST_KEYS.has(item_name_s) and batch_iter_limit > 0:
			double_exp_fast_batch_done = true
			var dexp_res: Dictionary = await game_manager.inventory_manager.use_double_exp_batch(game_manager.player, item_name_s, batch_iter_limit)
			if bool(dexp_res.get("authoritative_save_applied", false)):
				batch_authoritative_applied = true
			if bool(dexp_res.get("success", false)):
				if str(dexp_res.get("message", "")).strip_edges() != "":
					total_results.append(str(dexp_res.message))
			else:
				has_error = true
				failed_count = 1
				if str(dexp_res.get("message", "")).strip_edges() != "":
					total_results.append("[失败] " + str(dexp_res.message))

		var limit_equip_fast_batch_done: = false
		if not wudao_fast_batch_done and not double_exp_fast_batch_done and item_name_s == InventoryManager.LIMIT_EQUIPMENT_GIFT_NAME and batch_iter_limit > 0:
			limit_equip_fast_batch_done = true
			var le_res: Dictionary = await game_manager.inventory_manager.use_limit_equipment_gift_batch(game_manager.player, batch_iter_limit)
			if bool(le_res.get("authoritative_save_applied", false)):
				batch_authoritative_applied = true
			if bool(le_res.get("success", false)):
				if str(le_res.get("message", "")).strip_edges() != "":
					total_results.append(str(le_res.message))
			else:
				has_error = true
				failed_count = batch_iter_limit
				if str(le_res.get("message", "")).strip_edges() != "":
					total_results.append("[失败] " + str(le_res.message))

		var medal_fast_batch_done: = false
		if not wudao_fast_batch_done and not double_exp_fast_batch_done and not limit_equip_fast_batch_done and item_name_s == "宠物补章器" and batch_iter_limit > 0:
			medal_fast_batch_done = true
			var medal_batch_count: = InventoryManager.clamp_medal_batch_use_count(batch_iter_limit, int(item.count))
			var mb_res: Dictionary = await game_manager.inventory_manager.use_pet_medal_batch(medal_batch_count)
			if bool(mb_res.get("authoritative_save_applied", false)):
				batch_authoritative_applied = true
			if bool(mb_res.get("success", false)):
				if str(mb_res.get("message", "")).strip_edges() != "":
					total_results.append(str(mb_res.message))
			else:
				has_error = true
				failed_count = medal_batch_count
				if str(mb_res.get("message", "")).strip_edges() != "":
					total_results.append("[失败] " + str(mb_res.message))

		if not wudao_fast_batch_done and not double_exp_fast_batch_done and not limit_equip_fast_batch_done and not medal_fast_batch_done:
			var batch_handled: = false

			if not batch_handled and count > 1 and InventoryManager.item_uses_pet_batch_cap(item_name_s):
				var pet_batch_result: Dictionary = {}
				if InventoryManager.SERVER_AUTH_PET_EGG_NAMES.has(item_name_s):
					pet_batch_result = await game_manager.inventory_manager.use_pet_egg_batch(item.id, game_manager.player, count)
				elif item_name_s == "离线宠物锦囊":
					pet_batch_result = await game_manager.inventory_manager.use_offline_pet_gift_batch(item.id, game_manager.player, count)
				elif FestivalGiftManager.is_festival_gift(item_name_s):
					pet_batch_result = await FestivalGiftManager.use_festival_gift_batch(item.id, game_manager.player, count, item_name_s)
				elif item_name_s == "天关锦囊" or (item_name_s.ends_with("关礼包") and item_name_s != InventoryManager.BROTHER_TOWER_GIFT_NAME):
					pet_batch_result = await game_manager.inventory_manager.use_tower_gift_batch(item.id, game_manager.player, count)
				else:
					pet_batch_result = await game_manager.inventory_manager.use_server_gift_batch(item.id, game_manager.player, count)
				var pbres: Dictionary = pet_batch_result if pet_batch_result is Dictionary else {"success": false, "message": "批量操作失败"}
				if bool(pbres.get("authoritative_save_applied", false)):
					batch_authoritative_applied = true
				if bool(pbres.get("success", false)):
					custom_summary_lines = pbres.get("summary_lines", []) if pbres.get("summary_lines", []) is Array else []
					if FestivalGiftManager.is_festival_gift(item_name_s) or item_name_s == "天关锦囊" or item_name_s.ends_with("关礼包"):
						total_gold += int(pbres.get("total_gold", 0))
					total_results.append(str(pbres.get("message", "")))
				else:
					has_error = true
					failed_count = count
					total_results.append("[失败] " + str(pbres.get("message", "批量操作失败")))
				batch_handled = true
			for i in range(batch_iter_limit):
				if batch_handled:
					break
				var batch_item_name: = item_name_s
				if InventoryManager.GOLD_BAG_CONFIG.has(batch_item_name) and count > 1:
					var gb_cfg = InventoryManager.GOLD_BAG_CONFIG[batch_item_name]
					var gb_amount: int = int(gb_cfg.get("amount", 0))
					var batch_result = await game_manager.inventory_manager.use_gold_bag_batch(item.id, game_manager.player, count)
					var result: Dictionary = batch_result if batch_result is Dictionary else {"success": false, "message": "批量操作失败"}
					if bool(result.get("authoritative_save_applied", false)):
						batch_authoritative_applied = true
					if result.success:
						total_gold += count * gb_amount
						total_results.append(result.message)
					else:
						has_error = true
						failed_count = count
						total_results.append("[失败] " + str(result.message))
					break
				var result_raw = await game_manager.inventory_manager.use_item(item.id, game_manager.player)
				var result: Dictionary = result_raw if result_raw is Dictionary else {"success": false, "message": "操作失败，请重试"}
				if bool(result.get("authoritative_save_applied", false)):
					batch_authoritative_applied = true
				if result.success:
					if InventoryManager.CULTIVATION_PILL_WHITELIST_KEYS.has(str(batch_item_name).strip_edges()) and bool(result.get("cultivation_pill_stock_consumed", false)):
						wudao_effective_used += maxi(0, int(result.get("cultivation_pill_consumed_amount", 0)))
					var rm: = str(result.get("message", "")).strip_edges()
					if rm != "":
						total_results.append(rm)

					var msg = result.message
					if msg != "":

						var gold_match = msg.find("获得")
						if gold_match != -1:
							var gold_str = msg.substr(gold_match + 2)
							var gold_end = gold_str.find("金币")
							if gold_end != -1:
								var gold_num = gold_str.substr(0, gold_end).strip_edges()
								if gold_num.is_valid_int():
									total_gold += int(gold_num)


						var exp_match = msg.find("获得")
						if exp_match != -1:
							var exp_str = msg.substr(exp_match + 2)
							var exp_end = exp_str.find("经验")
							if exp_end != -1:
								var exp_num = exp_str.substr(0, exp_end).strip_edges()
								if exp_num.is_valid_int():
									total_exp += int(exp_num)


						var hp_match = msg.find("恢复")
						if hp_match != -1:
							var hp_str = msg.substr(hp_match + 2)
							var hp_end = hp_str.find("点生命")
							if hp_end != -1:
								var hp_num = hp_str.substr(0, hp_end).strip_edges()
								if hp_num.is_valid_int():
									total_hp += int(hp_num)


						var mp_match = msg.find("恢复")
						if mp_match != -1:
							var mp_str = msg.substr(mp_match + 2)
							var mp_end = mp_str.find("点内力")
							if mp_end != -1:
								var mp_num = mp_str.substr(0, mp_end).strip_edges()
								if mp_num.is_valid_int():
									total_mp += int(mp_num)


						if msg.find("获得") != -1 and msg.find("宠物") == -1:
							var is_server_pet_reward_line: bool = msg.find("获得【") != -1 and msg.find("成长") != -1
							if not is_server_pet_reward_line:
								var item_name = ""
								var item_start = msg.find("获得") + 2
								var item_end = msg.find("x")
								if item_end == -1:
									item_end = msg.length()
								item_name = msg.substr(item_start, item_end - item_start).strip_edges()
								if item_name != "" and not item_name.is_valid_int():
									if items_gained.has(item_name):
										items_gained[item_name] += 1
									else:
										items_gained[item_name] = 1


						if msg.find("获得宠物") != -1:
							var pet_start = msg.find("获得宠物") + 4
							var pet_name = msg.substr(pet_start).strip_edges()
							if pet_name != "":
								pets_gained.append(pet_name)
				else:
					has_error = true
					failed_count += 1
					if result.message != "":
						total_results.append("[失败] " + result.message)
					break

		var item_display_name: = str(item.name) if item else ""
		var gb_summary_cfg = InventoryManager.GOLD_BAG_CONFIG.get(item_display_name)
		var summary_use_count: int = count - failed_count
		if InventoryManager.CULTIVATION_PILL_WHITELIST_KEYS.has(str(item_display_name).strip_edges()):
			summary_use_count = wudao_effective_used
		var summary: Array = []
		if not custom_summary_lines.is_empty():
			summary = custom_summary_lines.duplicate()
		elif gb_summary_cfg != null and total_gold > 0:
			var gb_sponsor: String = str(gb_summary_cfg.get("sponsor", ""))
			summary.append("批量使用了 %d 个%s" % [summary_use_count, item_display_name])
			summary.append("获得%s大佬赞助的%d金币！" % [gb_sponsor, total_gold])
		else:
			summary.append("批量使用了 %d 个%s" % [summary_use_count, item.name])
			if total_gold > 0:
				summary.append("获得金币：%d" % total_gold)
		if custom_summary_lines.is_empty() and gb_summary_cfg == null:
			for tr_line in total_results:
				var tr_s: = str(tr_line).strip_edges()
				if tr_s != "":
					summary.append(tr_s)
		if total_exp > 0:
			summary.append("获得经验：%d" % total_exp)
		if total_hp > 0:
			summary.append("恢复生命：%d" % total_hp)
		if total_mp > 0:
			summary.append("恢复内力：%d" % total_mp)

		for item_name in items_gained.keys():
			summary.append("获得%s x%d" % [item_name, items_gained[item_name]])

		for pet_name in pets_gained:
			summary.append("获得宠物：%s" % pet_name)

		if failed_count > 0:
			summary.append("失败次数：%d" % failed_count)
		if wudao_quota_skipped > 0:
			summary.append("本世修行丹药限用5颗，已跳过 %d 次（未扣道具）" % wudao_quota_skipped)


		var persisted_ok: = true
		if summary_use_count > 0 and not batch_authoritative_applied:
			persisted_ok = await game_manager.force_cloud_upload_and_wait("reward_batch_use", true, 30.0)


		if is_instance_valid(dialog):
			dialog.queue_free()
		var result_title = "批量使用结果" if not has_error else "批量使用完成（部分失败）"
		var result_message = "\n".join(summary)
		if not persisted_ok:
			result_title = "批量使用完成（同步未确认）"
			result_message += "\n\n云端同步未确认完成，请稍后重试或重新登录确认结果。"
		_show_simple_dialog(result_title, result_message)


		_setup_bag_view_nodes()
		_clear_container(bag_item_container)
		_build_bag_item_view()
		_update_player_ui()
		if batch_authoritative_applied:
			_refresh_pet_roster_after_authority_reward()
		else:
			_update_pet_ui()
		if not game_manager.inventory_manager.item_used.is_connected(_on_item_used):
			game_manager.inventory_manager.item_used.connect(_on_item_used)
	)
	btn_hbox.add_child(confirm_btn)


	cancel_btn = Button.new()
	cancel_btn.text = "取消"
	cancel_btn.custom_minimum_size = Vector2(80, 35)
	_apply_action_button_style(cancel_btn)
	cancel_btn.pressed.connect( func(): dialog.queue_free())
	btn_hbox.add_child(cancel_btn)

	vbox.add_child(btn_hbox)

	panel.add_child(vbox)
	dialog.add_child(panel)
	add_child(dialog)
	dialog.popup_centered()


func _show_drop_equipment_confirm_popup(equip_id: String, equip_name: String):
	var popup = Window.new()
	popup.title = ""
	popup.size = Vector2i(380, 280)
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	popup.add_child(main_panel)

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 25
	vbox.offset_top = 25
	vbox.offset_right = -25
	vbox.offset_bottom = -25
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 20)
	main_panel.add_child(vbox)

	var title_label = Label.new()
	title_label.text = "确认丢弃"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 22)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title_label)

	var name_label = Label.new()
	name_label.text = equip_name
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.add_theme_font_size_override("font_size", 18)
	name_label.add_theme_color_override("font_color", Color(1, 0.9, 0.5))
	vbox.add_child(name_label)

	var msg_label = Label.new()
	msg_label.text = "确定要丢弃吗？\n此操作不可恢复！"
	msg_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	msg_label.add_theme_font_size_override("font_size", 16)
	msg_label.add_theme_color_override("font_color", Color(0.9, 0.7, 0.7))
	vbox.add_child(msg_label)

	var btn_hbox = HBoxContainer.new()
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	btn_hbox.add_theme_constant_override("separation", 20)
	vbox.add_child(btn_hbox)

	var cancel_btn = Button.new()
	cancel_btn.text = "取消"
	UIStyle.style_popup_button(cancel_btn, false)
	cancel_btn.pressed.connect( func(): popup.queue_free())
	btn_hbox.add_child(cancel_btn)

	var confirm_btn = Button.new()
	confirm_btn.text = "确认丢弃"
	UIStyle.style_popup_button(confirm_btn, true)
	confirm_btn.pressed.connect( func():
		if not game_manager or not game_manager.network:
			_show_simple_dialog("丢弃失败", "系统错误：网络模块未初始化")
			return
		if not game_manager.network.is_logged_in():
			_show_simple_dialog("丢弃失败", "当前网络不可用，宠装丢弃需联网并由服务器确认。")
			return
		popup.queue_free()
		_run_pet_equipment_drop_secure(equip_id)
	)
	btn_hbox.add_child(confirm_btn)

	add_child(popup)
	popup.popup_centered()
	UIStyle.animate_window_popup(popup)


func _show_unseal_confirm_popup(item, stone_name: String, unseal_cost: Dictionary):
	var popup = Window.new()
	popup.title = ""
	popup.size = Vector2i(420, 380)
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())
	popup.add_child(main_panel)

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 25
	vbox.offset_top = 25
	vbox.offset_right = -25
	vbox.offset_bottom = -25
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	vbox.add_theme_constant_override("separation", 15)
	main_panel.add_child(vbox)

	var title_label = Label.new()
	title_label.text = "确认解封"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 22)
	title_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title_label)

	var name_label = Label.new()
	name_label.text = item.name
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.add_theme_font_size_override("font_size", 18)
	name_label.add_theme_color_override("font_color", Color(1, 0.9, 0.5))
	vbox.add_child(name_label)

	var cost_label = Label.new()
	cost_label.text = "消耗：\n- %s x1\n- %d 万金币\n\n成功率：50%%" % [stone_name, unseal_cost.gold / 10000]
	cost_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	cost_label.add_theme_font_size_override("font_size", 15)
	cost_label.add_theme_color_override("font_color", Color(0.8, 0.8, 0.9))
	vbox.add_child(cost_label)

	var warning_label = Label.new()
	warning_label.text = "注意：解封失败将损失解封石和金币！"
	warning_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	warning_label.add_theme_font_size_override("font_size", 14)
	warning_label.add_theme_color_override("font_color", Color(0.9, 0.7, 0.7))
	vbox.add_child(warning_label)

	var btn_hbox = HBoxContainer.new()
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	btn_hbox.add_theme_constant_override("separation", 20)
	vbox.add_child(btn_hbox)

	var cancel_btn = Button.new()
	cancel_btn.text = "取消"
	UIStyle.style_popup_button(cancel_btn, false)
	cancel_btn.pressed.connect( func(): popup.queue_free())
	btn_hbox.add_child(cancel_btn)

	var confirm_btn = Button.new()
	confirm_btn.text = "确认解封"
	UIStyle.style_popup_button(confirm_btn, true)
	confirm_btn.pressed.connect( func():
		if not game_manager.network or not game_manager.network.is_logged_in():
			_show_simple_dialog("解封失败", "当前网络不可用，已阻止解封。\n为防止断网SL，解封需联网并由服务器确认。")
			popup.queue_free()
			return
		var sealed_ref = _resolve_sealed_suit_ref(item)
		if String(sealed_ref.get("source", "")) == "none":
			_show_game_alert("未找到封印套装道具", "解封失败")
			popup.queue_free()
			return
		confirm_btn.disabled = true
		cancel_btn.disabled = true
		var source = String(sealed_ref.get("source", ""))
		var equipment_id: = ""
		var sealed_item_id: = ""
		if source == "item_bag":
			sealed_item_id = String(sealed_ref.get("item_id", "")).strip_edges()
		elif source == "equip_bag":
			var sealed_equipment = sealed_ref.get("equipment", null)
			if sealed_equipment:
				equipment_id = str(sealed_equipment.id).strip_edges()



		var sd_unseal: Dictionary = item.sealed_data if item != null and item.sealed_data is Dictionary else {}
		if source == "equip_bag" and game_manager and game_manager.inventory_manager:
			var inv_match: = _find_sealed_suit_item_id_if_unique(sd_unseal, game_manager.inventory_manager.items)
			if inv_match != "" and sealed_item_id.is_empty():
				sealed_item_id = String(inv_match).strip_edges()
		var op_id: = "equipment_unseal_%s_%s_%d_%d" % [equipment_id, sealed_item_id, Time.get_unix_time_from_system(), Time.get_ticks_msec()]
		var on_success = func(data: Dictionary):
			if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
				game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
			var result: Dictionary = data.get("result", {}) if data.get("result", {}) is Dictionary else {}
			var ok: = bool(result.get("success", false))
			if ok:
				_add_log("[color=green]★ %s ★[/color]" % data.get("message", "解封成功"))
				_show_game_alert(data.get("message", "解封成功"), "解封成功")
			else:
				var fail_msg: = str(result.get("message", "")).strip_edges()
				if fail_msg.is_empty():
					fail_msg = str(data.get("message", "")).strip_edges()
				if fail_msg.is_empty():
					fail_msg = "解封失败"
				_add_log("[color=red]%s[/color]" % fail_msg)
				_show_simple_dialog("解封失败", fail_msg)
			_update_bag_view()
			_update_character_view()
			_update_player_ui()
			if is_instance_valid(popup):
				popup.queue_free()
		var on_failed = func(error: String):
			if is_instance_valid(confirm_btn):
				confirm_btn.disabled = false
			if is_instance_valid(cancel_btn):
				cancel_btn.disabled = false
			_show_simple_dialog("解封失败", error)
		game_manager.network.equipment_unseal_suit_success.connect(on_success, CONNECT_ONE_SHOT)
		game_manager.network.equipment_unseal_suit_failed.connect(on_failed, CONNECT_ONE_SHOT)
		game_manager.network.request_equipment_unseal_suit(equipment_id, sealed_item_id, op_id)
	)
	btn_hbox.add_child(confirm_btn)

	add_child(popup)
	popup.popup_centered()
	UIStyle.animate_window_popup(popup)

