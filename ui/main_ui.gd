	if _attr_panel_refresh_pending:
		_attr_panel_refresh_reschedule = true
		return
	_attr_panel_refresh_pending = true
	call_deferred("_run_character_attr_panel_refresh")

func _run_character_attr_panel_refresh() -> void :
