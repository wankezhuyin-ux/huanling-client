## 综合战力 —— 纯展示口径（战斗结算不用它）。
## 权重按"这场仗里各属性值多少"来配：攻击直接乘伤害，生命/内力换的是容错。
## 数字只是为了给玩家一个"我变强了"的纵向对比，不参与任何判定。
func _player_power_score(player) -> int:
	if player == null:
		return 0
	var hp: float = float(player.max_hp)
	var mp: float = float(player.max_mp)
	var atk: float = float(player.attack_base)
	var def: float = float(player.defense_base)
	var agi: float = float(player.agility_base)
	return int(hp * 0.5 + mp * 0.4 + atk * 12.0 + def * 10.0 + agi * 8.0)


## 千分位：战力是六位数，不分组就读不出来
func _format_big_number(v: int) -> String:
	var raw: = str(absi(v))
	var out: = ""
	var cnt: = 0
	for i in range(raw.length() - 1, -1, -1):
		out = raw[i] + out
		cnt += 1
		if cnt % 3 == 0 and i > 0:
			out = "," + out
	return ("-" if v < 0 else "") + out


## 一条极简资源条：底槽 + 填充 + 左上角标签
func _ink_resource_bar(label_text: String, cur: float, maxv: float, fill: Color, width: float) -> Control:
	var s: = _ink_s()
	var host: = VBoxContainer.new()
	host.add_theme_constant_override("separation", int(round(2.0 * s)))
	host.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", int(round(6.0 * s)))
	head.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head.add_child(_ink_text(label_text, 17.0, Color(0.62, 0.58, 0.50), false))
	var sp: = Control.new()
	sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sp.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head.add_child(sp)
	head.add_child(_ink_text("%d / %d" % [int(cur), int(maxv)], 16.0, Color(0.74, 0.70, 0.60), false))
	host.add_child(head)
	var track: = Control.new()
	track.custom_minimum_size = Vector2(minf(width, 120.0 * s), 7.0 * s)
	track.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	track.mouse_filter = Control.MOUSE_FILTER_IGNORE
	host.add_child(track)
	var bg: = ColorRect.new()
	bg.color = Color(0.02, 0.018, 0.013, 0.85)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	track.add_child(bg)
	bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var ratio: float = clampf(cur / maxf(maxv, 1.0), 0.0, 1.0)
	var fg: = ColorRect.new()
	fg.color = fill
	fg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	track.add_child(fg)
	fg.set_anchors_and_offsets_preset(Control.PRESET_LEFT_WIDE)
	fg.offset_right = maxf(2.0, width * ratio)
	return host


## 角色光环双圆环（设计稿 .halo/.ring/.ring.i2）：底光晕 + 外环亮金 + 内环淡金。
## 挂在 Control 的 draw 信号上画，不引新类。
func _draw_hero_rings(c: Control, r_out: float, r_in: float) -> void:
	# 圆心直接取立绘的落点（含包围盒偏移），圆环才和人重合
	var center: = Vector2(c.size.x * 0.5, c.size.y * 0.44)
	var host: = c.get_parent()
	if host != null:
		if host.has_meta("hero_cx"):
			center.x = float(host.get_meta("hero_cx"))
		if host.has_meta("hero_cy"):
			center.y = float(host.get_meta("hero_cy"))
	var gold: = Color(0.788, 0.635, 0.294)
	c.draw_circle(center, r_out * 1.06, Color(gold.r, gold.g, gold.b, 0.05))
	c.draw_arc(center, r_out, 0.0, TAU, 72, Color(gold.r, gold.g, gold.b, 0.34), 1.4, true)
	c.draw_arc(center, r_in, 0.0, TAU, 72, Color(gold.r, gold.g, gold.b, 0.14), 1.0, true)


