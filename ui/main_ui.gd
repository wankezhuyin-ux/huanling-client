func _run_suit_dismantle_secure(dismantle_action: Callable) -> void :
	if not game_manager or not game_manager.network:
		_show_simple_dialog("分解失败", "系统错误：网络模块未初始化")
		return
	if not game_manager.network.is_logged_in():
		_show_simple_dialog("分解失败", "当前网络不可用，已阻止分解。\n为防止断网SL，套装分解需联网并由服务器确认。")
		return
	var payload = dismantle_action.call()
	if not (payload is Dictionary):
		_show_simple_dialog("分解失败", "分解参数错误")
		return
	var op_id: = "equipment_dismantle_suit_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
	var on_success = func(data: Dictionary):
		if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
			game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
			game_manager.strip_local_after_authoritative_suit_dismantle(
				str(payload.get("equipment_id", "")), 
				str(payload.get("sealed_item_id", ""))
			)
		_update_bag_view()
		_show_simple_dialog("分解成功", str(data.get("message", "分解成功")))
	var on_failed = func(error: String):
		_show_simple_dialog("分解失败", error)
	game_manager.network.equipment_dismantle_suit_success.connect(on_success, CONNECT_ONE_SHOT)
	game_manager.network.equipment_dismantle_suit_failed.connect(on_failed, CONNECT_ONE_SHOT)
	game_manager.network.request_equipment_dismantle_suit(str(payload.get("equipment_id", "")), str(payload.get("sealed_item_id", "")), op_id)

