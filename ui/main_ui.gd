func _on_brother_tower_battle_ended(victory: bool):
	_clear_brother_tower_coop_battle_ui()
	if victory:
		var complete_result: Dictionary = game_manager.brother_tower_last_complete_result if game_manager else {}
		if bool(complete_result.get("ok", false)):
			var data = complete_result.get("data", {})
			if data is Dictionary and not data.is_empty():
				_brother_tower_victory_pending_popup = false
				_brother_tower_complete_result_cache = {}
				_refresh_brother_tower_mail_if_needed(data)
				var reward_text: = _format_brother_tower_complete_rewards(data)
				if _brother_tower_victory_popup_shown:
					_update_brother_tower_victory_reward_text(reward_text)
					return
				_show_brother_tower_result_dialog(true, reward_text)
				_brother_tower_victory_popup_shown = true
				return
		if not _brother_tower_complete_result_cache.is_empty():
			var cached: = _brother_tower_complete_result_cache
			_brother_tower_complete_result_cache = {}
			_brother_tower_victory_pending_popup = false
			_refresh_brother_tower_mail_if_needed(cached)
			var cached_text: = _format_brother_tower_complete_rewards(cached)
			if _brother_tower_victory_popup_shown:
				_update_brother_tower_victory_reward_text(cached_text)
				return
			_show_brother_tower_result_dialog(true, cached_text)
			_brother_tower_victory_popup_shown = true
		else:
			_brother_tower_victory_pending_popup = true
			_show_brother_tower_result_dialog(true, "联手通关！")
			if game_manager and game_manager.network:
				call_deferred("_brother_tower_complete_popup_watchdog_async")
			else:
				_brother_tower_victory_pending_popup = false
	else:
		_brother_tower_complete_result_cache = {}
		_brother_tower_victory_pending_popup = false
		_show_brother_tower_result_dialog(false, "无奖励")

func _brother_tower_complete_popup_watchdog_async() -> void :
	var waited: = 0.0
	while waited < 15.0 and _brother_tower_victory_pending_popup:
		await get_tree().create_timer(0.5).timeout
		waited += 0.5
	if not _brother_tower_victory_pending_popup:
		return
	_brother_tower_victory_pending_popup = false
	_update_brother_tower_victory_reward_text("奖励详情加载中，请稍候查看邮件「兄弟天关奖励」")

func _on_brother_tower_complete_success(data: Dictionary) -> void :
	_bt_ui_script().clear_lobby_after_battle_end(game_manager)
	if game_manager and game_manager.network:
		game_manager.network.get_brother_tower_poll("lobby")
	_refresh_brother_tower_mail_if_needed(data)
	var reward_text: = _format_brother_tower_complete_rewards(data)
	if _brother_tower_victory_pending_popup:
		_brother_tower_victory_pending_popup = false
		if _brother_tower_victory_popup_shown:
			_update_brother_tower_victory_reward_text(reward_text)
		else:
			_show_brother_tower_result_dialog(true, reward_text)
	elif _brother_tower_victory_popup_shown:
		_update_brother_tower_victory_reward_text(reward_text)
	else:
		_brother_tower_complete_result_cache = data

func _on_brother_tower_complete_failed(error: String) -> void :
	var err_text: = str(error).strip_edges()
	if err_text.contains("未通关") or err_text.contains("无法结算"):
		return
	_brother_tower_complete_result_cache = {}
	if not _brother_tower_victory_pending_popup:
		return
	_brother_tower_victory_pending_popup = false
	if err_text.is_empty():
		err_text = "奖励发放异常，请查看邮件或重新登录"
	else:
		err_text = "奖励发放异常：%s（可查看邮件或重新登录）" % err_text
	_show_brother_tower_result_dialog(false, err_text)

func _normalize_bt_reward_display_data(data: Dictionary) -> Dictionary:
	var normalized: = data.duplicate(true)
	if str(normalized.get("rewardType", "none")) != "gift_mail":
		return normalized
	var friendship_gain: = maxi(0, int(normalized.get("friendshipGain", 0)))
	if friendship_gain > 0:
		normalized["rewardType"] = "friendship"
		return normalized
	if not bool(normalized.get("mailSent", false)):
		return normalized
	var bt_ui: = _bt_ui_script()
	var daily_reward_max: = int(normalized.get("dailyRewardMax", bt_ui._daily_reward_max()))
	if daily_reward_max <= 0:
		daily_reward_max = 1
	var daily_reward_count: = int(normalized.get("dailyRewardCount", bt_ui._daily_reward_count()))
	var daily_clear_count: = int(normalized.get("dailyClearCount", bt_ui._daily_clear_count()))
	if daily_clear_count > daily_reward_count or daily_clear_count > daily_reward_max:
		normalized["rewardType"] = "friendship"
		normalized["friendshipGain"] = _bt_friendship_gain_fallback(normalized)
	return normalized

func _bt_friendship_gain_fallback(data: Dictionary) -> int:
	var bt_mgr: = _bt_mgr_script()
	var difficulty: String = bt_mgr.normalize_difficulty(
		data.get("difficulty", game_manager.brother_tower_difficulty if game_manager else bt_mgr.DIFFICULTY_EASY)
	)
	if game_manager and game_manager.has_method("get_brother_tower_difficulty_preset"):
		var preset: Dictionary = game_manager.get_brother_tower_difficulty_preset(difficulty)
		var gain: = int(preset.get("friendshipGain", 0))
		if gain > 0:
			return gain
	var preset: Dictionary = bt_mgr.get_difficulty_preset(difficulty, game_manager)
	return maxi(1, int(preset.get("friendshipGain", 0)))

func _format_brother_tower_complete_rewards(data: Dictionary) -> String:
	var normalized: = _normalize_bt_reward_display_data(data)
	var reward_type: = str(normalized.get("rewardType", "none"))
	match reward_type:
		"gift_mail":
			if bool(normalized.get("mailSent", false)):
				var gift_count: = maxi(1, int(normalized.get("giftCount", 1)))
				return "天关组队锦囊 ×%d（请查收邮件「兄弟天关奖励」）" % gift_count
			var fallback_friendship: = maxi(0, int(normalized.get("friendshipGain", 0)))
			if fallback_friendship > 0:
				return "今日礼包已领，获得友情点 ×%d" % fallback_friendship
			return "今日通关次数已满，无额外奖励"
		"friendship":
			var friendship_gain: = maxi(1, int(normalized.get("friendshipGain", 0)))
			return "友情点 ×%d" % friendship_gain
		_:
			return "无奖励"

