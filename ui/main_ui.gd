func _try_open_player_character_switch_popup() -> void :
	if not game_manager:
		return
	if game_manager.in_battle:
		_show_tip_popup("请先停止战斗")
		return
	if game_manager.is_auto_battle_enabled():
		_show_tip_popup("请先停止自动战斗后再切换角色")
		return
	if game_manager.network == null or game_manager.network.auth_token == "":
		_show_tip_popup("请先登录后再切换角色")
		return
	_show_player_character_switch_popup()

