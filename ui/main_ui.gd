func _on_pet_skill_learn_success(data: Dictionary):
	var msg = str(data.get("message", "学习成功"))
	_show_simple_dialog("学习成功", msg)
	_update_pet_view()

func _on_pet_max_level_learn_success(data: Dictionary):
	var pending_restore: Array = []
	if game_manager and game_manager.pet_manager and game_manager.pet_manager.has_method("snapshot_pending_skill_learn_syncs"):
		pending_restore = game_manager.pet_manager.snapshot_pending_skill_learn_syncs()
	if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(data.get("saveData"), {"pets_authoritative": true, "skip_deferred_cloud_save": true, "skip_pet_collection_trim": true})
		game_manager.save_game(false)
	if game_manager and game_manager.pet_manager and game_manager.pet_manager.has_method("restore_pending_skill_learn_syncs"):
		game_manager.pet_manager.restore_pending_skill_learn_syncs(pending_restore)
	_update_pet_view()
	_chain_flush_pending_pet_skill_learn()
	if not bool(data.get("learned", false)):
		return
	show_pet_max_level_learn_popup(data.get("learnedSkill", {}))

func show_pet_max_level_learn_popup(learned: Variant = null) -> void :
	var skill_name: = "新技能"
	var skill_lv: = 1
	if learned is Dictionary:
		skill_name = str((learned as Dictionary).get("skill_name", (learned as Dictionary).get("skillName", "新技能"))).strip_edges()
		if skill_name.is_empty():
			skill_name = "新技能"
		skill_lv = maxi(1, int((learned as Dictionary).get("level", 1)))
	_show_simple_dialog("满级领悟", "宠物领悟了【%slv%d】！" % [skill_name, skill_lv])

func _on_pet_max_level_learn_failed(_error_msg: String):

	_chain_flush_pending_pet_skill_learn()

func _chain_flush_pending_pet_skill_learn() -> void :
	if game_manager == null or game_manager.pet_manager == null:
		return
	if not game_manager.pet_manager.has_method("flush_pending_pet_skill_learn_syncs"):
		return
	game_manager.pet_manager.call_deferred("flush_pending_pet_skill_learn_syncs")

func _on_pet_skill_learn_failed(error_msg: String):
	_show_simple_dialog("学习失败", str(error_msg))

func _on_martial_skill_book_success(data: Dictionary):
