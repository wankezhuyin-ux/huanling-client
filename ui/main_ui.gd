func _get_pet_soul_reward_map_parts() -> PackedStringArray:
	var map_parts: PackedStringArray = []
	for element in ["金", "木", "水", "火", "土"]:
		for pet_id in GameData.SOUL_REWARD_PET_LIBRARY:
			var pdata: Dictionary = GameData.SOUL_REWARD_PET_LIBRARY[pet_id]
			if str(pdata.get("element", "")) == element:
				map_parts.append("%s→%s" % [element, str(pdata.get("name", pet_id))])
				break
	return map_parts

func _get_pet_soul_rules_lines() -> Array:
	var cfg: = _get_pet_soul_runtime_cfg()
	var rule_a_min: = float(cfg.get("ruleAGrowthMin", 6.0))
	var rule_b_min_evo: = float(cfg.get("ruleBGrowthMinEvolution", 50.0))
	var rule_b_min_norm: = float(cfg.get("ruleBGrowthMinNormal", 45.0))
	var pts_min: = int(cfg.get("ruleBPointsMin", 40))
	var pts_max: = int(cfg.get("ruleBPointsMax", 60))
	var growth_offset: = int(cfg.get("growthToPointsOffset", 5))
	var bonus_cap: = int(cfg.get("bonusCapPercent", 100))
	var lines: = [
		{"prefix": "1）可投入宠物：", "content": "①1级0代幼年形态的可进化宠，成长达到%.1f以上；②1级0代不可进化宠，成长达到%.1f以上；③3代满级（不可进化1500级/可进化1200级且须终极形态）且不可进化成长≥%.0f、可进化成长≥%.0f。" % [rule_a_min, rule_a_min, rule_b_min_norm, rule_b_min_evo]}, 
		{"prefix": "2）点数增加：", "content": "①符合条件的1级0代宠物，按“成长值整数部分减%d”获得点数；②3代满级每次随机增加%d~%d点，成长越高越容易获得%d点。" % [growth_offset, pts_min, pts_max, pts_max]}, 
		{"prefix": "3）加成成长：", "content": "每升1%%所需点数为10、30、50、70……（每级+20），最高可提升%d%%。" % bonus_cap}, 
		{"prefix": "4）生效范围：", "content": "仅对出战宠物生效，按出战宠物五行属性应用对应加成；仅在五行相克/被克时生效并参与结算。"}
	]
	if bool(cfg.get("rebirthEnabled", true)):
		var chance_pct: = int(round(float(cfg.get("rebirthChance", 0.5)) * 100.0))
		var g_min: = float(cfg.get("rebirthGrowthMin", 6.0))
		var g_max: = float(cfg.get("rebirthGrowthMax", 8.0))
		var mut_cfg: Dictionary = {}
		if game_manager and game_manager.has_method("get_pet_mutation_runtime_config"):
			mut_cfg = game_manager.get_pet_mutation_runtime_config()
		var mut_chance_pct: = int(round(float(mut_cfg.get("soulMutateChance", 0.1)) * 100.0))
		var mut_g_min: = float(mut_cfg.get("soulMutateGrowthMin", 7.0))
		var mut_g_max: = float(mut_cfg.get("soulMutateGrowthMax", 9.0))
		var map_parts: = _get_pet_soul_reward_map_parts()
		lines.append({
			"prefix": "5）魂魄重生：", 
			"content": "仅限3代满级投入，成功后另有%d%%几率获得同五行魂魄重生宠（1级0代不可进化，成长%.1f~%.1f），邮件发放、每次最多1只，须前往邮箱领取。获得重生宠时，%d%%几率成为变异1品质（成长%.1f~%.1f）。对应：%s。" % [chance_pct, g_min, g_max, mut_chance_pct, mut_g_min, mut_g_max, "、".join(map_parts)]
		})
	return lines

