		"批量存袋", 
		"列表内暂无可存袋宠物", 
		"确认存袋", 
		max_selectable, 
		eligible, 
		func(selected: Array, on_close_parent: Callable):
			_confirm_pet_batch_store(selected, on_close_parent)
	)

