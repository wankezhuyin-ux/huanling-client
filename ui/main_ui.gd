## 内页统一按钮：描金细边 + 极淡同色底，按下加深。三级按钮只是 accent 不同。
func _ink_outline_button(btn: Button, font_px: int, accent: Color = Color(0.788, 0.635, 0.294)) -> void:
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	var normal = StyleBoxFlat.new()
	normal.bg_color = Color(accent.r, accent.g, accent.b, 0.09)
	normal.border_color = Color(accent.r, accent.g, accent.b, 0.58)
	normal.set_border_width_all(hair)
	normal.set_corner_radius_all(0)
	normal.content_margin_left = 14.0 * s
	normal.content_margin_right = 14.0 * s
	normal.content_margin_top = 6.0 * s
	normal.content_margin_bottom = 6.0 * s
	var hover: StyleBoxFlat = normal.duplicate()
	hover.bg_color = Color(accent.r, accent.g, accent.b, 0.20)
	hover.border_color = Color(accent.r, accent.g, accent.b, 0.92)
	var pressed: StyleBoxFlat = normal.duplicate()
	pressed.bg_color = Color(accent.r, accent.g, accent.b, 0.30)
	pressed.border_color = Color(accent.r, accent.g, accent.b, 1.0)
	for st_name in ["normal", "hover", "pressed", "disabled"]:
		btn.add_theme_stylebox_override(st_name, normal)
	btn.add_theme_stylebox_override("hover", hover)
	btn.add_theme_stylebox_override("pressed", pressed)
	btn.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	btn.add_theme_font_size_override("font_size", font_px)
	btn.add_theme_color_override("font_color", Color(0.925, 0.898, 0.84))
	btn.add_theme_color_override("font_hover_color", Color(1.0, 0.94, 0.78))
	btn.add_theme_color_override("font_pressed_color", INK_GOLD_HI)
	btn.add_theme_color_override("font_disabled_color", Color(0.76, 0.72, 0.64))


## 实心金底按钮 —— 设计稿里"主操作"只有一个（出战中/取出/使用），
## 其余都是描金空底。整套界面靠这个区分"能直接点的事"和"只是入口"。
func _ink_solid_gold_button(btn: Button, font_px: int, accent: Color = Color(0.788, 0.635, 0.294)) -> void:
	var s: = _ink_s()
	var normal = StyleBoxFlat.new()
	normal.bg_color = Color(accent.r, accent.g, accent.b, 0.92)
	normal.border_color = Color(0.976, 0.902, 0.706, 0.85)
	normal.set_border_width_all(maxi(1, int(round(1.0 * s))))
