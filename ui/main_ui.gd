const BATTLE_LUNGE_HP_HIDDEN_META: = "_lunge_hp_hidden"

func _set_sprite_frames_fixed_duration(frames: SpriteFrames, anim_name: String, duration_sec: float) -> void :
	var frame_count: = frames.get_frame_count(anim_name)
	if frame_count > 0 and duration_sec > 0.0:
		frames.set_animation_speed(anim_name, float(frame_count) / duration_sec)

func _append_sheet_frames(frames: SpriteFrames, anim_name: String, sheet: Texture2D) -> int:
	if sheet == null:
		return 0
	var frame_count: = maxi(1, int(sheet.get_width() / 256))
	for fi in range(frame_count):
		var atlas: = AtlasTexture.new()
		atlas.atlas = sheet
		atlas.region = Rect2(fi * 256, 0, 256, 256)
		frames.add_frame(anim_name, atlas)
	return frame_count

func _build_player_battle_sprite_frames_for_character(character_id: int) -> SpriteFrames:
	var cid: = character_id
	var all_ids: = PlayerCharacterConfig.get_all_ids()
	if all_ids.is_empty():
		cid = 0
	elif not all_ids.has(character_id):
		cid = all_ids[0]
	var sprite_id: = PlayerCharacterConfig.get_sprite_id(cid)
	return _build_creature_battle_sprite_frames(sprite_id, PLAYER_ATTACK_DURATION)

func _build_player_battle_sprite_frames() -> SpriteFrames:
	return _build_player_battle_sprite_frames_for_character(_get_player_character_id())

func _on_battle_unit_turn(unit: Dictionary) -> void :
	if _is_bt_battle():
		_sync_bt_battle_sprite_refs()
	_play_bt_unit_turn_anim(unit)

func _iter_battle_lunge_wraps() -> Array:
	var wraps: Array = []
	for wrap in [_battle_player_wrap, _battle_pet_wrap, _battle_coop_player_wrap, _battle_coop_pet_wrap]:
		if is_instance_valid(wrap):
			wraps.append(wrap)
	for monster_ui in monster_ui_nodes:
		if is_instance_valid(monster_ui):
			wraps.append(monster_ui)
	return wraps

func _battle_wrap_field_pos(wrap: Control) -> Vector2:
	return _get_wrap_origin_in_field(wrap)

func _field_pos_to_wrap_local(wrap: Control, field_pos: Vector2) -> Vector2:
	if not is_instance_valid(wrap):
		return field_pos
	var parent: = wrap.get_parent()
	if is_instance_valid(parent) and str(parent.name).begins_with("BTSlot_"):
		return field_pos - (parent as Control).position
	return field_pos

func _wrap_local_to_field_pos(wrap: Control, local_pos: Vector2) -> Vector2:
	if not is_instance_valid(wrap):
		return local_pos
	var parent: = wrap.get_parent()
	if is_instance_valid(parent) and str(parent.name).begins_with("BTSlot_"):
		return (parent as Control).position + local_pos
	return local_pos

func _battle_lunge_home_local(wrap: Control) -> Vector2:
	if not is_instance_valid(wrap):
		return Vector2.ZERO
	if _is_battle_ally_wrap_slot_layout(wrap):
		return Vector2.ZERO
	if wrap.has_meta("_battle_home_pos"):
		return wrap.get_meta("_battle_home_pos")
	var parent: = wrap.get_parent()
	if is_instance_valid(parent) and str(parent.name).begins_with("BTSlot_"):
		return Vector2.ZERO
	if wrap == _battle_player_wrap:
		return _get_player_battle_wrap_pos()
	if wrap == _battle_pet_wrap:
		return _get_pet_battle_wrap_pos()
	if wrap == _battle_coop_player_wrap:
		return _get_bt_unit_field_pos("coop_player")
	if wrap == _battle_coop_pet_wrap:
		return _get_bt_unit_field_pos("coop_pet")
	return wrap.position

func _battle_wrap_home_field_pos(wrap: Control) -> Vector2:
	if not is_instance_valid(wrap):
		return Vector2.ZERO
	return _wrap_local_to_field_pos(wrap, _battle_lunge_home_local(wrap))

func _clamp_lunge_contact_in_field(contact: Vector2, wrap: Control) -> Vector2:
	var field: = monster_container as Control
	if not is_instance_valid(field) or field.size.x < 32.0:
		return contact


	var cell_w: = WORLD_BOSS_BATTLE_CELL_SIZE.x if _is_world_boss_battle() else BATTLE_GRID_CELL_SIZE.x
	var max_x: = field.size.x - cell_w * 0.35
	if contact.x > max_x:
		return Vector2(max_x, contact.y)
	return contact

func _snap_monster_ui_to_battle_home(monster_ui: Control) -> void :
	if not is_instance_valid(monster_ui):
		return
	_kill_monster_entrance_tween(monster_ui)
	_restore_battle_lunge_home(monster_ui)
	if monster_ui.has_meta("_battle_home_pos"):
		var home_pos: Vector2 = monster_ui.get_meta("_battle_home_pos")
		monster_ui.position = home_pos
		monster_ui.set_meta(BATTLE_LUNGE_HOME_POS_META, home_pos)
	monster_ui.modulate = Color.WHITE

func _snap_dead_monsters_to_battle_home() -> void :
	if game_manager == null or game_manager.battle_system == null:
		return
	var monsters: Array = game_manager.battle_system.monsters
	for i in range(mini(monsters.size(), monster_ui_nodes.size())):
		if game_manager.battle_system.is_monster_alive(monsters[i]):
			continue
		if is_instance_valid(monster_ui_nodes[i]):
			_snap_monster_ui_to_battle_home(monster_ui_nodes[i])

func _find_battle_wrap_hp_bar(wrap: Control) -> Control:
	if not is_instance_valid(wrap):
		return null
	var ally: = wrap.get_node_or_null("AllyBattleHPBar")
	if is_instance_valid(ally):
		return ally
	var monster: = wrap.get_node_or_null("MonsterHPBar")
	if is_instance_valid(monster):
		return monster
	var nested: = wrap.find_child("MonsterHPBar", true, false)
	if is_instance_valid(nested):
		return nested
	return wrap.find_child("AllyBattleHPBar", true, false)

func _hide_battle_wrap_hp_for_lunge(wrap: Control) -> void :
	if not is_instance_valid(wrap):
		return
	var hp_bar: = _find_battle_wrap_hp_bar(wrap)
	if not is_instance_valid(hp_bar):
		return
	wrap.set_meta(BATTLE_LUNGE_HP_HIDDEN_META, true)
	hp_bar.visible = false

func _show_battle_wrap_hp_after_lunge(wrap: Control) -> void :
	if not is_instance_valid(wrap):
		return
	if not wrap.has_meta(BATTLE_LUNGE_HP_HIDDEN_META):
		return
	wrap.remove_meta(BATTLE_LUNGE_HP_HIDDEN_META)
	var hp_bar: = _find_battle_wrap_hp_bar(wrap)
	if is_instance_valid(hp_bar):
		hp_bar.visible = true

func _kill_battle_lunge_tween(wrap: Control) -> void :
	if not is_instance_valid(wrap) or not wrap.has_meta(BATTLE_LUNGE_TWEEN_META):
		_show_battle_wrap_hp_after_lunge(wrap)
		return
	var old_tween = wrap.get_meta(BATTLE_LUNGE_TWEEN_META)
	wrap.remove_meta(BATTLE_LUNGE_TWEEN_META)
	if old_tween is Tween and is_instance_valid(old_tween):
		(old_tween as Tween).kill()
	_show_battle_wrap_hp_after_lunge(wrap)

func _ensure_battle_lunge_home(wrap: Control) -> void :
	if not is_instance_valid(wrap):
		return
	wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, _battle_lunge_home_local(wrap))
	if not wrap.has_meta(BATTLE_LUNGE_HOME_Z_META):
		wrap.set_meta(BATTLE_LUNGE_HOME_Z_META, wrap.z_index)

func _restore_battle_lunge_home(wrap: Control) -> void :
	if not is_instance_valid(wrap):
		return
	_kill_battle_lunge_tween(wrap)
	var home_local: = _battle_lunge_home_local(wrap)
	wrap.position = home_local
	wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, home_local)
	if wrap.has_meta(BATTLE_LUNGE_HOME_Z_META):
		wrap.z_index = int(wrap.get_meta(BATTLE_LUNGE_HOME_Z_META))
	_show_battle_wrap_hp_after_lunge(wrap)

func _restore_all_battle_lunges() -> void :
	for wrap in _iter_battle_lunge_wraps():
		if wrap.has_meta("_battle_home_pos"):
			_kill_monster_entrance_tween(wrap)
		_restore_battle_lunge_home(wrap)
	_clear_all_monster_attack_finished_callbacks()

func _snapshot_battle_lunge_homes() -> void :
	for wrap in _iter_battle_lunge_wraps():
		_kill_battle_lunge_tween(wrap)
		wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, _battle_lunge_home_local(wrap))
		wrap.set_meta(BATTLE_LUNGE_HOME_Z_META, wrap.z_index)

func _resolve_lunge_attacker_wrap(unit: Dictionary) -> Control:
	var unit_type: = str(unit.get("type", ""))
	match unit_type:
		"player":
			return _battle_player_wrap
		"pet":
			return _battle_pet_wrap
		"coop_player":
			return _battle_coop_player_wrap
		"coop_pet":
			return _battle_coop_pet_wrap
		"monster":
			var idx: = int(unit.get("index", -1))
			if idx >= 0 and idx < monster_ui_nodes.size():
				return monster_ui_nodes[idx]
	return null

func _first_alive_monster_lunge_wrap() -> Control:
	if game_manager == null or game_manager.battle_system == null:
		if not monster_ui_nodes.is_empty() and is_instance_valid(monster_ui_nodes[0]):
			return monster_ui_nodes[0]
		return null
	var monsters: Array = game_manager.battle_system.monsters
	for i in range(mini(monsters.size(), monster_ui_nodes.size())):
		if game_manager.battle_system.is_monster_alive(monsters[i]) and is_instance_valid(monster_ui_nodes[i]):
			return monster_ui_nodes[i]
	return null

func _fallback_ally_lunge_wrap() -> Control:
	if is_instance_valid(_battle_player_wrap) and not _ally_player_defeat_applied:
		return _battle_player_wrap
	if is_instance_valid(_battle_pet_wrap) and not _ally_pet_defeat_applied:
		return _battle_pet_wrap
	if is_instance_valid(_battle_coop_player_wrap) and not _ally_coop_player_defeat_applied:
		return _battle_coop_player_wrap
	if is_instance_valid(_battle_coop_pet_wrap) and not _ally_coop_pet_defeat_applied:
		return _battle_coop_pet_wrap
	if is_instance_valid(_battle_player_wrap):
		return _battle_player_wrap
	if is_instance_valid(_battle_pet_wrap):
		return _battle_pet_wrap
	return null

func _resolve_lunge_target_wrap(unit: Dictionary) -> Control:
	var attacker_type: = str(unit.get("type", ""))
	var target_type: = str(unit.get("target_type", ""))
	var target_index: = int(unit.get("target_index", -1))
	if attacker_type == "monster":
		if target_type in ["player", "pet", "coop_player", "coop_pet"]:
			var ally_wrap: = _get_ally_wrap_for_hit_type(target_type)
			if is_instance_valid(ally_wrap) and not _is_monster_battle_wrap(ally_wrap):
				return ally_wrap
		return _fallback_ally_lunge_wrap()
	if target_type == "monster":
		if target_index >= 0 and target_index < monster_ui_nodes.size() and is_instance_valid(monster_ui_nodes[target_index]):
			return monster_ui_nodes[target_index]
	elif target_type in ["player", "pet", "coop_player", "coop_pet"]:
		var named_ally: = _get_ally_wrap_for_hit_type(target_type)
		if is_instance_valid(named_ally):
			return named_ally
	return _first_alive_monster_lunge_wrap()

func _is_any_monster_entrance_playing() -> bool:
	for monster_ui in monster_ui_nodes:
		if not is_instance_valid(monster_ui) or not monster_ui.has_meta("_entrance_tween"):
			continue
		var playing_tween = monster_ui.get_meta("_entrance_tween")
		if playing_tween is Tween and is_instance_valid(playing_tween):
			return true
	return false

func _battle_lunge_aim_offset_in_wrap(wrap: Control) -> Vector2:
	if not is_instance_valid(wrap):
		return Vector2.ZERO
	if wrap == _battle_player_wrap or wrap == _battle_coop_player_wrap:
		return _get_battle_ally_slot_center_in_wrap(wrap)
	if wrap == _battle_pet_wrap or wrap == _battle_coop_pet_wrap:
		return _bt_pet_sprite_offset() + _ally_pet_battle_slot_size() * 0.5
	for node in monster_ui_nodes:
		if node is Control and node == wrap:
			return _world_boss_monster_sprite_center_offset()
	return Vector2.ZERO

func _cancel_monster_entrance_for_lunge(wrap: Control) -> void :
	if not is_instance_valid(wrap):
		return
	var is_monster: = false
	for node in monster_ui_nodes:
		if node == wrap:
			is_monster = true
			break
	if not is_monster or not wrap.has_meta("_entrance_tween"):
		return
	_kill_monster_entrance_tween(wrap)
	if wrap.has_meta("_battle_home_pos"):
		wrap.position = wrap.get_meta("_battle_home_pos")
	wrap.modulate = Color.WHITE

func _is_monster_battle_wrap(wrap: Control) -> bool:
	if not is_instance_valid(wrap):
		return false
	for node in monster_ui_nodes:
		if node == wrap:
			return true
	return false

func _monster_lunge_ally_field_pos(target_wrap: Control) -> Vector2:
	if is_instance_valid(target_wrap):
		return _get_wrap_origin_in_field(target_wrap)
	return _get_player_battle_wrap_pos()

func _start_battle_attack_lunge(attacker_wrap: Control, target_wrap: Control, time_scale: float = 1.0) -> void :
	if not _should_use_battle_sprite_anim():
		return
	if not is_instance_valid(attacker_wrap) or not is_instance_valid(target_wrap):
		return
	if _is_monster_battle_wrap(attacker_wrap) and _is_monster_battle_wrap(target_wrap):
		target_wrap = _fallback_ally_lunge_wrap()
	if not is_instance_valid(target_wrap) or attacker_wrap == target_wrap:
		return
	var monster_to_ally: = _is_monster_battle_wrap(attacker_wrap) and not _is_monster_battle_wrap(target_wrap)
	_cancel_monster_entrance_for_lunge(attacker_wrap)
	if monster_to_ally:
		_snap_monster_ui_to_battle_home(attacker_wrap)
	else:
		_restore_battle_lunge_home(attacker_wrap)
	if attacker_wrap.has_meta("_battle_home_pos"):
		var grid_home: Vector2 = attacker_wrap.get_meta("_battle_home_pos")
		attacker_wrap.position = grid_home
		attacker_wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, grid_home)
	else:
		_ensure_battle_lunge_home(attacker_wrap)
		if attacker_wrap.has_meta(BATTLE_LUNGE_HOME_POS_META):
			attacker_wrap.position = attacker_wrap.get_meta(BATTLE_LUNGE_HOME_POS_META)
	if not attacker_wrap.has_meta(BATTLE_LUNGE_HOME_Z_META):
		attacker_wrap.set_meta(BATTLE_LUNGE_HOME_Z_META, attacker_wrap.z_index)
	var from_origin: = _get_wrap_origin_in_field(attacker_wrap) if monster_to_ally else _battle_wrap_home_field_pos(attacker_wrap)
	var to_origin: = _monster_lunge_ally_field_pos(target_wrap) if monster_to_ally else _battle_wrap_home_field_pos(target_wrap)
	var attacker_aim_offset: = Vector2.ZERO
	var from_aim: = from_origin
	var to_aim: = to_origin
	if _is_world_boss_battle():
		attacker_aim_offset = _battle_lunge_aim_offset_in_wrap(attacker_wrap)
		from_aim = from_origin + attacker_aim_offset
		to_aim = to_origin + _battle_lunge_aim_offset_in_wrap(target_wrap)
	var delta: = to_aim - from_aim
	var dist: = delta.length()
	var gap: = BATTLE_LUNGE_BOSS_CONTACT_GAP if _is_world_boss_battle() else BATTLE_LUNGE_CONTACT_GAP
	if monster_to_ally and dist <= gap + 4.0:
		to_aim = from_aim + Vector2(-220.0, 0.0)
		delta = to_aim - from_aim
		dist = delta.length()
	elif dist <= gap + 4.0 and not monster_to_ally:
		return
	var scale: = maxf(0.25, time_scale)
	var approach_sec: = BATTLE_LUNGE_APPROACH_SECONDS * scale
	var return_sec: = BATTLE_LUNGE_RETURN_SECONDS * scale
	_hide_battle_wrap_hp_for_lunge(attacker_wrap)
	var contact_field: = _clamp_lunge_contact_in_field(to_aim - delta.normalized() * gap - attacker_aim_offset, attacker_wrap)
	var contact_local: = _field_pos_to_wrap_local(attacker_wrap, contact_field)
	var home_local: Vector2 = attacker_wrap.get_meta(BATTLE_LUNGE_HOME_POS_META)
	var home_z: = int(attacker_wrap.get_meta(BATTLE_LUNGE_HOME_Z_META))
	attacker_wrap.z_index = home_z + BATTLE_LUNGE_Z_BOOST
	var tween: Tween = attacker_wrap.create_tween()
	attacker_wrap.set_meta(BATTLE_LUNGE_TWEEN_META, tween)
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_QUAD)
	tween.tween_property(attacker_wrap, "position", contact_local, approach_sec)
	var hold_sec: = maxf(0.02, BATTLE_LUNGE_HOLD_SECONDS * scale)
	tween.tween_interval(hold_sec)
	tween.set_ease(Tween.EASE_IN)
	tween.tween_property(attacker_wrap, "position", home_local, return_sec)
	tween.tween_callback(_on_battle_lunge_finished.bind(attacker_wrap, tween, home_local, home_z))

func _on_battle_lunge_finished(wrap: Control, tween: Tween, home_local: Vector2, home_z: int) -> void :
	if not is_instance_valid(wrap):
		return
	if wrap.has_meta(BATTLE_LUNGE_TWEEN_META) and wrap.get_meta(BATTLE_LUNGE_TWEEN_META) == tween:
		wrap.remove_meta(BATTLE_LUNGE_TWEEN_META)
		wrap.position = home_local
		wrap.z_index = home_z
	_show_battle_wrap_hp_after_lunge(wrap)
	_refresh_active_battle_hud()

func _start_monster_slot_lunge(monster_index: int, time_scale: float = 1.0, target_wrap: Control = null) -> void :
	if not _should_use_battle_sprite_anim():
		return
	if monster_index < 0 or monster_index >= monster_ui_nodes.size():
		return
	var attacker_wrap: Control = monster_ui_nodes[monster_index]
	if not is_instance_valid(target_wrap) or _is_monster_battle_wrap(target_wrap):
		target_wrap = _fallback_ally_lunge_wrap()
	if not is_instance_valid(attacker_wrap) or not is_instance_valid(target_wrap):
		return
	if attacker_wrap == target_wrap or _is_monster_battle_wrap(target_wrap):
		return
	_cancel_monster_entrance_for_lunge(attacker_wrap)
	_snap_monster_ui_to_battle_home(attacker_wrap)
	if attacker_wrap.has_meta("_battle_home_pos"):
		var grid_home: Vector2 = attacker_wrap.get_meta("_battle_home_pos")
		attacker_wrap.position = grid_home
		attacker_wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, grid_home)
	else:
		_ensure_battle_lunge_home(attacker_wrap)
		if attacker_wrap.has_meta(BATTLE_LUNGE_HOME_POS_META):
			attacker_wrap.position = attacker_wrap.get_meta(BATTLE_LUNGE_HOME_POS_META)
	if not attacker_wrap.has_meta(BATTLE_LUNGE_HOME_Z_META):
		attacker_wrap.set_meta(BATTLE_LUNGE_HOME_Z_META, attacker_wrap.z_index)
	var from_origin: = _get_wrap_origin_in_field(attacker_wrap)
	var to_origin: = _monster_lunge_ally_field_pos(target_wrap)
	var attacker_aim_offset: = Vector2.ZERO
	var from_aim: = from_origin
	var to_aim: = to_origin
	if _is_world_boss_battle():
		attacker_aim_offset = _battle_lunge_aim_offset_in_wrap(attacker_wrap)
		from_aim = from_origin + attacker_aim_offset
		to_aim = to_origin + _battle_lunge_aim_offset_in_wrap(target_wrap)
	var delta: = to_aim - from_aim
	var dist: = delta.length()
	var gap: = BATTLE_LUNGE_BOSS_CONTACT_GAP if _is_world_boss_battle() else BATTLE_LUNGE_CONTACT_GAP
	if dist <= gap + 4.0:
		to_aim = from_aim + Vector2(-220.0, 0.0)
		delta = to_aim - from_aim
		dist = delta.length()
	if dist <= 8.0:
		return
	var scale: = maxf(0.25, time_scale)
	var approach_sec: = BATTLE_LUNGE_APPROACH_SECONDS * scale
	var return_sec: = BATTLE_LUNGE_RETURN_SECONDS * scale
	_hide_battle_wrap_hp_for_lunge(attacker_wrap)
	var contact_field: = _clamp_lunge_contact_in_field(to_aim - delta.normalized() * gap - attacker_aim_offset, attacker_wrap)
	var contact_local: = _field_pos_to_wrap_local(attacker_wrap, contact_field)
	var home_local: Vector2 = attacker_wrap.get_meta(BATTLE_LUNGE_HOME_POS_META)
	var home_z: = int(attacker_wrap.get_meta(BATTLE_LUNGE_HOME_Z_META))
	attacker_wrap.z_index = home_z + BATTLE_LUNGE_Z_BOOST
	var tween: Tween = attacker_wrap.create_tween()
	attacker_wrap.set_meta(BATTLE_LUNGE_TWEEN_META, tween)
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_QUAD)
	tween.tween_property(attacker_wrap, "position", contact_local, approach_sec)
	var hold_sec: = maxf(0.02, BATTLE_LUNGE_HOLD_SECONDS * scale)
	tween.tween_interval(hold_sec)
	tween.set_ease(Tween.EASE_IN)
	tween.tween_property(attacker_wrap, "position", home_local, return_sec)
	tween.tween_callback(_on_battle_lunge_finished.bind(attacker_wrap, tween, home_local, home_z))

func _play_bt_unit_turn_anim(unit: Dictionary) -> void :
	if _is_bt_battle():
		_sync_bt_battle_sprite_refs()
	var lunge_scale: = float(unit.get("lunge_time_scale", 1.0))
	if lunge_scale <= 0.0:
		lunge_scale = 1.0
	var unit_type: = str(unit.get("type", ""))
	_play_battle_attacker_windup(unit_type, int(unit.get("index", -1)), lunge_scale)
	if unit_type == "player":
		_play_player_battle_attack()
	elif unit_type == "pet":
		_play_pet_battle_attack(lunge_scale)
	elif unit_type == "coop_player":
		_play_coop_player_battle_attack()
	elif unit_type == "coop_pet":
		_play_coop_pet_battle_attack(lunge_scale)
	elif unit_type == "monster":
		_play_monster_battle_attack(int(unit.get("index", -1)), _resolve_lunge_target_wrap(unit))
	if unit_type != "monster" and _should_use_battle_sprite_anim() and not bool(unit.get("skip_lunge", false)):
		_start_battle_attack_lunge(_resolve_lunge_attacker_wrap(unit), _resolve_lunge_target_wrap(unit), lunge_scale)

## 出手的一瞬间先沉一下身，再冲出去。压扁幅度很小（4.5%），但足够让眼睛抓到
## 「这一次是他打的」——之前几个单位连着出手时，看上去像一团影子在闪。
func _play_battle_attacker_windup(unit_type: String, unit_index: int, time_scale: float = 1.0) -> void :
	if not _should_use_battle_sprite_anim():
		return
	var sprite: = _resolve_hit_reaction_sprite(unit_type, unit_index)
	if sprite == null or not is_instance_valid(sprite):
		return
	var base: Vector2 = sprite.scale
	if base.x == 0.0 or base.y == 0.0:
		return
	var scale_f: = maxf(0.25, time_scale)
	var tween: Tween = sprite.create_tween()
	tween.tween_property(sprite, "scale", base * Vector2(0.955, 0.955), 0.055 * scale_f).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(sprite, "scale", base, 0.11 * scale_f).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


func _resolve_local_player_battle_anim() -> AnimatedSprite2D:
	if not is_instance_valid(_battle_player_wrap):
		return null
	var node: = _battle_player_wrap.get_node_or_null("PlayerBattleAnim")
	if is_instance_valid(node):
		_battle_player_sprite = node
	return node as AnimatedSprite2D if node is AnimatedSprite2D else null

func _resolve_coop_player_battle_anim() -> AnimatedSprite2D:
	if not is_instance_valid(_battle_coop_player_wrap):
		return null
	var node: = _battle_coop_player_wrap.get_node_or_null("CoopPlayerBattleAnim")
	if is_instance_valid(node):
		_battle_coop_player_sprite = node
	return node as AnimatedSprite2D if node is AnimatedSprite2D else null

func _live_animated_sprite_in_slot(slot: Control, preferred_name: String) -> AnimatedSprite2D:
	if not is_instance_valid(slot):
		return null
	var named: = slot.get_node_or_null(preferred_name)
	if named is AnimatedSprite2D and is_instance_valid(named) and not named.is_queued_for_deletion():
		return named as AnimatedSprite2D
	for child in slot.get_children():
		if child is AnimatedSprite2D and is_instance_valid(child) and not child.is_queued_for_deletion():
			return child as AnimatedSprite2D
	return null

func _resolve_local_pet_battle_anim() -> AnimatedSprite2D:
	if not is_instance_valid(_battle_pet_wrap):
		return null
	var slot: = _battle_pet_wrap.get_node_or_null("PetSpriteSlot") as Control
	var spr: = _live_animated_sprite_in_slot(slot, "PetBattleSprite")
	if spr:
		_battle_pet_sprite = spr
	return spr

func _resolve_coop_pet_battle_anim() -> AnimatedSprite2D:
	if not is_instance_valid(_battle_coop_pet_wrap):
		return null
	var slot: = _battle_coop_pet_wrap.get_node_or_null("CoopPetSpriteSlot") as Control
	var spr: = _live_animated_sprite_in_slot(slot, "CoopPetBattleSprite")
	if spr:
		_battle_coop_pet_sprite = spr
	return spr

func _play_player_battle_attack() -> void :
	if not _should_use_battle_sprite_anim():
		return
	var spr: = _resolve_local_player_battle_anim()
	if spr == null or spr.sprite_frames == null:
		return
	if _is_bt_battle():
		if _bt_visual_state("local_player") == BT_ALLY_VIS_DEFEATED or _ally_player_defeat_applied:
			return
		_set_bt_visual_state("local_player", BT_ALLY_VIS_ATTACKING)
	elif _ally_player_defeat_applied:
		return
	if not spr.sprite_frames.has_animation("attack"):
		return
	spr.visible = true
	if spr.animation_finished.is_connected(_on_player_battle_attack_finished):
		spr.animation_finished.disconnect(_on_player_battle_attack_finished)
	spr.frame = 0
	spr.play("attack")
	spr.animation_finished.connect(_on_player_battle_attack_finished, CONNECT_ONE_SHOT)

func _on_player_battle_attack_finished() -> void :
	if not is_instance_valid(_battle_player_sprite):
		return
	var spr: = _battle_player_sprite as AnimatedSprite2D
	if spr == null or spr.sprite_frames == null:
		return
	if _is_bt_battle():
		if _bt_visual_state("local_player") == BT_ALLY_VIS_DEFEATED or _ally_player_defeat_applied:
			return
		if game_manager and game_manager.player and not game_manager.player.is_alive():
			return
		_set_bt_visual_state("local_player", BT_ALLY_VIS_IDLE)
	_apply_battle_sprite_playback_state(spr)

func _play_pet_battle_attack(time_scale: float = 1.0) -> void :
	if not _should_use_battle_sprite_anim():
		return
	var spr: = _resolve_local_pet_battle_anim()
	if spr == null or spr.sprite_frames == null:
		return
	if _is_bt_battle() or _is_arena_battle():
		if _bt_visual_state("local_pet") == BT_ALLY_VIS_DEFEATED or _ally_pet_defeat_applied:
			if _is_arena_battle():
				var arena_pet = _get_battle_display_pet()
				if arena_pet == null or arena_pet.hp <= 0:
					return
				_ally_pet_defeat_applied = false
			else:
				return
		_set_bt_visual_state("local_pet", BT_ALLY_VIS_ATTACKING)
	elif _ally_pet_defeat_applied:
		return
	if not spr.sprite_frames.has_animation("attack"):
		if spr.sprite_frames.has_animation("idle"):
			spr.frame = 0
			spr.play("idle")
		return
	spr.visible = true
	if spr.animation_finished.is_connected(_on_pet_battle_attack_finished):
		spr.animation_finished.disconnect(_on_pet_battle_attack_finished)
	spr.speed_scale = 1.0 / maxf(0.25, time_scale)
	spr.frame = 0
	spr.play("attack")
	spr.animation_finished.connect(_on_pet_battle_attack_finished, CONNECT_ONE_SHOT)

func _on_pet_battle_attack_finished() -> void :
	if not is_instance_valid(_battle_pet_sprite):
		return
	var spr: = _battle_pet_sprite as AnimatedSprite2D
	if spr == null or spr.sprite_frames == null:
		return
	spr.speed_scale = 1.0
	if _is_bt_battle() or _is_arena_battle():
		if _bt_visual_state("local_pet") == BT_ALLY_VIS_DEFEATED or _ally_pet_defeat_applied:
			return
		var pet = _get_battle_display_pet()
		if pet == null or pet.hp <= 0:
			return
		_set_bt_visual_state("local_pet", BT_ALLY_VIS_IDLE)
	_apply_battle_sprite_playback_state(spr)

func _get_monster_battle_animated_sprite(monster_index: int) -> AnimatedSprite2D:
	if monster_index < 0 or monster_index >= monster_ui_nodes.size():
		return null
	var monster_ui = monster_ui_nodes[monster_index]
	if not is_instance_valid(monster_ui):
		return null
	var slot = monster_ui.get_node_or_null("MonsterSpriteSlot")
	if slot == null:
		return null
	var spr = slot.get_node_or_null("MonsterSprite")
	return spr as AnimatedSprite2D if spr is AnimatedSprite2D else null

func _clear_animated_sprite_finished_connections(spr: AnimatedSprite2D) -> void :
	if spr == null or not is_instance_valid(spr):
		return
	for conn in spr.animation_finished.get_connections():
		var cb = conn.get("callable")
		if cb is Callable and spr.animation_finished.is_connected(cb):
			spr.animation_finished.disconnect(cb)

func _clear_all_monster_attack_finished_callbacks() -> void :
	for i in range(monster_ui_nodes.size()):
		_clear_animated_sprite_finished_connections(_get_monster_battle_animated_sprite(i))

func _play_monster_battle_attack(monster_index: int, target_wrap: Control = null) -> void :
	if not is_inside_tree() or not _should_use_battle_sprite_anim():
		return
	var spr: = _get_monster_battle_animated_sprite(monster_index)
	if spr != null and spr.sprite_frames != null:
		if spr.sprite_frames.has_animation("attack"):
			_clear_animated_sprite_finished_connections(spr)
			spr.frame = 0
			spr.play("attack")
			spr.animation_finished.connect(_on_monster_battle_attack_finished.bind(monster_index), CONNECT_ONE_SHOT)
		elif spr.sprite_frames.has_animation("idle"):
			spr.frame = 0
			spr.play("idle")
	_start_monster_slot_lunge(monster_index, 1.0, target_wrap)

func _on_monster_battle_attack_finished(monster_index: int) -> void :
	var spr: = _get_monster_battle_animated_sprite(monster_index)
	if spr == null or spr.sprite_frames == null:
		return
	_apply_battle_sprite_playback_state(spr)

func _create_battle_sprite_slot(slot_size: Vector2 = BATTLE_SPRITE_SLOT_SIZE) -> Control:
	var slot = Control.new()
	slot.custom_minimum_size = slot_size
	slot.size = slot_size

	slot.clip_contents = false
	slot.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return slot

func _battle_sprite_slot_center(slot_size: Vector2 = BATTLE_SPRITE_SLOT_SIZE) -> Vector2:
	return slot_size * 0.5

func _add_static_sprite_to_slot(
	slot: Control, 
	texture: Texture2D, 
	slot_size: Vector2 = BATTLE_SPRITE_SLOT_SIZE, 
	static_display_size: Vector2 = BATTLE_STATIC_SPRITE_SIZE, 
	mirror_x: bool = false
) -> TextureRect:
	var tr = TextureRect.new()
	tr.texture = texture
	var tex_size: = texture.get_size()
	if tex_size.x <= 0.0 or tex_size.y <= 0.0:
		tex_size = static_display_size
	var fit: = minf(static_display_size.x / tex_size.x, static_display_size.y / tex_size.y)
	var display_size: = tex_size * fit
	tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tr.stretch_mode = TextureRect.STRETCH_KEEP
	tr.size = tex_size
	tr.custom_minimum_size = tex_size
	tr.scale = Vector2( - fit, fit) if mirror_x else Vector2(fit, fit)
	if mirror_x:
		tr.position = Vector2((slot_size.x + display_size.x) * 0.5, (slot_size.y - display_size.y) * 0.5)
	else:
		tr.position = (slot_size - display_size) * 0.5
	tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
	slot.add_child(tr)
	return tr

func _add_anim_sprite_to_slot(slot: Control, sprite_sheet: Texture2D, mirror_x: bool = false) -> AnimatedSprite2D:
	var scale_val = BATTLE_SPRITE_SLOT_SIZE.x / 256.0
	var scale_vec = Vector2( - scale_val, scale_val) if mirror_x else Vector2(scale_val, scale_val)
	var anim = _build_idle_anim_sprite_from_sheet(sprite_sheet, scale_vec, true)
	if anim:
		anim.position = _battle_sprite_slot_center()
		slot.add_child(anim)
	return anim

