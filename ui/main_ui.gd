func _do_relogin(dialog: Window, username: String, password: String, error_label: Label, login_btn: Button):
	if not network:
		if is_instance_valid(error_label):
			error_label.text = "网络错误"
			error_label.visible = true
		if is_instance_valid(login_btn):
			login_btn.disabled = false
			login_btn.text = "重新登录"
		return

	network.login_success.connect( func(user_id, nickname, token):
		dialog.queue_free()
		_download_save_from_server()
	, CONNECT_ONE_SHOT)

	network.login_failed.connect( func(error):
		if is_instance_valid(error_label):
			error_label.text = error
			error_label.visible = true
		if is_instance_valid(login_btn):
			login_btn.disabled = false
			login_btn.text = "重新登录"
	, CONNECT_ONE_SHOT)

	network.login(username, password)

