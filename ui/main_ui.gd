	btn.add_theme_color_override("font_disabled_color", Color(0.72, 0.68, 0.58))


func _find_live_pet_by_id(pet_id: String):
	if pet_id == "" or not game_manager or not game_manager.pet_manager:
		return null
	var pm = game_manager.pet_manager
	var pid: = str(pet_id).strip_edges()
	for candidate in pm.pets:
		if candidate and str(candidate.id) == pid:
			return candidate
	for candidate in pm.pet_bag:
		if candidate and str(candidate.id) == pid:
			return candidate

	if pm.has_method("get_assist_pet_at"):
		pm._ensure_assist_pets_size()
		for i in range(pm.assist_pets.size()):
			var ap = pm.assist_pets[i]
			if ap != null and is_instance_valid(ap) and str(ap.id) == pid:
				return ap
	return null

func _resolve_live_pet(pet):
	if pet == null:
		return null
	return _find_live_pet_by_id(str(pet.id))

func _show_pet_action_popup_by_id(pet_id: String):
	var live_pet = _find_live_pet_by_id(pet_id)
	if live_pet == null:
		_show_simple_dialog("提示", "宠物数据不存在")
		return
	_show_pet_action_popup(live_pet)

func _show_pet_action_popup(pet):
	var live_pet = _resolve_live_pet(pet)
	if live_pet == null:
		_show_simple_dialog("操作失败", "宠物已不存在，请刷新列表后重试")
		return

	var popup_key = "pet_action:%s" % str(live_pet.id)
	if _focus_existing_popup(popup_key):
		return
	var popup = Window.new()
	_mark_popup_key(popup, popup_key)
	popup.title = ""
	popup.size = Vector2i(400, 320)
	popup.transparent = true
	popup.borderless = true
	popup.unresizable = true
	popup.close_requested.connect( func(): popup.queue_free())

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 20
	vbox.offset_top = 20
	vbox.offset_right = -20
	vbox.offset_bottom = -20
	vbox.add_theme_constant_override("separation", 10)

	var title = Label.new()
	title.text = "%s Lv.%d" % [live_pet.pet_name, live_pet.level]
	title.add_theme_font_size_override("font_size", 24)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_color_override("font_color", Color(1, 0.84, 0) if live_pet.is_elite else Color.WHITE)
	vbox.add_child(title)

	var sep = HSeparator.new()
	vbox.add_child(sep)

	var active_pet = game_manager.pet_manager.get_active_pet()
	var is_active = active_pet and active_pet.id == live_pet.id
	var popup_ref = popup


	var row1 = HBoxContainer.new()
	row1.add_theme_constant_override("separation", 10)
	row1.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var detail_btn = Button.new()
	detail_btn.text = "查看详情"
	detail_btn.custom_minimum_size = Vector2(0, 45)
	detail_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	detail_btn.add_theme_font_size_override("font_size", 18)
	_apply_action_button_style(detail_btn)
	detail_btn.pressed.connect( func():
		var detail_pet = _resolve_live_pet(live_pet)
		if detail_pet == null:
			_show_simple_dialog("提示", "宠物数据不存在")
			if popup_ref and is_instance_valid(popup_ref):
				popup_ref.queue_free()
			return
		popup_ref.queue_free()
		_show_pet_detail_popup(detail_pet)
	)
	row1.add_child(detail_btn)

	if is_active:
		var active_btn = Button.new()
		active_btn.text = "当前出战中"
		active_btn.custom_minimum_size = Vector2(0, 45)
		active_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		active_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(active_btn)
		active_btn.disabled = true
		row1.add_child(active_btn)
	else:
		var set_active_btn = Button.new()
		set_active_btn.text = "设为出战"
		set_active_btn.custom_minimum_size = Vector2(0, 45)
		set_active_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		set_active_btn.add_theme_font_size_override("font_size", 18)
		_ink_solid_gold_button(set_active_btn, _ink_font(20.0))
		var target_pet_id: = str(live_pet.id)
		set_active_btn.pressed.connect( func():
			if target_pet_id.is_empty() or _find_live_pet_by_id(target_pet_id) == null:
				_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
				popup_ref.queue_free()
				return
			if game_manager.is_in_instanced_challenge():
				_show_simple_dialog("无法切换", "挑战进行中无法切换出战宠")
				return
			set_active_btn.disabled = true
			set_active_btn.text = "处理中..."
			var prep: Dictionary = game_manager.prepare_seamless_pet_switch()
			var was_auto: bool = bool(prep.get("was_auto", false))
			if not game_manager.pet_manager.set_active_pet_by_id(target_pet_id):
				game_manager.finish_seamless_pet_switch(was_auto)
				if was_auto:
					auto_battle = true
					if stop_battle_btn:
						stop_battle_btn.text = "停止战斗"
				_show_simple_dialog("操作失败", "切换出战宠失败，请稍后再试")
				if is_instance_valid(set_active_btn):
					set_active_btn.disabled = false
					set_active_btn.text = "设为出战"
				return
			if game_manager.network != null and game_manager.network.is_logged_in():
				if not await game_manager.await_active_pet_switch_cloud_sync(15.0):
					_show_simple_dialog("同步失败", "出战宠已切换，但云端同步未完成，请稍后再练或重登确认等级")
			game_manager.finish_seamless_pet_switch(was_auto)
			if was_auto:
				auto_battle = true
				if stop_battle_btn:
					stop_battle_btn.text = "停止战斗"
			if is_instance_valid(popup_ref):
				popup_ref.queue_free()
			_update_pet_ui()
		)
		row1.add_child(set_active_btn)

	vbox.add_child(row1)


	var row2 = HBoxContainer.new()
	row2.add_theme_constant_override("separation", 10)
	row2.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var lock_btn = Button.new()
	lock_btn.text = "解锁" if live_pet.locked else "锁定"
	lock_btn.custom_minimum_size = Vector2(0, 45)
	lock_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	lock_btn.add_theme_font_size_override("font_size", 18)
	_apply_action_button_style(lock_btn)
	lock_btn.pressed.connect( func():
		var lock_pet = _resolve_live_pet(live_pet)
		if lock_pet == null:
			_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
			popup_ref.queue_free()
			return
		lock_btn.disabled = true
		if game_manager == null or game_manager.pet_manager == null:
			_show_simple_dialog("操作失败", "系统未就绪，请稍后再试")
			popup_ref.queue_free()
			return
		var want_locked: bool = not bool(lock_pet.locked)
		if game_manager.network and game_manager.network.is_logged_in():
			var api_result: Dictionary = await game_manager.request_pet_lock_authority(lock_pet, want_locked)
			if not bool(api_result.get("ok", false)):
				if is_instance_valid(lock_btn):
					lock_btn.disabled = false
				_show_simple_dialog("同步失败", str(api_result.get("error", "锁定状态未能写入云端，请稍后重试。")))
				return
		else:
			var toggle_result: Dictionary = game_manager.pet_manager.toggle_pet_lock(lock_pet)
			if not toggle_result.success:
				_show_simple_dialog("操作失败", toggle_result.message)
				lock_btn.disabled = false
				return
			game_manager.save_game()
		if is_instance_valid(popup_ref):
			popup_ref.queue_free()
		_update_pet_ui()
	)
	row2.add_child(lock_btn)

	var release_btn = Button.new()
	release_btn.text = "放生"
	release_btn.custom_minimum_size = Vector2(0, 45)
	release_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	release_btn.add_theme_font_size_override("font_size", 18)
	_ink_outline_button(release_btn, _ink_font(20.0), Color(0.72, 0.34, 0.26))
	release_btn.pressed.connect( func():
		var current_pet = _resolve_live_pet(live_pet)
		if current_pet == null:
			_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
			popup_ref.queue_free()
			return
		release_btn.disabled = true
		if not _show_release_pet_confirm_popup(current_pet, popup_ref, release_btn):
			var ap = game_manager.pet_manager.get_active_pet() if game_manager.pet_manager else null
			var pet_active = ap != null and str(ap.id) == str(current_pet.id)
			if not pet_active and not current_pet.locked:
				release_btn.disabled = false
				release_btn.text = "放生"
	)
	if is_active:
		release_btn.disabled = true
		release_btn.text = "出战中"
	elif live_pet.locked:
		release_btn.disabled = true
		release_btn.text = "已锁定"
	row2.add_child(release_btn)

	vbox.add_child(row2)


	var row3 = HBoxContainer.new()
	row3.add_theme_constant_override("separation", 10)
	row3.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	if not is_active:

		var collection_btn = Button.new()
		collection_btn.text = "加入图鉴"
		collection_btn.custom_minimum_size = Vector2(0, 45)
		collection_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		collection_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(collection_btn)
		collection_btn.pressed.connect( func():
			var collection_pet = _resolve_live_pet(live_pet)
			if collection_pet == null:
				_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
				popup_ref.queue_free()
				return
			if game_manager.network == null or not game_manager.network.is_logged_in():
				_show_tip_popup("请先登录后再投入图鉴")
				return
			collection_btn.disabled = true
			_show_add_to_collection_confirm(popup_ref, collection_pet)
		)

		if game_manager.pet_collection_manager:
			var collection_info = game_manager.pet_collection_manager.get_collection_info(live_pet.pet_id)
			var pet_mut: = _get_pet_mutation_count(live_pet)
			if live_pet.locked:
				collection_btn.disabled = true
				collection_btn.text = "已锁定"
			elif bool(collection_info.get("is_max", false)):
				collection_btn.disabled = true
				collection_btn.text = "图鉴已满"
			elif bool(collection_info.get("is_normal_max", false)):
				if pet_mut >= 1 and not bool(collection_info.get("is_mutation_max", false)):
					collection_btn.text = "变异升华"
				else:
					collection_btn.disabled = true
					collection_btn.text = "需变异品质"
		row3.add_child(collection_btn)


		var store_bag_btn = Button.new()
		store_bag_btn.text = "存袋"
		store_bag_btn.custom_minimum_size = Vector2(0, 45)
		store_bag_btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		store_bag_btn.add_theme_font_size_override("font_size", 18)
		_apply_action_button_style(store_bag_btn)
		store_bag_btn.pressed.connect( func():
			var store_pet = _resolve_live_pet(live_pet)
			_sync_pet_bag_store(store_pet, popup_ref, store_bag_btn)
		)
		row3.add_child(store_bag_btn)
	else:

		var active_hint = Label.new()
		active_hint.text = "出战中的宠物无法加入图鉴或存袋"
		active_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		active_hint.add_theme_font_size_override("font_size", 16)
		active_hint.add_theme_color_override("font_color", Color(0.6, 0.6, 0.6))
		active_hint.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row3.add_child(active_hint)

	vbox.add_child(row3)


	var close_btn = Button.new()
	close_btn.text = "取消"
	close_btn.custom_minimum_size = POPUP_ACTION_BTN_SIZE
	close_btn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	close_btn.add_theme_font_size_override("font_size", 18)
	_apply_action_button_style(close_btn)
	close_btn.pressed.connect( func(): popup_ref.queue_free())

	var close_container = HBoxContainer.new()
	close_container.alignment = BoxContainer.ALIGNMENT_CENTER
	close_container.add_child(close_btn)
	vbox.add_child(close_container)

	main_panel.add_child(vbox)
	popup.add_child(main_panel)
	add_child(popup)
	popup.popup_centered()


func _show_add_to_collection_confirm(parent_popup: Window, pet):
	if not game_manager or not game_manager.pet_manager:
		_show_error_tip("宠物系统未初始化")
		return
	if not game_manager.pet_manager.pets.has(pet):
		_show_error_tip("该宠物已被处理，请刷新后重试")
		return

	var popup_key = "pet_collection_confirm:%s" % str(pet.id)
	if _focus_existing_popup(popup_key):
		return
	var confirm_popup = Window.new()
	_mark_popup_key(confirm_popup, popup_key)
	confirm_popup.title = ""

	confirm_popup.size = Vector2i(420, 360)
	confirm_popup.transparent = true
	confirm_popup.borderless = true
	confirm_popup.unresizable = true
	var submitting: = false
	confirm_popup.close_requested.connect( func():

		if submitting:
			return
		if is_instance_valid(confirm_popup):
			confirm_popup.queue_free()
	)

	var main_panel = Panel.new()
	main_panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	main_panel.add_theme_stylebox_override("panel", UIStyle.create_popup_style())

	var vbox = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 20
	vbox.offset_top = 20
	vbox.offset_right = -20
	vbox.offset_bottom = -20
	vbox.add_theme_constant_override("separation", 15)

	var title = Label.new()
	title.text = "加入图鉴确认"
	title.add_theme_font_size_override("font_size", 24)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	vbox.add_child(title)

	var sep = HSeparator.new()
	vbox.add_child(sep)

	var info_label = Label.new()
	const PetCollectionDataConfirm = preload("res://scripts/pet_collection/pet_collection_data.gd")
	var is_mutation_invest: = false
	if game_manager.pet_collection_manager:
		var cinfo = game_manager.pet_collection_manager.get_collection_info(str(pet.pet_id))
		is_mutation_invest = bool(cinfo.get("is_normal_max", false)) and _get_pet_mutation_count(pet) >= 1
	if is_mutation_invest:
		title.text = "变异升华确认"
		info_label.text = "确定要将变异品质 %s (Lv.%d) 投入图鉴升华吗？\n\n加入后宠物将消失，变异图鉴+1（每只%s）" % [
			pet.pet_name, 
			pet.level, 
			PetCollectionDataConfirm.format_bonus_percent_signed(PetCollectionDataConfirm.MUTATION_BONUS_PER)
		]
	else:
		info_label.text = "确定要将 %s (Lv.%d) 加入图鉴吗？\n\n加入后宠物将消失，图鉴等级+1" % [pet.pet_name, pet.level]
	info_label.add_theme_font_size_override("font_size", 18)
	info_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	info_label.add_theme_color_override("font_color", Color(0.9, 0.9, 0.9))
	info_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vbox.add_child(info_label)

	var warning_label = Label.new()
	warning_label.text = "⚠️ 此操作不可撤销"
	warning_label.add_theme_font_size_override("font_size", 16)
	warning_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	warning_label.add_theme_color_override("font_color", Color(0.9, 0.3, 0.3))
	vbox.add_child(warning_label)

	var btn_hbox = HBoxContainer.new()
	btn_hbox.alignment = BoxContainer.ALIGNMENT_CENTER
	btn_hbox.add_theme_constant_override("separation", 20)
	btn_hbox.custom_minimum_size = Vector2(0, 48)
	vbox.add_child(btn_hbox)

	var confirm_btn = Button.new()
	confirm_btn.text = "确认加入"
	confirm_btn.custom_minimum_size = Vector2(120, 44)
	UIStyle.style_popup_button(confirm_btn, true)
	var confirm_pet = pet
	var cached_instance_id: = str(pet.id)
	var cached_species_id: = str(pet.pet_id)
	var cancel_btn_ref: Button = null
	var set_confirm_busy: = func(busy: bool):
		if is_instance_valid(confirm_btn):
			confirm_btn.disabled = busy
		if is_instance_valid(cancel_btn_ref):
			cancel_btn_ref.disabled = busy
	confirm_btn.pressed.connect( func():
		if submitting:
			return
		submitting = true
		set_confirm_busy.call(true)
		if game_manager.pet_collection_manager and game_manager.pet_manager:
			if not game_manager.pet_manager.pets.has(confirm_pet):
				submitting = false
				set_confirm_busy.call(false)
				_show_error_tip("该宠物已被处理，请勿重复操作")
				return
			if game_manager.network == null or not game_manager.network.is_logged_in():
				submitting = false
				set_confirm_busy.call(false)
				_show_tip_popup("请先登录后再投入图鉴")
				return
			if not bool(game_manager.is_cloud_sync_ready()):
				submitting = false
				set_confirm_busy.call(false)
				_show_error_tip("出战宠物状态同步中，请稍后再试")
				return
			if not await game_manager.force_cloud_upload_and_wait("pet_collection_invest_precheck", false, 15.0):
				submitting = false
				set_confirm_busy.call(false)
				_show_error_tip("宠物状态同步中，请稍后再试")
				return
			if not is_instance_valid(confirm_pet) or not game_manager.pet_manager.pets.has(confirm_pet):
				submitting = false
				set_confirm_busy.call(false)
				_show_error_tip("该宠物已被处理，请刷新后重试")
				return
			var state: = {"done": false, "ok": false, "message": "", "data": {}}
			var op_id: = "pet_collection_invest_%d_%s" % [Time.get_ticks_usec(), cached_instance_id]
			var on_success = func(data: Dictionary):
				state.done = true
				state.ok = true
				state.data = data if data is Dictionary else {}
				state.message = str(state.data.get("message", "图鉴升级成功"))
				if game_manager.pet_manager:
					game_manager.pet_manager.remove_pet_by_id(cached_instance_id)
				if state.data.has("saveData") and state.data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(state.data.get("saveData"), {"preserve_local_pets_not_in_cloud": true, "skip_pet_collection_trim": true})
				elif game_manager.pet_collection_manager != null:
					# 服务端 /pet/collection/invest 只回 {success, points}：既不收走宠物，也不回存档。
					# 图鉴进度唯一的落地方式是 saveData，缺了它就成了「宠物没了、图鉴还是 0」，
					# 五行图鉴永远凑不满 10 个 → 飞升大罗金仙被永久卡死。
					# 这里按同一条规则在本地补记一次，随后照常强制上传，把进度写进云端存档。
					var pcm = game_manager.pet_collection_manager
					var species_local: = cached_species_id
					var old_n: int = pcm.get_count(species_local)
					var new_n: int = old_n + 1
					var kind_local: = "mutation" if is_mutation_invest else "normal"
					var res_local: Variant = state.data.get("result")
					if res_local is Dictionary:
						new_n = int((res_local as Dictionary).get("newCount", new_n))
						kind_local = str((res_local as Dictionary).get("investKind", kind_local))
					if kind_local == "mutation":
						# 变异升华：普通图鉴已满 50，这一只加的是变异层数，不能算进普通进度
						pcm.apply_species_progress_from_save(species_local, old_n, pcm.get_mutation_count(species_local) + 1)
					else:
						pcm.apply_species_progress_from_save(species_local, new_n, -1)
					# 补齐 result，让下面读 result 的图鉴提示、任务计数能正常走
					state.data["result"] = {
						"speciesId": species_local, 
						"oldCount": old_n, 
						"newCount": new_n, 
						"investKind": kind_local, 
					}
			var on_failed = func(error: String):
				state.done = true
				state.ok = false
				state.message = error
			game_manager.network.pet_collection_invest_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.pet_collection_invest_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.pet_collection_invest(cached_instance_id, op_id, cached_species_id, "mutation" if is_mutation_invest else "normal")
			var deadline: = Time.get_ticks_msec() + 20000
			while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
				await game_manager.get_tree().process_frame
			if game_manager.network.pet_collection_invest_success.is_connected(on_success):
				game_manager.network.pet_collection_invest_success.disconnect(on_success)
			if game_manager.network.pet_collection_invest_failed.is_connected(on_failed):
				game_manager.network.pet_collection_invest_failed.disconnect(on_failed)
			submitting = false
			if not bool(state.ok):
				set_confirm_busy.call(false)
				var fail_msg: = str(state.message)
				if fail_msg.is_empty():
					fail_msg = "图鉴投入超时，请稍后重试"
				_show_error_tip(fail_msg)
				return
			var upload_ok: = true
			if game_manager.has_method("force_cloud_upload_and_wait"):
				upload_ok = await game_manager.force_cloud_upload_and_wait("pet_collection_invest_post", true, 20.0)
			if not upload_ok:
				_show_tip_popup("图鉴投入成功，宠物列表已保留；云端同步稍后会自动重试")
			var res_v: Variant = state.data.get("result")
			if res_v is Dictionary and int((res_v as Dictionary).get("oldCount", -1)) == 0 and game_manager.quest_manager:
				game_manager.quest_manager.on_pet_collection_activated()
			if is_instance_valid(confirm_popup):
				confirm_popup.queue_free()
			if is_instance_valid(parent_popup):
				parent_popup.queue_free()
			_update_pet_ui()
			var species_id: = cached_species_id
			var old_count: = 0
			var invest_kind: = "normal"
			var bonus_inc: = 0.0
			if res_v is Dictionary:
				var res_dict: = res_v as Dictionary
				species_id = str(res_dict.get("speciesId", species_id))
				old_count = int(res_dict.get("oldCount", 0))
				invest_kind = str(res_dict.get("investKind", "normal"))
				if res_dict.has("bonusIncrease"):
					bonus_inc = float(res_dict.get("bonusIncrease", 0.0))
			if old_count < 0:
				old_count = 0
			const PetCollectionDataClass = preload("res://scripts/pet_collection/pet_collection_data.gd")
			var bonus_type: = PetCollectionDataClass.get_bonus_type(species_id)
			if bonus_inc <= 0.0:
				if invest_kind == "mutation":
					bonus_inc = PetCollectionDataClass.MUTATION_BONUS_PER
				else:
					bonus_inc = PetCollectionDataClass.get_bonus_increase(old_count)
			_show_collection_success_tip(bonus_type, bonus_inc, invest_kind == "mutation")
		else:
			submitting = false
			set_confirm_busy.call(false)
	)
	btn_hbox.add_child(confirm_btn)

	var cancel_btn = Button.new()
	cancel_btn_ref = cancel_btn
	cancel_btn.text = "取消"
	cancel_btn.custom_minimum_size = Vector2(120, 44)
	UIStyle.style_popup_button(cancel_btn, false)
	cancel_btn.pressed.connect( func():
		if submitting:
			return
		if is_instance_valid(confirm_popup):
			confirm_popup.queue_free()
	)
	btn_hbox.add_child(cancel_btn)

	main_panel.add_child(vbox)
	confirm_popup.add_child(main_panel)
	add_child(confirm_popup)
	confirm_popup.popup_centered()


