func _show_character_equipment_bonus_popup() -> void :
	var popup_key: = "char_equip_bonus"
	var shell: = _open_styled_popup(popup_key, INVENTORY_DETAIL_POPUP_GROUP, Vector2i(460, 520), 14)
	if shell.is_empty():
		return
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox

	var title: = Label.new()
	title.text = "装备属性加成"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 22)
	title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	vbox.add_child(title)

	var equipped = game_manager.equipment_manager.equipped
	var total_attack = 0
	var total_defense = 0
	var total_hp = 0
	var total_mp = 0
	var total_agility = 0
	for slot in equipped:
		var item = equipped[slot]
		if item:
			total_attack += item.attack
			total_defense += item.defense
			total_hp += item.hp
			total_mp += item.mp
			total_agility += item.agility

	var stats_grid: = GridContainer.new()
	stats_grid.columns = 2
	stats_grid.add_theme_constant_override("h_separation", 36)
	stats_grid.add_theme_constant_override("v_separation", 14)
	vbox.add_child(stats_grid)
	stats_grid.add_child(_create_stat_label("攻击加成", total_attack, Color(1, 0.5, 0.5)))
	stats_grid.add_child(_create_stat_label("内力加成", total_mp, Color(0.5, 0.8, 1)))
	stats_grid.add_child(_create_stat_label("防御加成", total_defense, Color(0.5, 0.7, 1)))
	stats_grid.add_child(_create_stat_label("敏捷加成", total_agility, Color(1, 1, 0.5)))
	stats_grid.add_child(_create_stat_label("生命加成", total_hp, Color(0.5, 1, 0.5)))

	if game_manager.suit_manager:
		var set_bonus = game_manager.suit_manager.calculate_total_set_bonus()
		var active_suits_pre = game_manager.suit_manager.get_active_suit_sets()
		if active_suits_pre.size() > 0 or set_bonus.attack > 0 or set_bonus.defense > 0 or set_bonus.hp > 0 or set_bonus.agility > 0 or set_bonus.mp > 0:
			var suit_title: = Label.new()
			suit_title.text = "套装属性加成"
			suit_title.add_theme_font_size_override("font_size", 18)
			suit_title.add_theme_color_override("font_color", Color(1, 0.84, 0))
			vbox.add_child(suit_title)
			var suit_grid: = GridContainer.new()
			suit_grid.columns = 2
			suit_grid.add_theme_constant_override("h_separation", 36)
			suit_grid.add_theme_constant_override("v_separation", 14)
			vbox.add_child(suit_grid)
			suit_grid.add_child(_create_stat_label("攻击加成", set_bonus.attack, Color(1, 0.7, 0.5)))
			suit_grid.add_child(_create_stat_label("内力加成", set_bonus.mp, Color(0.5, 0.9, 1)))
			suit_grid.add_child(_create_stat_label("防御加成", set_bonus.defense, Color(0.5, 0.8, 1)))
			suit_grid.add_child(_create_stat_label("敏捷加成", set_bonus.agility, Color(1, 1, 0.7)))
			suit_grid.add_child(_create_stat_label("生命加成", set_bonus.hp, Color(0.7, 1, 0.5)))
			if active_suits_pre.size() > 0:
				var suit_list_label: = Label.new()
				suit_list_label.text = "已激活套装: " + ", ".join(active_suits_pre)
				suit_list_label.add_theme_font_size_override("font_size", 16)
				suit_list_label.add_theme_color_override("font_color", Color(1, 0.84, 0))
				suit_list_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
				suit_list_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				vbox.add_child(suit_list_label)
				var min_enh_lv: = _get_character_full_set_min_enhance_level()
				if min_enh_lv > 0:
					var bonus_pct: = SuitEquipmentEnhance.total_set_bonus_percent(min_enh_lv) * 100.0
					var enh_label: = Label.new()
					enh_label.text = "五件同套最低 +%d，当前套装加成比例：%.1f%%" % [min_enh_lv, bonus_pct]
					enh_label.add_theme_font_size_override("font_size", 15)
					enh_label.add_theme_color_override("font_color", Color(0.75, 0.9, 1.0))
					enh_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
					enh_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
					vbox.add_child(enh_label)

	var close_btn: = _popup_fixed_btn("关闭", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	close_btn.pressed.connect( func(): popup.queue_free())
	vbox.add_child(_popup_btn_row([close_btn]))
	_finish_styled_popup(popup)

func _update_pet_view():
