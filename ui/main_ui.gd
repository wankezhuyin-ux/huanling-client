func _assist_formation_board_width() -> float:
	if pet_assist_scroll and is_instance_valid(pet_assist_scroll) and pet_assist_scroll.size.x > 8.0:
		return maxf(280.0, pet_assist_scroll.size.x - 8.0)
	return 420.0

func _fit_assist_formation_board(board: Control) -> void :
	if board == null or not is_instance_valid(board):
		return
	var w: = _assist_formation_board_width()
	var h: = w / _ASSIST_FORMATION_ASPECT
	var target: = Vector2(w, h)
	if board.custom_minimum_size.distance_to(target) < 1.0:
		return
	board.custom_minimum_size = target

func _place_assist_formation_seat(parent: Control, seat: Control, nx: float, ny: float, seat_size: Vector2, offset_x: float = 0.0, offset_y: float = 0.0) -> void :
	if parent == null or seat == null:
		return
	parent.add_child(seat)
	seat.anchor_left = nx
	seat.anchor_top = ny
	seat.anchor_right = nx
	seat.anchor_bottom = ny
	seat.offset_left = - seat_size.x * 0.5 + offset_x
	seat.offset_right = seat_size.x * 0.5 + offset_x

	seat.offset_top = - seat_size.y * 0.82 + offset_y
	seat.offset_bottom = seat_size.y * 0.18 + offset_y


func _assist_formation_slot_xs() -> Array:
	var w: = maxf(1.0, _assist_formation_board_width())
	var left_n: = _ASSIST_FORMATION_SLOT_X0 - _ASSIST_FORMATION_EDGE_NUDGE_PX / w
	var right_n: = _ASSIST_FORMATION_SLOT_X4 + _ASSIST_FORMATION_EDGE_NUDGE_PX / w
	var xs: Array = []
	for i in range(5):
		xs.append(left_n + float(i) * (right_n - left_n) / 4.0)
	return xs

func _build_pet_assist_view() -> void :
	if pet_assist_container == null:
		pet_assist_container = get_node_or_null("MainContent/PetView/ContentArea/AssistScroll/AssistContainer")
	if pet_assist_container == null:
		return
	_clear_container_immediate(pet_assist_container)
	if not game_manager or not game_manager.pet_manager:
		return
	if pet_assist_scroll:
		pet_assist_scroll.mouse_filter = Control.MOUSE_FILTER_STOP
		pet_assist_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
		pet_assist_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	pet_assist_container.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pet_assist_container.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	pet_assist_container.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var pm = game_manager.pet_manager
	pm._ensure_assist_pets_size()
	var rei: = int(game_manager.player.reincarnation) if game_manager.player else 0

	var tip_row: = HBoxContainer.new()
	tip_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tip_row.add_theme_constant_override("separation", 8)
	pet_assist_container.add_child(tip_row)

	var tip: = Label.new()
	tip.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tip.text = "助战 · 投胎 %d（每100开1槽）" % rei
	tip.add_theme_font_size_override("font_size", 16)
	tip.add_theme_color_override("font_color", Color(0.95, 0.96, 1.0))
	tip_row.add_child(tip)

	var help_btn: = Button.new()
	help_btn.text = "?"
	help_btn.custom_minimum_size = Vector2(40, 36)
	help_btn.add_theme_font_size_override("font_size", 16)
	help_btn.pressed.connect(_show_assist_help_dialog)
	tip_row.add_child(help_btn)

	var overview_btn: = Button.new()
	overview_btn.text = "查看助战加成"
	overview_btn.custom_minimum_size = Vector2(140, 36)
	overview_btn.add_theme_font_size_override("font_size", 15)
	overview_btn.pressed.connect(_show_assist_bonus_overview_dialog)
	tip_row.add_child(overview_btn)

	var board: = Control.new()
	board.name = "AssistFormationBoard"
	board.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	board.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_fit_assist_formation_board(board)
	pet_assist_container.add_child(board)
	board.resized.connect( func():
		_fit_assist_formation_board(board)
	)
	call_deferred("_fit_assist_formation_board", board)

	var bg: = TextureRect.new()
	bg.name = "FormationBg"
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	bg.offset_left = 0
	bg.offset_top = 0
	bg.offset_right = 0
	bg.offset_bottom = 0
	bg.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	bg.stretch_mode = TextureRect.STRETCH_SCALE
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var bg_tex: = _load_assist_ui_texture(_ASSIST_BG_PATH)
	if bg_tex:
		bg.texture = bg_tex
	board.add_child(bg)

	var seat_sz: = _ASSIST_FORMATION_PET_SIZE
	var active_sz: = _ASSIST_FORMATION_ACTIVE_SIZE
	var slot_xs: Array = _assist_formation_slot_xs()
	var row_down: = _ASSIST_FORMATION_ROW_DOWN_PX
	_place_assist_formation_seat(board, _create_assist_formation_active_seat(active_sz), _ASSIST_FORMATION_ACTIVE_POS.x, _ASSIST_FORMATION_ACTIVE_POS.y, active_sz, 0.0, _ASSIST_FORMATION_ACTIVE_DOWN_PX)
	for i in range(5):
		var nx: float = float(slot_xs[i])
		_place_assist_formation_seat(board, _create_assist_formation_slot_seat(i, seat_sz), nx, _ASSIST_FORMATION_ROW0_Y, seat_sz, 0.0, row_down)
	for i in range(5, 10):
		var nx2: float = float(slot_xs[i - 5])
		_place_assist_formation_seat(board, _create_assist_formation_slot_seat(i, seat_sz), nx2, _ASSIST_FORMATION_ROW1_Y, seat_sz, 0.0, row_down)

func _assist_slot_bonus_summary_lines(assist_pet) -> Dictionary:
	if assist_pet == null:
		return {"rate": "加成比例：—", "stats": ""}
	var rate_pct: = PetAssistBonus.rate_for_pet(assist_pet) * 100.0
	var atk: = PetAssistBonus.flat_bonus_from_assist_pet(assist_pet, "attack")
	var deff: = PetAssistBonus.flat_bonus_from_assist_pet(assist_pet, "defense")
	var agi: = PetAssistBonus.flat_bonus_from_assist_pet(assist_pet, "agility")
	var hp: = PetAssistBonus.flat_bonus_from_assist_pet(assist_pet, "hp")
	return {
		"rate": "加成比例：%.0f%%" % rate_pct, 
		"stats": "攻+%.0f 防+%.0f 敏+%.0f 血+%.0f" % [atk, deff, agi, hp], 
	}

