## 角色页左栏角色卡（设计稿 char.html .hero）：立绘 + 双圆环光环 +
## 名字/境界/等级 + 综合战力 + 气血/内力条 + 投胎次数。
##
## 设计稿是「左栏竖卡 + 右栏属性表」的版式，所以这里必须按窄栏来做：
## 宽度跟着 HeroColumn 走（约屏宽 40%），内容一律纵向排；
## 立绘用战斗同款 idle 动图帧（AnimatedSprite2D）而不是方形头像，
## 人物是透明的、会呼吸，和设计稿的"人物动态图"一致。
func _build_character_hero_card(player) -> PanelContainer:
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	var card: = PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.size_flags_vertical = Control.SIZE_EXPAND_FILL
	card.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.036, 0.031, 0.022, 0.62)
	st.border_color = Color(0.788, 0.635, 0.294, 0.42)
	st.set_border_width_all(hair)
	st.set_corner_radius_all(0)
	card.add_theme_stylebox_override("panel", st)
	# 双金线：PanelContainer 会把子节点拉满，InkInnerLine 不能当子节点，改挂 draw
	card.draw.connect(_draw_hero_card_inner_line.bind(card, 5.0))
	card.resized.connect(card.queue_redraw)

	var pad: = MarginContainer.new()
	pad.add_theme_constant_override("margin_left", int(round(10.0 * s)))
	pad.add_theme_constant_override("margin_right", int(round(10.0 * s)))
	pad.add_theme_constant_override("margin_top", int(round(10.0 * s)))
	pad.add_theme_constant_override("margin_bottom", int(round(12.0 * s)))
	pad.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(pad)

	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", int(round(7.0 * s)))
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pad.add_child(col)

	# ① 道体行（设计稿左栏顶部：道体 + 名字 · Lv）
	var head_row: = HBoxContainer.new()
	head_row.add_theme_constant_override("separation", int(round(10.0 * s)))
	head_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(head_row)
	head_row.add_child(_ink_text("道 体", 23.0, Color(0.87, 0.85, 0.78), false))
	head_row.add_child(_ink_text(str(player.player_name), 23.0, Color(0.62, 0.50, 0.25), false))
	head_row.add_child(_ink_text("· Lv.%d" % int(player.level), 23.0, Color(0.56, 0.45, 0.22), false))

	# ② 立绘：idle 动图帧 + 背后双圆环。用动图而不是方形头像 —— 头像图带浅色
	# 背景，放大后是一块亮方块；战斗帧本身就是透明人物，最贴近设计稿。
	var stage: = Control.new()
	stage.custom_minimum_size = Vector2(0, 452.0 * s)
	stage.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	# 关键：不再 SIZE_EXPAND_FILL。之前 stage 吃掉整张卡的高度，人物被“撑”到
	# 栏的下半部分、名字被顶到最底部；效果图里人物在上三分之一，留白在战力下面。
	stage.size_flags_vertical = Control.SIZE_FILL
	stage.clip_contents = false
	stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(stage)
	var ring: = Control.new()
	ring.name = "HeroRing"
	ring.mouse_filter = Control.MOUSE_FILTER_IGNORE
	stage.add_child(ring)
	ring.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	ring.draw.connect(_draw_hero_rings_auto.bind(ring))
	var hero_anim: = _make_hero_idle_anim(stage, s)
	if hero_anim == null:
		# 兜底：没有动图帧就退回方形头像 + 水墨 shader（去底 + 边缘渐隐）
		var tex = _get_player_avatar_texture()
		if tex != null:
			var pic: = TextureRect.new()
			pic.texture = tex
			pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
			var mat: = ShaderMaterial.new()
			mat.shader = load("res://assets/shaders/portrait_ink.gdshader")
			pic.material = mat
			stage.add_child(pic)
			pic.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	# ③ 名字（居中）+ 境界签
	var name_row: = HBoxContainer.new()
	name_row.alignment = BoxContainer.ALIGNMENT_CENTER
	name_row.add_theme_constant_override("separation", int(round(6.0 * s)))
	name_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(name_row)
	name_row.add_child(_ink_text(str(player.player_name), 38.0, Color(0.92, 0.90, 0.85), true, true))

	# ③b 境界签 + 等级同一行居中（效果图：签在左、Lv 在右，字号一致）
	var meta_row: = HBoxContainer.new()
	meta_row.alignment = BoxContainer.ALIGNMENT_CENTER
	meta_row.add_theme_constant_override("separation", int(round(9.0 * s)))
	meta_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(meta_row)
	meta_row.add_child(_ink_tag_chip(str(player.realm), Color(0.788, 0.635, 0.294)))
	meta_row.add_child(_ink_text("Lv.%d" % int(player.level), 24.0, Color(0.82, 0.80, 0.74), false))

	# ④ 综合战力（设计稿 .power：上下各一根金线、中间两行居中）
	var rule_top: = ColorRect.new()
	rule_top.color = Color(0.788, 0.635, 0.294, 0.16)
	rule_top.custom_minimum_size = Vector2(0, hair)
	rule_top.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(rule_top)
	var power_box: = VBoxContainer.new()
	power_box.alignment = BoxContainer.ALIGNMENT_CENTER
	power_box.add_theme_constant_override("separation", int(round(1.0 * s)))
	power_box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(power_box)
	var power_key: = _ink_text("综 合 战 力", 17.0, Color(0.46, 0.43, 0.37), false)
	power_key.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	power_key.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	power_box.add_child(power_key)
	var power_val: = _ink_text(_format_big_number(_player_power_score(player)), 37.0, INK_GOLD_HI, true, true)
	power_val.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	power_val.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	power_box.add_child(power_val)
	# 效果图战力数值下面没有第二条线，留白到气血条为止
	var spacer: = Control.new()
	spacer.size_flags_vertical = Control.SIZE_EXPAND_FILL
	spacer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(spacer)

	# ⑤ 气血 / 内力（设计稿左栏底部竖排）
	col.add_child(_ink_hero_vital_row("气血", float(player.hp), float(player.max_hp),
		Color(0.72, 0.26, 0.20)))
	col.add_child(_ink_hero_vital_row("内力", float(player.mp), float(player.max_mp),
		Color(0.788, 0.635, 0.294)))

	# ⑥ 投胎次数（设计稿 vitals 第三行）
	var birth_row: = HBoxContainer.new()
	birth_row.add_theme_constant_override("separation", int(round(6.0 * s)))
	birth_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(birth_row)
	birth_row.add_child(_ink_text("投胎次数", 15.0, Color(0.62, 0.58, 0.50), false))
	var birth_sp: = Control.new()
	birth_sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	birth_sp.mouse_filter = Control.MOUSE_FILTER_IGNORE
	birth_row.add_child(birth_sp)
	birth_row.add_child(_ink_text("%d 次" % int(player.reincarnation), 17.0, INK_GOLD_HI, true, false))
	return card


## 立绘动图：复用战斗那套 idle 帧（256px 一帧的透明人物序列）。
## 帧图是 256 基准，按 stage 的短边等比缩放并居中；stage 尺寸变化时重排。
func _make_hero_idle_anim(stage: Control, s: float) -> AnimatedSprite2D:
	var frames: SpriteFrames = _build_player_battle_sprite_frames_for_character(_get_player_character_id())
	if frames == null or not frames.has_animation("idle"):
		return null
	if frames.get_frame_count("idle") <= 0:
		return null
	var anim: = AnimatedSprite2D.new()
	anim.name = "HeroIdleAnim"
	anim.centered = true
	anim.sprite_frames = frames
	anim.animation = "idle"
	anim.z_index = 1
	stage.add_child(anim)
	# 帧图里人物不一定正好在 256 画布正中（挥剑的手臂会把包围盒拉偏），
	# 光环要按**可见像素**的包围盒对齐，否则会出现"圆环站在人左边"这种情况。
	var off: = Vector2.ZERO
	var ftex: = frames.get_frame_texture("idle", 0)
	if ftex is AtlasTexture:
		var atlas: = ftex as AtlasTexture
		if atlas.atlas != null:
			var sheet_img: = atlas.atlas.get_image()
			if sheet_img != null:
				var reg: = atlas.region
				var sub: = sheet_img.get_region(Rect2i(reg.position, reg.size))
				var used: = sub.get_used_rect()
				if used.size.x > 4 and used.size.y > 4:
					off = (Vector2(used.position) + Vector2(used.size) * 0.5) - Vector2(128.0, 128.0)

	var fit: = func() -> void :
		if not is_instance_valid(anim) or not is_instance_valid(stage):
			return
		# 帧图 256 里人物可见区约 0.53w × 0.59h —— 这套 idle 人物本身偏"宽扁"，
		# 按高度取会把两侧撑满整个左栏（看着就是"人物太大"）。设计稿里人物
		# 宽度只占左栏约 6 成、高度约 1/3，所以这里按**栏宽**定尺寸，再用栏高兜上限。
		# 目标：可见高 ≈ 栏高 19%、可见宽 ≈ 栏宽 53%（效果图实测）。
		# stage 高度 470*s 是给人物的“取景框”，系数不能卡在 height*1.0 上，
		# 否则人物只长到 15%（上一版就是被 1.06 卡住了）。
		var side: float = minf(stage.size.x * 1.83, stage.size.y * 1.33)
		if side < 8.0:
			return
		var k: float = side / 256.0
		anim.scale = Vector2(k, k)
		anim.position = Vector2(stage.size.x * 0.5, stage.size.y * 0.52) - off * k
		# 光环跟着人物一起缩，并且用同一个中心（之前半径 = 半个栏宽、还偏到腿下）
		stage.set_meta("hero_side", side)
		stage.set_meta("hero_cx", anim.position.x)
		stage.set_meta("hero_cy", anim.position.y)
		var ring_node: = stage.get_node_or_null("HeroRing")
		if ring_node != null:
			(ring_node as Control).queue_redraw()
	stage.resized.connect(fit)
	anim.play("idle")
	fit.call()
	return anim


## 光环：半径跟着**人物尺寸**算（设计稿里圆环直径≈人物宽度），
## 之前按 stage 整块算，半径等于半个栏宽，比人物还大一圈。
func _draw_hero_rings_auto(c: Control) -> void:
	var side: float = 0.0
	var host: = c.get_parent()
	if host != null and host.has_meta("hero_side"):
		side = float(host.get_meta("hero_side"))
	if side <= 1.0:
		side = minf(c.size.x, c.size.y) * 0.9
	var r_out: float = clampf(side * 0.155, 10.0, minf(c.size.x, c.size.y) * 0.42)
	if r_out < 10.0:
		return
	_draw_hero_rings(c, r_out, r_out * 0.86)


## 面板内缩第二根金线（挂在 PanelContainer 的 draw 上，不能当子节点）
func _draw_hero_card_inner_line(c: Control, inset: float) -> void:
	var w: float = c.size.x - inset * 2.0
	var h: float = c.size.y - inset * 2.0
	if w <= 2.0 or h <= 2.0:
		return
	c.draw_rect(Rect2(inset, inset, w, h), Color(0.788, 0.635, 0.294, 0.22), false, 1.0)


## 装备一览：基础属性页里一眼看到"我这身什么水平"，点任意格跳装备页。
## 设计稿把这块放在属性列表最下面，作用是给"去装备页"一个入口和一次确认。
func _build_equipment_glance_section() -> VBoxContainer:
	var s: = _ink_s()
	var box: = VBoxContainer.new()
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.add_theme_constant_override("separation", int(round(8.0 * s)))
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", int(round(8.0 * s)))
	head.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head.add_child(_ink_text("装备一览", 21.0, INK_GOLD_HI, true, true))
	var sp: = Control.new()
	sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sp.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head.add_child(sp)
	var more: = Button.new()
	more.text = "全部装备 ›"
	more.focus_mode = Control.FOCUS_NONE
	more.custom_minimum_size = Vector2(0, 38.0 * s)
	_ink_outline_button(more, _ink_font(18.0))
	more.pressed.connect( func(): _switch_character_subtab_to_equipment())
	head.add_child(more)
	box.add_child(head)

	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", int(round(8.0 * s)))
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(row)

	var slots: Array = [
		["weapon", "武器"], ["helmet", "头盔"], ["armor", "衣甲"],
		["boots", "鞋靴"], ["accessory", "饰品"],
	]
	var side: = 104.0 * s
	var equipped: Dictionary = {}
	if game_manager != null and game_manager.equipment_manager != null:
		equipped = game_manager.equipment_manager.equipped
	for spec in slots:
		var slot_key: String = spec[0]
		var slot_cn: String = spec[1]
		var item = equipped.get(slot_key, null)
		if item == null:
			row.add_child(InventoryGridCell.make_empty(int(side), slot_cn, InventoryGridCell.EQUIP_SLOT_BORDER))
			continue
		var tex: Texture2D = InventoryIconHelper.resolve_equipment_icon(item)
		var rarity: String = str(item.rarity) if "rarity" in item else "common"
		row.add_child(InventoryGridCell.make_filled(
			int(side), tex, str(item.name), 1,
			InventoryIconHelper.rarity_border_color(rarity),
			func(): _show_equipment_action_popup(item, slot_key, true),
			Color.WHITE, false, "", false, ""))
	return box


func _switch_character_subtab_to_equipment() -> void:
	# 页签顺序由 tscn 决定，这里按名字找，别写死 index
	var box := get_node_or_null("MainContent/CharacterView/SubButtons")
	if box == null:
		return
	for i in range(box.get_child_count()):
		var b: = box.get_child(i)
		if b is Button and str((b as Button).text).contains("装备"):
			(b as Button).emit_signal("pressed")
			return


## 左栏角色卡重绘。设计稿是「左栏人物 + 右栏属性表」的两栏版式：
## 人物、名字、战力、气血内力常驻在左，右侧页签切换只换属性表。
func _refresh_character_hero_column() -> void:
	if character_hero_column == null:
		return
	if game_manager == null or game_manager.player == null:
		return
	# 外壳留空：框线由角色卡自己画（避免双层边框叠在一起）
	character_hero_column.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	_clear_container_immediate(character_hero_column)
	var card: = _build_character_hero_card(game_manager.player)
	character_hero_column.add_child(card)
	# Panel 不是容器，不会给子节点排版：不显式铺满，卡片会缩成"内容最小宽"，
	# 左栏就变成一条细窄的竖条（第一版就是这么错的）。
	card.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)


func _build_basic_stats_view():
	var player = game_manager.player

	# ── 角色卡放在左栏（设计稿版式：左栏竖卡 / 右栏属性表）──
	# 它是常驻的，不参与右侧滚动区的清空，数据变了单独重建一次。
	_refresh_character_hero_column()

	var stats_section = _create_section_vbox("基础信息")
	character_basic_stats_container.add_child(stats_section)

	stats_section.add_child(_create_info_label("角色名称", player.player_name, 100, 18))
	stats_section.add_child(_create_info_label("等级", "Lv.%d" % player.level, 100, 18))
	stats_section.add_child(_create_info_label("境界", player.realm, 100, 18))
	stats_section.add_child(_create_info_label("修行值", str(player.cultivation), 100, 18))
	stats_section.add_child(_create_info_label("修行丹药", "%d/%d颗" % [player.cultivation_pills_used, player.MAX_CULTIVATION_PILLS_PER_LIFE], 100, 18))
	stats_section.add_child(_create_info_label("投胎次数", str(player.reincarnation), 100, 18))

	var separator2 = HSeparator.new()
	character_basic_stats_container.add_child(separator2)


	var points_section = VBoxContainer.new()
	points_section.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	points_section.add_theme_constant_override("separation", 10)
	character_basic_stats_container.add_child(points_section)


	var title_hbox = HBoxContainer.new()
	title_hbox.add_theme_constant_override("separation", 10)
	points_section.add_child(title_hbox)

	var section_title = Label.new()
	section_title.text = "属性加点"
	section_title.add_theme_font_size_override("font_size", 19)
	section_title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	title_hbox.add_child(section_title)


	var plan_btn = Button.new()
	plan_btn.text = "加点方案"
	plan_btn.custom_minimum_size = Vector2(88, 32)
	plan_btn.add_theme_font_size_override("font_size", 14)
	_apply_action_button_style(plan_btn)
	plan_btn.disabled = _player_attr_rpc_busy
	plan_btn.pressed.connect( func():
		_show_auto_allocation_dialog()
	)
	title_hbox.add_child(plan_btn)


	var plan_total: int = player._auto_allocation_plan_total()
	if player.pending_auto_points > 0 and plan_total > 0 and player.pending_auto_points >= plan_total:
		var allocate_now_btn = Button.new()
		allocate_now_btn.text = "立即分配(%d)" % player.pending_auto_points
		allocate_now_btn.custom_minimum_size = Vector2(98, 32)
		allocate_now_btn.add_theme_font_size_override("font_size", 14)
		_apply_action_button_style(allocate_now_btn)
		allocate_now_btn.disabled = _player_attr_rpc_busy
		allocate_now_btn.pressed.connect( func():
			_run_player_attr_auto_allocate()
		)
		title_hbox.add_child(allocate_now_btn)

	var separator_points = HSeparator.new()
	points_section.add_child(separator_points)

	var points_label = Label.new()
	if player.points > 0:
		points_label.text = "可用属性点: %d" % player.points
	else:
		points_label.text = "可用属性点: 0"
	if player.permanent_points > 0:
		points_label.text += "   永久: %d" % player.permanent_points
	points_label.add_theme_font_size_override("font_size", 18)
	points_label.add_theme_color_override("font_color", Color(1, 0.84, 0))
	points_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	points_section.add_child(points_label)

	# 「待分配 16 · 满100点自动分配」原来跟在主行后面，一行塞不下直接顶出屏幕，
	# 拆成一行小字副标题。
	if player.pending_auto_points > 0:
		var pending_hint = Label.new()
		pending_hint.text = "待分配 %d · 满%d点自动分配" % [player.pending_auto_points, player.AUTO_ALLOCATE_THRESHOLD]
		pending_hint.add_theme_font_size_override("font_size", 13)
		pending_hint.add_theme_color_override("font_color", Color(0.72, 0.68, 0.58))
		pending_hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		points_section.add_child(pending_hint)

	var points_grid = GridContainer.new()
