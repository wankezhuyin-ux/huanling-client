var _log_lines: Array = []
var _feed_lines: Array = []
const MAX_DISPLAY_LOG_LINES: int = 200
# 内嵌战报：设计稿（battle.html .feed）是带时间戳的滚动列表 —— 每行 [02:41] 灰
# 时间 + 正文 + 右侧朱砂伤害（暴击金），系统行金色。实装这里按 9:16 屏的可用
# 高度给了 10 行（240 设计像素 ≈ 面板高 -290→-52），比参考稿 5 行更接近设计稿密度。
const MAX_BATTLE_FEED_LINES: int = 10
# 战报行配色（对齐设计稿 ink.css：tm #6E6757 / dm #E0775C / crit #F0B24E / sys 金）
const FEED_TM_COLOR: String = "#6e6757"
const FEED_DM_COLOR: String = "#e0775c"
const FEED_CRIT_COLOR: String = "#f0b24e"
const FEED_SYS_COLOR: String = "#c9a24e"
var _feed_dmg_regex: RegEx = null
var _fight_log_history: BattleFightLogHistory = BattleFightLogHistory.new()
var _last_fight_log_victory: bool = false
var _current_fight_log_finished: bool = false
var _log_popup_view_index: int = 0
var _log_popup_meta_label: Label = null
var _log_popup_view: RichTextLabel = null
var _log_popup_scroll: ScrollContainer = null
var _log_popup_prev_btn: Button = null
var _log_popup_next_btn: Button = null
var _log_popup_window: Window = null

func _should_skip_battle_feed_line(message: String) -> bool:
	var stripped: = message.strip_edges()
	# 只滤掉「└ 属性 攻:8 防:6 …」这种从属行（参考稿画面日志区里也不占独立一行）。
	# 注意：**不要**顺手把「--- 第 N 回合 ---」「★ 连击触发 ★」「遭遇 X Lv.N!」
	# 这些行参考稿自己就会打，剔了反而是我们跟参考稿不一样。
	return stripped.begins_with("└")

func _apply_battle_feed_style() -> void :
	if battle_feed_panel:
		# 和上面「累计输出 / 每秒伤害」那条统计条用同一组底板参数（_build_battle_stats_bar），
		# 半透明墨底 + 1px 淡金线，两块面板看起来才是一套。
		var st: = StyleBoxFlat.new()
		st.bg_color = Color(0.052, 0.046, 0.033, 0.62)
		st.border_color = Color(0.788, 0.635, 0.294, 0.26)
		st.set_border_width_all(1)
		st.set_corner_radius_all(0)
		st.content_margin_left = 0.0
		st.content_margin_right = 0.0
		st.content_margin_top = 0.0
		st.content_margin_bottom = 0.0
		battle_feed_panel.add_theme_stylebox_override("panel", st)
		battle_feed_panel.clip_contents = true
	if battle_feed_text:
		battle_feed_text.add_theme_color_override("default_color", Color(0.87, 0.83, 0.74, 0.95))
		battle_feed_text.fit_content = false
		battle_feed_text.scroll_active = false
		battle_feed_text.scroll_following = true
		battle_feed_text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

func _clear_battle_feed() -> void :
	_feed_lines.clear()
	if battle_feed_text:
		battle_feed_text.clear()

func _refresh_battle_feed_display() -> void :
	if not battle_feed_text:
		return
	battle_feed_text.clear()
	for line in _feed_lines:
		battle_feed_text.append_text(line + "\n")
	if battle_feed_text.get_line_count() > 0:
		battle_feed_text.scroll_to_line(battle_feed_text.get_line_count() - 1)

## 战报时间戳：设计稿 .tm 是 [02:41] 这种"战斗时长"口径（mm:ss 递增），
## 和统计条第 3 格共用 _bst_start_ms，一场仗内连续。
func _battle_feed_timestamp() -> String:
	if _bst_start_ms <= 0:
		return "--:--"
	var elapsed: = maxf(0.0, float(Time.get_ticks_msec() - _bst_start_ms) / 1000.0)
	return "%02d:%02d" % [int(elapsed) / 60, int(elapsed) % 60]


## 内嵌战报行上色（设计稿 battle.html .line 的口径）：
## - 「--- 第 N 回合 ---」「★…★」→ 系统行，金色
## - 纯文本行里的「造成 X 点伤害」→ 数字染朱砂，暴击染金
## - **已经带 bbcode 的行走原样**：战斗日志系统（damage_feedback/status 之类）自己
##   就上了色，再转义一次会把 [color=red] 变成字面量（踩过）。
var _feed_regex_ready: bool = false
var _feed_has_tag_regex: RegEx = null

func _ink_feed_bbcode(message: String) -> String:
	var stripped: = message.strip_edges()
	var is_sys: = stripped.begins_with("---") or stripped.begins_with("★")
	if is_sys:
		return "[color=%s]%s[/color]" % [FEED_SYS_COLOR, stripped]
	if not _feed_regex_ready:
		_feed_regex_ready = true
		_feed_has_tag_regex = RegEx.new()
		_feed_has_tag_regex.compile("\\[/?(color|b|i|u|s|bgcolor|fgcolor|font|center|right|fill|outline_size|pulse|wave|tornado|shake|fade|rainbow|lb|rb)")
		_feed_dmg_regex = RegEx.new()
		_feed_dmg_regex.compile("([\\d][\\d,]*)\\s*点(伤害|内力)?")
	if _feed_has_tag_regex.search(stripped) != null:
		return stripped
	var safe: = stripped.replace("[", "[lb]").replace("]", "[rb]")
	var crit: = stripped.contains("暴击") or stripped.contains("会心")
	var dm_color: = FEED_CRIT_COLOR if crit else FEED_DM_COLOR
	# 只染紧跟"造成/受到/反击…点"语义的数字：先按正则抓数字段，
	# 再要求它前面 8 个字内出现过动词，避免把「Lv.860」「第 3 回合」染进去。
	var ranges: Array = []
	for m in _feed_dmg_regex.search_all(safe):
		var num_start: = m.get_start(1)
		if num_start < 8:
			continue
		var prefix: = safe.substr(maxi(0, num_start - 8), mini(8, num_start))
		if not (prefix.contains("造成") or prefix.contains("受到") or prefix.contains("反击") or prefix.contains("反弹")):
			continue
		ranges.append(Vector2i(num_start, m.get_end(1)))
	# 从后往前替换，避免前面的插入挪动后面的下标
	ranges.sort_custom(func(a, b): return a.x > b.x)
	var result: = safe
	for r in ranges:
		var num_text: = safe.substr(r.x, r.y - r.x)
		result = result.substr(0, r.x) + "[color=%s]%s[/color]" % [dm_color, num_text] + result.substr(r.y)
	return result

func _append_battle_feed_line(message: String) -> void :
	if _should_skip_battle_feed_line(message):
		return
	# 设计稿口径：每行 [mm:ss] 灰时间戳 + 正文 + 伤害染色。_feed_lines 存的是
	# 成品 bbcode（只供内嵌区显示）；弹窗的 _log_lines 仍是带【时:分:秒】的原文。
	_feed_lines.append("[color=%s][%s][/color] %s" % [FEED_TM_COLOR, _battle_feed_timestamp(), _ink_feed_bbcode(message)])
	if _feed_lines.size() > MAX_BATTLE_FEED_LINES:
		_feed_lines = _feed_lines.slice( - MAX_BATTLE_FEED_LINES)
	_refresh_battle_feed_display()

func _flash_battle_feed() -> void :
	if not battle_feed_text:
		return
	battle_feed_text.modulate = Color(1.45, 1.4, 1.1, 1.0)
	var tween = create_tween()
	tween.bind_node(battle_feed_text)
	tween.tween_property(battle_feed_text, "modulate", Color.WHITE, 0.35).set_trans(Tween.TRANS_SINE)

func _apply_battle_highlight(highlight: Dictionary, log_message: String = "") -> void :
	if highlight.is_empty():
		return
	if str(highlight.get("hit_fx", "")) == "splash":
		_play_splash_hit_fx(str(highlight.get("hit_fx_type", "monster")), int(highlight.get("hit_fx_index", -1)))
	var hl_type: = str(highlight.get("type", ""))
	var hl_text: = str(highlight.get("text", ""))
	if hl_text == "":
		return
	var anchor: = "center"
	var color: = Color(0.95, 0.95, 0.95, 1.0)
	var large: = false
	match hl_type:
		"battle_start":
			anchor = "center"
			color = Color(0.95, 0.95, 0.95, 1.0)
			large = true
		"combo":
			anchor = "player"
			color = BATTLE_BANNER_COLORS.combo
		"joint":
			anchor = "player"
			color = BATTLE_BANNER_COLORS.joint
		"skill":
			anchor = str(highlight.get("anchor", "pet"))
			if _is_bt_viewer() and hl_text == "一击三伤" and not log_message.is_empty():
				anchor = _resolve_bt_viewer_skill_anchor_from_message(log_message, anchor)
			color = BATTLE_BANNER_COLORS.skill
		_:
			return
	_flash_battle_feed()
	var hl_index: = int(highlight.get("anchor_index", -1))
	_show_battle_floating_text(anchor, hl_text, color, large, hl_type, hl_index)
	if highlight.has("heal_amount"):
		var heal_amount: int = int(highlight["heal_amount"])
		if heal_amount > 0:
			var heal_idx: = hl_index if anchor == "monster" else 0
			_show_battle_damage_float(anchor, heal_idx, "+%d" % heal_amount, Color(0.41, 0.86, 0.49, 1.0), 20)

func _extract_log_attacker_name_plain(message: String) -> String:
	var plain: = str(message)
	while true:
		var start: = plain.find("[")
		if start < 0:
			break
		var end: = plain.find("]", start)
		if end < 0:
			break
		plain = plain.substr(0, start) + plain.substr(end + 1)
	var skill_idx: = plain.find("【一击三伤】")
	var atk_idx: = plain.find(" 攻击")
	var cut: = plain.length()
	if skill_idx >= 0:
		cut = skill_idx
	elif atk_idx >= 0:
		cut = atk_idx
	return plain.substr(0, cut).strip_edges()

func _resolve_bt_viewer_skill_anchor_from_message(message: String, fallback_anchor: String) -> String:
	if not _is_bt_viewer() or game_manager == null or game_manager.battle_system == null:
		return fallback_anchor
	var attacker_name: = _extract_log_attacker_name_plain(message)
	if attacker_name.is_empty():
		return fallback_anchor
	var bs = game_manager.battle_system
	if bs.player and str(bs.player.player_name) == attacker_name:
		return "player"
	var coop = _get_coop_battle_unit("coop_player")
	if coop and str(coop.display_name) == attacker_name:
		return "coop_player"
	return fallback_anchor

func _add_log(message: String, highlight: Dictionary = {}) -> void :
	if not message.strip_edges().is_empty():
		var timestamp = Time.get_time_string_from_system()
		# 参考稿战斗日志的时间戳是【00:16:12】这种全角方括号，之前用的是 [00:16:12]，
		# 截图对比一眼就能看出差别，这里对齐参考稿写法。
		_log_lines.append("【%s】%s" % [timestamp, message])
		if _log_lines.size() > MAX_DISPLAY_LOG_LINES:
			_log_lines = _log_lines.slice( - MAX_DISPLAY_LOG_LINES)
			battle_log.clear()
			for line in _log_lines:
				battle_log.append_text(line + "\n")
		else:
			battle_log.append_text(_log_lines[-1] + "\n")
		_append_battle_feed_line(message)
	if not highlight.is_empty():
		_apply_battle_highlight(highlight, message)
	if not message.strip_edges().is_empty() and _log_popup_window != null and is_instance_valid(_log_popup_window) and _log_popup_view_index == 0:
		_refresh_fight_log_popup_content()


func _get_current_fight_log_title() -> String:
	if game_manager == null:
		return "战斗"
	if game_manager.is_brother_tower_battle:
		return "兄弟天关 · 第%d波" % int(game_manager.brother_tower_current_wave)
	if bool(game_manager.is_shengsi_tower_replay) or bool(game_manager.is_shengsi_replay_result_open):
		return "生死塔"
	if game_manager.is_tower_battle and int(game_manager.current_tower_floor) > 0:
		return "天关第%d层" % int(game_manager.current_tower_floor)
	var map_name: = str(game_manager.current_map)
	if not map_name.is_empty():
		return map_name
	return "战斗"


