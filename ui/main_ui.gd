	title_label.text = "批量使用 %s" % item.name
	title_label.add_theme_font_size_override("font_size", 20)
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_color_override("font_color", item.get_rarity_color())
	vbox.add_child(title_label)


	var count_hbox = HBoxContainer.new()
	count_hbox.alignment = BoxContainer.ALIGNMENT_CENTER

	var count_label = Label.new()
	count_label.text = "使用数量："
	count_label.add_theme_font_size_override("font_size", 16)
	count_hbox.add_child(count_label)

	var spinbox = SpinBox.new()
	spinbox.min_value = 1
	var batch_cap: int = int(item.count)
	if item_name_for_cap == InventoryManager.LIMIT_EQUIPMENT_GIFT_NAME:
		batch_cap = mini(batch_cap, InventoryManager.LIMIT_EQUIPMENT_GIFT_BATCH_MAX)
	elif item_name_for_cap == "宠物补章器":
		batch_cap = mini(batch_cap, mini(InventoryManager.PET_MEDAL_BATCH_MAX, InventoryManager.get_active_pet_medal_room()))
	elif InventoryManager.CULTIVATION_PILL_WHITELIST_KEYS.has(item_name_for_cap) and game_manager.player != null:
		var life_left: = maxi(0, int(game_manager.player.MAX_CULTIVATION_PILLS_PER_LIFE) - int(game_manager.player.cultivation_pills_used))
		batch_cap = mini(batch_cap, life_left)
	elif InventoryManager.item_uses_pet_batch_cap(item_name_for_cap):
		batch_cap = mini(batch_cap, InventoryManager.PET_BATCH_USE_MAX)
