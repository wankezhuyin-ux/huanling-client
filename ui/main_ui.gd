func _get_pet_equip_value(equipment, key: String) -> Variant:
	if equipment is Dictionary:
		if key == "pet_enhance_level":
			return int(equipment.get("pet_enhance_level", 0))
		var val = equipment.get(key, null)
		if val != null:
			match key:
				"name":
					return str(val)
				"id", "slot", "rarity":
					return str(val)
				"attack", "defense", "agility", "hp", "mp":
					return int(val) if val is float or val is int else 0
				_:
					return val
		match key:
			"id": return equipment.get("equip_id", "")
			"name": return equipment.get("equip_name", "")
			"rarity": return equipment.get("quality", "common")
			_: return 0
	elif equipment is Object:
		match key:
			"id": return equipment.id
			"name": return equipment.name
			"slot": return equipment.slot
			"rarity": return equipment.rarity
			"attack": return equipment.attack
			"defense": return equipment.defense
			"hp": return equipment.hp
			"mp": return equipment.mp
			"agility": return equipment.agility
			"pet_enhance_level": return equipment.pet_enhance_level
			_: return 0
	else:
		return 0

func _pet_equip_snapshot(equipment) -> Dictionary:
	# 把宠装拍成一份完整 dict 随穿戴请求发给服务端。
	# 服务端的宠装背包如果被旧的紧凑存档上传清空过，它会用这份快照补登，
	# 玩家就不会遇到「背包里明明有，点穿戴说宠装不存在」。
	if equipment is Dictionary:
		return (equipment as Dictionary).duplicate(true)
	if equipment is Object and equipment.has_method("to_dict"):
		var d = equipment.to_dict()
		if d is Dictionary:
			return d
	return {}

func _get_pet_medal_counts(pet) -> Dictionary:
	var result = {
		"brave": 0, 
		"calm": 0, 
		"bold": 0
	}
	if pet == null:
		return result

	if "medal_counts" in pet and pet.medal_counts is Dictionary:
		var medals = pet.medal_counts as Dictionary
		result.brave = int(medals.get("brave", medals.get("yongmeng", 0)))
		result.calm = int(medals.get("calm", medals.get("lengjing", 0)))
		result.bold = int(medals.get("bold", medals.get("guogan", 0)))
	elif "medals" in pet and pet.medals is Dictionary:
		var medals2 = pet.medals as Dictionary
		result.brave = int(medals2.get("brave", medals2.get("yongmeng", 0)))
		result.calm = int(medals2.get("calm", medals2.get("lengjing", 0)))
		result.bold = int(medals2.get("bold", medals2.get("guogan", 0)))

	result.brave = clamp(result.brave, 0, 5)
	result.calm = clamp(result.calm, 0, 5)
	result.bold = clamp(result.bold, 0, 5)
	return result

func _get_equipment_icon(slot: String) -> Texture2D:
