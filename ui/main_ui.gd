func _confirm_pet_equipment_batch_dismantle(equipment_list: Array, on_close_parent: Callable = Callable()) -> void :
	var ids: Array = []
	var total_frag: = 0
	for equipment in equipment_list:
		if equipment == null:
			continue
		var eid: = _pet_equipment_dismantle_selection_key(equipment)
		if eid.is_empty():
			continue
		ids.append(eid)
		total_frag += PetEquipmentEnhance.dismantle_fragment_count(equipment)
	if ids.is_empty():
		_show_simple_dialog("分解失败", "没有可分解的宠物装备")
		return
	_show_batch_dismantle_confirm_popup(
		"宠物装备批量分解确认", 
		"将分解 %d 件宠物装备，预计获得宠装碎片 x%d" % [ids.size(), total_frag], 
		func():
			if on_close_parent.is_valid():
				on_close_parent.call()
			_pending_pet_equipment_dismantle_ids = ids.duplicate()
			var op_id: = "pet_equipment_dismantle_batch_%d_%d" % [Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			game_manager.network.request_pet_equipment_dismantle_batch(ids, op_id)
	)

func _show_pet_equipment_batch_dismantle_result(result: Dictionary) -> void :
	var total: = int(result.get("totalFragmentCount", 0))
	var count: = int(result.get("committedCount", 0))
	var summary: = "成功分解 %d 件，共获得宠装碎片 x%d" % [count, total]
	_show_batch_dismantle_result_popup("宠物装备分解结果", summary, result.get("items", []), func(item: Dictionary) -> String:
		return "· %s  +%d 宠装碎片" % [str(item.get("name", "")), int(item.get("fragmentCount", 0))]
	)

func _on_pet_equipment_dismantle_batch_success(data: Dictionary) -> void :
	if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
	_pending_pet_equipment_dismantle_ids.clear()
	_refresh_pet_equipment_view()
	_update_bag_view()
	var result_var: Variant = data.get("result", {})
