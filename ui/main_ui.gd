func _check_vip_expired_locally() -> void :
	if not game_manager or not game_manager.player:
		return
	var player = game_manager.player
	if not player.is_vip:
		return
	if VipBenefits.is_vip_active(player):
		return
	player.is_vip = false
	if game_manager.pet_manager:
		game_manager.pet_manager.update_max_pet_bag_for_vip(0)
	_add_log("[color=#ffb347]VIP 已到期，相关加成已停止。[/color]")

