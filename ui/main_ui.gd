func _await_pet_bag_server_op(pet_id: String, op: String) -> Dictionary:
	var state: = {"done": false, "ok": false, "message": "", "data": {}}
	if not game_manager or not game_manager.network:
		state.message = "网络未初始化"
		return state
	var op_id: = "pet_bag_%s_%d_%s" % [op, Time.get_ticks_usec(), pet_id]
	var on_success = func(data: Dictionary):
		state.done = true
		state.ok = true
		state.data = data if data is Dictionary else {}
		state.message = str(state.data.get("message", "操作成功"))
	var on_failed = func(error: String):
		state.done = true
		state.ok = false
		state.message = error
	var net = game_manager.network
	var sig_ok = net.pet_bag_store_success if op == "store" else net.pet_bag_retrieve_success
	var sig_fail = net.pet_bag_store_failed if op == "store" else net.pet_bag_retrieve_failed
	sig_ok.connect(on_success, CONNECT_ONE_SHOT)
	sig_fail.connect(on_failed, CONNECT_ONE_SHOT)
	if op == "store":
		net.pet_bag_store(pet_id, op_id)
	else:
		net.pet_bag_retrieve(pet_id, op_id)
	var deadline: = Time.get_ticks_msec() + 20000
	while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
		await game_manager.get_tree().process_frame
	if sig_ok.is_connected(on_success):
		sig_ok.disconnect(on_success)
	if sig_fail.is_connected(on_failed):
		sig_fail.disconnect(on_failed)
	if not bool(state.done):
		state.ok = false
		state.message = "服务器响应超时，请稍后重试"
	elif bool(state.ok) and state.data.has("saveData") and state.data.get("saveData") is Dictionary:
		game_manager.apply_cloud_save(state.data.get("saveData"), {"pets_authoritative": true, "skip_deferred_cloud_save": true})
		game_manager.save_game(false)
	return state

func _sync_pet_bag_retrieve(retrieve_pet) -> void :
	if not game_manager or not game_manager.pet_manager:
		_show_simple_dialog("操作失败", "宠物管理器未初始化")
		return
	var live_pet = _resolve_live_pet(retrieve_pet)
	if live_pet == null:
		_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
		return
	if not game_manager.network or not game_manager.network.is_logged_in():
		_show_simple_dialog("操作失败", "需要联网后才能从宠物袋取出")
		return
	var pm = game_manager.pet_manager
	var in_bag: = false
	for bp in pm.pet_bag:
		if bp and str(bp.id) == str(live_pet.id):
			in_bag = true
			break
	if not in_bag:
		_show_simple_dialog("操作失败", "该宠物不在宠物袋中")
		return
	if pm.pets.size() >= pm.max_pets:
		_show_simple_dialog("操作失败", "宠物栏已满，请先腾出一个位置")
		return
	if not bool(game_manager.is_cloud_sync_ready()):
		_show_simple_dialog("操作失败", "宠物状态同步中，请稍后再试")
		return
	var pet_id: = str(live_pet.id)
	game_manager.begin_pet_bag_op_cloud_sync()
	var state: Dictionary = await _await_pet_bag_server_op(pet_id, "retrieve")
	game_manager.end_pet_bag_op_cloud_sync()
	if not bool(state.get("ok", false)):
		_show_simple_dialog("操作失败", str(state.get("message", "取出失败，请重试")))
		return
	_refresh_pet_bag_view()
	_refresh_pet_list_view()

func _sync_pet_bag_store(store_pet, popup_ref, store_bag_btn: Button) -> void :
	if store_pet == null:
		_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
		if is_instance_valid(popup_ref):
			popup_ref.queue_free()
		return
	if not game_manager or not game_manager.pet_manager:
		_show_simple_dialog("操作失败", "宠物管理器未初始化")
		return
	if is_instance_valid(store_bag_btn):
		store_bag_btn.disabled = true
	var live_pet = _resolve_live_pet(store_pet)
	if live_pet == null:
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
		return
	if not game_manager.network or not game_manager.network.is_logged_in():
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", "需要联网后才能存入宠物袋")
		return
	var pm = game_manager.pet_manager
	if pm.active_pet and str(pm.active_pet.id) == str(live_pet.id):
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", "出战宠物不能放入宠物袋")
		return
	if pm.pet_bag.size() >= pm.max_pet_bag:
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", "宠物袋已满")
		return
	var in_roster: = false
	for p in pm.pets:
		if p and str(p.id) == str(live_pet.id):
			in_roster = true
			break
	if not in_roster:
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", "未找到该宠物")
		return
	if not bool(game_manager.is_cloud_sync_ready()):
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", "宠物状态同步中，请稍后再试")
		return
	var pet_id: = str(live_pet.id)
	game_manager.begin_pet_bag_op_cloud_sync()
	var state: Dictionary = await _await_pet_bag_server_op(pet_id, "store")
	game_manager.end_pet_bag_op_cloud_sync()
	if not bool(state.get("ok", false)):
		if is_instance_valid(store_bag_btn):
			store_bag_btn.disabled = false
		_show_simple_dialog("操作失败", str(state.get("message", "存袋失败，请重试")))
		return
	if is_instance_valid(popup_ref):
		popup_ref.queue_free()
	_refresh_pet_list_view()
	_refresh_pet_bag_view()



