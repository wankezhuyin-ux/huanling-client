	combat_grid.add_theme_constant_override("h_separation", 10)
	combat_grid.add_theme_constant_override("v_separation", 4)
	right_vbox.add_child(combat_grid)

	var is_active_pet: = false
	if game_manager and game_manager.pet_manager and game_manager.pet_manager.active_pet != null and pet != null:
		var ap = game_manager.pet_manager.active_pet
		is_active_pet = ap == pet or str(ap.id) == str(pet.id)
	var display_attack = pet.get_final_attack_with_equipment() if is_active_pet else pet.get_final_attack()
	var display_defense = pet.get_final_defense_with_equipment() if is_active_pet else pet.get_final_defense()
	var display_agility = pet.get_final_agility_with_equipment() if is_active_pet else pet.get_final_agility()
	var display_hp = pet.get_final_max_hp_with_equipment() if is_active_pet else pet.get_final_max_hp()

	var combat_items = [
		["攻击", "%.1f" % display_attack], 
		["防御", "%.1f" % display_defense], 
		["敏捷", "%.1f" % display_agility], 
		["生命", "%.0f/%.0f" % [pet.hp, display_hp]], 
	]
	var bonus_items: Array = []
	var medal_counts_for_combat = _get_pet_medal_counts(pet)
	var medal_atk_bonus = int(medal_counts_for_combat.get("brave", 0)) * 2
	var medal_def_bonus = int(medal_counts_for_combat.get("calm", 0)) * 2
	var medal_agi_bonus = int(medal_counts_for_combat.get("bold", 0)) * 2
	bonus_items.append(["勋章攻加成", "+%d%%" % medal_atk_bonus])
	bonus_items.append(["勋章防加成", "+%d%%" % medal_def_bonus])
	bonus_items.append(["勋章敏加成", "+%d%%" % medal_agi_bonus])
	if is_active_pet and game_manager.pet_collection_manager:
		var atlas_bonuses = game_manager.pet_collection_manager.get_total_bonuses()
		if float(atlas_bonuses.get("attack", 0.0)) > 0.0:
			bonus_items.append(["图鉴攻加成", PetCollectionData.format_bonus_percent_signed(float(atlas_bonuses.get("attack", 0.0)))])
		if float(atlas_bonuses.get("defense", 0.0)) > 0.0:
			bonus_items.append(["图鉴防加成", PetCollectionData.format_bonus_percent_signed(float(atlas_bonuses.get("defense", 0.0)))])
		if float(atlas_bonuses.get("agility", 0.0)) > 0.0:
			bonus_items.append(["图鉴敏加成", PetCollectionData.format_bonus_percent_signed(float(atlas_bonuses.get("agility", 0.0)))])
		if float(atlas_bonuses.get("hp", 0.0)) > 0.0:
			bonus_items.append(["图鉴生加成", PetCollectionData.format_bonus_percent_signed(float(atlas_bonuses.get("hp", 0.0)))])
	if is_active_pet and game_manager and game_manager.pet_equipment_manager:
		# 宠装是**固定值**加成（攻击 +500 这种），不是百分比，和上面几行要分开写，
		# 否则玩家会以为「穿戴了却一点没加」。原来这里压根没有宠装这一档，
		# 出战宠物详情的「加成明细」里就只有勋章/图鉴/法宝，看不到装备。
		var pe_bonus: Dictionary = game_manager.pet_equipment_manager.get_all_bonus(pet)
		var pe_keys: Array = ["attack", "defense", "agility", "hp"]
		var pe_labels: Dictionary = {
			"attack": "装备攻加成", "defense": "装备防加成", 
			"agility": "装备敏加成", "hp": "装备生加成", 
		}
		for pe_key in pe_keys:
			var pe_val: float = float(pe_bonus.get(pe_key, 0.0))
			if pe_val > 0.0:
				bonus_items.append([str(pe_labels.get(pe_key, pe_key)), "+%d" % int(round(pe_val))])
	if is_active_pet:
		var fb_atk: = FabaoStatBonus.pet_pct("atk")
		var fb_def: = FabaoStatBonus.pet_pct("def")
		var fb_agi: = FabaoStatBonus.pet_pct("agi")
		var fb_hp: = FabaoStatBonus.pet_pct("hp")
		if fb_atk > 0.0:
			bonus_items.append(["法宝攻加成", "+%.1f%%" % fb_atk])
		if fb_def > 0.0:
			bonus_items.append(["法宝防加成", "+%.1f%%" % fb_def])
		if fb_agi > 0.0:
			bonus_items.append(["法宝敏加成", "+%.1f%%" % fb_agi])
		if fb_hp > 0.0:
			bonus_items.append(["法宝生加成", "+%.1f%%" % fb_hp])
		var noble_pct: = 0
		if game_manager:
			noble_pct = clampi(int(game_manager.noble_pet_damage_bonus), 0, 30)
		if noble_pct > 0:
			bonus_items.append(["贵族攻加成", "+%d%%" % noble_pct])
			bonus_items.append(["贵族防加成", "+%d%%" % noble_pct])
			bonus_items.append(["贵族敏加成", "+%d%%" % noble_pct])
		combat_items.append(["状态", "出战中(含装备加成)"])

	var assist_atk: = 0.0
	var assist_def: = 0.0
	var assist_agi: = 0.0
	var assist_hp: = 0.0
	var assist_count: = 0
	var has_assist_bonus: = false
	if is_active_pet and game_manager and game_manager.pet_manager and game_manager.pet_manager.has_method("get_assist_flat_bonus_for_active"):
		assist_atk = float(game_manager.pet_manager.get_assist_flat_bonus_for_active("attack"))
		assist_def = float(game_manager.pet_manager.get_assist_flat_bonus_for_active("defense"))
		assist_agi = float(game_manager.pet_manager.get_assist_flat_bonus_for_active("agility"))
		assist_hp = float(game_manager.pet_manager.get_assist_flat_bonus_for_active("hp"))
		has_assist_bonus = assist_atk > 0.0 or assist_def > 0.0 or assist_agi > 0.0 or assist_hp > 0.0
		if has_assist_bonus:
			if game_manager.pet_manager.has_method("get_assist_occupied_count"):
				assist_count = int(game_manager.pet_manager.get_assist_occupied_count())
			else:
				for ap in game_manager.pet_manager.assist_pets:
					if ap != null:
						assist_count += 1

	for item in combat_items:
		var key_label = Label.new()
		key_label.text = item[0] + ":"
		key_label.add_theme_font_size_override("font_size", 18)
		key_label.add_theme_color_override("font_color", Color(0.6, 0.65, 0.75))
		combat_grid.add_child(key_label)

		var value_label = Label.new()
		value_label.text = item[1]
		value_label.add_theme_font_size_override("font_size", 18)
		value_label.add_theme_color_override("font_color", Color(0.9, 0.9, 0.9))
		combat_grid.add_child(value_label)

	if not bonus_items.is_empty() or has_assist_bonus:
		var fold_body = VBoxContainer.new()
		fold_body.visible = false
		fold_body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fold_body.add_theme_constant_override("separation", 8)
		if not bonus_items.is_empty():
			var bonus_grid = GridContainer.new()
			bonus_grid.columns = 2
			bonus_grid.add_theme_constant_override("h_separation", 10)
			bonus_grid.add_theme_constant_override("v_separation", 4)
			bonus_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			for bitem in bonus_items:
				var bk = Label.new()
				bk.text = str(bitem[0]) + ":"
				bk.add_theme_font_size_override("font_size", 18)
				bk.add_theme_color_override("font_color", Color(0.6, 0.65, 0.75))
				bonus_grid.add_child(bk)
				var bv = Label.new()
				bv.text = str(bitem[1])
				bv.add_theme_font_size_override("font_size", 18)
				bv.add_theme_color_override("font_color", Color(0.9, 0.9, 0.9))
				bonus_grid.add_child(bv)
