func _clear_container_immediate(container: Control):
	if container == null:
		return
	while container.get_child_count() > 0:
		var child = container.get_child(0)
		container.remove_child(child)
		child.queue_free()

func _process(delta):
	_flush_ink_reskin_pending()
	_guard_modal_dim(delta)
	_online_gate_timer += delta
	if _online_gate_timer >= ONLINE_GATE_INTERVAL:
		_online_gate_timer = 0.0
		_main_ui_periodic_online_check()
	_vip_expire_check_timer += delta
	if _vip_expire_check_timer >= VIP_EXPIRE_CHECK_INTERVAL:
		_vip_expire_check_timer = 0.0
		_check_vip_expired_locally()
	if not game_manager or not game_manager.initialized:
		return
	if _character_attr_panel_stale and _should_refresh_character_attr_ui():
		_refresh_character_attr_panel(false)


	if _vip_info_requested:
		_vip_info_timer += delta
		if _vip_info_timer >= _vip_info_timeout:
			_vip_info_requested = false
			_vip_info_timer = 0.0
			print("[VIP] 获取VIP信息超时，跳过")


	if not _vip_info_loaded_successfully and network and network.is_logged_in():
		_force_vip_request_timer += delta
		if _force_vip_request_timer >= FORCE_VIP_REQUEST_DELAY:
			print("[VIP] ⚠️ %d秒内未成功加载VIP信息，强制请求..." % FORCE_VIP_REQUEST_DELAY)
			_force_vip_request_timer = 0.0
			_vip_info_requested = true
			_vip_info_timer = 0.0
			network.get_vip_info()

	auto_save_timer += delta
	if auto_save_timer >= auto_save_interval:
		auto_save_timer = 0.0
		game_manager.flush_battle_progress_persist(true)



	if game_manager.auto_change_map_enabled and not game_manager.in_battle:
		auto_change_map_timer += delta
		if auto_change_map_timer >= AUTO_CHANGE_MAP_INTERVAL:
			auto_change_map_timer = 0.0


	var battle_hud_refreshed: = false
	if game_manager and game_manager.in_battle and current_view == "battle":
		_refresh_active_battle_hud()
		battle_hud_refreshed = true

	if not auto_battle:
		if not battle_hud_refreshed:
			_update_player_ui_optimized()
		return
	if _is_player_character_switch_popup_open():
		if not battle_hud_refreshed:
			_update_player_ui_optimized()
		return
	if game_manager.is_five_elements_battle or game_manager.is_suit_dungeon_battle or game_manager.is_atlas_dungeon_battle or game_manager.is_brother_tower_battle or game_manager.is_tower_battle or game_manager.is_tower_settling or game_manager.is_world_boss_battle or game_manager.is_arena_battle:
		return

	var now_ms: = Time.get_ticks_msec()
	if _battle_cooldown_deadline_ms <= 0:
		_battle_cooldown_deadline_ms = now_ms

	if not game_manager.in_battle:
		battle_cooldown = float(max(0, _battle_cooldown_deadline_ms - now_ms)) / 1000.0
		if _battle_countdown_active:
			var remaining_ms: int = maxi(0, int(_battle_cooldown_deadline_ms - now_ms))
			var remain_sec: int = int((remaining_ms + 999) / 1000)
			if remain_sec >= 1 and remain_sec <= 1 and remain_sec != _last_battle_countdown_second_announced:
				_last_battle_countdown_second_announced = remain_sec
				_add_log("[color=yellow]下一场战斗将在 %d 秒后开始...[/color]" % remain_sec)
		if now_ms >= _battle_cooldown_deadline_ms:
			_battle_countdown_active = false
			_last_battle_countdown_second_announced = -1
			_battle_cooldown_deadline_ms = now_ms + 1000
			battle_cooldown = 1.0
			if _start_auto_battle():

				_battle_cooldown_deadline_ms = now_ms + 1000
				battle_cooldown = 1.0
	else:
		battle_cooldown = float(max(0, _battle_cooldown_deadline_ms - now_ms)) / 1000.0
		if now_ms >= _battle_cooldown_deadline_ms:
			var next_wait_ms: = 1000
			if game_manager.battle_system:
				game_manager.battle_system.execute_turn()
				var wait_sec: = float(game_manager.battle_system.last_execute_wait_seconds)
				if wait_sec > 0.0:
					next_wait_ms = clampi(int(round(wait_sec * 1000.0)), 250, 2000)
			_battle_cooldown_deadline_ms = now_ms + next_wait_ms
			battle_cooldown = float(next_wait_ms) / 1000.0

	if not battle_hud_refreshed:
		_update_player_ui_optimized()

func _notification(what):
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		if game_manager and game_manager.initialized:
			print("游戏即将退出，正在保存...")
			game_manager.save_game()
		get_tree().quit()

func _start_auto_battle() -> bool:
	if game_manager == null or not game_manager.initialized:
		return false


	if startup_dialog and is_instance_valid(startup_dialog):
		return false
	if _is_player_character_switch_popup_open():
		return false

	if main_content == null or not main_content.visible:
		return false


	if game_manager.has_method("is_cloud_sync_ready") and not bool(game_manager.is_cloud_sync_ready()):
		return false


	if game_manager.get("_login_pet_battle_grace_period"):
		return false
	if game_manager.has_method("is_battle_start_temporarily_blocked") and bool(game_manager.is_battle_start_temporarily_blocked()):
		return false
	if game_manager.pet_manager:
		var active_pet = game_manager.pet_manager.get_active_pet()
		var pet_count = game_manager.pet_manager.get_pet_count()

		if active_pet == null and pet_count > 0:
			return false
	if network == null or not network.is_logged_in():
		return false

	if game_manager.battle_system:
		game_manager.battle_system.drive_by_execute_turn = true
	return game_manager.start_battle()

