## 小号操作键（原「天蓝圆角块」，角色页 +10/+100、加点方案等都用它）。
## 墨底金线 + 直角，和整页表皮同一套语言。
func _apply_light_blue_button_style(btn: Button):
	if btn == null:
		return
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	var fs: = btn.get_theme_font_size("font_size")
	if fs <= 0:
		fs = _ink_font(17.0)
	var normal := StyleBoxFlat.new()
	normal.bg_color = Color(0.055, 0.070, 0.074, 0.72)
	normal.border_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.55)
	normal.set_border_width_all(hair)
	normal.set_corner_radius_all(0)
	normal.content_margin_left = 8.0 * s
	normal.content_margin_right = 8.0 * s
	normal.content_margin_top = 3.0 * s
	normal.content_margin_bottom = 3.0 * s
	var hover: StyleBoxFlat = normal.duplicate()
	hover.bg_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.22)
	hover.border_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.95)
	var pressed: StyleBoxFlat = normal.duplicate()
	pressed.bg_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.34)
	pressed.border_color = INK_GOLD_HI
	var disabled: StyleBoxFlat = normal.duplicate()
	disabled.bg_color = Color(0.055, 0.070, 0.074, 0.45)
	disabled.border_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.22)
	btn.add_theme_stylebox_override("normal", normal)
	btn.add_theme_stylebox_override("hover", hover)
	btn.add_theme_stylebox_override("pressed", pressed)
	btn.add_theme_stylebox_override("disabled", disabled)
	btn.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	btn.add_theme_font_size_override("font_size", fs)
	btn.add_theme_color_override("font_color", Color(0.945, 0.910, 0.840))
	btn.add_theme_color_override("font_hover_color", INK_GOLD_HI)
	btn.add_theme_color_override("font_pressed_color", INK_GOLD_HI)
	btn.add_theme_color_override("font_disabled_color", Color(0.72, 0.68, 0.60))
	btn.add_theme_constant_override("outline_size", 0)

