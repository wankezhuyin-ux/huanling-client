func _show_view(view_name: String, city_skip_reset: bool = false):

	if view_name != "battle" and _is_challenge_view_locked():
		_show_simple_dialog("无法切换", "挑战进行中，请先完成或停止当前挑战")
		return
	current_view = view_name

	# 图鉴是挂在 MainUI 根上的整页浮层（不是 PetView 的子节点），
	# 切页时必须自己收掉，否则会盖在角色/背包页上面。
	_close_pet_atlas_page()

	# 内页底板：主城视图让位（CityView 自己铺满），其余四页开底板并把
	# MainContent 那层 0.76 不透明的墨绿底撤掉，否则底板一点也看不见。
	var inner := view_name != "city"
	if _page_backdrop != null and is_instance_valid(_page_backdrop):
		if inner:
			_page_backdrop.open_for(view_name)
		else:
			_page_backdrop.close()
	var views = [battle_view, character_view, pet_view, bag_view, city_view]
	var target_view: Control = null

	match view_name:
		"battle":
			target_view = battle_view
		"character":
			target_view = character_view
		"pet":
			target_view = pet_view
		"bag":
			target_view = bag_view
		"city":
			target_view = city_view

	for view in views:
		if view == null or view == target_view:
			continue
		if view.visible:
			var tween = create_tween()
			tween.tween_property(view, "modulate:a", 0.0, 0.15)
			tween.tween_callback( func(): view.visible = false)

	if target_view:
		target_view.modulate.a = 0.0
		target_view.visible = true
		var tween = create_tween()
		tween.tween_property(target_view, "modulate:a", 1.0, 0.2)

	match view_name:
		"battle":
			game_manager.play_bgm_battle()
			_update_battle_view()
		"character":
			game_manager.play_bgm_normal()
			_show_character_subview("basic_stats")
			_notify_player_attr_changed("character_view")
		"pet":
			game_manager.play_bgm_normal()
			_show_pet_subview("list")
			_update_pet_view()
		"bag":
			game_manager.play_bgm_normal()
			_show_bag_subview("item")
			_update_bag_view()
		"city":
			game_manager.play_bgm_normal()
			_show_city_view(city_skip_reset)
	_apply_main_content_overlay_for_view(view_name)
	_refresh_challenge_nav_lock()
	if INK_CHROME:
		_ink_nav_select(view_name)

var _main_content_style_default: StyleBox = null
var _main_content_style_city_clear: StyleBoxFlat = null

func _apply_main_content_overlay_for_view(view_name: String) -> void :

	if main_content == null or not is_instance_valid(main_content):
		return
	if _main_content_style_default == null:
		_main_content_style_default = main_content.get_theme_stylebox("panel")
	if _main_content_style_city_clear == null:
		var clear_style: = StyleBoxFlat.new()
		clear_style.bg_color = Color(0, 0, 0, 0)
		clear_style.set_border_width_all(0)
		clear_style.set_corner_radius_all(0)
		_main_content_style_city_clear = clear_style
	if view_name == "city":
		main_content.add_theme_stylebox_override("panel", _main_content_style_city_clear)
	elif _ink_page_shell_ready:
		# 内页背景交给 InkPageBackdrop（虚化主城 + 墨青罩），这里不能再盖一层
		# 0.76 不透明的墨绿底，否则底板完全看不见（MainContent 铺满整屏）。
		main_content.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	elif _main_content_style_default != null:
		main_content.add_theme_stylebox_override("panel", _main_content_style_default)


func _is_challenge_view_locked() -> bool:
	return game_manager != null\
	and game_manager.has_method("is_in_instanced_challenge")\
	and bool(game_manager.is_in_instanced_challenge())


func _refresh_challenge_nav_lock() -> void :
	var locked: = _is_challenge_view_locked()
	if character_btn:
		character_btn.disabled = locked
	if city_btn:
		city_btn.disabled = locked
	if pet_btn:
		pet_btn.disabled = locked
	if bag_btn:
		bag_btn.disabled = locked
	if battle_btn:
		battle_btn.disabled = false
	if map_btn:
		map_btn.disabled = locked
	if ascend_btn and is_instance_valid(ascend_btn):
		ascend_btn.disabled = locked
	if reincarnate_btn and is_instance_valid(reincarnate_btn):
		reincarnate_btn.disabled = locked

func _apply_sub_button_style(btn: Button, is_selected: bool):
	if btn == null:
		return
	# 内页页签：去底、去圆角，只留一条金色下划线（设计稿里页签本身就是"字 + 线"）
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	btn.add_theme_font_size_override("font_size", _ink_font(25.0 if is_selected else 24.0))
	btn.add_theme_color_override("font_color", INK_GOLD_HI if is_selected else Color(0.62, 0.58, 0.50))
	btn.add_theme_color_override("font_hover_color", Color(1.0, 0.94, 0.78))
	btn.add_theme_color_override("font_pressed_color", INK_GOLD_HI)
	btn.add_theme_color_override("font_disabled_color", Color(0.42, 0.40, 0.36))

	var style = StyleBoxFlat.new()
	style.bg_color = Color(0, 0, 0, 0)
	style.set_corner_radius_all(0)
	if is_selected:
		# 设计稿的选中页签是"三面折边的小盒子"：左右上三条细金边 + 底下不收口，
		# 直接坐在贯穿面板的那条横线上，等于从线里"长出来"。
		# 底色和下面那块面板同色，页签才像"从面板里长出来的"，而不是贴了张黑纸
		style.bg_color = Color(0.035, 0.043, 0.045, 0.26)
		style.border_width_top = hair
		style.border_width_left = hair
		style.border_width_right = hair
		style.border_color = Color(0.930, 0.800, 0.440, 0.80)
	style.content_margin_left = 18.0 * s
	style.content_margin_right = 18.0 * s
	style.content_margin_top = 8.0 * s
	style.content_margin_bottom = 10.0 * s
	for st_name in ["normal", "hover", "pressed", "disabled", "focus"]:
		btn.add_theme_stylebox_override(st_name,
			style if st_name != "focus" else StyleBoxEmpty.new())

	# 选中态：页签底下叠一段亮光。亮芯压在按钮底沿、正好盖住面板那条暗金线，
	# 于是整条线只有"当前这一格"是亮的，其余仍是暗金等宽线。
	# z_index 必须高于面板横线（_ink_add_top_glow 里是 6），否则会被暗线盖过去。
	var glow: = btn.get_node_or_null("InkTabGlow") as TextureRect
	if glow == null:
		glow = TextureRect.new()
		glow.name = "InkTabGlow"
		glow.texture = _ink_glow_underline_texture()
		glow.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		glow.stretch_mode = TextureRect.STRETCH_SCALE
		glow.mouse_filter = Control.MOUSE_FILTER_IGNORE
		glow.z_index = 9
		btn.add_child(glow)
		glow.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_WIDE)
	glow.offset_left = -3.0 * s
	glow.offset_right = 3.0 * s
	glow.offset_top = -15.0 * s
	# 页签盒底沿和面板顶线之间还有 6~8px 的缝，亮芯必须落到底下那条暗金线上，
	# 否则看起来是"页签下面一条、面板上一条"两根线，不像同一根线只有这一格亮。
	glow.offset_bottom = 11.0
	glow.visible = is_selected



## 两栏版式的开关。装备页要「装备栏 + 6 列背包」的整幅宽度，
## 左侧常驻人物栏会把右栏挤到一半、格子被压扁，所以进装备页时收起左栏、右栏铺满。
func _set_character_hero_column_expanded(expanded: bool) -> void:
	if is_instance_valid(character_hero_column):
		character_hero_column.visible = expanded
	var right: Control = get_node_or_null("MainContent/CharacterView/ContentArea/Body/RightStack") as Control
	if right == null:
		return
	# 展开 = 设计稿的 38% 左栏 + 5px 缝；收起 = 从 0 开始铺满
	right.anchor_left = 0.38 if expanded else 0.0
	right.offset_left = 5.0 if expanded else 0.0


func _show_character_subview(subview_name: String):
	# 先定版式再建内容：装备页要按铺满后的宽度算背包格子，顺序反了会按半宽算
	_set_character_hero_column_expanded(subview_name != "equipment")
	# 两栏化后四个滚动容器挪到了 ContentArea/Body/RightStack 下，路径要跟着走，
	# 不然这里取到 null 会直接报错中断 → 页签样式和后续构建全都不执行。
	var basic_stats_scroll = $MainContent / CharacterView / ContentArea / Body / RightStack / BasicStatsContainer
	var combat_stats_scroll = $MainContent / CharacterView / ContentArea / Body / RightStack / CombatStatsContainer
	var equipment_scroll = $MainContent / CharacterView / ContentArea / Body / RightStack / EquipmentContainer
	var talent_scroll = $MainContent / CharacterView / ContentArea / Body / RightStack / TalentContainer

	basic_stats_scroll.visible = false
	combat_stats_scroll.visible = false
	equipment_scroll.visible = false
	if talent_scroll:
		talent_scroll.visible = false

	_apply_sub_button_style(character_basic_stats_btn, false)
	_apply_sub_button_style(character_combat_stats_btn, false)
	_apply_sub_button_style(character_equipment_btn, false)
	if character_talent_btn:
		_apply_sub_button_style(character_talent_btn, false)

	match subview_name:
		"basic_stats":
			basic_stats_scroll.visible = true
			_apply_sub_button_style(character_basic_stats_btn, true)
		"combat_stats":
			combat_stats_scroll.visible = true
			_apply_sub_button_style(character_combat_stats_btn, true)
			_clear_container_immediate(character_combat_stats_container)
			_build_combat_stats_view()
		"equipment":
			equipment_scroll.visible = true
			_apply_sub_button_style(character_equipment_btn, true)
			if character_equipment_container.get_child_count() == 0:
				_build_character_equipment_view()
		"talent":
			if talent_scroll:
