func _make_bag_inventory_grid_cell(side: int, item) -> Control:
	var is_aggregate: = item is Dictionary and str(item.get("entry_kind", "")) == "limit_material_aggregate"
	var display_name: = ""
	var count: = 1
	var rarity: = "common"
	if is_aggregate:
		display_name = str(item.get("name", "极限材料"))
		count = int(item.get("count", 0))
		var rep = item.get("representative_item", null)
		if rep != null:
			if "rarity" in rep:
				rarity = str(rep.rarity)
			elif rep is Dictionary:
				rarity = str(rep.get("rarity", "common"))
	else:
		display_name = str(item.name)
		var item_data = GameData.ALL_ITEMS.get(item.name, {})
		if item_data is Dictionary and item_data.has("name"):
			display_name = str(item_data.get("name", display_name))
		count = int(item.count)
		if "rarity" in item:
			rarity = str(item.rarity)
		elif item_data is Dictionary:
			rarity = str(item_data.get("rarity", "common"))
	var tex: = InventoryIconHelper.category_icon_for_inventory_item(item)
	var border: = InventoryIconHelper.rarity_border_color(rarity)
	var badge: = InventoryIconHelper.badge_for_inventory_item(item)
	var captured = item
	var on_tap: Callable
	if is_aggregate:
		on_tap = func(): _show_limit_material_aggregate_popup(captured)
	else:
		on_tap = func(): _show_item_action_popup(captured)
	return InventoryGridCell.make_filled(side, tex, display_name, count, border, on_tap, Color.WHITE, true, "", false, badge)
func _get_bag_item_type(item) -> String:
	if item == null:
		return ""
	if game_manager and game_manager.inventory_manager:
		return game_manager.inventory_manager.resolve_bag_category(item.name, item.item_type, item.custom_data)
	var configured_type: = str(GameData.ALL_ITEMS.get(item.name, {}).get("type", ""))
	if configured_type in ["material", "herb"]:
		return "material"
	return "item"

