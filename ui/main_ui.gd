		confirm_btn.disabled = selected_map.size() <= 0
		refresh_list.call()
	select_all_btn.pressed.connect( func(): update_selection.call(true))
	clear_all_btn.pressed.connect( func(): update_selection.call(false))
	confirm_btn.pressed.connect( func():
		var selected: Array = []
		for equipment in eligible:
			if bool(selected_map.get(_pet_equipment_dismantle_selection_key(equipment), false)):
				selected.append(equipment)
		if selected.is_empty():
			return
		_confirm_pet_equipment_batch_dismantle(selected, func(): popup.queue_free())
	)
