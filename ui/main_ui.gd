func _rebuild_pet_soul_detail_candidate_list(
	list_box: VBoxContainer, 
	eligible: Array, 
	selected_map: Dictionary, 
	selection_label: Label, 
	batch_commit_btn: Button, 
	element: String
) -> void :
	if list_box == null or not is_instance_valid(list_box):
		return
	for child in list_box.get_children():
		child.queue_free()
	if eligible.is_empty():
		list_box.add_child(_build_pet_soul_empty_state(element))
		return
	for pet in eligible:
		var pid: = str(pet.id)
		var is_selected: = bool(selected_map.get(pid, false))
		var card: = _create_pet_soul_candidate_item(pet, is_selected)
		TouchScrollUtils.bind_tap(card, func():
			if selected_map.has(pid):
				selected_map.erase(pid)
			else:
				selected_map[pid] = true
			if is_instance_valid(selection_label):
				selection_label.text = "已选 %d 只" % selected_map.size()
			if is_instance_valid(batch_commit_btn):
				batch_commit_btn.disabled = selected_map.size() <= 0
			_rebuild_pet_soul_detail_candidate_list(list_box, eligible, selected_map, selection_label, batch_commit_btn, element)
		)
		list_box.add_child(card)

