func _apply_action_button_style(btn: Button):
	if btn == null:
		return
	var fs: = btn.get_theme_font_size("font_size")
	if fs <= 0:
		fs = _ink_font(21.0)
	_ink_outline_button(btn, fs, INK_GOLD)
	for st_name in ["normal", "hover", "pressed", "disabled"]:
		var base := btn.get_theme_stylebox(st_name)
		if base is StyleBoxFlat:
			var cp: StyleBoxFlat = (base as StyleBoxFlat).duplicate()
			cp.bg_color = Color(0.055, 0.068, 0.072, 0.62)
			if st_name == "hover":
				cp.bg_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.26)
			elif st_name == "pressed":
				cp.bg_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.38)
			elif st_name == "disabled":
				cp.bg_color = Color(0.055, 0.068, 0.072, 0.40)
			btn.add_theme_stylebox_override(st_name, cp)
	btn.add_theme_constant_override("outline_size", 0)

func _apply_store_button_style(btn: Button) -> void :
	_apply_action_button_style(btn)

