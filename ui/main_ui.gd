func _make_pet_equip_slot_cell(side: int, pet_slot: String, equipment) -> Control:
	var slot_name: = str(PetEquipmentData.SLOTS.get(pet_slot, {}).get("name", pet_slot))
	if equipment == null:
		return InventoryGridCell.make_empty(side, slot_name, InventoryGridCell.EQUIP_SLOT_BORDER)
	var rarity: = str(_get_pet_equip_value(equipment, "rarity"))
	var border: = InventoryIconHelper.rarity_border_color(rarity)
	if border == InventoryGridCell.CELL_BORDER_NORMAL or border == InventoryGridCell.CELL_BORDER_EMPTY:
		border = InventoryGridCell.EQUIP_SLOT_BORDER
	var tex: = InventoryIconHelper.resolve_equipment_icon(equipment)
	var enh_lv: = int(_get_pet_equip_value(equipment, "pet_enhance_level"))
	var display_name: = PetEquipmentEnhance.format_display_name(str(_get_pet_equip_value(equipment, "name")), enh_lv)
	var enh_badge: = InventoryIconHelper.enhance_badge_for_equipment(equipment)
	var captured = equipment
	var captured_slot: = pet_slot
	return InventoryGridCell.make_filled(
		side, tex, display_name, 0, border, 
		func(): _show_pet_equipment_action_popup(captured, captured_slot, true), 
		Color.WHITE, false, "", true, "", enh_badge
	)

func _make_pet_bag_equip_cell(side: int, equipment) -> Control:
	var rarity: = str(_get_pet_equip_value(equipment, "rarity"))
