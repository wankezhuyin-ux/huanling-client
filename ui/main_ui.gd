		game_manager.begin_post_login_broadcast_sync(save_data)

func _on_post_login_offline_claim_applied(_success: bool) -> void :
	print("[STARTUP] offline_claim_applied success=%s dialog_shown=%s pending=%s" % [str(_success), str(_startup_offline_dialog_shown), str(_startup_offline_pending)])
	_cached_pet_texture = ""
	_update_player_ui()
	_update_pet_ui()
	# 这一次没有离线奖励（离线不足 60 秒 / VIP 离线时长已到顶）时，要把「欢迎回来」
	# 立刻补上，否则玩家会卡在一个没有面板的空画面上。
	if not _startup_offline_dialog_shown:
		_maybe_show_startup_welcome_after_offline()

func _maybe_show_startup_welcome_after_offline() -> void :
	"""离线奖励流程走完（点了「领取奖励」）之后才弹「欢迎回来」——参考稿就是这个顺序。"""
	_startup_offline_pending = false
	_startup_offline_dialog_shown = false
	if _game_started:
		# _start_game 已经跑过、HUD 却是在「待弹离线面板」状态下藏起来的，
		# 这里必须还回去，否则玩家同样是黑屏。
		_restore_game_hud_after_startup()
		return
	if startup_dialog and is_instance_valid(startup_dialog):
		return
	# 新号/刚注册还没建角色的账号仍要先建角色（离线结算对新号本来也是 0 秒，不会弹离线面板）。
	if is_new_game or _needs_character_creation():
		_show_character_creation_dialog()
	else:
		_show_login_dialog()

func _startup_offline_watchdog() -> void :
	"""离线奖励流程的安全网。
	启动时 HUD 是按「待弹离线面板」状态藏起来的，正常路径由离线结算回包
	（或 60 秒内无收益的兜底分支）把界面还回来。但只要中间任何一步抛脚本错误
	（例如存档里某个字段类型不对、网络回包缺字段），回调就永远发不出去，
	玩家看到的就是**一直黑屏、连弹窗都没有**。这里加一个超时兜底：
	无论中间发生什么，时间到了都必须把界面还给玩家。
	"""
	if not is_inside_tree():
		return
	get_tree().create_timer(STARTUP_OFFLINE_WATCHDOG_SECONDS).timeout.connect(_on_startup_offline_watchdog_timeout)

func _on_startup_offline_watchdog_timeout() -> void :
	# 离线奖励面板已经正常弹过了（玩家可能正看着它，或者在点「领取奖励」），
	# 这时候绝对不能插一个「欢迎回来」上去 —— 那就是玩家说的
	# 「先弹人物信息、再弹离线奖励，顺序反了」。
	if _startup_offline_dialog_shown:
		return
	# 判断标准是「屏幕上到底有没有东西」，不能只看 _startup_offline_pending：
	# 那个标志可能被别处清掉，但 HUD 依然是藏着的，玩家就对着纯背景干等。
	if _startup_dialog_visible():
		return
	if _game_started and _startup_hud_visible():
		return
	push_warning("[MAIN_UI] 离线奖励流程超时（网络或存档异常），强制恢复界面，避免黑屏卡死")
	_startup_offline_pending = false
	_startup_offline_dialog_shown = false
	if _game_started:
		_restore_game_hud_after_startup()
		return
	if is_new_game or _needs_character_creation():
		_show_character_creation_dialog()
	else:
		_show_login_dialog()

func _startup_dialog_visible() -> bool:
	if startup_dialog == null or not is_instance_valid(startup_dialog):
		return false
	if startup_dialog is Window:
		return (startup_dialog as Window).visible
	return true

func _startup_hud_visible() -> bool:
	return top_bar != null and top_bar.visible and bottom_nav != null and bottom_nav.visible

func _restore_game_hud_after_startup() -> void :
	"""把启动弹窗期间藏掉的 HUD 还回来（首页皮在子类里覆盖本函数追加自己的节点）。"""
	if top_bar:
		top_bar.visible = true
	if main_content:
		main_content.visible = true
	if bottom_nav:
		bottom_nav.visible = true

func _on_post_login_offline_rewards_ready(hours_f: float, exp_v: int, gold: int, _pet_offline_exp: Dictionary, pet_gifts: int, is_vip: bool, level_change: Dictionary = {}) -> void :
	# 参考稿登录顺序：先弹「离线奖励」→ 点「领取奖励」→ 才到「欢迎回来」名称等级面板。
	# 如果欢迎面板已经先弹出来了（下载存档那条分支），这里先收掉，领完奖励再补回来。
	if startup_dialog and is_instance_valid(startup_dialog):
		startup_dialog.queue_free()
		startup_dialog = null
	_startup_offline_pending = true
	_startup_offline_dialog_shown = true
	# 面板背后不能露出角色条 / 金币 / 飞升投胎按钮 / 底部导航 ——
	# 参考稿这个界面就是一块干净的场景背景，只有中间的面板。
	_hide_game_hud_for_startup_dialog()

	var level_lines: = PackedStringArray()
	var p_before: = int(level_change.get("playerLevelBefore", 0))
	var p_after: = int(level_change.get("playerLevelAfter", 0))
	if p_before > 0 and p_after > 0:
		if p_after > p_before:
			level_lines.append("人物: 从 %d 级升到 %d 级" % [p_before, p_after])
		else:
			level_lines.append("人物: 保持 %d 级" % p_before)
	var pet_before: = int(level_change.get("petLevelBefore", 0))
	var pet_after: = int(level_change.get("petLevelAfter", 0))
	if pet_before > 0 and pet_after > 0:
		var pet_label: = str(level_change.get("petName", "")).strip_edges()
		if pet_label.is_empty():
			pet_label = "出战宠"
		if pet_after > pet_before:
			level_lines.append("%s: 从 %d 级升到 %d 级" % [pet_label, pet_before, pet_after])
		else:
			level_lines.append("%s: 保持 %d 级" % [pet_label, pet_before])

	var dialog: = Window.new()
	dialog.title = "离线奖励"
	# 470 而不是 520：内容只有「标题 + 离线时长 + 3 行奖励 + 按钮」，
	# 原来上下各空出近 100px，配上金属框反而更显得空荡
	dialog.size = Vector2(460, 470)
	dialog.borderless = true
	dialog.transparent = true
	dialog.unresizable = true
	dialog.exclusive = true

	var panel: = Panel.new()
	panel.name = "MainPanel"
	panel.set_anchors_preset(Control.PRESET_FULL_RECT)
	dialog.add_child(panel)
	# 金属包边 + 投影（原来只有 1px 金线，整块面板看着像贴在画面上的纸片）
	_attach_metal_frame(dialog, panel)

	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 28
	vbox.offset_right = -28
	vbox.offset_top = 24
	vbox.offset_bottom = -24
	vbox.add_theme_constant_override("separation", 14)
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER

	var title: = Label.new()
	title.text = "离线奖励"
	title.add_theme_font_size_override("font_size", 26)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
	vbox.add_child(title)

	var info: = Label.new()
	info.text = "离线时间: %.1f 小时" % snapped(hours_f, 0.1)
	info.add_theme_font_size_override("font_size", 19)
	info.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	info.add_theme_color_override("font_color", Color(0.92, 0.92, 0.96))
	vbox.add_child(info)

	if is_vip:
		var vip_label: = Label.new()
		vip_label.text = "[VIP用户]"
		vip_label.add_theme_font_size_override("font_size", 17)
		vip_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		vip_label.add_theme_color_override("font_color", Color(1, 0.85, 0.3))
		vbox.add_child(vip_label)

	# 排版照参考稿：「获得奖励:」一行，下面逐行「人物 / 宠物: 从 X 级升到 Y 级」「金币: N」，
	# 数值是绿色。参考稿**不显示经验数字**（经验已经体现在升级结果里），这里同样不显示。
	var detail: = RichTextLabel.new()
	detail.bbcode_enabled = true
	detail.fit_content = true
	detail.scroll_active = false
	detail.custom_minimum_size = Vector2(0, 0)
	detail.add_theme_font_size_override("normal_font_size", 19)
	detail.add_theme_font_size_override("bold_font_size", 19)
	var value_color: = "#3ddc6a"
	var label_color: = "#e8e8ef"
	var body: = "[center][color=%s]获得奖励:[/color]\n" % label_color
	for line in level_lines:
		body += "[color=%s]%s[/color]\n" % [value_color, line]
	body += "[color=%s]金币: [/color][color=%s]%d[/color]" % [label_color, value_color, gold]
	if pet_gifts > 0:
		body += "\n[color=%s]离线宠物锦囊: [/color][color=%s]%d 个[/color]" % [label_color, value_color, pet_gifts]
	body += "[/center]"
	detail.text = body
	vbox.add_child(detail)

	if pet_gifts > 0:
		var gift_tip: = Label.new()
		gift_tip.text = "（礼包已发放到背包，打开可获得极品宠物）"
		gift_tip.add_theme_font_size_override("font_size", 13)
		gift_tip.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		gift_tip.add_theme_color_override("font_color", Color(0.68, 0.68, 0.74))
		vbox.add_child(gift_tip)

	var spacer: = Control.new()
	spacer.custom_minimum_size = Vector2(0, 10)
	vbox.add_child(spacer)

	var ok_btn: = Button.new()
	ok_btn.text = "领取奖励"
	ok_btn.custom_minimum_size = Vector2(0, 46)
	UIStyle.style_popup_button(ok_btn, true)
	ok_btn.pressed.connect( func():
		if is_instance_valid(dialog):
			dialog.queue_free()
		# 领完才进「欢迎回来」面板，顺序和参考稿一致。
		_maybe_show_startup_welcome_after_offline()
	)
	vbox.add_child(ok_btn)
	panel.add_child(vbox)

	add_child(dialog)
	# 兜底：万一玩家用系统返回键把面板关掉（没点「领取奖励」），也要能进到
	# 「欢迎回来」面板，不能卡在一块空背景上。_maybe_show_startup_welcome_* 幂等。
	dialog.tree_exited.connect( func():
		if not _game_started and not (startup_dialog and is_instance_valid(startup_dialog)):
			_maybe_show_startup_welcome_after_offline()
	)
	dialog.popup_centered()

