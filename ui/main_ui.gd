		level_lbl.size = Vector2(block_width, BATTLE_ALLY_NAME_LINE_HEIGHT)

func _make_battle_slot_hp_stylebox(fill_color: Color) -> StyleBoxFlat:
	var style: = StyleBoxFlat.new()
	style.bg_color = fill_color
	style.corner_radius_top_left = BATTLE_SLOT_HP_BAR_CORNER_RADIUS
	style.corner_radius_top_right = BATTLE_SLOT_HP_BAR_CORNER_RADIUS
	style.corner_radius_bottom_left = BATTLE_SLOT_HP_BAR_CORNER_RADIUS
	style.corner_radius_bottom_right = BATTLE_SLOT_HP_BAR_CORNER_RADIUS
	return style

func _style_battle_slot_hp_bar(hp_bar: ProgressBar, fill_color: Color, bar_size: Vector2 = BT_SLOT_HP_BAR_SIZE) -> void :
	if hp_bar == null:
		return
	hp_bar.add_theme_stylebox_override("fill", _make_battle_slot_hp_stylebox(fill_color))
	hp_bar.add_theme_stylebox_override("background", _make_battle_slot_hp_stylebox(BATTLE_SLOT_HP_BAR_BG_COLOR))

	hp_bar.custom_minimum_size = bar_size
	hp_bar.size = bar_size
	hp_bar.size_flags_horizontal = 0
	hp_bar.size_flags_vertical = 0

func _apply_bt_slot_ally_ui_layout(
	name_lbl: Label, 
	level_lbl: Label, 
	hp_bar: ProgressBar, 
	block_x: float, 
	block_width: float
) -> void :
	_apply_bt_slot_name_layout(name_lbl, level_lbl, block_x, block_width)
	if is_instance_valid(hp_bar):
		hp_bar.position = BT_SLOT_HP_BAR_POS
		_style_battle_slot_hp_bar(hp_bar, BATTLE_SLOT_HP_BAR_ALLY_FILL_COLOR, BT_SLOT_HP_BAR_SIZE)

func _ensure_ally_battle_hp_bar_on_wrap(wrap: Control) -> ProgressBar:
	if not is_instance_valid(wrap):
		return null
	var hp_bar: = wrap.get_node_or_null("AllyBattleHPBar") as ProgressBar
	if is_instance_valid(hp_bar):
		return hp_bar
	hp_bar = ProgressBar.new()
	hp_bar.name = "AllyBattleHPBar"
	hp_bar.show_percentage = false
	hp_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hp_bar.z_index = 21
	_style_battle_slot_hp_bar(hp_bar, BATTLE_SLOT_HP_BAR_ALLY_FILL_COLOR, BT_SLOT_HP_BAR_SIZE)
	wrap.add_child(hp_bar)
	_apply_bt_slot_ally_ui_layout(null, null, hp_bar, 0.0, BT_SLOT_NAME_BLOCK_WIDTH)
	return hp_bar

func _update_battle_ally_wrap_hp_bar(hp_bar: ProgressBar, current_hp: int, max_hp: int) -> void :
	if not is_instance_valid(hp_bar):
		return
	var safe_max: = maxi(1, max_hp)
	var safe_hp: = clampi(current_hp, 0, safe_max)
	hp_bar.max_value = safe_max
	hp_bar.value = safe_hp
	_set_battle_hp_bar_percent(hp_bar, safe_hp, safe_max)

func _set_battle_hp_bar_percent(hp_bar: ProgressBar, current_hp: int, max_hp: int) -> void :
	if not is_instance_valid(hp_bar):
		return
	var safe_max: = maxi(1, max_hp)
	var pct: = int(round(float(clampi(current_hp, 0, safe_max)) / float(safe_max) * 100.0))
	var label: = hp_bar.get_node_or_null("HpPct") as Label
	if label == null:
		label = Label.new()
		label.name = "HpPct"
		label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		label.set_anchors_preset(Control.PRESET_FULL_RECT)
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		label.add_theme_font_size_override("font_size", 8)
		label.add_theme_color_override("font_color", Color.WHITE)
		label.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
		label.add_theme_constant_override("outline_size", 2)
		hp_bar.add_child(label)
	label.text = "%d%%" % pct

func _show_hit_target_hp_bar(hit_target_type: String, hit_target_index: int) -> void :
	var wrap: Control = null
	match hit_target_type:
		"player":
			wrap = _battle_player_wrap
		"pet":
			wrap = _battle_pet_wrap
		"coop_player":
			wrap = _battle_coop_player_wrap
		"coop_pet":
			wrap = _battle_coop_pet_wrap
		"monster":
			if hit_target_index >= 0 and hit_target_index < monster_ui_nodes.size():
				wrap = monster_ui_nodes[hit_target_index]
	if not is_instance_valid(wrap):
		return
	var hp_bar: = _find_battle_wrap_hp_bar(wrap)
	if is_instance_valid(hp_bar):
		hp_bar.visible = true

func _sync_battle_ally_wrap_hp_bars() -> void :
	if not game_manager:
		return
	var display_player: = _get_battle_display_player()
	if display_player and is_instance_valid(_battle_player_hp_bar):
		var player_max_hp: int = display_player.get_max_hp()
		var player_hp: = clampi(int(display_player.hp), 0, player_max_hp)
		_update_battle_ally_wrap_hp_bar(_battle_player_hp_bar, player_hp, player_max_hp)
	if is_instance_valid(_battle_pet_hp_bar):
		var active_pet = _get_battle_display_pet()
		if active_pet:
			var pet_max_hp: int = active_pet.get_final_max_hp_with_equipment()
			_update_battle_ally_wrap_hp_bar(_battle_pet_hp_bar, int(active_pet.hp), pet_max_hp)
	if _uses_coop_ally_slots():
		var coop_player = _get_coop_battle_unit("coop_player")
		if coop_player and is_instance_valid(_battle_coop_player_hp_bar):
			_update_battle_ally_wrap_hp_bar(
				_battle_coop_player_hp_bar, 
				int(coop_player.hp), 
				int(coop_player.max_hp)
			)
		var coop_pet = _get_coop_battle_unit("coop_pet")
		if coop_pet and is_instance_valid(_battle_coop_pet_hp_bar):
			_update_battle_ally_wrap_hp_bar(
				_battle_coop_pet_hp_bar, 
				int(coop_pet.hp), 
				int(coop_pet.max_hp)
			)

func _get_ally_defeated_static_center_field_y() -> float:
	var pet_slot_pos: = _battle_grid_ally_slot_pos(BATTLE_GRID_ROW_MEMBER, true)
	return (
		pet_slot_pos.y + _bt_pet_sprite_offset().y + _ally_pet_battle_slot_size().y
		- ALLY_DEFEATED_STATIC_CENTER_HALF_H
	)

func _apply_field_ally_name_layout(name_lbl: Label, level_lbl: Label, wrap_field_y: float, block_x: float, block_width: float) -> void :
	_apply_bt_slot_name_layout(name_lbl, level_lbl, block_x, block_width)

func _ensure_bt_ally_slot_grid(field: Control) -> void :
	if field == null:
		return
	for slot_id in BT_SLOT_IDS:
		if is_instance_valid(_bt_ally_slots.get(slot_id)):
			continue
		var slot: = Control.new()
		slot.name = "BTSlot_%s" % slot_id
		slot.position = _get_bt_slot_field_pos(slot_id)
		slot.custom_minimum_size = BATTLE_GRID_CELL_SIZE
		slot.mouse_filter = Control.MOUSE_FILTER_IGNORE
		slot.z_index = 19
		field.add_child(slot)
		_bt_ally_slots[slot_id] = slot

func _clear_bt_ally_slot_grid() -> void :
	for slot_id in _bt_ally_slots.keys():
		var slot = _bt_ally_slots[slot_id]
		if is_instance_valid(slot):
			slot.queue_free()
	_bt_ally_slots.clear()

func _mount_wrap_to_bt_slot(
	wrap: Control, 
	slot_id: String, 
	name_lbl: Label, 
	level_lbl: Label, 
	hp_bar: ProgressBar, 
	block_x: float, 
	block_width: float
) -> void :
	if not is_instance_valid(wrap):
		return
	var slot: Control = _bt_ally_slots.get(slot_id)
	if not is_instance_valid(slot):
		return
	if not is_instance_valid(hp_bar):
		hp_bar = _ensure_ally_battle_hp_bar_on_wrap(wrap)
	if wrap == _battle_player_wrap:
		_battle_player_hp_bar = hp_bar
	elif wrap == _battle_pet_wrap:
		_battle_pet_hp_bar = hp_bar
	elif wrap == _battle_coop_player_wrap:
		_battle_coop_player_hp_bar = hp_bar
	elif wrap == _battle_coop_pet_wrap:
		_battle_coop_pet_hp_bar = hp_bar
	if wrap.get_parent() != slot:
		if wrap.get_parent():
			wrap.get_parent().remove_child(wrap)
		slot.add_child(wrap)
	wrap.position = Vector2.ZERO
	wrap.z_index = 20
	wrap.set_meta(BATTLE_LUNGE_HOME_POS_META, Vector2.ZERO)
	wrap.set_meta(BATTLE_LUNGE_HOME_Z_META, wrap.z_index)
	_normalize_bt_wrap_layout(wrap, slot_id, name_lbl, level_lbl, hp_bar, block_x, block_width)

func _mount_battle_ally_units_to_slots() -> void :
	var field = monster_container
	if field == null:
		return
	_ensure_bt_ally_slot_grid(field)
	for unit_key in _battle_ally_mount_unit_keys():
		var spec: = _get_ally_unit_mount_spec(unit_key)
		if spec.is_empty() or not is_instance_valid(spec.wrap):
			continue
		var slot_id: = _ally_slot_id_for_unit(unit_key)
		if slot_id.is_empty():
			continue
		_mount_wrap_to_bt_slot(
			spec.wrap, 
			slot_id, 
			spec.name, 
			spec.level, 
			spec.get("hp"), 
			spec.block_x, 
			spec.block_width
		)
	_sync_battle_ally_wrap_hp_bars()
	_enforce_ally_pet_sprites_mirror()
	_set_player_battle_halo_battle_visible(true)
	if _is_bt_battle():
		_apply_brother_tower_death_stamps_from_state()

func _mount_brother_tower_units_to_slots() -> void :
	_mount_battle_ally_units_to_slots()

func _unmount_brother_tower_wraps_to_field(field: Control) -> void :
	if not is_instance_valid(field):
		return
	for wrap in [_battle_player_wrap, _battle_pet_wrap]:
		if is_instance_valid(wrap) and wrap.get_parent() != field:
			if wrap.get_parent():
				wrap.get_parent().remove_child(wrap)
			field.add_child(wrap)
	_mount_battle_ally_units_to_slots()

