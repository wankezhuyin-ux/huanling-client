func _verse_broadcast_star_first_line(poem_full: String, player_name: String, extra_tail: String = "") -> String:
	var lines: = poem_full.split("\n")
	var first: = ""
	var second: = ""
	if lines.size() > 0:
		first = str(lines[0]).strip_edges()
	if lines.size() > 1:
		second = str(lines[1]).strip_edges()
	if first.ends_with("。"):
		first = first.substr(0, first.length() - 1)
	var line1 = "★%s★" % first
	var line2 = "【%s】%s" % [player_name, second]
	if not extra_tail.is_empty():
		line2 += extra_tail
	return line1 + "\n" + line2

func _ready():
	# 版本探针：热更包里 main_ui 若是旧编译缓存，这里不会出现，
	# 一眼就能区分「脚本没更新」还是「别的地方炸了」。
	print("[PROBE] main_ui build=2.5.9.28 offline_pending_member=%s"
		% str(get("_startup_offline_pending") != null))
	print("=== MainUI _ready 开始 ===")
	print("save_data 是否存在: ", save_data != null)

	print("检查UI节点...")
	print("top_bar 是否存在: ", top_bar != null)
	print("main_content 是否存在: ", main_content != null)
	print("bottom_nav 是否存在: ", bottom_nav != null)

	print("隐藏UI元素...")
	if top_bar:
		top_bar.visible = false
	if main_content:
		main_content.visible = false
	if bottom_nav:
		bottom_nav.visible = false
	print("UI元素已隐藏")

	print("创建 GameManager...")
	game_manager = _create_game_manager()
	if game_manager == null:
		push_error("[MainUI] GameManager 未创建，请重启游戏或重新下载更新")
		return
	add_child(game_manager)
	print("[MainUI] hotfix_chain=v4 base=2.0.8 resume_auto=1 gm=load city=load")
	print("GameManager 创建完成")

	print("检测运行环境...")

	var is_editor_debug = OS.has_feature("editor") and not OS.has_feature("standalone")
	print("编辑器调试模式: ", is_editor_debug)



	print("检查 save_data...")
	var from_login_flow: = user_id > 0 or not String(auth_token).strip_edges().is_empty()
	if save_data != null or from_login_flow:
		print("从登录界面进入，跳过初始化，使用传入的存档数据")
		is_new_game = false

	else:
		print("检查本地存档...")
		is_new_game = not game_manager.has_save()
		print("是否新游戏: ", is_new_game)


		if is_editor_debug and not is_new_game:
			print("编辑器调试模式：强制显示登录界面以测试注册登录流程")
			is_new_game = true


		if is_new_game:

			print("新游戏，等待set_network...")
			pass
		else:

			print("调用 game_manager.initialize()...")
			game_manager.initialize()
			print("initialize() 完成")

	print("设置信号...")
	_setup_signals()
	_apply_battle_feed_style()
	print("信号设置完成")

	get_tree().get_root().size_changed.connect(_on_screen_size_changed)

	await get_tree().process_frame
	_apply_root_layout()
	_install_ink_reskin()

# ── 全局去蓝：旧版蓝灰控件回收 ────────────────────────────────────────────
# 选择地图 / 加点方案 / 欢迎回来 / 一堆旧弹窗都是硬编码的蓝灰配色（近 400 处），
# 逐个手改既会漏又会改坏功能色，所以改成运行时统一扫：只认「明显偏蓝」的颜色，
# 把明度重映射到墨→棕→纸金这条暖色轴（见 ui/ink_reskin.gd）。
var _ink_reskin_installed: bool = false
var _ink_reskin_pending: Array = []

func _install_ink_reskin() -> void:
	if _ink_reskin_installed:
		return
	_ink_reskin_installed = true
	InkReskin.purge_tree(self)
	var tree: = get_tree()
	if tree != null and not tree.node_added.is_connected(_on_ink_node_added):
		tree.node_added.connect(_on_ink_node_added)

func _on_ink_node_added(node: Node) -> void:
	if not (node is Control or node is Window):
		return
	# 大多数构造器是「先套样式再 add_child」，这里立刻扫一遍就能命中；
	# 也有反过来的（add_child 之后才 add_theme_*_override），所以统一排队，
	# 本帧末再补扫一次（_flush_ink_reskin_pending）。
	InkReskin.purge_node(node)
	var parent: = node.get_parent()
	if parent != null and _ink_reskin_pending.has(parent):
		return
	if _ink_reskin_pending.size() < 4000:
		_ink_reskin_pending.append(node)

func _flush_ink_reskin_pending() -> void:
	if _ink_reskin_pending.is_empty():
		return
	var batch: Array = _ink_reskin_pending
	_ink_reskin_pending = []
	for node in batch:
		if is_instance_valid(node):
			InkReskin.purge_tree(node)


