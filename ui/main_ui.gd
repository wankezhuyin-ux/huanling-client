func _present_modal_window(window: Window) -> void :
	var layer: = _ensure_modal_canvas_layer()
	layer.add_child(window)
	window.popup_centered()

	if window.has_method("move_to_foreground"):
		window.move_to_foreground()
	window.grab_focus()
	UIStyle.animate_window_popup(window)

func _find_existing_window_popup(popup_key: String) -> Window:
	var layer: = _modal_canvas_layer if _modal_canvas_layer and is_instance_valid(_modal_canvas_layer) else null
	if layer:
		for child in layer.get_children():
			if child is Window and str(child.get_meta("popup_key", "")) == popup_key:
				return child
	var roots: Array = [self]
	var scene_root = Engine.get_main_loop().current_scene
	if scene_root and scene_root != self:
		roots.append(scene_root)
	for root in roots:
		if root == null:
			continue
		for child in root.get_children():
			if child is Window and str(child.get_meta("popup_key", "")) == popup_key:
				return child
	return null

func _focus_existing_popup(popup_key: String) -> bool:
	var existing = _find_existing_window_popup(popup_key)
	if existing and is_instance_valid(existing):
		existing.show()
		existing.grab_focus()
		return true
	return false

func _mark_popup_key(popup: Window, popup_key: String) -> void :
	popup.set_meta("popup_key", popup_key)

const INVENTORY_DETAIL_POPUP_GROUP: = "inventory_detail"
const POPUP_ACTION_BTN_SIZE: = Vector2(160, 45)
const EQUIP_PAGE_H_MARGIN: = 16

var _character_equip_build_token: int = 0
var _pet_equip_build_token: int = 0
