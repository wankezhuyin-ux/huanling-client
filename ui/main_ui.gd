func _has_creature_battle_sprite(sprite_id: String) -> bool:
	return ResourceLoader.exists(_creature_idle_sprite_path(sprite_id))\
	or ResourceLoader.exists(_creature_attack_sprite_path(sprite_id))

func _creature_idle_sprite_path(sprite_id: String) -> String:
	# Art-only replacement for the original starter ID.
	if sprite_id.to_lower() == "kǔxínggūi":
		return "res://art/runtime/deer-idle.res"
	if sprite_id == "":
		return ""
	return "res://assets/sprites/" + sprite_id.to_lower() + "_idle.png"

func _creature_attack_sprite_path(sprite_id: String) -> String:
	# Art-only replacement for the original starter ID.
	if sprite_id.to_lower() == "kǔxínggūi":
		return "res://art/runtime/deer-attack.res"
	if sprite_id == "":
		return ""
	return "res://assets/sprites/" + sprite_id.to_lower() + "_attack.png"

func _battle_sprite_frames_cache_key(sprite_id: String, attack_duration: float) -> String:
	return "%s|%.3f" % [sprite_id.to_lower(), attack_duration]

func _try_load_idle_sprite_sheet(sprite_id: String) -> Texture2D:
	var path: = _creature_idle_sprite_path(sprite_id)
	if path.is_empty() or not ResourceLoader.exists(path):
		return null
	return load(path)

func _try_load_attack_sprite_sheet(sprite_id: String) -> Texture2D:
	var path: = _creature_attack_sprite_path(sprite_id)
	if path.is_empty() or not ResourceLoader.exists(path):
		return null
	return load(path)

func _build_creature_battle_sprite_frames(sprite_id: String, attack_duration: float = PLAYER_ATTACK_DURATION) -> SpriteFrames:
	if sprite_id == "":
		return null
	var cache_key: = _battle_sprite_frames_cache_key(sprite_id, attack_duration)
	if _battle_sprite_frames_cache.has(cache_key):
		return _battle_sprite_frames_cache[cache_key]
	var idle_sheet: Texture2D = _try_load_idle_sprite_sheet(sprite_id)
	var attack_sheet: Texture2D = _try_load_attack_sprite_sheet(sprite_id)
	if attack_sheet == null:
		attack_sheet = idle_sheet
	if idle_sheet == null and attack_sheet == null:
		return null
	var frames: = SpriteFrames.new()
	if idle_sheet:
		frames.add_animation("idle")
		if _append_sheet_frames(frames, "idle", idle_sheet) > 0:
			frames.set_animation_loop("idle", true)
			frames.set_animation_speed("idle", 8.0)
	if attack_sheet:
		frames.add_animation("attack")
		if _append_sheet_frames(frames, "attack", attack_sheet) > 0:
			frames.set_animation_loop("attack", false)
			_set_sprite_frames_fixed_duration(frames, "attack", attack_duration)
	if not frames.has_animation("idle") and frames.has_animation("attack"):
		frames.add_animation("idle")
		frames.add_frame("idle", frames.get_frame_texture("attack", 0))
		frames.set_animation_loop("idle", true)
	_battle_sprite_frames_cache[cache_key] = frames
	return frames

func _add_creature_battle_anim_to_slot(
	slot: Control, 
	sprite_id: String, 
	mirror_x: bool = false, 
	attack_duration: float = PLAYER_ATTACK_DURATION, 
	slot_size: Vector2 = BATTLE_SPRITE_SLOT_SIZE
) -> AnimatedSprite2D:
	var frames: = _build_creature_battle_sprite_frames(sprite_id, attack_duration)
	if frames == null:
		return null
	var scale_val: = slot_size.x / 256.0
	var scale_vec: = Vector2( - scale_val, scale_val) if mirror_x else Vector2(scale_val, scale_val)
	var anim: = AnimatedSprite2D.new()
	anim.centered = true
	anim.scale = scale_vec
	anim.sprite_frames = frames
	anim.position = _battle_sprite_slot_center(slot_size)
	slot.add_child(anim)
	return anim

func _apply_battle_sprite_playback_state(sprite: AnimatedSprite2D) -> void :
	if sprite == null or not is_instance_valid(sprite) or sprite.sprite_frames == null:
		return
	if sprite.is_playing() and sprite.animation == "attack":
		return
	if _should_use_battle_sprite_anim():
		if sprite.sprite_frames.has_animation("idle"):
			sprite.play("idle")
		elif sprite.sprite_frames.has_animation("attack"):
			sprite.play("attack")
	else:
		if sprite.sprite_frames.has_animation("idle"):
			sprite.play("idle")
			sprite.stop()
			sprite.frame = 0
		elif sprite.sprite_frames.has_animation("attack"):
			sprite.frame = 0
			sprite.stop()

func _get_creature_idle_frame_texture(sprite_id: String) -> Texture2D:
	if sprite_id.is_empty():
		return null
	var cache_key: = "idle_frame|%s" % sprite_id.to_lower()
	if _battle_sprite_static_tex_cache.has(cache_key):
		return _battle_sprite_static_tex_cache[cache_key] as Texture2D
	var idle_sheet: = _try_load_idle_sprite_sheet(sprite_id)
	if idle_sheet == null:
		return null
	var atlas: = AtlasTexture.new()
	atlas.atlas = idle_sheet
	atlas.region = Rect2(0, 0, 256, 256)
	_battle_sprite_static_tex_cache[cache_key] = atlas
	return atlas

func _get_player_idle_frame_texture(character_id: int) -> Texture2D:
	var cid: = _normalize_player_character_id(character_id)
	return _get_creature_idle_frame_texture(PlayerCharacterConfig.get_sprite_id(cid))

func _create_player_battle_anim_sprite(wrap: Control, node_name: String, character_id: int) -> AnimatedSprite2D:
	var cid: = _normalize_player_character_id(character_id)
	var player_frames: = _build_player_battle_sprite_frames_for_character(cid)
	if player_frames == null:
		return null
	var sprite_scale: = PlayerCharacterConfig.get_battle_sprite_scale(cid)
	var player_anim: = AnimatedSprite2D.new()
	player_anim.name = node_name
	player_anim.centered = false
	player_anim.scale = Vector2(sprite_scale, sprite_scale)
	player_anim.sprite_frames = player_frames
	player_anim.z_index = 20
	wrap.add_child(player_anim)
	_layout_player_visual_in_current_scene(wrap, cid)
	BattleMonsterDefeatEffect.remember_base_scale(player_anim)
	_apply_battle_sprite_playback_state(player_anim)
	_ensure_player_wrap_foot_shadow(wrap, player_anim)
	return player_anim

const PLAYER_BATTLE_ANIM_VISUAL_SIZE: = Vector2(256.0, 256.0)

func _should_use_battle_sprite_anim() -> bool:
	return _battle_sprite_anim_enabled

func _battle_pet_display_key(pet_id: String) -> String:
	var mirror_flag: = 1 if _bt_ally_pet_mirror_x() else 0
	return "%s|%d|%d" % [pet_id, 1 if _battle_sprite_anim_enabled else 0, mirror_flag]

func _resolve_creature_battle_static_texture(sprite_id: String, fallback: Texture2D) -> Texture2D:
	var idle_frame: = _get_creature_idle_frame_texture(sprite_id)
	if idle_frame != null:
		return idle_frame
	if fallback != null:
		return fallback
	if sprite_id == "":
		return null
	var cache_key: = sprite_id.to_lower()
	if _battle_sprite_static_tex_cache.has(cache_key):
		return _battle_sprite_static_tex_cache[cache_key] as Texture2D
	var am: = AssetManager.get_instance()
	if am:
		var tex: = am.get_pet_texture(sprite_id)
		if tex == null:
			tex = am.get_monster_texture(sprite_id)
		if tex:
			_battle_sprite_static_tex_cache[cache_key] = tex
			return tex
	return null

func _populate_battle_sprite_slot(
	slot: Control, 
	sprite_id: String, 
	mirror_x: bool, 
	fallback_tex: Texture2D, 
	slot_size: Vector2 = BATTLE_SPRITE_SLOT_SIZE, 
	attack_duration: float = MONSTER_ATTACK_DURATION, 
	sprite_node_name: String = "MonsterSprite", 
	static_display_size: Vector2 = BATTLE_STATIC_SPRITE_SIZE
) -> Node:
	if sprite_id != "" and _has_creature_battle_sprite(sprite_id):
		var anim: = _add_creature_battle_anim_to_slot(slot, sprite_id, mirror_x, attack_duration, slot_size)
		if anim:
			anim.name = sprite_node_name
			anim.z_index = 20
			BattleMonsterDefeatEffect.remember_base_scale(anim)
			_apply_battle_sprite_playback_state(anim)
			_ensure_battle_slot_foot_shadow(slot, slot_size, anim)
			return anim
	var static_tex: = _resolve_creature_battle_static_texture(sprite_id, fallback_tex)
	if static_tex == null:
		return null
	var tr: = _add_static_sprite_to_slot(slot, static_tex, slot_size, static_display_size, mirror_x)
	tr.name = sprite_node_name
	BattleMonsterDefeatEffect.remember_base_scale(tr)
	_ensure_battle_slot_foot_shadow(slot, slot_size, tr)
	return tr

func _ensure_battle_slot_foot_shadow(
	slot: Control, 
	slot_size: Vector2, 
	unit: Node, 
	body_offset_y: float = UIConstants.FOOT_SHADOW_BODY_OFFSET_Y
) -> void :
	if not is_instance_valid(slot) or slot_size.x <= 0.0 or slot_size.y <= 0.0:
		return
	FootShadow.ensure_on_parent(
		slot, 
		slot_size, 
		body_offset_y, 
		FootShadow.style_for_unit(unit)
	)

func _ensure_player_wrap_foot_shadow(wrap: Control, unit: Node = null) -> void :
	if not is_instance_valid(wrap):
		return
	if unit == null:
		unit = wrap.get_node_or_null("PlayerBattleAnim")
		if unit == null:
			unit = wrap.get_node_or_null("CoopPlayerBattleAnim")
	if not is_instance_valid(unit):
		return
	FootShadow.ensure_on_parent(
		wrap, 
		BATTLE_SPRITE_SLOT_SIZE, 
		UIConstants.FOOT_SHADOW_PLAYER_BODY_OFFSET_Y, 
		FootShadow.style_for_unit(unit), 
		BT_SLOT_SPRITE_OFFSET
	)

func _get_texture_rect_visual_rect(tr: TextureRect) -> Rect2:
	var display_size: = Vector2(tr.size.x * absf(tr.scale.x), tr.size.y * absf(tr.scale.y))
	var origin: = tr.position
	if tr.scale.x < 0.0:
		origin.x -= display_size.x
	if tr.scale.y < 0.0:
		origin.y -= display_size.y
	return Rect2(origin, display_size)

func _player_battle_static_position(display_size: Vector2, mirror_x: bool) -> Vector2:
	var ref_center: = PlayerCharacterConfig.get_battle_layout_center()
	if mirror_x:
		return Vector2(ref_center.x + display_size.x * 0.5, ref_center.y - display_size.y * 0.5)
	return ref_center - display_size * 0.5

func _add_player_battle_visual_to_wrap(wrap: Control) -> void :
