	privilege_checkbox_normal.corner_radius_top_left = 0
	privilege_checkbox_normal.corner_radius_top_right = 0
	privilege_checkbox_normal.corner_radius_bottom_left = 0
	privilege_checkbox_normal.corner_radius_bottom_right = 0
	double_exp_privilege_checkbox.add_theme_stylebox_override("normal", privilege_checkbox_normal)
	var privilege_checkbox_hover = privilege_checkbox_normal.duplicate()
