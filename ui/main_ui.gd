	# 装备一览已按需求移除：装备信息统一在「装备」页签看，基础属性页只留属性与境界。


func _on_character_realm_ascend_pressed(ascend_btn: Button = null) -> void :
	if _is_challenge_view_locked():
		_show_simple_dialog("无法操作", "挑战进行中，请先完成或停止当前挑战")
		return
	var player = game_manager.player
	var use_double_exp_privilege: = _is_double_exp_privilege_enabled()
	var ec = {}
	if game_manager and game_manager.pet_collection_manager:
		ec = game_manager.pet_collection_manager.get_all_element_collection_counts()
	var ascend_check = player.can_ascend(ec)
	if not ascend_check.can_ascend:
		if ascend_check.missing_elements.size() > 0:
			_add_log("[color=red]五行图鉴不足，飞升大罗金仙需要每个属性至少10个图鉴！[/color]")
		else:
			var required_level = GameData.ASCENSION_CONDITIONS.get(player.realm, {}).get("required_level", 0)
			if player.realm == "至尊":
				_add_log("[color=red]已经达到最高境界, 无法继续飞升![/color]")
			else:
				_add_log("[color=red]等级不足, 需要达到%d级才能飞升![/color]" % required_level)
		return
	var can_commit_critical_ascend: = false
	var sync_msg_ascend: = "当前网络同步异常，暂时无法执行飞升。\n请等待网络恢复后再试，避免进度回滚。"
	if game_manager and game_manager.network and game_manager.network.has_method("can_commit_critical_op"):
		can_commit_critical_ascend = bool(game_manager.network.can_commit_critical_op())
		if game_manager.network.has_method("get_sync_status_message"):
			sync_msg_ascend = str(game_manager.network.get_sync_status_message()) + "\n请等待网络恢复后再试，避免进度回滚。"
	else:
		sync_msg_ascend = "未连接网络服务，暂时无法执行飞升。\n请登录后重试。"
	if not can_commit_critical_ascend:
		_add_log("[color=red]%s[/color]" % sync_msg_ascend)
		if not _is_silent_realm_transition():
			_show_simple_dialog("同步异常", sync_msg_ascend)
		return

	if is_instance_valid(ascend_btn):
		ascend_btn.disabled = true
		ascend_btn.text = "飞升中..."

	var anim_panel: Panel = null
	var silent: = _is_silent_realm_transition()
	if not silent:
		anim_panel = _show_process_animation("飞升中", "天地灵气汇聚...")
		var anim_label = anim_panel.get_meta("anim_label") as Label
		var desc_label = anim_panel.get_meta("desc_label") as Label

		await get_tree().create_timer(0.7).timeout
		if anim_label and desc_label and is_instance_valid(anim_panel):
			anim_label.text = "飞升中··"
			desc_label.text = "突破境界瓶颈..."

		await get_tree().create_timer(0.7).timeout
		if anim_label and desc_label and is_instance_valid(anim_panel):
			anim_label.text = "飞升中···"
			desc_label.text = "即将踏入新境界..."

		await get_tree().create_timer(0.6).timeout
	if is_instance_valid(anim_panel):
		anim_panel.queue_free()

	var old_realm = player.realm
	# 飞升会把属性点重置为 20 + 永久点；开了「自动加点」时这批点会直接进
	# 待分配池，面板上「可用属性点」仍显示 0。这里记下差值，在结算弹窗里
	# 明说一句，免得玩家以为飞升根本没发属性点。
	var attr_points_before: int = int(player.points) + int(player.pending_auto_points)
	var snapshot = game_manager.create_secure_op_snapshot()
	var commit_result: Dictionary = await game_manager.commit_realm_transition(snapshot, "飞升", func() -> Dictionary:
		return player.ascend(ec)
	)


	if is_instance_valid(ascend_btn):
		ascend_btn.disabled = false
		ascend_btn.text = "开始飞升"

	if not bool(commit_result.get("success", false)):
		_add_log("[color=red]%s[/color]" % str(commit_result.get("message", "飞升结果同步失败，已回滚。")))
		return
	var result: Dictionary = commit_result.get("transition_result", {}) if commit_result.get("transition_result") is Dictionary else {}
	if bool(result.get("success", false)):
		var announce_msg = ""
		var popup_poem = ""
		var popup_msg = ""

		if str(result.get("poem", "")) == "SPECIAL":
			announce_msg = "夫唯不争，故天下莫能与之争。\n恭喜【%s】一心向武，从破中求立，终于突破自身极限，晋升幻灵天神。等级:%d" % [player.player_name, player.level]
			popup_poem = "夫唯不争，故天下莫能与之争。\n一心向武，从破中求立，终于突破自身极限！"
			popup_msg = "恭喜晋升幻灵天神！"
		else:
			var realm_msgs = {
				"散仙": "得道飞升成仙！", 
				"地仙": "得道晋升地仙！", 
				"天仙": "修为更上一层，晋升天仙！", 
				"大罗金仙": "修为更上一层，晋升大罗金仙！"
			}
			announce_msg = "%s\n恭喜【%s】%s 等级:%d" % [str(result.get("poem", "")), player.player_name, realm_msgs.get(player.realm, "晋升" + player.realm), player.level]
			popup_poem = str(result.get("poem", ""))
			popup_msg = "恭喜晋升【%s】！" % player.realm

		var attr_gained: int = int(player.points) + int(player.pending_auto_points) - attr_points_before
		if attr_gained > 0:
			if int(player.points) > 0:
				popup_msg += "\n本次飞升获得 %d 点属性点" % attr_gained
			else:
				popup_msg += "\n本次飞升获得 %d 点属性点（已勾选自动加点，进入待分配池，满 %d 点自动分配）" % [attr_gained, player.AUTO_ALLOCATE_THRESHOLD]

		game_manager.broadcast_event("ascend", player.player_name, {"old_realm": old_realm, "new_realm": player.realm, "level": player.level}, announce_msg)
		await _try_player_attr_auto_allocate_after_level_up()
		var refresh_callback: = func():
			_update_player_ui()
			if not _is_silent_realm_transition() and character_basic_stats_container.get_child_count() > 0:
				call_deferred("_refresh_character_stats_view")
		_show_result_popup("飞升成功", popup_poem, popup_msg, refresh_callback, use_double_exp_privilege)
	else:
		_add_log("[color=red]%s[/color]" % str(result.get("message", "飞升失败")))

func _on_character_realm_reincarnate_pressed(reincarnate_btn: Button = null) -> void :
	if _is_challenge_view_locked():
		_show_simple_dialog("无法操作", "挑战进行中，请先完成或停止当前挑战")
		return
	var player = game_manager.player
	var use_double_exp_privilege: = _is_double_exp_privilege_enabled()

	if not player.can_reincarnate():
		if player.realm != "幻灵天神":
			_add_log("[color=red]只有幻灵天神才能投胎![/color]")
		elif player.level < GameData.MAX_LEVEL_EVOLUTION:
			_add_log("[color=red]等级不足, 需要达到%d级才能投胎![/color]" % GameData.MAX_LEVEL_EVOLUTION)
		else:
			_add_log("[color=red]已经达到最大投胎次数![/color]")
		return
	var can_commit_critical_reincarnate: = false
	var sync_msg_reincarnate: = "当前网络同步异常，暂时无法执行投胎。\n请等待网络恢复后再试，避免进度回滚。"
	if game_manager and game_manager.network and game_manager.network.has_method("can_commit_critical_op"):
		can_commit_critical_reincarnate = bool(game_manager.network.can_commit_critical_op())
		if game_manager.network.has_method("get_sync_status_message"):
			sync_msg_reincarnate = str(game_manager.network.get_sync_status_message()) + "\n请等待网络恢复后再试，避免进度回滚。"
	else:
		sync_msg_reincarnate = "未连接网络服务，暂时无法执行投胎。\n请登录后重试。"
	if not can_commit_critical_reincarnate:
		_add_log("[color=red]%s[/color]" % sync_msg_reincarnate)
		if not _is_silent_realm_transition():
			_show_simple_dialog("同步异常", sync_msg_reincarnate)
		return

	if is_instance_valid(reincarnate_btn):
		reincarnate_btn.disabled = true
		reincarnate_btn.text = "投胎中..."

	var anim_panel: Panel = null
	var silent: = _is_silent_realm_transition()
	if not silent:
		anim_panel = _show_process_animation("投胎中", "凝聚无上法力...")
		var anim_label = anim_panel.get_meta("anim_label") as Label
		var desc_label = anim_panel.get_meta("desc_label") as Label

		await get_tree().create_timer(0.7).timeout
		if anim_label and desc_label and is_instance_valid(anim_panel):
			anim_label.text = "投胎中··"
			desc_label.text = "灵魂蜕变转化..."

		await get_tree().create_timer(0.7).timeout
		if anim_label and desc_label and is_instance_valid(anim_panel):
			anim_label.text = "投胎中···"
			desc_label.text = "即将重入凡尘..."

		await get_tree().create_timer(0.6).timeout
	if is_instance_valid(anim_panel):
		anim_panel.queue_free()

	var snapshot = game_manager.create_secure_op_snapshot()
	var reincarnate_commit_result: Dictionary = await game_manager.commit_realm_transition(snapshot, "投胎", func() -> Dictionary:
		return player.reincarnate()
	)

	if is_instance_valid(reincarnate_btn):
		reincarnate_btn.disabled = false
		reincarnate_btn.text = "开始投胎"

	if not bool(reincarnate_commit_result.get("success", false)):
		_add_log("[color=red]%s[/color]" % str(reincarnate_commit_result.get("message", "投胎结果同步失败，已回滚。")))
		return
	var result: Dictionary = reincarnate_commit_result.get("transition_result", {}) if reincarnate_commit_result.get("transition_result") is Dictionary else {}
	if bool(result.get("success", false)):
		var announce_msg = _verse_broadcast_star_first_line(REINCARNATE_BROADCAST_POEM, player.player_name, " 转世次数:%d" % player.reincarnation)
		var popup_poem = REINCARNATE_BROADCAST_POEM
		var perm_gain: = GameData.permanent_delta_on_reincarnate(player.reincarnation)
		var popup_msg = "第%d次投胎成功！获得%d点永久属性点！" % [player.reincarnation, perm_gain]
		game_manager.broadcast_event("reincarnate", player.player_name, {"reincarnation_count": player.reincarnation}, announce_msg)
		await _try_player_attr_auto_allocate_after_level_up()
		var refresh_callback: = func():
			_update_player_ui()
			if not _is_silent_realm_transition() and character_basic_stats_container.get_child_count() > 0:
				call_deferred("_refresh_character_stats_view")
		_show_result_popup("投胎成功", popup_poem, popup_msg, refresh_callback, use_double_exp_privilege)
	else:
		_add_log("[color=red]%s[/color]" % str(result.get("message", "投胎失败")))

func _on_double_exp_privilege_checkbox_toggled(pressed: bool) -> void :
	if _updating_double_exp_privilege_checkbox:
		return
	var pl = game_manager.player if game_manager else null
	if pl:
		pl.double_exp_auto_realm_enabled = pressed
		if game_manager:
			game_manager.save_game()
	if pressed:
		_sync_double_exp_privilege_checkbox_state(true)
		call_deferred("_try_auto_realm_transition")
	else:
		_refresh_double_exp_privilege_checkbox_text()

func _sync_double_exp_privilege_checkbox_state(show_tip_when_invalid: bool) -> void :
	if not is_instance_valid(double_exp_privilege_checkbox):
		return
	var player = game_manager.player if game_manager else null
	var is_active = player != null and player.is_double_exp_active()
	# 勾选状态 = 玩家自己的偏好，**不能因为双倍丹过期就自动清掉**。
	# 老写法是「丹一过期就把 double_exp_auto_realm_enabled 改 false 并存盘」：
	# 玩家勾过一次、丹到期后设置被悄悄关掉，之后再用丹也不会自动投胎，
	# 表现就是「属性面板的自动投胎功能不生效」。
	var want_enabled: bool = player != null and player.double_exp_auto_realm_enabled
	_updating_double_exp_privilege_checkbox = true
	double_exp_privilege_checkbox.button_pressed = want_enabled
	_updating_double_exp_privilege_checkbox = false

	if is_active:
		double_exp_privilege_checkbox.tooltip_text = "双倍经验符生效中：达到飞升/投胎条件后自动执行（结果弹窗自动关闭）"
	else:
		double_exp_privilege_checkbox.tooltip_text = "设置会被保存；仅在双倍经验符生效期间自动执行"
		if show_tip_when_invalid and want_enabled:
			_show_error_tip("已开启。双倍经验符生效期间，达到条件会自动飞升/投胎")
	_refresh_double_exp_privilege_checkbox_text()
	# 面板重建时补一次判定：勾着、丹在生效、等级也够了就直接执行，
	# 不用等下一次升级信号。
	if want_enabled and is_active:
		call_deferred("_try_auto_realm_transition")

func _is_double_exp_privilege_enabled() -> bool:
	var player = game_manager.player if game_manager else null
	if player == null or not player.is_double_exp_active():
		return false

	return player.double_exp_auto_realm_enabled

func _try_auto_realm_transition() -> void :
	if _auto_realm_transition_in_progress:
		return
	if not _is_double_exp_privilege_enabled():
		return
	if game_manager == null or game_manager.player == null:
		return
	var player = game_manager.player
	var previous_realm: String = player.realm
	var previous_reincarnation: int = player.reincarnation
	var ec = {}
	if game_manager.pet_collection_manager:
		ec = game_manager.pet_collection_manager.get_all_element_collection_counts()
	var can_reincarnate = player.can_reincarnate()
	var can_ascend = player.can_ascend(ec).can_ascend
	if not can_reincarnate and not can_ascend:
		return
	_auto_realm_transition_in_progress = true
	_dismiss_realm_transition_ui_chrome()
	if can_reincarnate:
		_add_log("[color=#f6d06a]双倍经验符权益触发：检测到满足投胎条件，正在自动投胎...[/color]")
		_show_auto_realm_transition_tip("双倍经验符权益触发\n检测到满足投胎条件，正在自动投胎...")
		await _on_character_realm_reincarnate_pressed()
		if player.reincarnation > previous_reincarnation:
			_add_log("[color=#7dff9b]双倍经验符权益触发：已自动投胎（第%d次）。[/color]" % player.reincarnation)
			_show_auto_realm_transition_tip("双倍经验符权益触发\n已自动投胎（第%d次）" % player.reincarnation)
			await _try_player_attr_auto_allocate_after_level_up()
	elif can_ascend:
		_add_log("[color=#f6d06a]双倍经验符权益触发：检测到满足飞升条件，正在自动飞升...[/color]")
		_show_auto_realm_transition_tip("双倍经验符权益触发\n检测到满足飞升条件，正在自动飞升...")
		await _on_character_realm_ascend_pressed()
		if player.realm != previous_realm:
			_add_log("[color=#7dff9b]双倍经验符权益触发：已自动飞升至【%s】。[/color]" % player.realm)
			_show_auto_realm_transition_tip("双倍经验符权益触发\n已自动飞升至【%s】" % player.realm)
			await _try_player_attr_auto_allocate_after_level_up()
	_auto_realm_transition_in_progress = false
	_dismiss_realm_transition_ui_chrome()
	call_deferred("_update_player_ui")

func _refresh_double_exp_privilege_checkbox_text() -> void :
	if not is_instance_valid(double_exp_privilege_checkbox):
		return
	# 右栏只有约 400px，原来那串 30 字的说明会被裁掉一半，压短但语义不变
	double_exp_privilege_checkbox.text = "启用双倍经验符权益（自动飞升/投胎）"

