func _on_battle_ended(victory: bool):
	_cancel_replay_skip_wait()
	_restore_all_battle_lunges()
	_last_fight_log_victory = victory
	_current_fight_log_finished = true
	call_deferred("_post_battle_attr_ui_catchup")
	_dismiss_realm_transition_ui_chrome()
	_clear_battle_banners(false)
	_clear_battle_feed()
	if auto_battle:
		_battle_cooldown_deadline_ms = Time.get_ticks_msec() + 1000
		battle_cooldown = 1.0
		_battle_countdown_active = true
		_last_battle_countdown_second_announced = -1

	var player_died = game_manager.battle_system.player_died_in_battle if game_manager.battle_system else false
	var pet_died = game_manager.battle_system.pet_died_in_battle if game_manager.battle_system else false


	if game_manager.auto_change_map_enabled:
		if player_died or pet_died:

			game_manager.auto_change_map_consecutive_deaths += 1
			game_manager.auto_change_map_consecutive_wins = 0
			var death_count = game_manager.auto_change_map_consecutive_deaths
			_add_log("[color=red]有伤亡！连续 %d 次战斗死亡[/color]" % death_count)


			_downgrade_map_for_auto_change()


			game_manager.auto_change_map_upgrade_cooldown = Time.get_unix_time_from_system() + 300
			_add_log("[color=yellow]已设置升级冷却，5分钟后才能升级[/color]")

			game_manager.mark_battle_progress_dirty("auto_change_death")
		else:

			if victory:
				_add_log("[color=green]战斗胜利![/color]")

				game_manager.auto_change_map_consecutive_wins += 1
				game_manager.auto_change_map_consecutive_deaths = 0
				var win_count = game_manager.auto_change_map_consecutive_wins
				_add_log("[color=green]完美胜利！连续 %d 次无死亡[/color]" % win_count)


				if win_count >= 3:
					var current_time = Time.get_unix_time_from_system()
					if current_time >= game_manager.auto_change_map_upgrade_cooldown:
						_upgrade_map_for_auto_change()
						game_manager.auto_change_map_consecutive_wins = 0
					else:
						var remaining = int(game_manager.auto_change_map_upgrade_cooldown - current_time)
						_add_log("[color=yellow]升级冷却中，还需 %d 秒才能升级[/color]" % remaining)

				game_manager.mark_battle_progress_dirty("auto_change_win")
	else:

		if victory:
			_add_log("[color=green]战斗胜利![/color]")
		else:
			_add_log("[color=red]战斗失败![/color]")

	_update_player_ui_optimized()
	_update_pet_ui_optimized()


	if game_manager.battle_system:
		_restore_all_battle_lunges()
		_snap_dead_monsters_to_battle_home()
		_update_monster_hp_ui_optimized()
		_update_battle_unit_death_stamps()




	if pet_view.visible:
		_refresh_pet_list_view()


	_update_quest_progress_on_battle_end(victory)


	if game_manager.last_battle_was_tower:
		_show_tower_result_dialog(victory)
	elif game_manager.last_battle_was_world_boss:
		_show_world_boss_result_dialog()
	elif game_manager.last_battle_was_arena:
		_show_arena_result_dialog()
	elif game_manager.last_battle_was_gang_kick:
		pass
	elif game_manager.last_battle_was_gang_siege:
		pass
	elif game_manager.last_battle_was_suit_dungeon:
		pass
	else:

		_update_map_ui()


func _update_quest_progress_on_battle_end(victory: bool):
	if not victory:
		return

	var quest_manager = game_manager.quest_manager
	if quest_manager == null:
		return


	var current_map = game_manager.current_map


	var battle_system = game_manager.battle_system
	if battle_system and battle_system.monsters:
		for monster in battle_system.monsters:
			if not battle_system.is_monster_alive(monster):
				var monster_id = ""
				var element = ""

				if monster is Dictionary:
					monster_id = monster.get("id", "")

					var MonsterDatabase = load("res://scripts/data/monster_database.gd")
					if MonsterDatabase:
						var monster_data = MonsterDatabase.get_monster(monster_id)
						element = monster_data.get("element", "")
				else:
					monster_id = monster.id
					element = monster.element


				quest_manager.on_battle_completed(current_map, monster_id, element)


	quest_manager.update_quest_progress(QuestDatabase.QuestConditionType.BATTLE_COUNT)

