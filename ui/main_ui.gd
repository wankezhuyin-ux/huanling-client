func _show_equipment_action_popup(item, slot: String, is_equipped: bool):
	if not is_equipped:
		_update_bag_detail_bar_item(item)
	var equip_key = str(item.id) if "id" in item else str(item.name)
	var popup_key = "equip_action:%s:%s:%s" % [equip_key, slot, str(is_equipped)]
	var shell: = _open_styled_popup(popup_key, INVENTORY_DETAIL_POPUP_GROUP, Vector2i(440, 520))
	if shell.is_empty():
		return
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox


	vbox.add_child(_build_character_equipment_detail_header(item, slot, is_equipped))

	var sep = HSeparator.new()
	vbox.add_child(sep)

	var popup_ref = popup
	var eq_btns: Array = []

	if is_equipped:
		var unequip_btn = _popup_fixed_btn("卸下装备", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		unequip_btn.pressed.connect( func():
			if game_manager.has_method("local_equipment_op"):
				var result: Dictionary = game_manager.local_equipment_op(false, "unequip", item.id, slot)
				if bool(result.get("success", false)):
					popup_ref.queue_free()
				_notify_player_attr_changed("local_equipment")
				_update_pet_ui()
				_refresh_pet_equipment_view()
				_show_simple_dialog("本地装备", str(result.get("message", "")))
				return
			if not game_manager or not game_manager.network or not game_manager.network.is_logged_in():
				_show_game_alert("当前网络不可用，装备卸下需联网并由服务器确认。", "无法卸下")
				return
			unequip_btn.disabled = true
			var op_id: = "equipment_unequip_%s_%d_%d" % [slot, Time.get_unix_time_from_system(), Time.get_ticks_msec()]
			var on_success: Callable
			var on_failed: Callable
			on_failed = func(error: String):
				var net = game_manager.network if game_manager else null
				if net and net.equipment_unequip_success.is_connected(on_success):
					net.equipment_unequip_success.disconnect(on_success)
				if is_instance_valid(unequip_btn):
					unequip_btn.disabled = false
				_show_game_alert(error, "无法卸下")
			on_success = func(data: Dictionary):
				var net = game_manager.network if game_manager else null
				if net and net.equipment_unequip_failed.is_connected(on_failed):
					net.equipment_unequip_failed.disconnect(on_failed)
				_begin_character_equipment_op_light_ui()
				if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
					game_manager.apply_cloud_save(data.get("saveData"), {
						"authoritative_equipment_inventory": true, 
						"skip_deferred_cloud_save": true, 
						"reconcile_treasure_chests": false, 
						"skip_title_gang_refresh": true, 
					})
				_add_log("[color=yellow]%s[/color]" % data.get("message", "已卸下装备"))
				if is_instance_valid(popup_ref):
					popup_ref.queue_free()
				_schedule_character_equipment_refresh()
				call_deferred("_end_character_equipment_op_light_ui_deferred")
			game_manager.network.equipment_unequip_success.connect(on_success, CONNECT_ONE_SHOT)
			game_manager.network.equipment_unequip_failed.connect(on_failed, CONNECT_ONE_SHOT)
			game_manager.network.request_equipment_unequip(slot, op_id)
		)
		eq_btns.append(unequip_btn)
	else:
		var is_sealed = item.is_sealed if "is_sealed" in item else false

		var row1_btns: Array = []

		if is_sealed:
			var unseal_btn = _popup_fixed_btn("解封", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
			unseal_btn.pressed.connect( func():
				popup_ref.queue_free()
				_unseal_suit_item(item)
			)
			row1_btns.append(unseal_btn)
		else:
			var equip_btn = _popup_fixed_btn("装备", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
			equip_btn.pressed.connect( func():
				if not game_manager or not game_manager.network or not game_manager.network.is_logged_in():
					_show_game_alert("当前网络不可用，装备穿戴需联网并由服务器确认。", "无法装备")
					return
				if item.is_suit:
					var SuitDatabaseDetailed = load("res://scripts/data/suit_database_detailed.gd")
					var required = SuitDatabaseDetailed.get_required_cultivation(EquipmentManager.coerce_suit_id(item.suit_id))
					if game_manager.player.cultivation < required:
						popup_ref.queue_free()
						_show_game_alert("修行值不足，需要 %d 才能装备 %s" % [required, item.name], "无法装备")
						return
				equip_btn.disabled = true
				var target_slot: = str(item.suit_slot if item.is_suit else item.slot)
				var op_id: = "equipment_equip_%s_%d_%d" % [str(item.id), Time.get_unix_time_from_system(), Time.get_ticks_msec()]
				var on_success = func(data: Dictionary):
					_begin_character_equipment_op_light_ui()
					if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
						game_manager.apply_cloud_save(data.get("saveData"), {
							"skip_deferred_cloud_save": true, 
							"reconcile_treasure_chests": false, 
							"skip_title_gang_refresh": true, 
						})
					_add_log("[color=green]%s[/color]" % data.get("message", "已装备"))
					if is_instance_valid(popup_ref):
						popup_ref.queue_free()
					_schedule_character_equipment_refresh()
					call_deferred("_end_character_equipment_op_light_ui_deferred")
				var on_failed = func(error: String):
					equip_btn.disabled = false
					_show_game_alert(error, "无法装备")
				game_manager.network.equipment_equip_success.connect(on_success, CONNECT_ONE_SHOT)
				game_manager.network.equipment_equip_failed.connect(on_failed, CONNECT_ONE_SHOT)
				var equip_snapshot: Dictionary = {}
				if item is Object and item.has_method("to_dict"):
					var snap_raw = item.to_dict()
					if snap_raw is Dictionary:
						equip_snapshot = snap_raw
				game_manager.network.request_equipment_equip(str(item.id), target_slot, op_id, equip_snapshot)
			)
			row1_btns.append(equip_btn)

		var store_btn = _popup_fixed_btn("存仓库", POPUP_ACTION_BTN_SIZE, _apply_store_button_style)
		store_btn.pressed.connect( func():
			if _try_local_inventory_action("store_equipment", str(item.id), popup_ref):
				return
			if not game_manager or not game_manager.inventory_manager:
				_show_game_alert("背包管理器未初始化。", "无法存仓库")
				return
			var is_character_equipment: bool = item != null and (item is EquipmentManager.Equipment or ("slot" in item and not ("count" in item)))
			if is_character_equipment:
				if not game_manager.network or not game_manager.network.is_logged_in():
					_show_game_alert("当前网络不可用，装备入仓需联网并由服务器确认。", "无法存仓库")
					return
				store_btn.disabled = true
				var equipment_id: = ""
				var sealed_item_id: = ""
				var is_sealed_suit: bool = item != null and item.is_suit and item.is_sealed
				if is_sealed_suit:


					var sd_store: Dictionary = item.sealed_data if item.sealed_data is Dictionary else {}
					var inv_m = game_manager.inventory_manager
					var eq_m = game_manager.equipment_manager
					if inv_m:
						for inv_row in inv_m.items:
							if inv_row.item_type == "sealed_suit" and str(inv_row.id) == str(item.id):
								sealed_item_id = str(inv_row.id).strip_edges()
								break
						if sealed_item_id.is_empty():
							var sid2: = _find_sealed_suit_item_id(sd_store, inv_m.items)
							if sid2 != "":
								sealed_item_id = String(sid2).strip_edges()
					if sealed_item_id.is_empty() and eq_m:
						if eq_m.inventory.has(item):
							equipment_id = str(item.id).strip_edges()
						else:
							for eq in eq_m.inventory:
								if eq != null and eq.is_suit and eq.is_sealed and str(eq.id) == str(item.id):
									equipment_id = str(eq.id).strip_edges()
									break
							if equipment_id.is_empty():
								var eq_hit = _find_sealed_equipment_ref(sd_store, eq_m.inventory)
								if eq_hit != null:
									equipment_id = str(eq_hit.id).strip_edges()
					if sealed_item_id.is_empty() and equipment_id.is_empty():
						store_btn.disabled = false
						_show_game_alert("未找到封印套装道具", "无法存仓库")
						return
				else:
					equipment_id = str(item.id)
				var op_id: = "equipment_store_warehouse_%s_%s_%d" % [equipment_id, sealed_item_id, Time.get_ticks_msec()]
				var on_success = func(data: Dictionary):
					if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
						game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
					_add_log("[color=green]%s[/color]" % data.get("message", "已存入仓库"))
					if is_instance_valid(popup_ref):
						popup_ref.queue_free()
					_update_bag_view()
				var on_failed = func(error: String):
					store_btn.disabled = false
					_show_game_alert(error, "无法存仓库")
				game_manager.network.equipment_store_warehouse_success.connect(on_success, CONNECT_ONE_SHOT)
				game_manager.network.equipment_store_warehouse_failed.connect(on_failed, CONNECT_ONE_SHOT)
				game_manager.network.request_equipment_store_warehouse(equipment_id, sealed_item_id, op_id)
				return
			if not game_manager.network or not game_manager.network.is_logged_in():
				_show_game_alert("请先登录账号后再使用仓库。", "无法存仓库")
				return
			_show_game_alert("人物装备存仓请在本界面操作；道具请切换到背包「道具」分页使用存仓库。", "无法存仓库")
		)
		row1_btns.append(store_btn)

		var row2_btns: Array = []

		if item.is_suit:
			var dismantle_btn = _popup_fixed_btn("分解", POPUP_ACTION_BTN_SIZE, _apply_dismantle_button_style)
			dismantle_btn.pressed.connect( func():
				if not game_manager or not game_manager.inventory_manager:
					_show_simple_dialog("分解失败", "系统错误：背包管理器未初始化")
					return
				var inv_manager = game_manager.inventory_manager
				if is_sealed:
					var sealed_ref: Dictionary = _resolve_sealed_suit_ref(item)
					var source: String = str(sealed_ref.get("source", ""))
					if source == "item_bag":
						var sealed_item_id: String = str(sealed_ref.get("item_id", ""))
						var reward_item: Dictionary = inv_manager.get_sealed_suit_item_dismantle_reward(sealed_item_id)
						if not reward_item.get("success", false):
							_show_simple_dialog("分解失败", str(reward_item.get("message", "该封印套装不可分解")))
							return
						popup_ref.queue_free()
						_show_suit_dismantle_confirm_popup(
							item.name, 
							str(reward_item.get("stone_name", "")), 
							int(reward_item.get("count", 0)), 
							func():
								await _run_suit_dismantle_secure( func() -> Dictionary:
									return {"sealed_item_id": sealed_item_id}
								)
						)
					elif source == "equip_bag":
						var sealed_equipment: Variant = sealed_ref.get("equipment", null)
						var reward_equip: Dictionary = inv_manager.get_suit_equipment_dismantle_reward(sealed_equipment)
						if not reward_equip.get("success", false):
							_show_simple_dialog("分解失败", str(reward_equip.get("message", "该封印套装不可分解")))
							return
						popup_ref.queue_free()
						_show_suit_dismantle_confirm_popup(
							item.name, 
							str(reward_equip.get("stone_name", "")), 
							int(reward_equip.get("count", 0)), 
							func():
								await _run_suit_dismantle_secure( func() -> Dictionary:
									return {"equipment_id": str(sealed_equipment.id)}
								)
						)
					else:
						_show_simple_dialog("分解失败", "未找到封印套装道具")
				else:
					var reward: Dictionary = inv_manager.get_suit_equipment_dismantle_reward(item)
					if not reward.get("success", false):
						_show_simple_dialog("分解失败", str(reward.get("message", "该套装不可分解")))
						return
					popup_ref.queue_free()
					_show_suit_dismantle_confirm_popup(
						item.name, 
						str(reward.get("stone_name", "")), 
						int(reward.get("count", 0)), 
						func():
							await _run_suit_dismantle_secure( func() -> Dictionary:
								return {"equipment_id": str(item.id)}
							)
					)
			)
			row2_btns.append(dismantle_btn)

		if not DiscardProtection.cannot_discard_equipment(item):
			var drop_btn = _popup_fixed_btn("丢弃", POPUP_ACTION_BTN_SIZE, _apply_drop_button_style)
			drop_btn.pressed.connect( func():
				if DiscardProtection.cannot_discard_equipment(item):
					_show_game_alert(DiscardProtection.blocked_message(), "无法丢弃")
					return
				if not game_manager or not game_manager.equipment_manager:
					_show_game_alert("系统错误：装备管理器未初始化", "丢弃失败")
					return
				if not game_manager.network or not game_manager.network.is_logged_in():
					_show_game_alert("当前网络不可用，人物装备丢弃需联网并由服务器确认。", "丢弃失败")
					return
				drop_btn.disabled = true
				var sealed_ref: Dictionary = _resolve_sealed_suit_ref(item)
				var drop_ok: = false
				var drop_msg: = ""
				if String(sealed_ref.get("source", "")) == "item_bag":
					var sealed_item_id: = str(sealed_ref.get("item_id", "")).strip_edges()
					if sealed_item_id.is_empty():
						if is_instance_valid(drop_btn):
							drop_btn.disabled = false
						_show_game_alert("未找到封印套装道具实例，请重登后再试。", "丢弃失败")
						return
					var op_id: = "inventory_drop_sealed_%s_%d_%d" % [sealed_item_id, Time.get_unix_time_from_system(), Time.get_ticks_msec()]
					var state: = {"done": false, "ok": false, "message": ""}
					var on_success = func(data: Dictionary):
						state.done = true
						state.ok = true
						state.message = str(data.get("message", "已丢弃"))
						if game_manager and data.has("saveData") and data.get("saveData") is Dictionary:
							game_manager.apply_cloud_save(data.get("saveData"), {"authoritative_equipment_inventory": true})
					var on_failed = func(error: String):
						state.done = true
						state.ok = false
						state.message = error
					game_manager.network.inventory_drop_success.connect(on_success, CONNECT_ONE_SHOT)
					game_manager.network.inventory_drop_failed.connect(on_failed, CONNECT_ONE_SHOT)
					game_manager.network.request_inventory_drop(sealed_item_id, 1, op_id)
					var deadline: = Time.get_ticks_msec() + 15000
					while not bool(state.done) and Time.get_ticks_msec() < deadline and game_manager.is_inside_tree():
						await game_manager.get_tree().process_frame
					if game_manager.network.inventory_drop_success.is_connected(on_success):
						game_manager.network.inventory_drop_success.disconnect(on_success)
					if game_manager.network.inventory_drop_failed.is_connected(on_failed):
						game_manager.network.inventory_drop_failed.disconnect(on_failed)
					if not bool(state.done):
						drop_msg = "服务器响应超时，请稍后重试"
					elif bool(state.ok):
						drop_ok = true
						drop_msg = str(state.message)
					else:
						drop_msg = str(state.message)
				else:
					var drop_result: Dictionary = await game_manager.equipment_manager.remove_from_inventory_online(item)
					drop_ok = bool(drop_result.get("success", false))
					drop_msg = str(drop_result.get("message", "丢弃失败"))
				if is_instance_valid(drop_btn):
					drop_btn.disabled = false
				if drop_ok:
					_add_log("[color=yellow]%s[/color]" % drop_msg)
					if is_instance_valid(popup_ref):
						popup_ref.queue_free()
					_show_character_subview("equipment")
					_update_bag_view()
					_update_character_view()
					_update_player_ui()
				else:
					_show_game_alert(drop_msg, "丢弃失败")
			)
			row2_btns.append(drop_btn)
		eq_btns.append_array(row1_btns)
		eq_btns.append_array(row2_btns)

	var close_btn = _popup_fixed_btn("取消", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	close_btn.pressed.connect( func(): popup_ref.queue_free())
	eq_btns.append(close_btn)
	_popup_add_btn_grid(vbox, eq_btns)

	_finish_styled_popup(popup)

func _fabao_make_rtl_line(bbcode: String) -> RichTextLabel:
	var rtl: = RichTextLabel.new()
	rtl.bbcode_enabled = true
	rtl.fit_content = true
	rtl.scroll_active = false
	rtl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	rtl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rtl.add_theme_font_size_override("normal_font_size", 16)
	rtl.text = bbcode
	rtl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return rtl

func _fabao_affix_bbcode(tier_id: String, aff: Dictionary, locked: bool = false) -> String:
	var g: = str(aff.get("group", ""))
	var cap: = FabaoBagPanel.affix_cap_text(tier_id, g)
	var cap_s: = "（上限%s%%）" % cap if cap != "-" else "（无数值上限）"
	var lock_s: = "[color=#ffb347]（已锁定）[/color]" if locked else ""
	if g == "evolve_mutate":
		return "[color=#c86cff]进化变异几率 +1%%%s[/color]" % cap_s
	if g == "armor_pierce_rate":
		return "[color=#c86cff]出战宠物破甲几率 +%d%%%s[/color]%s" % [int(aff.get("value", 0)), cap_s, lock_s]
	if g == "player_element":
		var el: = str(aff.get("element", ""))
		var hx: = FabaoBagPanel.element_color(el).to_html(false)
		return "[color=#5aa8ff]人物五行变为[/color][color=#%s]%s[/color][color=#9aa0b0]%s[/color]%s" % [hx, el, cap_s, lock_s]
	var name: = FabaoBagPanel.affix_group_name(g)
	return "[color=#f2f2f2]%s [/color][color=#5fd45f]+%d%%[/color][color=#9aa0b0]%s[/color]%s" % [name, int(aff.get("value", 0)), cap_s, lock_s]

func _fabao_lock_set_from_inst(inst: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for g in FabaoConfig.normalize_locked_groups(inst):
		out[g] = true
	return out

func _fabao_player_yuanbao() -> int:
	if game_manager and game_manager.player:
		return maxi(0, int(game_manager.player.yuanbao_currency))
	return 0

func _fabao_can_edit_affix_lock() -> bool:
	if game_manager == null or game_manager.fabao_manager == null:
		return false
	var pending: Variant = game_manager.fabao_manager.pending_reroll
	if pending is Dictionary and not (pending as Dictionary).is_empty():
		return false
	var pending_r: Variant = game_manager.fabao_manager.pending_reset
	if pending_r is Dictionary and not (pending_r as Dictionary).is_empty():
		return false
	return true

func _fabao_fill_affix_lines(host: Control, inst: Dictionary, allow_lock: bool = false, popup: Window = null) -> void :
	var tier: = str(inst.get("tier", "normal"))
	var fid: = str(inst.get("id", ""))
	var exp_v: = float(inst.get("exp_pct", 0))
	host.add_child(_fabao_make_rtl_line("[color=#ffd24d]经验提升 +%.1f%%（上限%.1f%%）[/color]" % [exp_v, exp_v]))
	var lock_set: = _fabao_lock_set_from_inst(inst)
	var show_lock: = allow_lock and _fabao_can_edit_affix_lock()
	for aff in FabaoBagPanel.sorted_affixes(inst):
		if not (aff is Dictionary):
			continue
		var ad: Dictionary = aff
		var g: = str(ad.get("group", ""))
		var locked: = bool(lock_set.get(g, false))
		if show_lock and FabaoConfig.is_lockable_affix_group(g):
			var row: = HBoxContainer.new()
			row.add_theme_constant_override("separation", 6)
			row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			row.add_child(_fabao_make_rtl_line(_fabao_affix_bbcode(tier, ad, locked)))
			var btn_txt: = "解锁" if locked else "锁定"
			var btn = _popup_fixed_btn(btn_txt, Vector2(80, 36), _apply_action_button_style)
			btn.add_theme_font_size_override("font_size", 14)
			var popup_ref = popup
			var tap_fid: = fid
			var tap_g: = g
			var tap_locked: = locked
			TouchScrollUtils.bind_tap(btn, func():
				_fabao_on_affix_lock_tap(popup_ref, tap_fid, tap_g, tap_locked)
			)
			row.add_child(btn)
			host.add_child(row)
		else:
			host.add_child(_fabao_make_rtl_line(_fabao_affix_bbcode(tier, ad, locked)))

func _fabao_clear_host_children(host: Control) -> void :
	if host == null or not is_instance_valid(host):
		return
	for c in host.get_children():
		host.remove_child(c)
		c.queue_free()

func _fabao_refresh_detail_affixes(popup: Window) -> void :
	if popup == null or not is_instance_valid(popup):
		return
	var host = popup.get_meta("fabao_affix_host", null)
	if host == null or not is_instance_valid(host):
		return
	var fid: = str(popup.get_meta("fabao_detail_id", ""))
	var loc: = str(popup.get_meta("fabao_detail_loc", ""))
	var inst: = _fabao_find_instance_by_id(fid)
	_fabao_clear_host_children(host)
	_fabao_fill_affix_lines(host, inst, loc == "bag", popup)

func _fabao_on_affix_lock_tap(popup: Window, fid: String, group: String, currently_locked: bool) -> void :
	if fid.is_empty() or group.is_empty():
		return
	if not _fabao_reroll_ui.is_empty():
		return
	if not _fabao_can_edit_affix_lock():
		_show_game_alert("请先处理上次法宝洗练结果", "法宝")
		return
	if currently_locked:
		ConfirmDialog.show(popup, "确认解锁", "解锁后该属性将重新参与洗练随机，已消耗的元宝不退还。", func():
			if popup != null and is_instance_valid(popup):
				var vbox = popup.get_meta("fabao_detail_vbox", null)
				_fabao_lock_popup_wait(popup, vbox, null, "处理中...", fid)
			FabaoApi.unlock_affix(fid, group)
		, "确认解锁")
		return
	var inst: = _fabao_find_instance_by_id(fid)
	var cost: = FabaoConfig.lock_cost_for_next(FabaoConfig.normalize_locked_groups(inst).size())
	var have: = _fabao_player_yuanbao()
	ConfirmDialog.show(popup, "确认锁定", "锁定后洗练时该属性不再随机。本次消耗 %d 元宝（当前拥有 %d），解锁不退还。" % [cost, have], func():
		if have < cost:
			_show_game_alert("元宝不足", "法宝")
			return
		if popup != null and is_instance_valid(popup):
			var vbox2 = popup.get_meta("fabao_detail_vbox", null)
			_fabao_lock_popup_wait(popup, vbox2, null, "处理中...", fid)
		FabaoApi.lock_affix(fid, group)
	, "确认锁定")

func _on_fabao_affix_lock_done(_fid: String, _locked: bool, _group: String) -> void :
	var popup = _fabao_reroll_ui.get("popup")
	_fabao_restore_reroll_wait()
	if popup is Window and is_instance_valid(popup):
		_fabao_refresh_detail_affixes(popup)

func _fabao_find_affix_by_group(affixes, group: String) -> Dictionary:
	if affixes is Array:
		for aff in affixes:
			if aff is Dictionary and str(aff.get("group", "")) == group:
				return aff
	return {}

func _fabao_reroll_delta_hex(old_v: int, new_v: int) -> String:
	if new_v > old_v:
		return "7ec8ff"
	if new_v < old_v:
		return "ff5c5c"
	return "5fd45f"

func _fabao_reroll_compare_bbcode(tier_id: String, before_aff: Dictionary, after_aff: Dictionary) -> String:
	var g: = str(before_aff.get("group", ""))
	var cap: = FabaoBagPanel.affix_cap_text(tier_id, g)
	var cap_s: = "（上限%s%%）" % cap if cap != "-" else "（无数值上限）"
	if g == "evolve_mutate":
		return "[color=#c86cff]进化变异几率 +1%%%s[/color]" % cap_s
	if g == "armor_pierce_rate":
		var old_p: = int(before_aff.get("value", 0))
		var new_p: = int(after_aff.get("value", 0))
		if old_p == new_p:
			return _fabao_affix_bbcode(tier_id, before_aff)
		return "[color=#c86cff]出战宠物破甲几率 +%d%% -> +%d%%%s[/color]" % [old_p, new_p, cap_s]
	if g == "player_element":
		var el_b: = str(before_aff.get("element", ""))
		var el_a: = str(after_aff.get("element", el_b))
		if el_a == el_b:
			return _fabao_affix_bbcode(tier_id, before_aff)
		var hx_b: = FabaoBagPanel.element_color(el_b).to_html(false)
		var hx_a: = FabaoBagPanel.element_color(el_a).to_html(false)
		return "[color=#5aa8ff]人物五行变为[/color][color=#%s]%s[/color][color=#9aa0b0] -> [/color][color=#%s]%s[/color][color=#9aa0b0]%s[/color]" % [hx_b, el_b, hx_a, el_a, cap_s]
	var name: = FabaoBagPanel.affix_group_name(g)
	var old_v: = int(before_aff.get("value", 0))
	var new_v: = int(after_aff.get("value", 0))
	if old_v == new_v:
		return _fabao_affix_bbcode(tier_id, before_aff)
	var hx: = _fabao_reroll_delta_hex(old_v, new_v)
	return "[color=#f2f2f2]%s+%d%%[/color] [color=#9aa0b0]->[/color] [color=#%s]%d%%[/color][color=#9aa0b0]%s[/color]" % [name, old_v, hx, new_v, cap_s]

func _fabao_fill_reroll_compare_lines(host: Control, pending: Dictionary) -> void :
	var tier: = str(pending.get("tier", "normal"))
	var exp_v: = float(pending.get("exp_pct", 0))
	host.add_child(_fabao_make_rtl_line("[color=#ffd24d]经验提升+%.1f%%（上限%.1f%%）[/color]" % [exp_v, exp_v]))
	var before_dummy: = {"affixes": pending.get("currentAffixes", [])}
	var after_list = pending.get("previewAffixes", [])
	var lock_set: Dictionary = {}
	var locked_raw: Variant = pending.get("lockedGroups", pending.get("locked_groups", []))
	if locked_raw is Array:
		for g0 in locked_raw:
			lock_set[str(g0)] = true
	for aff in FabaoBagPanel.sorted_affixes(before_dummy):
		if not (aff is Dictionary):
			continue
		var g: = str(aff.get("group", ""))
		var after_aff: = _fabao_find_affix_by_group(after_list, g)
		var line: = ""
		if after_aff.is_empty():
			line = _fabao_affix_bbcode(tier, aff, bool(lock_set.get(g, false)))
		else:
			line = _fabao_reroll_compare_bbcode(tier, aff, after_aff)
			if bool(lock_set.get(g, false)):
				line = "[color=#ffb347][已锁定][/color] " + line
		host.add_child(_fabao_make_rtl_line(line))

func _fabao_collect_buttons(n: Node, out: Array) -> void :
	if n is Button:
		out.append(n)
	for c in n.get_children():
		_fabao_collect_buttons(c, out)

func _fabao_clear_reroll_wait() -> void :
	_fabao_reroll_ui.clear()

func _fabao_lock_popup_wait(popup: Window, vbox: Control, primary: Button, wait_text: String, fabao_id: String = "") -> void :
	var btns: Array = []
	if vbox != null and is_instance_valid(vbox):
		_fabao_collect_buttons(vbox, btns)
	for b in btns:
		if b is Button:
			(b as Button).disabled = true
	var old_text: = ""
	if primary != null and is_instance_valid(primary):
		old_text = primary.text
		primary.text = wait_text
	var fid: = fabao_id.strip_edges()
	if fid.is_empty() and popup != null and is_instance_valid(popup) and popup.has_meta("fabao_reroll_id"):
		fid = str(popup.get_meta("fabao_reroll_id"))
	_fabao_reroll_ui = {
		"btns": btns, 
		"primary": primary, 
		"primary_text": old_text, 
		"popup": popup, 
		"vbox": vbox, 
		"fabao_id": fid, 
	}

func _fabao_restore_reroll_wait() -> void :
	if _fabao_reroll_ui.is_empty():
		return
	var primary = _fabao_reroll_ui.get("primary")
	if primary is Button and is_instance_valid(primary):
		primary.text = str(_fabao_reroll_ui.get("primary_text", primary.text))
	for b in _fabao_reroll_ui.get("btns", []):
		if b is Button and is_instance_valid(b):
			b.disabled = false
	_fabao_clear_reroll_wait()

func _fabao_find_instance_by_id(fid: String) -> Dictionary:
	if fid.is_empty() or game_manager == null or game_manager.fabao_manager == null:
		return {}
	var fm = game_manager.fabao_manager
	if fm.equipped_fabao is Dictionary and str((fm.equipped_fabao as Dictionary).get("id", "")) == fid:
		return (fm.equipped_fabao as Dictionary).duplicate(true)
	for arr in [fm.fabao_inventory, fm.fabao_warehouse]:
		if not (arr is Array):
			continue
		for inst in arr:
			if inst is Dictionary and str((inst as Dictionary).get("id", "")) == fid:
				return (inst as Dictionary).duplicate(true)
	return {}

func _fabao_reroll_stone_count() -> int:
	if game_manager == null or game_manager.inventory_manager == null:
		return 0
	if not game_manager.inventory_manager.has_method("get_item_count"):
		return 0
	return int(game_manager.inventory_manager.get_item_count(FabaoConfig.REROLL_STONE_NAME))

func _fabao_reroll_stone_remain_text() -> String:
	return "材料背包剩余洗练石：%d" % _fabao_reroll_stone_count()

func _fabao_reset_stone_count() -> int:
	if game_manager == null or game_manager.inventory_manager == null:
		return 0
	if not game_manager.inventory_manager.has_method("get_item_count"):
		return 0
	return int(game_manager.inventory_manager.get_item_count(FabaoConfig.RESET_STONE_NAME))

func _fabao_reset_stone_remain_text() -> String:
	return "材料背包剩余重置石：%d" % _fabao_reset_stone_count()

func _fabao_reroll_clear_vbox(vbox: VBoxContainer) -> void :
	for c in vbox.get_children():
		vbox.remove_child(c)
		c.queue_free()

func _fabao_fill_reroll_settled_view(popup: Window, vbox: VBoxContainer, accepted: bool, inst: Dictionary, fabao_id: String = "") -> void :
	_fabao_reroll_clear_vbox(vbox)
	var fid: = fabao_id.strip_edges()
	if fid.is_empty() and popup.has_meta("fabao_reroll_id"):
		fid = str(popup.get_meta("fabao_reroll_id"))
	if not fid.is_empty():
		popup.set_meta("fabao_reroll_id", fid)
	var title: = Label.new()
	title.text = "洗练结果"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	vbox.add_child(title)
	var hint: = Label.new()
	var result_line: = "已应用本次洗练。" if accepted else "已放弃本次洗练，词条保持原数值（洗练石已消耗）。"
	hint.text = "%s\n%s" % [result_line, _fabao_reroll_stone_remain_text()]
	hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	hint.add_theme_font_size_override("font_size", 13)
	hint.add_theme_color_override("font_color", Color(0.75, 0.76, 0.82))
	vbox.add_child(hint)
	var scroll: = ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	TouchScrollUtils.configure_scroll(scroll)
	vbox.add_child(scroll)
	var cols: = VBoxContainer.new()
	cols.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cols.add_theme_constant_override("separation", 4)
	scroll.add_child(cols)
	TouchScrollUtils.bind_content_touch_scroll(scroll, cols)
	if inst.is_empty():
		var miss: = Label.new()
		miss.text = "无法读取法宝当前属性"
		miss.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		cols.add_child(miss)
	else:
		_fabao_fill_affix_lines(cols, inst)
	var again_btn = _popup_fixed_btn("继续洗练", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	again_btn.pressed.connect( func():
		if not _fabao_reroll_ui.is_empty():
			return
		var again_id: = fid
		if again_id.is_empty() and is_instance_valid(popup) and popup.has_meta("fabao_reroll_id"):
			again_id = str(popup.get_meta("fabao_reroll_id"))
		if again_id.is_empty():
			return
		var cur: = _fabao_find_instance_by_id(again_id)
		if not FabaoConfig.has_rerollable_unlocked_affix(cur):
			_show_game_alert("请至少保留一条未锁定属性", "法宝")
			return
		_fabao_lock_popup_wait(popup, vbox, again_btn, "洗练中...", again_id)
		FabaoApi.reroll(again_id)
	)
	var close_btn = _popup_fixed_btn("关闭", POPUP_ACTION_BTN_SIZE)
	close_btn.pressed.connect( func():
		if is_instance_valid(popup):
			popup.queue_free()
	)
	vbox.add_child(_popup_btn_row([again_btn, close_btn]))

func _on_fabao_reroll_confirm_done(accepted: bool) -> void :
	var popup = _fabao_reroll_ui.get("popup")
	var vbox = _fabao_reroll_ui.get("vbox")
	var fid: = str(_fabao_reroll_ui.get("fabao_id", ""))
	_fabao_clear_reroll_wait()
	if not (popup is Window) or not is_instance_valid(popup):
		return
	if not (vbox is VBoxContainer) or not is_instance_valid(vbox):
		return
	if fid.is_empty() and popup.has_meta("fabao_reroll_id"):
		fid = str(popup.get_meta("fabao_reroll_id"))
	_fabao_fill_reroll_settled_view(popup, vbox, accepted, _fabao_find_instance_by_id(fid), fid)

func _start_fabao_synthesize_flow(tid: String, display_name: String) -> void :
	if _fabao_synth_waiting:
		return
	if game_manager == null or game_manager.fabao_manager == null:
		_show_game_alert("未登录", "合成失败")
		return
	_fabao_synth_waiting = true
	_fabao_synth_anim = _show_fabao_synth_anim_window(display_name)
	FabaoApi.synthesize(tid)

func _show_fabao_synth_anim_window(display_name: String) -> Window:
	var shell: = _open_styled_popup("fabao_synth_anim", "fabao_wait", Vector2i(400, 250))
	if shell.is_empty():
		return null
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox
	vbox.alignment = BoxContainer.ALIGNMENT_CENTER
	var anim_label: = Label.new()
	anim_label.text = "合成中..."
	anim_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	anim_label.add_theme_font_size_override("font_size", 29)
	anim_label.add_theme_color_override("font_color", Color(1, 0.84, 0))
	vbox.add_child(anim_label)
	popup.set_meta("anim_label", anim_label)
	var name_label: = Label.new()
	name_label.text = display_name
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.add_theme_font_size_override("font_size", 22)
	name_label.add_theme_color_override("font_color", Color(0.7, 0.7, 1.0))
	vbox.add_child(name_label)
	var desc_label: = Label.new()
	desc_label.text = "碎片凝聚..."
	desc_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	desc_label.add_theme_font_size_override("font_size", 20)
	desc_label.add_theme_color_override("font_color", Color(0.8, 0.8, 0.8))
	vbox.add_child(desc_label)
	popup.set_meta("desc_label", desc_label)
	popup.set_meta("synth_step", 0)
	var timer: = Timer.new()
	timer.wait_time = 0.7
	timer.autostart = true
	timer.timeout.connect( func():
		if not is_instance_valid(popup):
			return
		var step: = int(popup.get_meta("synth_step", 0)) + 1
		popup.set_meta("synth_step", step)
		var al = popup.get_meta("anim_label")
		var dl = popup.get_meta("desc_label")
		if al is Label:
			var dots: = ["·", "··", "···"]
			(al as Label).text = "合成中%s" % dots[step % 3]
		if dl is Label:
			var lines: = ["碎片凝聚...", "灵力注入胚体...", "器灵即将觉醒..."]
			(dl as Label).text = str(lines[step % lines.size()])
	)
	popup.add_child(timer)
	_finish_styled_popup(popup)
	return popup

func _fabao_close_synth_anim() -> void :
	_fabao_synth_waiting = false
	if _fabao_synth_anim != null and is_instance_valid(_fabao_synth_anim):
		_fabao_synth_anim.queue_free()
	_fabao_synth_anim = null

func _on_fabao_synthesize_done(inst: Dictionary) -> void :
	_fabao_close_synth_anim()
	if inst.is_empty():
		_show_game_alert("合成成功", "合成成功")
		return
	_show_fabao_action_popup(inst, "bag")

func _on_fabao_dismantle_done(msg: String) -> void :
	var text: = str(msg).strip_edges()
	if text.is_empty():
		text = "分解成功"
	_show_game_alert(text, "分解成功")

func _fabao_close_detail_then_confirm(popup_ref: Window, title: String, message: String, on_ok: Callable, confirm_label: String) -> void :
	if is_instance_valid(popup_ref):
		popup_ref.queue_free()
	ConfirmDialog.show(self, title, message, on_ok, confirm_label)

func _show_fabao_action_popup(inst: Dictionary, location: String = "bag") -> void :
	if inst.is_empty():
		return
	var loc: = location.strip_edges()
	if loc.is_empty():
		loc = "bag"
	var fabao_key: = str(inst.get("id", inst.get("name", "fabao")))
	var popup_key: = "fabao_action:%s:%s" % [fabao_key, loc]
	var popup_size: = Vector2i(440, 640)
	if loc == "bag":
		popup_size = Vector2i(440, 740)
	var shell: = _open_styled_popup(popup_key, INVENTORY_DETAIL_POPUP_GROUP, popup_size)
	if shell.is_empty():
		return
	var popup: Window = shell.popup
	var vbox: VBoxContainer = shell.vbox
	vbox.add_child(_build_fabao_detail_header(inst, loc))
	var sep = HSeparator.new()
	vbox.add_child(sep)
	var scroll: = ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.custom_minimum_size = Vector2(0, 180)
	TouchScrollUtils.configure_scroll(scroll)
	vbox.add_child(scroll)
	var lines: = VBoxContainer.new()
	lines.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	lines.add_theme_constant_override("separation", 4)
	scroll.add_child(lines)
	TouchScrollUtils.bind_content_touch_scroll(scroll, lines)
	var popup_ref = popup
	var fid: = str(inst.get("id", ""))
	popup.set_meta("fabao_detail_id", fid)
	popup.set_meta("fabao_detail_loc", loc)
	popup.set_meta("fabao_affix_host", lines)
	popup.set_meta("fabao_detail_vbox", vbox)
	_fabao_fill_affix_lines(lines, inst, loc == "bag", popup)
	var action_btns: Array = []
	if loc == "equipped":
		var unequip_btn = _popup_fixed_btn("卸下装备", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		unequip_btn.pressed.connect( func():
			FabaoApi.unequip()
			if is_instance_valid(popup_ref):
				popup_ref.queue_free()
		)
		action_btns.append(unequip_btn)
	elif loc == "warehouse":
		var retrieve_btn = _popup_fixed_btn("取出", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		retrieve_btn.pressed.connect( func():
			FabaoApi.retrieve_warehouse(fid)
			if is_instance_valid(popup_ref):
				popup_ref.queue_free()
		)
		action_btns.append(retrieve_btn)
		var dismantle_wh = _popup_fixed_btn("分解", POPUP_ACTION_BTN_SIZE, _apply_dismantle_button_style)
		dismantle_wh.pressed.connect( func():
			_fabao_close_detail_then_confirm(popup_ref, "确认分解", "分解后获得50个同档法宝碎片，法宝消失且不可恢复。", func():
				FabaoApi.dismantle(fid)
			, "确认分解")
		)
		action_btns.append(dismantle_wh)
	else:
		var equip_btn = _popup_fixed_btn("装备", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		equip_btn.pressed.connect( func():
			FabaoApi.equip(fid)
			if is_instance_valid(popup_ref):
				popup_ref.queue_free()
		)
		var store_btn = _popup_fixed_btn("存仓库", POPUP_ACTION_BTN_SIZE, _apply_store_button_style)
		store_btn.pressed.connect( func():
			FabaoApi.store_warehouse(fid)
			if is_instance_valid(popup_ref):
				popup_ref.queue_free()
		)
		action_btns.append(equip_btn)
		action_btns.append(store_btn)
		var reroll_btn = _popup_fixed_btn("洗练", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		reroll_btn.pressed.connect( func():
			if not _fabao_reroll_ui.is_empty():
				return
			var cur: = _fabao_find_instance_by_id(fid)
			if not FabaoConfig.has_rerollable_unlocked_affix(cur if not cur.is_empty() else inst):
				_show_game_alert("请至少保留一条未锁定属性", "法宝")
				return
			_fabao_lock_popup_wait(popup_ref, vbox, reroll_btn, "洗练中...", fid)
			FabaoApi.reroll(fid)
		)
		var reset_btn = _popup_fixed_btn("重置属性", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
		reset_btn.pressed.connect( func():
			if not _fabao_reroll_ui.is_empty():
				return
			var cur2: = _fabao_find_instance_by_id(fid)
			if not FabaoConfig.has_resettable_unlocked_affix(cur2 if not cur2.is_empty() else inst):
				_show_game_alert("没有可重置的未锁定属性", "法宝")
				return
			_fabao_lock_popup_wait(popup_ref, vbox, reset_btn, "重置中...", fid)
			FabaoApi.reset_affixes(fid)
		)
		action_btns.append(reroll_btn)
		action_btns.append(reset_btn)
		var dismantle_btn = _popup_fixed_btn("分解", POPUP_ACTION_BTN_SIZE, _apply_dismantle_button_style)
		dismantle_btn.pressed.connect( func():
			_fabao_close_detail_then_confirm(popup_ref, "确认分解", "分解后获得50个同档法宝碎片，法宝消失且不可恢复。", func():
				FabaoApi.dismantle(fid)
			, "确认分解")
		)
		action_btns.append(dismantle_btn)
	var close_btn = _popup_fixed_btn("取消", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	close_btn.pressed.connect( func():
		if is_instance_valid(popup_ref):
			popup_ref.queue_free()
	)
	action_btns.append(close_btn)
	_popup_add_btn_grid(vbox, action_btns)
	_finish_styled_popup(popup)

func _on_fabao_reroll_preview(pending: Dictionary) -> void :
	if pending.is_empty():
