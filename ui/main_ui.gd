func _ensure_city_ui_instance() -> CityUI:
	if _current_city_ui and is_instance_valid(_current_city_ui):
		var existing: = _current_city_ui as CityUI
		_connect_city_chat_cache_restore_signal(existing)
		return existing
	if city_ui_container == null or not is_instance_valid(city_ui_container):
		return null
	var city_ui_scene: PackedScene = load(CITY_UI_SCENE_PATH) as PackedScene
	if city_ui_scene == null:
		push_error("无法加载 city_ui 场景: %s" % CITY_UI_SCENE_PATH)
		return null
	var city_ui_node = city_ui_scene.instantiate()
	if city_ui_node == null:
		push_error("无法实例化 city_ui 场景")
		return null
	var city_ui: = city_ui_node as CityUI
	if city_ui == null:
		push_error("[MainUI] city_ui.tscn 根节点必须是 CityUI 脚本")
		city_ui_node.queue_free()
		return null
	city_ui.set_game_manager(game_manager)
	_connect_city_chat_cache_restore_signal(city_ui)
	if not _city_ui_closed_connected:
		city_ui.city_closed.connect(_on_city_ui_closed)
		_city_ui_closed_connected = true
	city_ui_container.add_child(city_ui)
	_current_city_ui = city_ui
	return city_ui

func _connect_city_chat_cache_restore_signal(city_ui: CityUI) -> void :
	if city_ui == null:
		return
	if not city_ui.chat_channel_cache_restore_requested.is_connected(_on_city_chat_cache_restore_requested):
		city_ui.chat_channel_cache_restore_requested.connect(_on_city_chat_cache_restore_requested)
	if not city_ui.chat_channel_history_fetched.is_connected(_on_city_chat_history_fetched):
		city_ui.chat_channel_history_fetched.connect(_on_city_chat_history_fetched)

func merge_chat_history_into_cache(messages: Array) -> void :
	for msg in messages:
		if msg is Dictionary:
			_append_to_chat_cache(msg as Dictionary)

func refresh_city_chat_display_from_cache() -> void :
	if _current_city_ui and is_instance_valid(_current_city_ui):
		_current_city_ui.sync_cached_messages(_get_city_chat_cache_for_ui(_current_city_ui))

func _on_city_chat_cache_restore_requested(channel: String, _gang_id: int) -> void :
	refresh_city_chat_display_from_cache()
	if channel == "world":
		_start_city_feed_refresh_async(true)

func _on_city_chat_history_fetched(channel: String, gang_id: int, messages: Array) -> void :
	merge_chat_history_into_cache(messages)
	if not _current_city_ui or not is_instance_valid(_current_city_ui):
		return
	if String(_current_city_ui.get_active_chat_channel()) != channel:
		return
	if channel == "gang" and int(_current_city_ui.get_active_chat_gang_id()) != gang_id:
		return
	refresh_city_chat_display_from_cache()

func _show_city_view(skip_reset: bool = false) -> void :
	if game_manager == null:
		push_error("[MainUI] GameManager 未初始化，无法显示主城")
		return
	game_manager.block_battle_start_temporarily(game_manager.BATTLE_START_BLOCK_CITY_SWITCH_MS, "show_city_view_begin")
	if city_ui_container == null or not is_instance_valid(city_ui_container):
		push_error("CityView 节点不存在，无法显示主城界面")
		return
	var city_ui: = _ensure_city_ui_instance()
	if city_ui == null:
		return
	if not skip_reset:
		city_ui.reset_for_show()
	city_ui.sync_cached_messages(_get_city_chat_cache_for_ui(city_ui))
	game_manager.block_battle_start_temporarily(game_manager.BATTLE_START_BLOCK_CITY_SWITCH_MS, "show_city_view_ready")
	_start_city_feed_refresh_async()

func _start_city_feed_refresh_async(force: bool = false) -> void :
	if _city_feed_refresh_running:
		if _current_city_ui and is_instance_valid(_current_city_ui):
			_current_city_ui.sync_cached_messages(_get_city_chat_cache_for_ui(_current_city_ui))
		return
	var now_ms: = Time.get_ticks_msec()
	if not force and now_ms - _city_feed_last_refresh_ms < CITY_FEED_REFRESH_COOLDOWN_MS:
		if _current_city_ui and is_instance_valid(_current_city_ui):
			_current_city_ui.sync_cached_messages(_get_city_chat_cache_for_ui(_current_city_ui))
		return
	_city_feed_refresh_running = true
	_refresh_city_feed_async()

func _refresh_city_feed_async() -> void :
	var fetch_state: = {
		"chat": [], 
		"broadcast": [], 
		"chat_done": false, 
		"broadcast_done": false, 
	}
	_fetch_city_chat_history_worker(fetch_state)
	_fetch_city_broadcast_history_worker(fetch_state)
	while not fetch_state.chat_done or not fetch_state.broadcast_done:
		await get_tree().process_frame
	_city_feed_last_refresh_ms = Time.get_ticks_msec()
	_merge_recent_world_feed_to_cache(fetch_state.chat, fetch_state.broadcast, 30)

	_apply_broadcast_history_watermark(fetch_state.broadcast)
	if _current_city_ui and is_instance_valid(_current_city_ui):
		var on_world: = String(_current_city_ui.get_active_chat_channel()) == "world"
		if on_world and _current_city_ui.has_method("clear_world_feed_display"):
			_current_city_ui.clear_world_feed_display()
		_current_city_ui.sync_cached_messages(_get_city_chat_cache_for_ui(_current_city_ui))
	if game_manager and game_manager.chat_network:
		game_manager.chat_network.poll_messages_now()
	_city_feed_refresh_running = false

func _apply_broadcast_history_watermark(broadcast_rows: Array) -> void :
	if broadcast_rows.is_empty() or game_manager == null:
		return
	if not game_manager.has_method("note_broadcast_history_watermark"):
		return
	var max_id: = 0
	var seen_ids: Array = []
	for b in broadcast_rows:
		if not b is Dictionary:
			continue
		var bid: = int((b as Dictionary).get("id", 0))
		if bid <= 0:
			continue
		seen_ids.append(bid)
		if bid > max_id:
			max_id = bid
	if max_id <= 0:
		return
	game_manager.note_broadcast_history_watermark(max_id, seen_ids)

func _fetch_city_chat_history_worker(fetch_state: Dictionary) -> void :
	var chat_hist: Array = []
	if game_manager and game_manager.chat_network:
		chat_hist = await game_manager.chat_network.fetch_world_chat_history(50)
	fetch_state.chat = chat_hist
	fetch_state.chat_done = true

func _fetch_city_broadcast_history_worker(fetch_state: Dictionary) -> void :
	var broadcast_hist: Array = []
	if game_manager and game_manager.network and game_manager.network.is_logged_in():
		for attempt in range(3):
			broadcast_hist = await game_manager.network.fetch_xianmo_broadcast_history_snapshot(0, CITY_FEED_BROADCAST_HISTORY_MAX)
			if not broadcast_hist.is_empty():
				break
			if attempt < 2:
				await get_tree().create_timer(0.2).timeout
	fetch_state.broadcast = broadcast_hist
	fetch_state.broadcast_done = true

