const BATTLE_LUNGE_RETURN_SECONDS: = 0.2
# 顶在怪身上的定格：只留 40 毫秒，够受击反馈被看见，又不至于像卡住。
const BATTLE_LUNGE_HOLD_SECONDS: = 0.04
