func _player_attr_save_auto_plan_async(enabled: bool, plan: Dictionary, dialog: Window) -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.network == null:
		_add_log("[color=red]网络未连接，无法保存方案[/color]")
		return
	_player_attr_rpc_busy = true
	var res: Dictionary = await _await_player_attr_save_auto_plan(enabled, plan)
	_player_attr_rpc_busy = false
	if not bool(res.get("ok", false)):
		_add_log("[color=red]%s[/color]" % str(res.get("error", "方案保存失败")))
		return
	_apply_local_auto_allocation_settings(enabled, plan)
	_apply_player_attr_authoritative_save(res.get("data", {}))
	if game_manager:
		game_manager.save_game(false)
	_add_log("[color=green]加点方案已保存！%s[/color]" % ("已启用" if enabled else "已禁用"))
	if is_instance_valid(dialog):
		dialog.queue_free()
	_attr_panel_refresh_pending = false
	_attr_panel_refresh_reschedule = false
	call_deferred("_refresh_character_attr_panel", false)

