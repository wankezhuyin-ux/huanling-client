func _ink_s() -> float:
	return max(0.35, get_viewport_rect().size.x / 1024.0)


## 底部安全区高度（Godot 逻辑像素）。iOS「添加到主屏幕」约 34pt，安卓 / 桌面 0。
## 页面脚本还没跑完时读不到，返回 0 且不写缓存，下次重排再试。
func _ink_safe_bottom_px() -> float:
	if _ink_safe_px >= 0.0:
		return _ink_safe_px
	if not OS.has_feature("web"):
		_ink_safe_px = 0.0
		return 0.0
	var res: Variant = JavaScriptBridge.eval(
		"(function(){try{var s=window.__hlSafe;return s?(s.bottom+'|'+s.cssW):'';}catch(e){return '';}})()"
	)
	if res == null:
		return 0.0
	var raw: String = str(res)
	if raw.is_empty():
		return 0.0
	var parts: PackedStringArray = raw.split("|")
	if parts.size() != 2:
		return 0.0
	var css_bottom: float = float(parts[0])
	var css_w: float = float(parts[1])
	if css_w <= 0.0 or css_bottom < 0.0:
		return 0.0
	var vw: float = get_viewport_rect().size.x
	_ink_safe_px = css_bottom * (vw / css_w) if vw > 0.0 else 0.0
	return _ink_safe_px


## 底栏为安全区整体上移后，底下露出来的一条用 dock_bar.png 最底部像素的同色
## 半透明块补上：视觉上还是同一条底栏，home 条压在这条色带上，不压五个按钮。
func _ink_update_safe_fill(safe: float, screen: Vector2) -> void:
	Engine.set_meta("hl_safe_bottom", safe)
	if safe <= 0.5:
		if is_instance_valid(_ink_safe_fill):
			_ink_safe_fill.visible = false
		return
	if not is_instance_valid(_ink_safe_fill):
		_ink_safe_fill = ColorRect.new()
		_ink_safe_fill.name = "InkSafeFill"
		_ink_safe_fill.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_ink_safe_fill.color = Color(8.0 / 255.0, 13.0 / 255.0, 17.0 / 255.0, 207.0 / 255.0)
		add_child(_ink_safe_fill)
	_ink_safe_fill.visible = true
	_ink_safe_fill.position = Vector2(0.0, screen.y - safe)
	_ink_safe_fill.size = Vector2(screen.x, safe)
	_ink_safe_fill.move_to_front()


func _ink_font(design_px: float) -> int:
	return int(round(design_px * _ink_s()))


func _apply_ink_chrome() -> void:
	if not INK_CHROME:
		return
	_apply_ink_topbar()
	_apply_ink_dock()
	_apply_ink_page_shell()
	print("[INK] chrome applied  s=%.3f" % _ink_s())


## 内页底板 + 内容面板的统一表皮。
## 底板插在 MainContent 之下：主城视图时 CityView 铺满把它盖住，
## 切到宠物/背包/角色/战斗时把 MainContent 的背景让出来，它就露出来当"底"。
func _apply_ink_page_shell() -> void:
	var mc := get_node_or_null("MainContent")
	if mc != null and _main_content_sb == null:
		_main_content_sb = (mc as Panel).get_theme_stylebox("panel")
	if _page_backdrop == null or not is_instance_valid(_page_backdrop):
		_page_backdrop = InkPageBackdrop.new()
		_page_backdrop.name = "InkPageBackdrop"
		add_child(_page_backdrop)
		# ⚠️ 只在创建时排一次序。move_child 的目标索引是"移除之后"的位置，
		# 如果每次 chrome（转屏/重建）都再调一次，底板会从 MainContent 之前
		# 挪到之后，把整个内页盖住（表现为角色/战斗页一片空白）。
		if mc != null:
			move_child(_page_backdrop, mc.get_index())
	_apply_ink_page_panels()
	_ink_style_page_tabs()
	_ink_style_battle_buttons()
	_ink_style_battle_top()
	_ink_page_shell_ready = true
	var cur := _current_view_name()
	if cur != "city":
		_page_backdrop.open_for(cur, true)


## 战斗页底部四键：原来是一整条蓝色渐变底图，和墨底金线完全不搭。
## 停止战斗是危险操作 → 朱砂；其余描金。
func _ink_style_battle_buttons() -> void:
	var spec := {
		"BattlePanel/LogBtn": Color(0.788, 0.635, 0.294),
		"BattlePanel/StopBattleBtn": Color(0.72, 0.34, 0.26),
		"BattlePanel/DisableBattleAnimBtn": Color(0.788, 0.635, 0.294),
	}
	var panel := get_node_or_null("MainContent/BattleView/BattlePanel")
	if panel == null:
		return
	for key in spec.keys():
		var b := panel.get_node_or_null(String(key).split("/")[1])
		if b is Button:
			(b as Button).icon = null
			var accent: Color = spec[key]
			_ink_outline_button(b as Button, _ink_font(21.0), accent)
			# 战斗页底色是实时战场截图，0.09 的透明底压不住，文字会糊在石阶上。
			# 这里单独给一层不透明墨底。
			for st_name in ["normal", "hover", "pressed", "disabled"]:
				var base := (b as Button).get_theme_stylebox(st_name)
				if base is StyleBoxFlat:
					var cp: StyleBoxFlat = (base as StyleBoxFlat).duplicate()
					cp.bg_color = Color(0.031, 0.038, 0.041, 0.80)
					(b as Button).add_theme_stylebox_override(st_name, cp)


## 战斗页上半部（角色卡 / 灵兽卡 / 地图信息 / 切换地图 / 日志底）。
## 参考稿这四块是深灰圆角胶囊 + 橙红渐变按钮，放在水墨战场上面像贴纸；
## 这里把它们换成半透墨底 + 1 设计像素金线，按钮走统一墨金语言。
func _ink_style_battle_top() -> void:
	var s: = _ink_s()
	var w: = maxi(1, int(round(1.0 * s)))
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.035, 0.043, 0.045, 0.66)
	sb.border_color = Color(INK_GOLD.r, INK_GOLD.g, INK_GOLD.b, 0.46)
	sb.set_border_width_all(w)
	sb.set_corner_radius_all(0)
	sb.content_margin_left = 10.0 * s
	sb.content_margin_right = 10.0 * s
	sb.content_margin_top = 6.0 * s
	sb.content_margin_bottom = 6.0 * s
	var panel_paths := [
		"MainContent/BattleView/PlayerPanel",
		"MainContent/BattleView/TopPanels/PetPanel",
		"MainContent/BattleView/TopPanels/MapInfoPanel",
		"MainContent/BattleView/TopPanels/MapBtnPanel",
	]
	for p in panel_paths:
		var pn := get_node_or_null(p)
		if pn is Panel:
			(pn as Panel).add_theme_stylebox_override("panel", sb)
			_ink_restyle_buttons_under(pn, sb)


func _ink_restyle_buttons_under(root: Node, panel_sb: StyleBox) -> void:
	for child in root.get_children():
		if child is Button:
			var b: Button = child
			if b.name == "MapBtn":
				_apply_action_button_style(b)
			else:
				_apply_light_blue_button_style(b)
		elif child.get_child_count() > 0:
			_ink_restyle_buttons_under(child, panel_sb)


## 页签均分：HBox 里每个页签等宽，视觉上才是设计稿那种"五格平分"。
func _ink_style_page_tabs() -> void:
	for p in ["MainContent/PetView/SubButtons", "MainContent/BagView/SubButtons",
			"MainContent/CharacterView/SubButtons"]:
		var box := get_node_or_null(p)
		if box is BoxContainer:
			(box as BoxContainer).alignment = BoxContainer.ALIGNMENT_CENTER
			(box as BoxContainer).add_theme_constant_override("separation", int(round(6.0 * _ink_s())))
			for child in box.get_children():
				if child is Button:
					(child as Button).size_flags_horizontal = Control.SIZE_EXPAND_FILL


## 内页面板：半透墨底 + 1 设计像素金线。参考稿是 0.76 不透明的墨绿底，
## 会把底板整个闷住，所以这里统一换掉。
func _apply_ink_page_panels() -> void:
	var w := maxi(1, int(round(1.0 * _ink_s())))
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.035, 0.043, 0.045, 0.26)
	sb.border_color = Color(0.788, 0.635, 0.294, 0.52)
	sb.set_border_width_all(w)
	sb.set_corner_radius_all(0)
	for p in ["MainContent/PetView/ContentArea", "MainContent/BagView/ContentArea",
			"MainContent/CharacterView/ContentArea"]:
		var n := get_node_or_null(p)
		if n is Panel:
			# 顶边交给光带，不要两条线叠在一起：面板框只留左右下三边
			var frame: StyleBoxFlat = sb.duplicate()
			frame.border_width_top = 0
			(n as Panel).add_theme_stylebox_override("panel", frame)
			# 顶沿交给光带，内线也不画顶边，否则"光带 + 实线"叠成一条粗硬直线
			_ink_add_inner_line(n as Panel, 6.0, 0.26, true)
			_ink_add_top_glow(n as Panel)


## 给面板补上"第二根金线"（设计稿的框是双层）。
## 幂等：同一个面板重复调用不会叠加；z_index 抬高到面板内容之上但鼠标穿透。
func _ink_add_inner_line(host: Control, inset_px: float = 6.0, alpha: float = 0.26, skip_top: bool = false) -> void:
	if host == null:
		return
	var existing: = host.get_node_or_null("InkInnerLine")
	if existing != null:
		return
	var s: = _ink_s()
	var line: = InkInnerLine.new()
	line.name = "InkInnerLine"
	line.inset = maxf(2.0, inset_px * s)
	line.line_width = maxf(1.0, 1.0 * s)
	line.line_color = Color(0.788, 0.635, 0.294, alpha)
	line.skip_top = skip_top
	line.z_index = 5
	host.add_child(line)
	line.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)


## 面板顶沿那条横线（设计稿里贯穿所有页签的那条）：
## 逐像素量过设计稿 —— 整条线上除了选中页签那一段，其余都是**同一个暗金色**
## (105,87,47)，等宽、贯全宽、不起伏。亮的那一段只属于当前页签，
## 由 _ink_glow_underline_texture() 单独叠在页签底下。
## 所以这里只铺一条低调的细线 + 极轻的上下晕，不再做"中间亮两端淡出"。
static var _ink_glow_rule_tex: Texture2D = null

func _ink_glow_rule_texture() -> Texture2D:
	if _ink_glow_rule_tex != null:
		return _ink_glow_rule_tex
	var w: int = 8
	var h: int = 34
	var img: Image = Image.create(w, h, false, Image.FORMAT_RGBA8)
	var core_row: float = 9.0
	var base := Color(0.412, 0.341, 0.184)   # 设计稿实测的暗金
	for _x in w:
		for y in h:
			var d: float = absf(float(y) - core_row)
			var a: float = 0.0
			if d < 0.5:
				a = 1.0
			elif d < 1.5:
				a = 0.38
			elif d < 2.5:
				a = 0.14
			img.set_pixel(_x, y, Color(base.r, base.g, base.b, a))
	_ink_glow_rule_tex = ImageTexture.create_from_image(img)
	return _ink_glow_rule_tex


## 选中页签底下那一段亮光：设计稿里它才是整条线上唯一的"亮"，
## 横向只覆盖当前页签（两端 16% 收细淡出），纵向亮芯压在页签底沿、光只往上散。
## 贴图宽度会被拉伸到页签宽度，所以横向渐变按比例给。
static var _ink_glow_under_tex: Texture2D = null

func _ink_glow_underline_texture() -> Texture2D:
	if _ink_glow_under_tex != null:
		return _ink_glow_under_tex
	var w: int = 128
	var h: int = 24
	var img: Image = Image.create(w, h, false, Image.FORMAT_RGBA8)
	var core_row: float = float(h - 3)
	for x in w:
		var t: float = float(x) / float(w - 1)
		# 横向：中间满亮，两端各 9% smoothstep 收口 —— 效果图的亮线几乎直通，
		# 只在端头柔化，淡出区太长会显得"没点亮"。
		var edge: float = clampf(minf(t, 1.0 - t) / 0.09, 0.0, 1.0)
		var hf: float = edge * edge * (3.0 - 2.0 * edge)
		for y in h:
			var d: float = core_row - float(y)
			var a: float = 0.0
			if d >= 0.0:
				# 亮芯 4 行满亮（视觉上约 2~3px，压得住底下那条暗金线）+ 向上 10 行柔光
				a = maxf(1.0 * clampf(1.0 - d / 3.4, 0.0, 1.0),
						0.34 * clampf(1.0 - d / 10.0, 0.0, 1.0))
			else:
				a = 0.9 * clampf(1.0 + d / 2.2, 0.0, 1.0)
			img.set_pixel(x, y, Color(1.0, 0.90, 0.64, a * hf))
	_ink_glow_under_tex = ImageTexture.create_from_image(img)
	return _ink_glow_under_tex


## 给面板顶沿加一条金色光带（幂等）。inset 是两端内缩，让线不顶到框角。
func _ink_add_top_glow(host: Control, inset_px: float = 4.0, height_px: float = 34.0) -> void:
	if host == null:
		return
	if host.get_node_or_null("InkGlowRule") != null:
		return
	var s: = _ink_s()
	var rule: = TextureRect.new()
	rule.name = "InkGlowRule"
	rule.texture = _ink_glow_rule_texture()
	rule.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	rule.stretch_mode = TextureRect.STRETCH_SCALE
	rule.mouse_filter = Control.MOUSE_FILTER_IGNORE
	rule.z_index = 6
	host.add_child(rule)
	rule.set_anchors_and_offsets_preset(Control.PRESET_TOP_WIDE)
	rule.offset_left = inset_px * s
	rule.offset_right = -inset_px * s
	rule.offset_top = -9.0 * s
	rule.offset_bottom = (height_px - 9.0) * s


func _apply_ink_topbar() -> void:
	if top_bar == null or not is_instance_valid(top_bar):
		return
	var s: = _ink_s()
	var vp: = get_viewport_rect().size
	# ① 顶栏本身透明，只负责排字
	top_bar.position = Vector2(0, 0)
	top_bar.size = Vector2(vp.x, 84.0 * s)
	top_bar.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	# ② 背后那条压暗渐隐（150 设计像素，和设计稿同一条曲线）
	if _ink_top_fade == null or not is_instance_valid(_ink_top_fade):
		_ink_top_fade = TextureRect.new()
		_ink_top_fade.name = "InkTopFade"
		_ink_top_fade.texture = load("res://assets/city_ink/topbar_fade.png") as Texture2D
		_ink_top_fade.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		_ink_top_fade.stretch_mode = TextureRect.STRETCH_SCALE
		_ink_top_fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_ink_top_fade.z_index = 9
		add_child(_ink_top_fade)
	if _ink_top_fade:
		_ink_top_fade.position = Vector2.ZERO
		_ink_top_fade.size = Vector2(vp.x, 150.0 * s)
		_ink_top_fade.visible = top_bar.visible

	var hbox: = top_bar.get_node_or_null("HBoxContainer")
	if hbox == null:
		return
	hbox.offset_left = 18.0 * s
	hbox.offset_right = -18.0 * s
	hbox.offset_top = 0.0
	hbox.offset_bottom = 0.0
	hbox.add_theme_constant_override("separation", int(round(4.0 * s)))

	# 交流群（白）+ 群号（金）：两段不同颜色，拆成两个 Label
	var qq: = hbox.get_node_or_null("QQGroupLabel")
	if qq is Label:
		var raw: String = (qq as Label).text
		var cut: = raw.find(" ")
		var head: = raw if cut < 0 else raw.substr(0, cut)
		var tail: = "" if cut < 0 else raw.substr(cut + 1).strip_edges()
		(qq as Label).text = head
		_ink_tint_label(qq as Label, 21.0, Color(0.66, 0.64, 0.58), 1.2)
		var num: = hbox.get_node_or_null("QQNumLabel") as Label
		if num == null:
			num = Label.new()
			num.name = "QQNumLabel"
			hbox.add_child(num)
			hbox.move_child(num, qq.get_index() + 1)
		num.text = tail
		_ink_tint_label(num, 27.0, INK_GOLD_HI, 1.2)
		num.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		num.size_flags_vertical = Control.SIZE_SHRINK_CENTER

	var gold: = hbox.get_node_or_null("GoldLabel")
	if gold is Label:
		# 顶栏布局「交流群 | 金币 | 元宝」：货币挨着排在左边，
		# 空档留在「同步」之前，所以这里不能再用 EXPAND_FILL 把元宝顶到最右。
		(gold as Label).size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		_ink_tint_label(gold as Label, 27.0, INK_GOLD_HI, 1.2)
	var yuanbao: = hbox.get_node_or_null("YuanbaoLabel")
	if yuanbao is Label:
		(yuanbao as Label).size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		_ink_tint_label(yuanbao as Label, 27.0, INK_CYAN, 1.2)
	if sync_status_label and is_instance_valid(sync_status_label):
		var spacer: = hbox.get_node_or_null("InkTopSpacer") as Control
		if spacer == null:
			spacer = Control.new()
			spacer.name = "InkTopSpacer"
			spacer.mouse_filter = Control.MOUSE_FILTER_IGNORE
			hbox.add_child(spacer)
			hbox.move_child(spacer, sync_status_label.get_index())
		spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	for icon_name in ["GoldIcon", "YuanbaoIcon"]:
		var ic: = hbox.get_node_or_null(icon_name)
		if ic is TextureRect:
			(ic as TextureRect).custom_minimum_size = Vector2(30.0 * s, 30.0 * s)

	# 同步状态：设计稿是一枚金色细边的墨底小牌
	if sync_status_label and is_instance_valid(sync_status_label):
		var pill: = StyleBoxFlat.new()
		pill.bg_color = Color(0.052, 0.044, 0.032, 0.59)
		pill.border_color = Color(0.788, 0.635, 0.294, 0.34)
		pill.set_border_width_all(1)
		pill.set_corner_radius_all(int(round(15.0 * s)))
		pill.content_margin_left = 9.0 * s
		pill.content_margin_right = 9.0 * s
		pill.content_margin_top = 2.0 * s
		pill.content_margin_bottom = 2.0 * s
		sync_status_label.add_theme_stylebox_override("normal", pill)
		_ink_tint_label(sync_status_label, 20.0, INK_WHITE, 1.0)


func _ink_tint_label(l: Label, design_px: float, col: Color, shadow: float) -> void:
	l.add_theme_font_size_override("font_size", _ink_font(design_px))
	l.add_theme_color_override("font_color", col)
	l.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.72))
	l.add_theme_constant_override("shadow_offset_x", int(max(1.0, round(shadow * _ink_s()))))
	l.add_theme_constant_override("shadow_offset_y", int(max(1.0, round(shadow * _ink_s()))))


const INK_NAV_ITEMS := [
	["BattleContainer", "secret", "battle"],
	["CharacterContainer", "hero", "character"],
	["CityContainer", "sect", "city"],
	["PetContainer", "pet", "pet"],
	["BagContainer", "bag", "bag"],
]


func _apply_ink_dock() -> void:
	if bottom_nav == null or not is_instance_valid(bottom_nav):
		return
	var s: = _ink_s()
	# ① 底栏底板：整条渐变 + 双金线（代替原来的深色 StyleBoxFlat）
	var sb: = StyleBoxTexture.new()
	sb.texture = load("res://assets/city_ink/dock_bar.png") as Texture2D
	bottom_nav.add_theme_stylebox_override("panel", sb)

	var hb: = bottom_nav.get_node_or_null("MainButtons")
	if hb:
		(hb as Control).offset_left = 0.0
		(hb as Control).offset_right = 0.0
		(hb as Control).offset_top = 12.0 * s
		(hb as Control).offset_bottom = -8.0 * s
		(hb as Control).add_theme_constant_override("separation", 0)

	if not _ink_nav_done:
		_ink_nav_done = true
		for item in INK_NAV_ITEMS:
			var cont: = bottom_nav.get_node_or_null("MainButtons/" + String(item[0]))
			if cont == null:
				continue
			var btn: = cont.get_node_or_null(String(item[0]).replace("Container", "Btn")) as Button
			var lab: = cont.get_node_or_null(String(item[0]).replace("Container", "Label")) as Label
			if btn == null:
				continue
			var tex: = load("res://assets/city_ink/nav_%s.png" % String(item[1])) as Texture2D
			btn.text = ""
			btn.icon = tex
			btn.expand_icon = true
			btn.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
			btn.focus_mode = Control.FOCUS_NONE
			btn.clip_text = false
			btn.custom_minimum_size = Vector2.ZERO
			for st in ["normal", "hover", "pressed", "focus", "disabled"]:
				btn.add_theme_stylebox_override(st, StyleBoxEmpty.new())
			# 从 HBox 里挪出来按设计坐标绝对摆放：HBox 会把 5 格均分整条宽，
			# 徽章会被拉得比设计稿大，最右那枚还会顶出屏幕。
			cont.reparent(bottom_nav)
			(cont as Control).set_anchors_preset(Control.PRESET_TOP_LEFT)
			(cont as Control).custom_minimum_size = Vector2.ZERO
			# 选中态底光（插在按钮背后）
			var glow: = TextureRect.new()
			glow.name = "InkGlow"
			glow.texture = load("res://assets/city_ink/dock_glow.png") as Texture2D
			glow.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			glow.stretch_mode = TextureRect.STRETCH_SCALE
			glow.mouse_filter = Control.MOUSE_FILTER_IGNORE
			glow.show_behind_parent = true
			glow.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
			glow.offset_left = -18.0 * s
			glow.offset_top = -16.0 * s
			glow.offset_right = 18.0 * s
			glow.offset_bottom = 12.0 * s
			btn.add_child(glow)
			if lab:
				# 21 → 27：21 设计 px 在 1080 宽手机上只有约 22 物理像素，字太小看不清
				# 27 → 34：真机上宋体的衬线在 19px 下糊成一团、看着像黑体，
				#   放大到 34 设计 px（1080 手机上约 35 物理像素）衬线才立得住。
				# 字体显式指定包里的粗宋：全局主题给的是 Regular（ink_serif.otf），
				#   底栏压在深墨底上，Regular 太细、观感像系统黑体。
				lab.add_theme_font_size_override("font_size", _ink_font(36.0))
				if _ink_bold_font == null:
					_ink_bold_font = load("res://assets/fonts/ink_serif_bold.otf") as Font
				if _ink_bold_font != null:
					lab.add_theme_font_override("font", _ink_bold_font)
				lab.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.88))
				lab.add_theme_constant_override("shadow_offset_x", maxi(1, int(round(1.5 * s))))
				lab.add_theme_constant_override("shadow_offset_y", maxi(1, int(round(1.5 * s))))
				# 负间距：Label 自身行高上下各有一段留白，靠 separation 把这层空白吃掉，
				# 让字顶真正贴住徽章下沿（只压字内留白，不压字形）。
				(cont as Control).add_theme_constant_override("separation", int(round(-9.0 * s)))
			_ink_nav.append({"btn": btn, "label": lab, "glow": glow, "cont": cont,
					"key": String(item[2]), "active": false})

	# 每帧尺寸都可能变（横竖屏 / 分屏），位置每次都重算。
	# 5 格 = 164 宽 + 36 间距（164+36=200 步进），整排居中：
	# 1024 设计宽下 5×164+4×36=964，左右各留 30。
	# 142/26 那版在手机上徽章偏小、间距偏挤，且左右各空 105 太浪费，这次把留白吃进来放大徽章。
	var i: = 0
	for it in _ink_nav:
		var cont: Control = it["cont"]
		if is_instance_valid(cont):
			cont.position = Vector2((30.0 + i * 200.0) * s, 14.0 * s)
			cont.size = Vector2(164.0 * s, 196.0 * s)
		i += 1
	_ink_nav_select(_current_view_name())


func _current_view_name() -> String:
	for v in ["battle", "character", "city", "pet", "bag"]:
		var n: = get_node_or_null("MainContent/" + v.capitalize() + "View")
		if n is CanvasItem and (n as CanvasItem).visible:
			return v
	return "city"


## 选中态：徽章提亮 + 金色底光 + 金字（设计稿里「主城」是选中态）
func _ink_nav_select(view: String) -> void:
	for it in _ink_nav:
		var on: bool = String(it["key"]) == view
		var btn: Button = it["btn"]
		var lab: Label = it["label"]
		var glow: TextureRect = it["glow"]
		if not is_instance_valid(btn):
			continue
		btn.modulate = Color(1.06, 1.03, 0.97) if on else Color(0.80, 0.80, 0.84)
		if is_instance_valid(glow):
			glow.modulate = Color(1, 1, 1, 1.0) if on else Color(1, 1, 1, 0.0)
		if lab:
			lab.add_theme_color_override("font_color",
					INK_GOLD_HI if on else INK_PAPER)
		it["active"] = on

