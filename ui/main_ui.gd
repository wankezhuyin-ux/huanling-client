func _sync_pet_assist_swap(slot_index: int, store_pet) -> void :
	if not game_manager or not game_manager.pet_manager:
		_show_simple_dialog("操作失败", "宠物管理器未初始化")
		return
	if not game_manager.network or not game_manager.network.is_logged_in():
		_show_simple_dialog("操作失败", "需要联网后才能换宠")
		return
	var pm = game_manager.pet_manager
	if pm.pets.size() >= pm.max_pets:
		_show_simple_dialog("无法换宠", "宠物列表已满，请先腾出一个位置再换宠")
		return
	var live_pet = _resolve_live_pet(store_pet)
	if live_pet == null:
		_show_simple_dialog("操作失败", "宠物已不存在，请刷新后重试")
		return

	game_manager.begin_pet_bag_op_cloud_sync()
	var unequip_state: Dictionary = await _await_pet_assist_server_op("unequip", slot_index)
	if not bool(unequip_state.get("ok", false)):
		game_manager.end_pet_bag_op_cloud_sync()
		_show_simple_dialog("换宠失败", str(unequip_state.get("message", "下阵失败")))
		_refresh_pet_assist_after_op()
		return
	var equip_state: Dictionary = await _await_pet_assist_server_op("equip", slot_index, str(live_pet.id))
	game_manager.end_pet_bag_op_cloud_sync()
	if not bool(equip_state.get("ok", false)):
		_show_simple_dialog("换宠失败", str(equip_state.get("message", "放入失败，原宠已下阵")))
		_refresh_pet_assist_after_op()
		return
	_refresh_pet_assist_after_op()

func _show_assist_bonus_overview_dialog() -> void :
	if not game_manager or not game_manager.pet_manager:
		return
	var pm = game_manager.pet_manager
	pm._ensure_assist_pets_size()
	var total_atk: = float(pm.get_assist_flat_bonus_for_active("attack"))
	var total_def: = float(pm.get_assist_flat_bonus_for_active("defense"))
	var total_agi: = float(pm.get_assist_flat_bonus_for_active("agility"))
	var total_hp: = float(pm.get_assist_flat_bonus_for_active("hp"))
	var occupied: = 0
	for i in range(PetAssistBonus.MAX_SLOTS):
		if pm.get_assist_pet_at(i) != null:
			occupied += 1
	var body: = "已放入 %d 个助战槽\n\n攻击 +%.1f\n防御 +%.1f\n敏捷 +%.1f\n生命 +%.1f" % [
		occupied, total_atk, total_def, total_agi, total_hp
	]
	_show_simple_dialog("助战总加成", body)

func _refresh_pet_assist_after_op() -> void :
	_refresh_pet_assist_view()
	_refresh_pet_list_view()
	if pet_bag_scroll != null and pet_bag_scroll.visible:
		_refresh_pet_bag_view()
	_update_pet_ui()
	if game_manager != null and game_manager.pet_manager != null:
		var active_pet = game_manager.pet_manager.get_active_pet()
		if active_pet != null:
			_refresh_open_pet_detail_for_pet(str(active_pet.id))

