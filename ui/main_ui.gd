func _fabao_fill_reset_settled_view(popup: Window, vbox: VBoxContainer, accepted: bool, inst: Dictionary, fabao_id: String = "") -> void :
	_fabao_reroll_clear_vbox(vbox)
	var fid: = fabao_id.strip_edges()
	if fid.is_empty() and popup.has_meta("fabao_reroll_id"):
		fid = str(popup.get_meta("fabao_reroll_id"))
	if not fid.is_empty():
		popup.set_meta("fabao_reroll_id", fid)
	popup.set_meta("fabao_flow", "reset")
	var title: = Label.new()
	title.text = "重置结果"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", Color(1, 0.84, 0))
	vbox.add_child(title)
	var hint: = Label.new()
	var result_line: = "已应用本次重置。" if accepted else "已放弃本次重置，词条保持原样（重置石已消耗）。"
	hint.text = "%s\n%s" % [result_line, _fabao_reset_stone_remain_text()]
	hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	hint.add_theme_font_size_override("font_size", 13)
	hint.add_theme_color_override("font_color", Color(0.75, 0.76, 0.82))
	vbox.add_child(hint)
	var scroll: = ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	TouchScrollUtils.configure_scroll(scroll)
	vbox.add_child(scroll)
	var cols: = VBoxContainer.new()
	cols.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cols.add_theme_constant_override("separation", 4)
	scroll.add_child(cols)
	TouchScrollUtils.bind_content_touch_scroll(scroll, cols)
	if inst.is_empty():
		var miss: = Label.new()
		miss.text = "无法读取法宝当前属性"
		miss.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		cols.add_child(miss)
	else:
		_fabao_fill_affix_lines(cols, inst)
	var again_btn = _popup_fixed_btn("继续重置", POPUP_ACTION_BTN_SIZE, _apply_action_button_style)
	again_btn.pressed.connect( func():
		if not _fabao_reroll_ui.is_empty():
			return
		var again_id: = fid
		if again_id.is_empty() and is_instance_valid(popup) and popup.has_meta("fabao_reroll_id"):
			again_id = str(popup.get_meta("fabao_reroll_id"))
		if again_id.is_empty():
			return
		var cur: = _fabao_find_instance_by_id(again_id)
		if not FabaoConfig.has_resettable_unlocked_affix(cur):
			_show_game_alert("没有可重置的未锁定属性", "法宝")
			return
		_fabao_lock_popup_wait(popup, vbox, again_btn, "重置中...", again_id)
		FabaoApi.reset_affixes(again_id)
	)
	var close_btn = _popup_fixed_btn("关闭", POPUP_ACTION_BTN_SIZE)
	close_btn.pressed.connect( func():
		if is_instance_valid(popup):
			popup.queue_free()
	)
	vbox.add_child(_popup_btn_row([again_btn, close_btn]))

func _on_fabao_reset_confirm_done(accepted: bool) -> void :
	var popup = _fabao_reroll_ui.get("popup")
	var vbox = _fabao_reroll_ui.get("vbox")
	var fid: = str(_fabao_reroll_ui.get("fabao_id", ""))
	_fabao_clear_reroll_wait()
	if not (popup is Window) or not is_instance_valid(popup):
		return
	if not (vbox is VBoxContainer) or not is_instance_valid(vbox):
		return
	if fid.is_empty() and popup.has_meta("fabao_reroll_id"):
		fid = str(popup.get_meta("fabao_reroll_id"))
	_fabao_fill_reset_settled_view(popup, vbox, accepted, _fabao_find_instance_by_id(fid), fid)

## 列表行（墨底金线版）：
##   左侧品质竖条 → 方形头像框 → 名字/等级/代数 → 成长·五行 → 技能 → 右侧描金「操作」
## 所有尺寸走 _ink_s()（1024 设计坐标），和主城 / 顶栏 / 底栏同一套换算。
func _create_pet_item_ui(pet, index: int) -> Panel:
	var s: = _ink_s()
	var hair: = maxi(1, int(round(1.0 * s)))
	var panel = Panel.new()
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.custom_minimum_size = Vector2(0, 126.0 * s)
	panel.mouse_filter = Control.MOUSE_FILTER_PASS

	var qcol: = _get_pet_name_quality_color(pet)
	var gcol: = _growth_tier_color(pet.total_growth)

	var active_pet = null
	if game_manager and game_manager.pet_manager:
		active_pet = game_manager.pet_manager.get_active_pet()
	var is_active: bool = active_pet != null and str(active_pet.id) == str(pet.id)

	# 行底：出战中抬一档亮度 + 金线加强，其余压到很低的存在感（列表靠内容分主次）
	var panel_style = StyleBoxFlat.new()
	panel_style.bg_color = Color(0.085, 0.072, 0.049, 0.86) if is_active else Color(0.038, 0.034, 0.026, 0.62)
	panel_style.border_color = Color(0.788, 0.635, 0.294, 0.70) if is_active else Color(0.788, 0.635, 0.294, 0.20)
	panel_style.set_border_width_all(hair)
	panel_style.set_corner_radius_all(0)
	panel.add_theme_stylebox_override("panel", panel_style)

	# 左侧竖条：颜色跟成长档位走，等于"这行的品质标签"
	var qbar: = ColorRect.new()
	qbar.color = Color(gcol.r, gcol.g, gcol.b, 0.92)
	qbar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	panel.add_child(qbar)
	qbar.set_anchors_and_offsets_preset(Control.PRESET_LEFT_WIDE)
	qbar.offset_right = 4.0 * s

	var row = HBoxContainer.new()
	panel.add_child(row)
	row.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	row.offset_left = 16.0 * s
	row.offset_top = 11.0 * s
	row.offset_right = -14.0 * s
	row.offset_bottom = -11.0 * s
	row.add_theme_constant_override("separation", int(round(14.0 * s)))
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE

	# ① 头像：八角框，描边按成长档位上色（灰白/绿/蓝/金）
	var frame_size: = 96.0 * s
	var frame: = InkOctagon.new()
	frame.custom_minimum_size = Vector2(frame_size, frame_size)
	frame.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.line_width = maxf(1.0, 1.6 * s)
	frame.set_tier(gcol, 0.10 if _growth_tier_index(pet.total_growth) >= 2 else 0.0)
	row.add_child(frame)

	var pet_texture = AssetManager.get_instance().get_pet_texture(pet.pet_id)
	# 内缩 6%：宠物图源本身四周有大片透明留白，留太多框内就显空
	var inner: = frame_size * 0.06
	if pet_texture:
		var icon = TextureRect.new()
		icon.texture = pet_texture
		icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(icon)
		icon.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		icon.offset_left = inner
		icon.offset_top = inner
		icon.offset_right = -inner
		icon.offset_bottom = -inner
	else:
		var fallback = ColorRect.new()
		fallback.color = _get_element_color(pet.element)
		fallback.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(fallback)
		fallback.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		fallback.offset_left = inner
		fallback.offset_top = inner
		fallback.offset_right = -inner
		fallback.offset_bottom = -inner

	# ② 文本列：两行制（设计稿 90px 行高的信息密度）
	var info = VBoxContainer.new()
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	info.add_theme_constant_override("separation", int(round(3.0 * s)))
	info.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(info)

	# 第一行：名字 · 等级 · 出战/锁定签
	var name_row = HBoxContainer.new()
	name_row.add_theme_constant_override("separation", int(round(9.0 * s)))
	name_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	info.add_child(name_row)

	name_row.add_child(_ink_text(str(pet.pet_name), 26.0, qcol, true, true))
	name_row.add_child(_ink_text("Lv.%d" % pet.level, 21.0, INK_GOLD_HI, false))
	name_row.add_child(_ink_text(_get_pet_quality_bracket_text(pet), 18.0, Color(qcol.r, qcol.g, qcol.b, 0.70), false))
	if is_active:
		name_row.add_child(_ink_tag_chip("出战", INK_GOLD_HI))
	if pet.locked:
		name_row.add_child(_ink_tag_chip("已锁", Color(0.60, 0.64, 0.68)))

	# 第二行：形态·代数 · 成长 · 五行 · 技能
	var stat_row = HBoxContainer.new()
	stat_row.add_theme_constant_override("separation", int(round(8.0 * s)))
	stat_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	info.add_child(stat_row)

	var form_text: = _normalize_pet_form_display(str(pet.form))
	var gen_text: = "%d代" % pet.generation
	var rei_suffix: = ("·转生%d" % pet.reincarnation_count) if pet.reincarnation_count > 0 else ""
	stat_row.add_child(_ink_text("%s · %s%s" % [form_text, gen_text, rei_suffix], 18.0, Color(0.60, 0.56, 0.46), false))
	stat_row.add_child(_ink_text("成长", 18.0, Color(0.60, 0.56, 0.46), false))
	stat_row.add_child(_ink_text("%.3f" % pet.total_growth, 22.0, gcol, false))
	stat_row.add_child(_ink_text("五行", 18.0, Color(0.60, 0.56, 0.46), false))
	stat_row.add_child(_ink_text(str(pet.element), 20.0, _get_element_color(pet.element), false))

	var skill_text: = _format_pet_list_skill_line(pet)
	var skill_col: = Color(0.46, 0.48, 0.50) if skill_text.contains("无") else Color(0.60, 0.76, 0.86)
	stat_row.add_child(_ink_text(skill_text, 18.0, skill_col, false))

	# ③ 操作按钮
	var click_hint = Button.new()
	click_hint.text = "点击操作"
	click_hint.custom_minimum_size = Vector2(112.0 * s, 54.0 * s)
	click_hint.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	click_hint.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	click_hint.focus_mode = Control.FOCUS_NONE
	_ink_outline_button(click_hint, _ink_font(21.0))
	row.add_child(click_hint)

	var click_pet_id: = str(pet.id)
	click_hint.pressed.connect( func():
		_show_pet_action_popup_by_id(click_pet_id)
	)

	_setup_mouse_filter(panel)

	return panel


