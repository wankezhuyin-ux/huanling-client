func _map_elements_bbcode(elements: Array) -> String:
	if elements.is_empty():
		return ""
	var parts: PackedStringArray = []
	for el in elements:
		var s: = str(el)
		var c: = _get_element_color(s)
		parts.append("[color=#%s]%s[/color]" % [c.to_html(false), s])
	return " ".join(parts)

func _map_elements_bbcode_compact(elements: Array) -> String:
	if elements.is_empty():
		return ""
	var parts: PackedStringArray = []
	for el in elements:
		var s: = str(el)
		var c: = _get_element_color(s)
		parts.append("[color=#%s]%s[/color]" % [c.to_html(false), s])
	return "".join(parts)

func _split_map_title_and_coords(full_map_name: String) -> Dictionary:
	var full: = full_map_name.strip_edges()
	var idx: = full.rfind("（")
	if idx < 0:
		return {"title": full, "coords": ""}
	var coords_str: = full.substr(idx)
	if not coords_str.ends_with("）"):
		return {"title": full, "coords": ""}
	var title: = full.substr(0, idx).strip_edges()
	return {"title": title, "coords": coords_str}

func _format_map_coords_for_display(coords: String) -> String:
	if coords.is_empty():
		return coords
	return coords.replace("（", "(").replace("）", ")")

func _apply_map_select_button_content(btn: Button, map_name: String, map_data: Dictionary, name_font_size: int, name_color: Color, name_hover_color: Color, name_prefix: String = "  ", elements_bbcode: String = "") -> void :
	btn.text = ""

	btn.clip_contents = false
	var split: Dictionary = _split_map_title_and_coords(map_name)
	var title: String = split.get("title", map_name)
	var coords: String = split.get("coords", "")
	if title.is_empty():
		title = map_name
	var coords_display: String = _format_map_coords_for_display(coords)
	var elems_compact: String = elements_bbcode
	if elems_compact.is_empty():
		if _map_select_elements_bbcode_cache.has(map_name):
			elems_compact = _map_select_elements_bbcode_cache[map_name]
		else:
			var elems_computed: Array = Monster.sorted_unique_map_elements(map_data)
			elems_compact = _map_elements_bbcode_compact(elems_computed)
			_map_select_elements_bbcode_cache[map_name] = elems_compact
	var has_elements_display: bool = not elems_compact.is_empty()
	var vbox: = VBoxContainer.new()
	vbox.set_anchors_preset(Control.PRESET_FULL_RECT)
	vbox.offset_left = 8
	vbox.offset_top = 4
	vbox.offset_right = -8
	vbox.offset_bottom = -4
	vbox.add_theme_constant_override("separation", 2)
	vbox.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var title_l: = Label.new()
	title_l.text = name_prefix + title
	title_l.autowrap_mode = TextServer.AUTOWRAP_OFF
	title_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title_l.add_theme_font_size_override("font_size", name_font_size)
	title_l.add_theme_color_override("font_color", name_color)
	title_l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(title_l)
	var has_line2: = not coords.is_empty() or has_elements_display
	if has_line2:
		var row2: = HBoxContainer.new()
		row2.add_theme_constant_override("separation", 4)
		row2.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row2.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var coords_l: = Label.new()
		coords_l.text = coords_display
		coords_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		coords_l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		coords_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		coords_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		coords_l.autowrap_mode = TextServer.AUTOWRAP_OFF
		coords_l.add_theme_font_size_override("font_size", name_font_size)
		coords_l.add_theme_color_override("font_color", name_color)
		coords_l.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row2.add_child(coords_l)
		if has_elements_display:
			var elems_rtl: = RichTextLabel.new()
			elems_rtl.bbcode_enabled = true
			elems_rtl.text = elems_compact
			elems_rtl.scroll_active = false
			elems_rtl.autowrap_mode = TextServer.AUTOWRAP_OFF
			elems_rtl.fit_content = true
			elems_rtl.size_flags_horizontal = Control.SIZE_SHRINK_END
			elems_rtl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			elems_rtl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
			elems_rtl.add_theme_font_size_override("normal_font_size", name_font_size)
			elems_rtl.mouse_filter = Control.MOUSE_FILTER_IGNORE
			var elems_margin: = MarginContainer.new()
			elems_margin.add_theme_constant_override("margin_right", MAP_SELECT_ELEMENTS_SCROLL_MARGIN)
			elems_margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
			elems_margin.size_flags_horizontal = Control.SIZE_SHRINK_END
			elems_margin.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			elems_margin.add_child(elems_rtl)
			row2.add_child(elems_margin)
		vbox.add_child(row2)
		btn.add_child(vbox)
		btn.mouse_entered.connect( func():
			title_l.add_theme_color_override("font_color", name_hover_color)
			coords_l.add_theme_color_override("font_color", name_hover_color)
		)
		btn.mouse_exited.connect( func():
			title_l.add_theme_color_override("font_color", name_color)
