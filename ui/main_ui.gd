func _on_save_downloaded(save_data):
	print("[MAIN_UI] _on_save_downloaded called, save_data has playerData: ", save_data and save_data.has("playerData"))

	if save_data and save_data.has("_download_error"):
		var error_msg = save_data.get("error_msg", "存档下载失败")
		print("[MAIN_UI] 存档下载失败: ", error_msg)
		_show_simple_dialog("下载失败", error_msg + "\n请重新登录重试")
		if network:
			network.logout()
		_show_login_dialog()
		return

	if save_data and save_data.has("playerData"):
		print("从服务器下载存档成功，正在应用...")
		if game_manager and not game_manager.initialized:
			print("初始化 game_manager...")
			game_manager.initialize(true)
		print("[MAIN_UI] game_manager exists: ", game_manager != null)
		if game_manager:
			game_manager.set_session_nickname(network_nickname)
			print("[MAIN_UI] 调用 apply_cloud_save, game_manager initialized: ", game_manager.initialized)
			print("[MAIN_UI] save_data type: ", typeof(save_data), " is_dict: ", save_data is Dictionary)
			if network:
				network.merge_pending_into_downloaded_save(save_data)
			game_manager.apply_cloud_save(save_data, {"pets_authoritative": true})
			if network:
				network.discard_pending_saves_after_cloud_applied()
			_begin_post_login_broadcast_sync(save_data)
			_request_title_sync_now()
			print("[MAIN_UI] apply_cloud_save 完成")
			print("[MAIN_UI] 调用登录后同步流程")
			_request_post_login_sync()
			print("[MAIN_UI] 登录后同步流程已发起")
			_update_login_dialog_info()
			_cached_pet_texture = ""
			_update_player_ui()
			_update_pet_ui()
		else:
			print("[MAIN_UI] game_manager is null!")
	else:
		print("服务器无存档，按新用户处理（不回退本地存档，避免跨账号串档）")
		if game_manager:
			game_manager.set_session_nickname(network_nickname)
		if game_manager and network_nickname != "" and game_manager.player:
			game_manager.player.player_name = network_nickname
			print("[MAIN_UI] 新用户设置角色名: ", network_nickname)
		if game_manager:
			game_manager.mark_cloud_sync_ready()
			_request_title_sync_now()
			_request_post_login_sync()
			_update_login_dialog_info()
			_cached_pet_texture = ""
			_update_player_ui()
			_update_pet_ui()

