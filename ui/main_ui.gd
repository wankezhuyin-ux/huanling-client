func _popup_add_btn_grid(host: Control, buttons: Array) -> void :
	var pair: Array = []
	for b in buttons:
		if not (b is Control):
			continue
		pair.append(b)
		if pair.size() >= 2:
			host.add_child(_popup_btn_row(pair))
