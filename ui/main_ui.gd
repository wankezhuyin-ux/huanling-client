func _on_use_fabao_player_element_toggled(pressed: bool) -> void :
	if game_manager == null or game_manager.player == null:
		return
	if game_manager.player.use_fabao_player_element == pressed:
		return
	game_manager.player.use_fabao_player_element = pressed
	game_manager.save_game(true, "fabao_player_element_toggle")
	call_deferred("_rebuild_combat_stats_after_fabao_element_toggle")

func _rebuild_combat_stats_after_fabao_element_toggle() -> void :
	if character_combat_stats_container == null:
		return
	if character_combat_stats_container.get_child_count() > 0:
		_clear_container_immediate(character_combat_stats_container)
	_build_combat_stats_view()

func _make_visible_checkbox_icon(checked: bool) -> Texture2D:
	var sz: = 18
	var img: = Image.create(sz, sz, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.12, 0.14, 0.18, 1.0))
	var border: = Color(0.82, 0.84, 0.88, 1.0)
	for i in sz:
		img.set_pixel(i, 0, border)
		img.set_pixel(i, 1, border)
		img.set_pixel(i, sz - 1, border)
		img.set_pixel(i, sz - 2, border)
		img.set_pixel(0, i, border)
		img.set_pixel(1, i, border)
		img.set_pixel(sz - 1, i, border)
		img.set_pixel(sz - 2, i, border)
	if checked:
		var mark: = Color(0.95, 0.82, 0.28, 1.0)
		for y in range(4, sz - 4):
			for x in range(4, sz - 4):
				img.set_pixel(x, y, mark)
	return ImageTexture.create_from_image(img)

func _get_character_full_set_min_enhance_level() -> int:
	if game_manager == null or game_manager.suit_manager == null:
		return 0
	var best: = 0
	for suit_level in game_manager.suit_manager.equipped_suits.keys():
		if not game_manager.suit_manager.is_full_set_equipped(suit_level):
			continue
		var slots: Dictionary = game_manager.suit_manager.equipped_suits.get(suit_level, {})
		var min_lv: = 999
		for eq in slots.values():
			if eq == null:
				continue
			min_lv = mini(min_lv, SuitEquipmentEnhance.get_level_from_equipment(eq))
		if min_lv == 999:
			min_lv = 0
		best = maxi(best, min_lv)
	return best

