func _run_player_attr_auto_allocate() -> void :
	_player_attr_auto_allocate_async()

func _player_attr_auto_allocate_async() -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.network == null:
		_add_log("[color=red]网络未连接，无法分配属性点[/color]")
		return
	_player_attr_rpc_busy = true
	var res: Dictionary = await _await_player_attr_auto_allocate()
	_player_attr_rpc_busy = false
	if not bool(res.get("ok", false)):
		_add_log("[color=red]%s[/color]" % str(res.get("error", "分配失败")))
		_notify_player_attr_changed("auto_allocate_manual_failed")
		return
	_player_attr_auto_fail_retry_count = 0
	_mark_player_attr_auto_success_debounce()
	_finalize_player_attr_rpc_success(res.get("data", {}), true)

func _run_player_attr_spend(func_name: String, count: int) -> void :
	_player_attr_spend_async(func_name, count)

func _player_attr_spend_async(func_name: String, count: int) -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.network == null:
		_add_log("[color=red]网络未连接，无法加点[/color]")
		return
	if count <= 0:
		return
	var stat: = _stat_key_from_add_func(func_name)
	if stat.is_empty():
		return
	_player_attr_rpc_busy = true
	var res: Dictionary = await _await_player_attr_spend_points(stat, count)
	_player_attr_rpc_busy = false
	if not bool(res.get("ok", false)):
		_add_log("[color=red]%s[/color]" % str(res.get("error", "加点失败")))
		_notify_player_attr_changed("spend_failed")
		return
	_finalize_player_attr_rpc_success(res.get("data", {}), true)

func _try_player_attr_auto_allocate_after_level_up() -> void :
	await _player_attr_auto_allocate_after_level_up_async()

func _player_attr_auto_allocate_after_level_up_async() -> void :
	if _player_attr_rpc_busy:
		return
	if game_manager == null or game_manager.player == null or game_manager.network == null:
		return
	var player_ref = game_manager.player
	if not _player_attr_meets_auto_allocate_threshold(player_ref):
		return
	_player_attr_rpc_busy = true
	var res: Dictionary = await _await_player_attr_auto_allocate()
	_player_attr_rpc_busy = false
	if not bool(res.get("ok", false)):
		_handle_player_attr_auto_allocate_failure(str(res.get("error", "自动分配失败")))
		return
	_player_attr_auto_fail_retry_count = 0
	_mark_player_attr_auto_success_debounce()
	_finalize_player_attr_rpc_success(res.get("data", {}), true)

func _run_player_attr_save_auto_plan(enabled: bool, plan: Dictionary, dialog: Window) -> void :
