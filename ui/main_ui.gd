	stats_label.add_theme_color_override("font_color", Color(0.8, 0.8, 1))
	info_vbox.add_child(stats_label)

	hbox.add_child(info_vbox)

	var click_hint = Button.new()
	click_hint.text = "点击操作"
	click_hint.custom_minimum_size = Vector2(100, 40)
	click_hint.add_theme_font_size_override("font_size", 18)
	click_hint.add_theme_color_override("font_color", Color(0.5, 0.5, 0.5))
	hbox.add_child(click_hint)

	var click_item = item
	var click_slot = slot
	click_hint.pressed.connect( func():
		_show_equipment_action_popup(click_item, click_slot, is_equipped)
	)

	panel.add_child(hbox)
	_setup_mouse_filter(panel)

	return panel

