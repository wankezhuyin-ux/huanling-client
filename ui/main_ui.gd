func _battle_grid_row_y(row_index: int) -> float:
	return BATTLE_GRID_ROW_ORIGIN_Y + float(row_index) * BATTLE_GRID_ROW_STEP

# 战场单位坐标是按 project.godot 的设计分辨率 720x1280 写死的绝对像素
# （BATTLE_GRID_ALLY_PLAYER_COL_X / BATTLE_GRID_MONSTER_COL0_X ...）。
# 但 stretch/aspect = "expand"：竖屏窄机（例如 418x907）逻辑高度会被拉长，
# 宽屏平板（例如 900x1108）逻辑宽度会变宽（720 → 1039）。
# 结果是宽屏上「人物 + 宠物 + 怪物」整排挤在左上角、人和宠叠在一起。
# 这里把设计画布水平居中，保证任何屏幕比例下站位都和参考稿一致。
const BATTLE_DESIGN_WIDTH: float = 720.0

func _battle_field_layout_offset() -> Vector2:
	if not is_instance_valid(monster_container):
		return Vector2.ZERO
	# 比武场 / 生死塔 / 五形有自己的一套 slot 布局（本来就会按容器居中），不要再叠偏移
	if game_manager != null and (game_manager.is_brother_tower_battle
			or game_manager.is_five_elements_battle
			or _is_arena_battle()):
		return Vector2.ZERO
	var field_w: float = monster_container.size.x
	if field_w <= BATTLE_DESIGN_WIDTH + 0.5:
		return Vector2.ZERO
	return Vector2(roundf((field_w - BATTLE_DESIGN_WIDTH) * 0.5), 0.0)

func _battle_grid_monster_col_x(col_index: int, total_count: int = 0) -> float:

	return BATTLE_GRID_MONSTER_COL0_X + float(col_index) * BATTLE_GRID_COL_STEP


func _battle_grid_use_classic_two_col_layout() -> bool:
	if game_manager == null:
		return false
	return bool(game_manager.is_brother_tower_battle) or bool(game_manager.is_five_elements_battle)



func _battle_grid_monster_slot_layout(index: int, total_count: int) -> Vector3i:
	var safe_index: = maxi(0, index)
	var row_order: Array[int] = [
		BATTLE_GRID_ROW_MEMBER, 
		BATTLE_GRID_ROW_LEADER, 
		BATTLE_GRID_ROW_RESERVE_BOTTOM, 
		BATTLE_GRID_ROW_RESERVE_TOP, 
	]

	var per_col: = 4 if total_count > 6 else 3
	var col: = int(safe_index / per_col)
	var role: = int(safe_index % per_col)
	role = mini(role, per_col - 1)
	role = mini(role, row_order.size() - 1)
	return Vector3i(col, row_order[role], role)

func _battle_monster_col_for_row_slot(role: int, slot_in_row: int) -> int:
	if role < 0 or role >= _battle_monster_row_col_order.size():
		return clampi(slot_in_row, 0, 2)
	var order = _battle_monster_row_col_order[role]
	if order is Array and slot_in_row >= 0 and slot_in_row < order.size():
		return clampi(int(order[slot_in_row]), 0, 2)
	return clampi(slot_in_row, 0, 2)


func _battle_grid_monster_slot_pos(index: int, total_count: int) -> Vector2:
	var layout: = _battle_grid_monster_slot_layout(index, total_count)
	var col: = layout.x
	var row: = layout.y

	var member_y: = _battle_grid_row_y(BATTLE_GRID_ROW_MEMBER)
	var y: = member_y + float(row - BATTLE_GRID_ROW_MEMBER) * BATTLE_GRID_MONSTER_ROW_STEP
	# 斜阵：我方在左下，敌方阵列朝右上铺开——列每右移一格往上抬一点（更远更小），
	# 同一列里越靠上的怪也往右让一点，两条轴合起来才是一条斜线而不是一竖排。
	y -= float(col) * BATTLE_GRID_SLANT_Y_STEP

	if _is_wild_field_battle_ui():
		y += BT_SLOT_HP_BAR_POS.y - MONSTER_BATTLE_HP_BAR_POS.y + WILD_MONSTER_HP_ALIGN_EXTRA_Y
	var x: = _battle_grid_monster_col_x(col, total_count) - float(col) * BATTLE_GRID_SLANT_X_PULL
	x -= float(row - BATTLE_GRID_ROW_MEMBER) * BATTLE_GRID_SLANT_ROW_X_STEP
	return Vector2(x, y) + _battle_field_layout_offset()

func _is_wild_field_battle_ui() -> bool:
	return game_manager != null\
	and bool(game_manager.in_battle)\
	and not bool(game_manager.is_in_instanced_challenge())


func _battle_grid_monster_slot_pos_formed(index: int, total_count: int) -> Vector2:
	return _battle_grid_monster_slot_pos(index, total_count)

func _pick_battle_monster_formation(force: bool = false) -> void :
	if force or _pending_monster_entrance:
		_battle_monster_formation_id = randi() % BATTLE_MONSTER_FORMATION_COUNT
		_battle_monster_offset_seed = randi()
		_battle_monster_row_col_order = []
		for _i in range(4):
			var cols: Array = [0, 1, 2]
			cols.shuffle()
			_battle_monster_row_col_order.append(cols)

func _battle_monster_ui_z_index_for_pos(pos: Vector2) -> int:

	return 20 + int(pos.y / 20.0)


func _battle_perspective_scale_at(unit_y: float) -> float:
	# 伪等距的「近大远小」：只按脚底 y 算，不碰逻辑，纯表现层。
	var span: float = maxf(BATTLE_PERSPECTIVE_Y_NEAR - BATTLE_PERSPECTIVE_Y_FAR, 1.0)
	var t: float = clampf((unit_y - BATTLE_PERSPECTIVE_Y_FAR) / span, 0.0, 1.0)
	return lerpf(BATTLE_PERSPECTIVE_SCALE_FAR, BATTLE_PERSPECTIVE_SCALE_NEAR, t)


func _apply_battle_slot_perspective(unit_ui: Control, slot_name: String = "MonsterSpriteSlot") -> void:
	# 只缩放精灵槽，血条和名字保持原尺寸，否则远处的怪看不清血量。
	if not is_instance_valid(unit_ui):
		return
	var slot = unit_ui.get_node_or_null(slot_name) as Control
	if slot == null:
		return
	var s: = _battle_perspective_scale_at(unit_ui.position.y)
	slot.pivot_offset = Vector2(slot.size.x * 0.5, slot.size.y)
	slot.scale = Vector2(s, s)


func _battle_grid_monster_formation_offset(index: int, total_count: int, formation_id: int) -> Vector2:

	if _battle_grid_use_classic_two_col_layout():
		return Vector2.ZERO
	var layout: = _battle_grid_monster_slot_layout(index, total_count)
	var col: = layout.x
	var role: = layout.z
	var side: = 1.0 if (col % 2) == 0 else -1.0
	var fid: = formation_id % BATTLE_MONSTER_FORMATION_COUNT
	var pack: = total_count > 5 and not _battle_grid_use_classic_two_col_layout()

	var jitter: = float(((_battle_monster_offset_seed + index * 17 + role * 31) % 21) - 10)

	if role == 0:
		var base_dx: = 0.0
		match fid:
			BATTLE_MONSTER_FORMATION_SCATTER:
				base_dx = 24.0 * side + float(col - 1) * -10.0
			BATTLE_MONSTER_FORMATION_ARC:
				base_dx = 20.0 * side + float(1 - col) * 14.0
			BATTLE_MONSTER_FORMATION_WEDGE:
				base_dx = 16.0 * side - float(col) * 8.0
			_:
				base_dx = 22.0 * side + float(col) * -12.0
		base_dx += jitter
		if pack:
			base_dx = clampf(base_dx, -40.0, 22.0)
		else:
			base_dx = clampf(base_dx, -36.0, 28.0)
		return Vector2(base_dx, 0.0)
	var dx: = 0.0
	var dy: = 0.0

	var compact_x: = float(col) * (-10.0 if pack else -14.0)
	match fid:
		BATTLE_MONSTER_FORMATION_SCATTER:
			dx = compact_x
			if role == 1:
				dx += (18.0 if pack else 26.0) * side
				dy = 8.0
			elif role == 2:
				dx += (-16.0 if pack else -24.0) * side
				dy = -8.0
			else:
				dx += (14.0 if pack else 22.0) * side
				dy = 12.0
		BATTLE_MONSTER_FORMATION_ARC:

			dx = float(col) * (6.0 if pack else 10.0) + compact_x * 0.5
			if role == 1:
				dx += (-12.0 if pack else -20.0) + (8.0 if pack else 12.0) * side
				dy = 10.0
			elif role == 2:
				dx += (-12.0 if pack else -20.0) - (8.0 if pack else 12.0) * side
				dy = -10.0
			else:
				dx += -18.0 if pack else -28.0
				dy = 14.0
		BATTLE_MONSTER_FORMATION_WEDGE:

			dx = float(col) * (8.0 if pack else 18.0)
			if col == 0:
				dx -= 10.0
			if role == 1:
				dx += (10.0 if pack else 16.0) * side
				dy = 8.0
			elif role == 2:
				dx += (-10.0 if pack else -14.0) * side
				dy = -10.0
			else:
				dx += (8.0 if pack else 10.0) * side
				dy = 12.0
		_:

			dx = float(col) * (-18.0 if pack else -28.0)
			if role == 1:
				dx += (12.0 if pack else 18.0) * side
				dy = 12.0
			elif role == 2:
				dx += (-12.0 if pack else -16.0) * side
				dy = -12.0
			else:
				dx += (8.0 if pack else 12.0) * side
				dy = 16.0
	dx += jitter * 0.6
	if pack:
		dx = clampf(dx, -36.0, 24.0)
	return Vector2(dx, dy)

func _is_arena_battle() -> bool:
	return game_manager != null and game_manager.is_arena_battle

func _arena_monster_is_pet(monster) -> bool:
	var role: = str(_get_monster_property(monster, "arena_role", "")).strip_edges()
	if role == "pet":
		return true
	if role == "player":
		return false
	return str(_get_monster_property(monster, "texture_id", "")) == "pet_mirror"

func _battle_grid_arena_monster_pos(is_pet: bool) -> Vector2:
	var col: = 0 if is_pet else 1
	return Vector2(_battle_grid_monster_col_x(col), _battle_grid_row_y(BATTLE_GRID_ROW_MEMBER))

func _battle_grid_shengsi_monster_pos(index: int, is_pet: bool) -> Vector2:
	var pair: = maxi(0, int(index / 2))
	var row: = BATTLE_GRID_ROW_LEADER if pair <= 0 else BATTLE_GRID_ROW_MEMBER
	var col: = 0 if is_pet else 1
	return Vector2(_battle_grid_monster_col_x(col), _battle_grid_row_y(row))

func _place_arena_or_shengsi_monster_ui(monster, slot_index: int, total_count: int) -> Vector2:
	if _is_shengsi_replay() and total_count >= 3:
		return _battle_grid_shengsi_monster_pos(slot_index, _arena_monster_is_pet(monster))
	if _is_arena_battle() and total_count <= 2:
		return _battle_grid_arena_monster_pos(_arena_monster_is_pet(monster))
	return Vector2.INF

func _arena_opponent_sprite_mirror_x(texture_id: String) -> bool:

	if not _is_arena_battle():
		return false
	return false

func _get_arena_monster_sprite_center_in_ui(monster_ui: Control) -> Vector2:
	var slot: = monster_ui.get_node_or_null("MonsterSpriteSlot") as Control
	if slot == null:
		return Vector2(MONSTER_BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_DEFEAT_CENTER_Y)
	var slot_size: = slot.size
	if slot_size.x <= 0.0:
		slot_size = MONSTER_BATTLE_SPRITE_SLOT_SIZE
	var center_x: = slot.position.x + _battle_sprite_slot_center(slot_size).x
	return Vector2(center_x, slot.position.y + slot_size.y * 0.5)

func _monster_is_player_mirror(monster) -> bool:
	return str(_get_monster_property(monster, "texture_id", "")) == "player_mirror"

func _uses_arena_style_monster_defeat(monster) -> bool:
	if _is_arena_battle():
		return true
	return _is_shengsi_replay() and _monster_is_player_mirror(monster)

func _arena_monster_defeat_flip_horizontal(monster) -> bool:

	if _monster_is_player_mirror(monster):
		return false
	return false

func _apply_arena_monster_defeat_effect(monster_ui: Control, monster) -> void :
	var slot: = monster_ui.get_node_or_null("MonsterSpriteSlot") as Control
	if slot == null:
		BattleMonsterDefeatEffect.apply_defeated(monster_ui)
		return
	var sprite: = slot.get_node_or_null("MonsterSprite")
	if not is_instance_valid(sprite) or not sprite is CanvasItem:
		BattleMonsterDefeatEffect.apply_defeated(monster_ui)
		return
	var override_tex: Texture2D = null
	if _monster_is_player_mirror(monster):
		var cid: = int(_get_monster_property(monster, "character_id", 0))
		override_tex = _get_player_defeated_static_texture_for_character(cid)

	var sprite_center: = Vector2.ZERO
	if sprite is Node2D:
		sprite_center = (sprite as Node2D).position
	else:
		var slot_size: = slot.size
		if slot_size.x <= 0.0:
			slot_size = MONSTER_BATTLE_SPRITE_SLOT_SIZE
		sprite_center = _battle_sprite_slot_center(slot_size)
	var opts: = {
		"flip_horizontal": _arena_monster_defeat_flip_horizontal(monster), 
		"static_parent": slot, 
		"static_center": sprite_center, 
		"dizzy_position": slot.position + sprite_center + Vector2(0.0, -6.0), 
	}
	if override_tex != null:
		opts["override_texture"] = override_tex
	BattleMonsterDefeatEffect.apply_defeated_on(monster_ui, slot, sprite as CanvasItem, opts)

func _restore_arena_monster_sprite_layout(monster_ui: Control, monster) -> void :
	var slot: = monster_ui.get_node_or_null("MonsterSpriteSlot") as Control
	if slot == null:
		return
	var texture_id: = str(_get_monster_property(monster, "texture_id", ""))
	if texture_id == "player_mirror":
		var cid: = int(_get_monster_property(monster, "character_id", 0))
		_layout_arena_opponent_player_visual(slot, cid)
	elif texture_id == "pet_mirror":
		var sprite: = slot.get_node_or_null("MonsterSprite")
		if is_instance_valid(sprite):
			_set_ally_pet_sprite_mirror(sprite, slot, false)
			if sprite is AnimatedSprite2D:
				_apply_battle_sprite_playback_state(sprite as AnimatedSprite2D)

func _create_arena_opponent_player_sprite(slot: Control, character_id: int) -> AnimatedSprite2D:
	var cid: = _normalize_player_character_id(character_id)
	var player_frames: = _build_player_battle_sprite_frames_for_character(cid)
	if player_frames == null:
		return null
	var player_anim: = AnimatedSprite2D.new()
	player_anim.name = "MonsterSprite"
	player_anim.centered = true
	player_anim.sprite_frames = player_frames
	player_anim.z_index = 20
	slot.add_child(player_anim)
	_layout_arena_opponent_player_visual(slot, cid)
	var slot_size: = slot.size
	if slot_size.x <= 0.0:
		slot_size = MONSTER_BATTLE_SPRITE_SLOT_SIZE
	_ensure_battle_slot_foot_shadow(slot, slot_size, player_anim, UIConstants.FOOT_SHADOW_PLAYER_BODY_OFFSET_Y)
	return player_anim

func _layout_arena_opponent_player_visual(slot: Control, character_id: int) -> void :
	var anim: = slot.get_node_or_null("MonsterSprite") as AnimatedSprite2D
	if anim == null:
		return
	var cid: = _normalize_player_character_id(character_id)
	var slot_size: = slot.size
	if slot_size.x <= 0.0:
		slot_size = MONSTER_BATTLE_SPRITE_SLOT_SIZE
	var slot_center: = _battle_sprite_slot_center(slot_size)
	var fit: = slot_size.x / 256.0 * BT_PLAYER_SPRITE_SCALE_MULTIPLIER
	var base_scale: = PlayerCharacterConfig.get_battle_sprite_scale(cid)
	anim.centered = true
	anim.position = slot_center
	anim.scale = Vector2( - base_scale * fit, base_scale * fit)
	BattleMonsterDefeatEffect.remember_base_scale(anim)
	_apply_battle_sprite_playback_state(anim)
	_ensure_battle_slot_foot_shadow(slot, slot_size, anim, UIConstants.FOOT_SHADOW_PLAYER_BODY_OFFSET_Y)

func _is_world_boss_battle() -> bool:
	return game_manager != null and game_manager.is_world_boss_battle and not game_manager.is_arena_battle

func _world_boss_ally_sprite_center_y() -> float:
	var player_center: = _get_player_battle_wrap_pos().y + _get_battle_ally_slot_center_in_wrap().y
	var pet_center: = _get_pet_battle_wrap_pos().y + _bt_pet_sprite_offset().y + _ally_pet_battle_slot_size().y * 0.5
	return (player_center + pet_center) * 0.5

func _world_boss_monster_sprite_center_offset() -> Vector2:
	return Vector2(10.0, 0.0) + WORLD_BOSS_BATTLE_SPRITE_SIZE * 0.5

func _world_boss_monster_ui_position(cell_width: float) -> Vector2:
	var col_center_x: = _battle_grid_monster_col_x(0) + BATTLE_GRID_CELL_SIZE.x * 0.5
	var x: = col_center_x - cell_width * 0.5
	var center_offset: = _world_boss_monster_sprite_center_offset()
	var y: = _world_boss_ally_sprite_center_y() - center_offset.y
	return Vector2(x, y)

func _battle_grid_ally_slot_pos(row_index: int, is_pet: bool) -> Vector2:
	var col_x: = BATTLE_GRID_ALLY_PET_COL_X if is_pet else BATTLE_GRID_ALLY_PLAYER_COL_X
	var y: = _battle_grid_row_y(row_index)
	# 宠物站在主角斜后方半个身位，避免人与宠叠成一条直线
	if is_pet:
		y += BATTLE_ALLY_SLANT_Y_STEP
	return Vector2(col_x + BATTLE_GRID_ALLY_COL_SHIFT_X, y)

func _bt_local_on_leader_row() -> bool:
	if _is_shengsi_replay():
		return true
	return not _is_bt_viewer()

func _bt_slot_id_for_row(is_leader_row: bool, is_pet: bool) -> String:
	if is_leader_row:
		return "leader_pet" if is_pet else "leader_player"
	return "member_pet" if is_pet else "member_player"

func _ally_slot_id_for_unit(unit_key: String) -> String:
	if _uses_coop_ally_slots():
		return _bt_slot_id_for_unit(unit_key)
	match unit_key:
		"local_player":
			return "member_player"
		"local_pet":
			return "member_pet"
	return ""

func _battle_ally_mount_unit_keys() -> Array:
	if _uses_coop_ally_slots():
		return BT_UNIT_KEYS
	return ["local_player", "local_pet"]

func _get_ally_unit_mount_spec(unit_key: String) -> Dictionary:
	return _bt_get_unit_mount_spec(unit_key)

func _bt_slot_id_for_unit(unit_key: String) -> String:
	var on_leader: = _bt_local_on_leader_row()
	match unit_key:
		"local_player":
			return _bt_slot_id_for_row(on_leader, false)
		"local_pet":
			return _bt_slot_id_for_row(on_leader, true)
		"coop_player":
			return _bt_slot_id_for_row( not on_leader, false)
		"coop_pet":
			return _bt_slot_id_for_row( not on_leader, true)
	return ""

func _bt_slot_id_for_hit_type(hit_type: String) -> String:
	match hit_type:
		"player":
			return _ally_slot_id_for_unit("local_player")
		"pet":
			return _ally_slot_id_for_unit("local_pet")
		"coop_player":
			return _ally_slot_id_for_unit("coop_player")
		"coop_pet":
			return _ally_slot_id_for_unit("coop_pet")
	return ""

func _bt_get_unit_mount_spec(unit_key: String) -> Dictionary:
	var slot_id: = _bt_slot_id_for_unit(unit_key)
	if slot_id.is_empty():
		return {}
	match unit_key:
		"local_player":
			return {
				"slot_id": slot_id, 
				"wrap": _battle_player_wrap, 
				"name": _battle_player_name_label, 
				"level": _battle_player_level_label, 
				"hp": _battle_player_hp_bar, 
				"block_x": 0.0, 
				"block_width": BT_SLOT_NAME_BLOCK_WIDTH, 
			}
		"local_pet":
			return {
				"slot_id": slot_id, 
				"wrap": _battle_pet_wrap, 
				"name": _battle_pet_name_label, 
				"level": _battle_pet_level_label, 
				"hp": _battle_pet_hp_bar, 
				"block_x": 0.0, 
				"block_width": BT_SLOT_NAME_BLOCK_WIDTH, 
			}
		"coop_player":
			return {
				"slot_id": slot_id, 
				"wrap": _battle_coop_player_wrap, 
				"name": _battle_coop_player_name_label, 
				"level": _battle_coop_player_level_label, 
				"hp": _battle_coop_player_hp_bar, 
				"block_x": 0.0, 
				"block_width": BT_SLOT_NAME_BLOCK_WIDTH, 
			}
		"coop_pet":
			return {
				"slot_id": slot_id, 
				"wrap": _battle_coop_pet_wrap, 
				"name": _battle_coop_pet_name_label, 
				"level": _battle_coop_pet_level_label, 
				"hp": _battle_coop_pet_hp_bar, 
				"block_x": 0.0, 
				"block_width": BT_SLOT_NAME_BLOCK_WIDTH, 
			}
	return {}

func _bt_character_id_for_wrap(wrap: Control) -> int:
	if wrap == _battle_coop_player_wrap:
		var coop = _get_coop_battle_unit("coop_player")
		if coop:
			return int(coop.player_character_id)
	return _get_player_character_id()

func _resolve_bt_slot_id_for_wrap(wrap: Control) -> String:
	if not is_instance_valid(wrap):
		return ""
	for unit_key in BT_UNIT_KEYS:
		var spec: = _bt_get_unit_mount_spec(unit_key)
		if spec.get("wrap") == wrap:
			return _ally_slot_id_for_unit(unit_key)
	return ""

func _bt_visual_state(unit_key: String) -> String:
	return str(_bt_ally_visual_state.get(unit_key, BT_ALLY_VIS_IDLE))

func _set_bt_visual_state(unit_key: String, state: String) -> void :
	_bt_ally_visual_state[unit_key] = state

func _reset_bt_ally_visual_states() -> void :
	_bt_ally_visual_state.clear()

func _unit_key_for_wrap(wrap: Control) -> String:
	if not is_instance_valid(wrap):
		return ""
	for unit_key in BT_UNIT_KEYS:
		var spec: = _bt_get_unit_mount_spec(unit_key)
		if spec.get("wrap") == wrap:
			return unit_key
	return ""

func _is_ally_defeat_fx_present(wrap: Control) -> bool:
	if not is_instance_valid(wrap):
		return false
	if wrap.get_node_or_null(BattleMonsterDefeatEffect.DIZZY_NODE_NAME) != null:
		return true
	if wrap.get_node_or_null(BattleMonsterDefeatEffect.DEFEATED_STATIC_NAME) != null:
		return true
	return false

func _get_battle_ally_defeat_anchor_in_wrap(wrap: Control) -> Vector2:
	return _get_battle_ally_slot_center_in_wrap(wrap) + Vector2(0.0, ALLY_DEFEAT_ANCHOR_BELOW_SLOT_CENTER_Y)

func _get_battle_ally_slot_center_in_wrap(_wrap: Control = null) -> Vector2:
	return BT_SLOT_SPRITE_OFFSET + _battle_sprite_slot_center(BATTLE_SPRITE_SLOT_SIZE)

func _is_battle_ally_wrap_slot_layout(wrap: Control) -> bool:
	if not is_instance_valid(wrap):
		return false
	if _resolve_bt_slot_id_for_wrap(wrap) != "":
		return true
	var parent: = wrap.get_parent()
	return is_instance_valid(parent) and str(parent.name).begins_with("BTSlot_")

func _get_bt_slot_defeat_anchor(_slot_id: String) -> Vector2:
	return _get_battle_ally_slot_center_in_wrap()

func _get_bt_pet_defeat_center_y(wrap: Control, slot: Control, sprite: CanvasItem) -> float:
	return _get_ally_defeated_anchor_from_sprite(wrap, slot, sprite).y

func _wild_battle_player_sprite_extra_scale(wrap: Control) -> float:
	if is_instance_valid(wrap) and wrap == _battle_player_wrap and not _is_bt_battle():
		return WILD_BATTLE_PLAYER_SPRITE_EXTRA_SCALE
	return 1.0

func _layout_bt_player_visual_in_cell(wrap: Control, player_anim: Node) -> void :
	var cid: = _bt_character_id_for_wrap(wrap)
	var slot_center: = BT_SLOT_SPRITE_OFFSET + Vector2(BATTLE_SPRITE_SLOT_SIZE.x, BATTLE_SPRITE_SLOT_SIZE.y) * 0.5
	var fit: = BATTLE_SPRITE_SLOT_SIZE.x / 256.0 * BT_PLAYER_SPRITE_SCALE_MULTIPLIER * _wild_battle_player_sprite_extra_scale(wrap)
	if player_anim is AnimatedSprite2D:
		var anim: = player_anim as AnimatedSprite2D
		var base_scale: = PlayerCharacterConfig.get_battle_sprite_scale(cid)
		anim.centered = true
		anim.position = slot_center
		anim.scale = Vector2(base_scale * fit, base_scale * fit)
		BattleMonsterDefeatEffect.remember_base_scale(anim)
		_apply_battle_sprite_playback_state(anim)
	elif player_anim is TextureRect:
		var tr: = player_anim as TextureRect
		var tex_size: = tr.texture.get_size() if tr.texture else Vector2.ZERO
		var target_h: = PlayerCharacterConfig.get_battle_static_display_height(cid) * fit
		var scale_val: = target_h / tex_size.y if tex_size.y > 0.0 else fit
		var display_size: = Vector2(tex_size.x * scale_val, tex_size.y * scale_val)
		tr.position = BT_SLOT_SPRITE_OFFSET + (BATTLE_SPRITE_SLOT_SIZE - display_size) * 0.5
		BattleMonsterDefeatEffect.remember_base_scale(tr)
	_ensure_player_wrap_foot_shadow(wrap, player_anim)
	if wrap == _battle_player_wrap:
		_sync_player_battle_halo_position()

func _layout_player_visual_in_current_scene(wrap: Control, _character_id: int = -1) -> void :
	if not is_instance_valid(wrap):
		return
	var player_anim: Node = wrap.get_node_or_null("PlayerBattleAnim")
	if player_anim == null:
		player_anim = wrap.get_node_or_null("CoopPlayerBattleAnim")
	if not is_instance_valid(player_anim):
		return
	_layout_bt_player_visual_in_cell(wrap, player_anim)

func _normalize_bt_wrap_container(
	wrap: Control, 
	name_lbl: Label, 
	level_lbl: Label, 
	hp_bar: ProgressBar, 
	block_x: float, 
	block_width: float
) -> void :
	if not is_instance_valid(wrap):
		return
	wrap.custom_minimum_size = BATTLE_GRID_CELL_SIZE
	if not is_instance_valid(hp_bar):
		hp_bar = _ensure_ally_battle_hp_bar_on_wrap(wrap)
	_apply_bt_slot_ally_ui_layout(name_lbl, level_lbl, hp_bar, block_x, block_width)

func _normalize_bt_wrap_sprite(wrap: Control, slot_id: String) -> void :
	if not is_instance_valid(wrap):
		return
	var sprite_slot: = wrap.get_node_or_null("PetSpriteSlot") as Control
	if sprite_slot == null:
		sprite_slot = wrap.get_node_or_null("CoopPetSpriteSlot") as Control
	if is_instance_valid(sprite_slot):
		sprite_slot.position = _bt_pet_sprite_offset()
		var pet_slot_size: = _ally_pet_battle_slot_size()
		sprite_slot.custom_minimum_size = pet_slot_size
		sprite_slot.size = pet_slot_size
	var player_anim: = wrap.get_node_or_null("PlayerBattleAnim")
	if player_anim == null:
		player_anim = wrap.get_node_or_null("CoopPlayerBattleAnim")
	if is_instance_valid(player_anim):
		_layout_bt_player_visual_in_cell(wrap, player_anim)
	if slot_id.ends_with("_pet"):
		var pet_sprite_node: Node = null
		if is_instance_valid(sprite_slot):
			pet_sprite_node = sprite_slot.get_node_or_null("PetBattleSprite")
			if pet_sprite_node == null:
				pet_sprite_node = sprite_slot.get_node_or_null("CoopPetBattleSprite")
		if pet_sprite_node != null:
			_set_ally_pet_sprite_mirror(pet_sprite_node, sprite_slot, true)

func _normalize_bt_wrap_layout(
	wrap: Control, 
	slot_id: String, 
	name_lbl: Label, 
	level_lbl: Label, 
	hp_bar: ProgressBar, 
	block_x: float, 
	block_width: float
) -> void :
	if not is_instance_valid(wrap):
		return
	_normalize_bt_wrap_container(wrap, name_lbl, level_lbl, hp_bar, block_x, block_width)
	var unit_key: = _unit_key_for_wrap(wrap)
	if unit_key != "" and _bt_visual_state(unit_key) != BT_ALLY_VIS_IDLE:
		return
	_normalize_bt_wrap_sprite(wrap, slot_id)

func _is_bt_viewer() -> bool:
	return game_manager != null and game_manager.is_brother_tower_battle and game_manager.brother_tower_role == "viewer"

func _bt_ally_pet_mirror_x() -> bool:
	return true

func _bt_ally_defeat_flip_horizontal() -> bool:
	return false

func _resume_bt_sprite_idle(sprite: Node) -> void :
	if not is_instance_valid(sprite):
		return
	var spr: = sprite as AnimatedSprite2D
	if spr != null:
		_apply_battle_sprite_playback_state(spr)

func _sync_bt_battle_sprite_refs() -> void :
	if not _uses_coop_ally_slots():
		return
	if is_instance_valid(_battle_player_wrap):
		var player_anim: = _battle_player_wrap.get_node_or_null("PlayerBattleAnim")
		if is_instance_valid(player_anim):
			_battle_player_sprite = player_anim
	if is_instance_valid(_battle_pet_wrap):
		var pet_slot: = _battle_pet_wrap.get_node_or_null("PetSpriteSlot") as Control
		if is_instance_valid(pet_slot):
			var pet_sprite: = pet_slot.get_node_or_null("PetBattleSprite")
			if is_instance_valid(pet_sprite):
				_battle_pet_sprite = pet_sprite
	if is_instance_valid(_battle_coop_player_wrap):
		var coop_player_anim: = _battle_coop_player_wrap.get_node_or_null("CoopPlayerBattleAnim")
		if is_instance_valid(coop_player_anim):
			_battle_coop_player_sprite = coop_player_anim
	if is_instance_valid(_battle_coop_pet_wrap):
		var coop_slot: = _battle_coop_pet_wrap.get_node_or_null("CoopPetSpriteSlot") as Control
		if is_instance_valid(coop_slot):
			var coop_pet_sprite: = coop_slot.get_node_or_null("CoopPetBattleSprite")
			if is_instance_valid(coop_pet_sprite):
				_battle_coop_pet_sprite = coop_pet_sprite

func _resume_bt_alive_units_idle() -> void :
	if not _uses_coop_ally_slots() or not game_manager:
		return
	if is_instance_valid(_battle_player_sprite) and not _ally_player_defeat_applied and _bt_visual_state("local_player") == BT_ALLY_VIS_IDLE:
		var player: = _get_battle_display_player()
		if player and player.is_alive():
			_resume_bt_sprite_idle(_battle_player_sprite)
	if is_instance_valid(_battle_pet_sprite) and not _ally_pet_defeat_applied and _bt_visual_state("local_pet") == BT_ALLY_VIS_IDLE:
		var pet = _get_battle_display_pet()
		if pet and pet.hp > 0:
			_resume_bt_sprite_idle(_battle_pet_sprite)
	if is_instance_valid(_battle_coop_player_sprite) and not _ally_coop_player_defeat_applied and _bt_visual_state("coop_player") == BT_ALLY_VIS_IDLE:
		var coop_player = _get_coop_battle_unit("coop_player")
		if coop_player and coop_player.is_alive():
			_resume_bt_sprite_idle(_battle_coop_player_sprite)
	if is_instance_valid(_battle_coop_pet_sprite) and not _ally_coop_pet_defeat_applied and _bt_visual_state("coop_pet") == BT_ALLY_VIS_IDLE:
		var coop_pet = _get_coop_battle_unit("coop_pet")
		if coop_pet and coop_pet.is_alive():
			_resume_bt_sprite_idle(_battle_coop_pet_sprite)

func _sync_bt_battle_sprite_refs_and_idle() -> void :
	_sync_bt_battle_sprite_refs()
	_resume_bt_alive_units_idle()

func _force_clear_ally_defeat_fx_on_wrap(wrap) -> void :
	if wrap == null or not is_instance_valid(wrap):
		return
	if not (wrap is Control):
		return
	var wrap_ctrl: = wrap as Control
	var dizzy = wrap_ctrl.get_node_or_null(BattleMonsterDefeatEffect.DIZZY_NODE_NAME)
	if dizzy:
		dizzy.queue_free()
	var defeated = wrap_ctrl.get_node_or_null(BattleMonsterDefeatEffect.DEFEATED_STATIC_NAME)
	if defeated:
		defeated.queue_free()
	for node_name in ["PlayerBattleAnim", "CoopPlayerBattleAnim"]:
		var node = wrap_ctrl.get_node_or_null(node_name)
		if node is CanvasItem:
			node.visible = true
			node.modulate = Color.WHITE
			if node is AnimatedSprite2D:
				_layout_player_visual_in_current_scene(wrap_ctrl)
				BattleMonsterDefeatEffect.remember_base_scale(node)
				_apply_battle_sprite_playback_state(node as AnimatedSprite2D)
	FootShadow.set_visible_on(wrap_ctrl, true)
	for slot_name in ["PetSpriteSlot", "CoopPetSpriteSlot"]:
		var slot = wrap_ctrl.get_node_or_null(slot_name) as Control
		if not is_instance_valid(slot):
			continue
		var slot_defeated = slot.get_node_or_null(BattleMonsterDefeatEffect.DEFEATED_STATIC_NAME)
		if slot_defeated:
			slot_defeated.queue_free()
		for pet_sprite_name in ["PetBattleSprite", "CoopPetBattleSprite"]:
			var pet_node = slot.get_node_or_null(pet_sprite_name)
			if pet_node is CanvasItem:
				pet_node.visible = true
				pet_node.modulate = Color.WHITE
			if pet_node is AnimatedSprite2D:
				_set_ally_pet_sprite_mirror(pet_node, slot, _bt_ally_pet_mirror_x())
				_apply_battle_sprite_playback_state(pet_node as AnimatedSprite2D)
		FootShadow.set_visible_on(slot, true)

func _null_stale_battle_wrap_ref(wrap_ref: Control) -> Control:
	if wrap_ref != null and not is_instance_valid(wrap_ref):
		return null
	return wrap_ref

func _reset_brother_tower_ally_defeat_on_wave_start() -> void :
	if not _is_bt_battle():
		return
	_battle_player_wrap = _null_stale_battle_wrap_ref(_battle_player_wrap)
	_battle_pet_wrap = _null_stale_battle_wrap_ref(_battle_pet_wrap)
	_battle_coop_player_wrap = _null_stale_battle_wrap_ref(_battle_coop_player_wrap)
	_battle_coop_pet_wrap = _null_stale_battle_wrap_ref(_battle_coop_pet_wrap)
	_sync_bt_battle_sprite_refs()
	for wrap in [_battle_player_wrap, _battle_pet_wrap, _battle_coop_player_wrap, _battle_coop_pet_wrap]:
		if wrap != null and is_instance_valid(wrap):
			_force_clear_ally_defeat_fx_on_wrap(wrap)
	_ally_pet_defeat_applied = false
	_ally_player_defeat_applied = false
	_ally_coop_player_defeat_applied = false
	_ally_coop_pet_defeat_applied = false
	_reset_bt_ally_visual_states()
	_set_bt_visual_state("local_player", BT_ALLY_VIS_IDLE)
	_set_bt_visual_state("local_pet", BT_ALLY_VIS_IDLE)
	_set_bt_visual_state("coop_player", BT_ALLY_VIS_IDLE)
	_set_bt_visual_state("coop_pet", BT_ALLY_VIS_IDLE)
	_resume_bt_alive_units_idle()
	_set_player_battle_halo_battle_visible(true)

func _set_ally_pet_sprite_mirror(sprite: Node, slot: Control, mirror_x: bool) -> void :
	if sprite == null or not is_instance_valid(slot):
		return
	var slot_size: = slot.size
	if slot_size.x <= 0.0:
		slot_size = _ally_pet_battle_slot_size()
	if sprite is AnimatedSprite2D:
		var anim: = sprite as AnimatedSprite2D
		var scale_val: = slot_size.x / 256.0
		anim.scale = Vector2( - scale_val, scale_val) if mirror_x else Vector2(scale_val, scale_val)
		anim.position = _battle_sprite_slot_center(slot_size)
		BattleMonsterDefeatEffect.remember_base_scale(anim)
	elif sprite is TextureRect:
		var tr: = sprite as TextureRect
		var tex_size: = tr.texture.get_size() if tr.texture else tr.size
		if tex_size.x <= 0.0 or tex_size.y <= 0.0:
			tex_size = _ally_pet_battle_slot_size()
		var fit: = minf(_ally_pet_battle_slot_size().x / tex_size.x, _ally_pet_battle_slot_size().y / tex_size.y)
		var display_size: = tex_size * fit
		tr.scale = Vector2( - fit, fit) if mirror_x else Vector2(fit, fit)
		if mirror_x:
			tr.position = Vector2((slot_size.x + display_size.x) * 0.5, (slot_size.y - display_size.y) * 0.5)
		else:
			tr.position = (slot_size - display_size) * 0.5
		BattleMonsterDefeatEffect.remember_base_scale(tr)

func _enforce_ally_pet_sprites_mirror() -> void :
	if is_instance_valid(_battle_pet_wrap) and is_instance_valid(_battle_pet_sprite):
		var pet_slot: = _battle_pet_wrap.get_node_or_null("PetSpriteSlot") as Control
		if is_instance_valid(pet_slot) and _bt_visual_state("local_pet") == BT_ALLY_VIS_IDLE:
			_set_ally_pet_sprite_mirror(_battle_pet_sprite, pet_slot, true)
	if is_instance_valid(_battle_coop_pet_wrap) and is_instance_valid(_battle_coop_pet_sprite):
		var coop_slot: = _battle_coop_pet_wrap.get_node_or_null("CoopPetSpriteSlot") as Control
		if is_instance_valid(coop_slot) and _bt_visual_state("coop_pet") == BT_ALLY_VIS_IDLE:
			_set_ally_pet_sprite_mirror(_battle_coop_pet_sprite, coop_slot, true)

func _enforce_bt_pet_sprites_mirror() -> void :
	_enforce_ally_pet_sprites_mirror()

func _bt_pet_sprite_offset() -> Vector2:
	var size_delta: = _ally_pet_battle_slot_size() - BATTLE_SPRITE_SLOT_SIZE
