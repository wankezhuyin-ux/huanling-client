func _update_avatar_texture(container: Control, asset_name: String, asset_type: String = "portrait"):
	if not container:
		return

	var should_update = false

	match asset_type:
		"pet":
			if _cached_pet_texture != asset_name:
				_cached_pet_texture = asset_name
				should_update = true
		"player":
			if _cached_player_texture != asset_name:
				_cached_player_texture = asset_name
				should_update = true
		_:
			should_update = true

	if not should_update:
		return

	var texture: Texture2D = null
	if asset_name != "":
		match asset_type:
			"pet":
				texture = AssetManager.get_instance().get_pet_texture(asset_name)
			"monster":
				texture = AssetManager.get_instance().get_monster_texture(asset_name)
			_:
				texture = AssetManager.get_instance().get_portrait(asset_name)

	var texture_rect_name = "AvatarTexture"
	var existing_texture = container.get_node_or_null(texture_rect_name)

	var avatar_size = Vector2(80, 80)
	if asset_type == "pet":
		avatar_size = container.custom_minimum_size
		if avatar_size.x <= 0.0 or avatar_size.y <= 0.0:
			avatar_size = Vector2(60, 60)
	elif asset_type == "monster":
		avatar_size = Vector2(60, 60)

	if texture:
		if existing_texture:
			existing_texture.texture = texture
			existing_texture.custom_minimum_size = avatar_size
			if asset_type == "pet":
				existing_texture.mouse_filter = Control.MOUSE_FILTER_IGNORE
				_apply_pet_avatar_mirror(existing_texture, container)
		else:
			var new_texture_rect = TextureRect.new()
			new_texture_rect.name = texture_rect_name
			new_texture_rect.texture = texture
			new_texture_rect.custom_minimum_size = avatar_size
			new_texture_rect.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
			new_texture_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			if asset_type == "pet":
				new_texture_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
			else:
				new_texture_rect.set_anchors_preset(Control.PRESET_FULL_RECT)
			container.add_child(new_texture_rect)
			if asset_type == "pet":
				_apply_pet_avatar_mirror(new_texture_rect, container)
		if container is ColorRect:
			container.color = Color(0, 0, 0, 0)
		container.visible = true
	else:
		if existing_texture:
			existing_texture.queue_free()
		if container is ColorRect:
			container.color = Color(0.2, 0.2, 0.2, 0.5)
		container.visible = true

func _get_player_character_id() -> int:
	if _is_bt_battle():
		var snap_player: = _get_bt_snapshot_player_dict()
		if not snap_player.is_empty():
			return PlayerCharacterConfig.normalize_id(int(snap_player.get("player_character_id", 0)))
	if _is_arena_battle() and game_manager:
		return PlayerCharacterConfig.normalize_id(game_manager.arena_battle_character_id)
	if game_manager and game_manager.player:
		return PlayerCharacterConfig.normalize_id(game_manager.player.player_character_id)
	return 0

func _get_player_avatar_texture(character_id: int = -1) -> Texture2D:
	var cid: = _get_player_character_id() if character_id < 0 else PlayerCharacterConfig.normalize_id(character_id)
	var path: = PlayerCharacterConfig.get_avatar_tx_path(cid)
	if not ResourceLoader.exists(path):
		path = PlayerCharacterConfig.get_avatar_tx_path(0)
	var tex: = load(path) as Texture2D
	return tex

func _invalidate_player_visual_cache() -> void :
	_cached_player_texture = ""
	_cached_player_character_id = -1
	_player_defeated_static_by_cid.clear()

func _refresh_all_player_visuals() -> void :
	_invalidate_player_visual_cache()
	_update_player_battle_panel_avatar()
	if is_instance_valid(_battle_player_wrap):
		_recreate_player_battle_sprite_only()
	elif battle_view and battle_view.visible:
		var field = get_node_or_null("MainContent/BattleView/BattlePanel/SpriteField")
		if field:
			_create_player_battle_wrap(field)
	_refresh_player_battle_display()
	_refresh_character_stats_view()
	# 角色页左栏那张人物卡（立绘/名字/战力）是单独一块，不在属性表里。
	# 换完角色不重建它，玩家站在角色页点完「确定」会发现立绘还是上一个角色 ——
	# 看着就像「切换没生效」。重建放在这里，一次覆盖战斗面板 + 属性表 + 立绘。
	if is_instance_valid(character_hero_column):
		_refresh_character_hero_column()
	_update_player_ui()

func _update_player_battle_panel_avatar() -> void :
	if not player_avatar_rect:
		return
	var cid: = _get_player_character_id()
	var cache_key: = PlayerCharacterConfig.get_avatar_tx_name(cid)
	if _cached_player_texture == cache_key and _cached_player_character_id == cid:
		return
	_cached_player_texture = cache_key
	_cached_player_character_id = cid
	var avatar_tex: = _get_player_avatar_texture(cid)
	var texture_rect_name: = "AvatarTexture"
	var existing_texture = player_avatar_rect.get_node_or_null(texture_rect_name)
	var avatar_size: = Vector2(80, 80)
	if existing_texture:
		existing_texture.texture = avatar_tex
		existing_texture.custom_minimum_size = avatar_size
		existing_texture.mouse_filter = Control.MOUSE_FILTER_IGNORE
	else:
		var new_texture_rect: = TextureRect.new()
		new_texture_rect.name = texture_rect_name
		new_texture_rect.texture = avatar_tex
		new_texture_rect.custom_minimum_size = avatar_size
		new_texture_rect.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
		new_texture_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		new_texture_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		new_texture_rect.set_anchors_preset(Control.PRESET_FULL_RECT)
		player_avatar_rect.add_child(new_texture_rect)
	if player_avatar_rect is ColorRect:
		player_avatar_rect.color = Color(0, 0, 0, 0)
	player_avatar_rect.visible = true

