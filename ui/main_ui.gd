func _is_bt_battle() -> bool:
	return game_manager != null and game_manager.is_brother_tower_battle

func _is_shengsi_replay() -> bool:
	return game_manager != null and bool(game_manager.is_shengsi_tower_replay)

func _uses_coop_ally_slots() -> bool:
	return _is_bt_battle() or _is_shengsi_replay()

func _get_battle_display_pet() -> Pet:
	if (_is_bt_battle() or _is_arena_battle()) and game_manager and game_manager.battle_system:
		var battle_pet = game_manager.battle_system.active_pet
		if battle_pet:
			return battle_pet
	if game_manager and game_manager.pet_manager:
		return game_manager.pet_manager.get_active_pet()
	return null

func _get_bt_snapshot_player_dict() -> Dictionary:
	if not game_manager:
		return {}
	var snap: Dictionary = game_manager.brother_tower_local_snapshot
	if snap.is_empty():
		return {}
	var player_raw = snap.get("player")
	return player_raw if player_raw is Dictionary else {}

func _get_battle_display_player() -> Player:
	if (_is_bt_battle() or _is_arena_battle()) and game_manager and game_manager.battle_system:
		var battle_player = game_manager.battle_system.player
		if battle_player:
			return battle_player
	if game_manager:
		return game_manager.player
	return null

func _get_wrap_origin_in_field(wrap: Control) -> Vector2:
	if not is_instance_valid(wrap):
		return Vector2.ZERO
	var parent: = wrap.get_parent()
	if is_instance_valid(parent) and str(parent.name).begins_with("BTSlot_"):
		return parent.position + wrap.position
	return wrap.position

func _safe_battle_canvas_item(node: Variant) -> CanvasItem:
	if node == null or not is_instance_valid(node):
		return null
	if node is CanvasItem:
		return node as CanvasItem
	return null

func _get_ally_wrap_for_hit_type(hit_type: String) -> Control:
	match hit_type:
		"player":
			return _battle_player_wrap
		"pet":
			return _battle_pet_wrap
		"coop_player":
			return _battle_coop_player_wrap
		"coop_pet":
			return _battle_coop_pet_wrap
	return null

func _get_ally_head_pos_in_field_for_wrap(wrap: Control, sprite: CanvasItem = null) -> Vector2:
	if not is_instance_valid(wrap):
		return Vector2.ZERO
	var origin: = _get_wrap_origin_in_field(wrap)
	var pet_slot: = wrap.get_node_or_null("PetSpriteSlot") as Control
	if pet_slot == null:
		pet_slot = wrap.get_node_or_null("CoopPetSpriteSlot") as Control
	if is_instance_valid(pet_slot):
		origin += pet_slot.position
		if is_instance_valid(sprite) and sprite is AnimatedSprite2D:
			return _get_sprite_visual_head_in_field(sprite as AnimatedSprite2D, origin + sprite.position)
		if is_instance_valid(sprite) and sprite is TextureRect:
			var tr: = sprite as TextureRect
			var display_size: Vector2 = tr.size * tr.scale
			return origin + tr.position + Vector2(display_size.x * 0.5, 0.0)
		return origin + Vector2(pet_slot.size.x * 0.5, 0.0)
	if is_instance_valid(sprite) and sprite is AnimatedSprite2D:
		return _get_sprite_visual_head_in_field(sprite as AnimatedSprite2D, origin + sprite.position)
	if is_instance_valid(sprite) and sprite is TextureRect:
		var tr2: = sprite as TextureRect
		var display: = tr2.size * tr2.scale
		return origin + tr2.position + Vector2(display.x * 0.5, 0.0)
	var slot_id: = _resolve_bt_slot_id_for_wrap(wrap)
	if slot_id != "":
		return origin + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + 40.0)
	return origin + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + 40.0)

func _get_sprite_visual_head_in_field(sprite: AnimatedSprite2D, origin_in_field: Vector2, visual_scale: float = 1.0) -> Vector2:
	var rect: = _get_animated_sprite_visual_rect(sprite)
	return origin_in_field + rect.position * visual_scale + Vector2(rect.size.x * visual_scale * 0.5, 0.0)

func _get_player_sprite_origin_in_field() -> Vector2:
	if is_instance_valid(_battle_player_wrap):
		return _get_wrap_origin_in_field(_battle_player_wrap)
	if is_instance_valid(_battle_player_sprite):
		return _battle_player_sprite.position
	return _get_player_battle_wrap_pos()

func _get_player_head_pos_in_field() -> Vector2:
	if not is_instance_valid(_battle_player_wrap):
		var pos: = _get_player_battle_wrap_pos()
		return pos + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + 40.0)
	return _get_ally_head_pos_in_field_for_wrap(_battle_player_wrap, _safe_battle_canvas_item(_battle_player_sprite))

func _get_pet_head_pos_in_field() -> Vector2:
	if not is_instance_valid(_battle_pet_wrap):
		var pos: = _get_pet_battle_wrap_pos()
		return pos + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, _bt_pet_sprite_offset().y + _ally_pet_battle_slot_size().y * 0.5)
	return _get_ally_head_pos_in_field_for_wrap(_battle_pet_wrap, _safe_battle_canvas_item(_battle_pet_sprite))

func _get_coop_player_head_pos_in_field() -> Vector2:
	if not is_instance_valid(_battle_coop_player_wrap):
		var pos: = _get_bt_unit_field_pos("coop_player") if _uses_coop_ally_slots() else Vector2.ZERO
		return pos + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + 40.0)
	return _get_ally_head_pos_in_field_for_wrap(_battle_coop_player_wrap, _safe_battle_canvas_item(_battle_coop_player_sprite))

func _get_coop_pet_head_pos_in_field() -> Vector2:
	if not is_instance_valid(_battle_coop_pet_wrap):
		var pos: = _get_bt_unit_field_pos("coop_pet") if _uses_coop_ally_slots() else Vector2.ZERO
		return pos + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, _bt_pet_sprite_offset().y + _ally_pet_battle_slot_size().y * 0.5)
	return _get_ally_head_pos_in_field_for_wrap(_battle_coop_pet_wrap, _safe_battle_canvas_item(_battle_coop_pet_sprite))

func _battle_slot_visual_scale(slot: Control) -> float:
	var s: float = slot.scale.x
	return s if absf(s) > 0.001 else 1.0


func _battle_slot_scaled_origin_in_field(monster_ui: Control, slot: Control) -> Vector2:
	# 精灵槽是按「底部中心」缩放的，缩放后左上角会往右下让开一点；
	# 飘字、受击特效都从这个原点算，不修正的话远处的怪会偏十几像素。
	var s: = _battle_slot_visual_scale(slot)
	if absf(s - 1.0) < 0.001:
		return monster_ui.position + slot.position
	return monster_ui.position + slot.position + Vector2(slot.size.x * (1.0 - s) * 0.5, slot.size.y * (1.0 - s))


func _get_monster_head_pos_in_field(monster_ui: Control) -> Vector2:
	var slot: = monster_ui.get_node_or_null("MonsterSpriteSlot") as Control
	if slot:
		var sprite = slot.find_child("MonsterSprite", true, false)
		var origin: Vector2 = _battle_slot_scaled_origin_in_field(monster_ui, slot)
		var s: = _battle_slot_visual_scale(slot)
		if is_instance_valid(sprite) and sprite is AnimatedSprite2D:
			return _get_sprite_visual_head_in_field(sprite, origin, s)
		if is_instance_valid(sprite) and sprite is TextureRect:
			var tr: = sprite as TextureRect
			var display_size: Vector2 = tr.size * tr.scale * s
			return origin + tr.position * s + Vector2(display_size.x * 0.5, 0.0)
		return origin + Vector2(slot.size.x * s * 0.5, 0.0)
	return monster_ui.position + Vector2(MONSTER_BATTLE_GRID_CELL_SIZE.x * 0.5, 8.0)

func _get_monster_sprite_center_in_field(monster_ui: Control) -> Vector2:
	var slot: = monster_ui.get_node_or_null("MonsterSpriteSlot") as Control
	if slot:
		var sprite = slot.find_child("MonsterSprite", true, false)
		var origin: Vector2 = _battle_slot_scaled_origin_in_field(monster_ui, slot)
		var s: = _battle_slot_visual_scale(slot)
		if is_instance_valid(sprite) and sprite is AnimatedSprite2D:
			var rect: = _get_animated_sprite_visual_rect(sprite)
			return origin + rect.position * s + rect.size * s * 0.5
		if is_instance_valid(sprite) and sprite is TextureRect:
			var tr: = sprite as TextureRect
			var display_size: Vector2 = tr.size * tr.scale * s
			return origin + tr.position * s + display_size * 0.5
		return origin + slot.size * s * 0.5
	return monster_ui.position + MONSTER_BATTLE_GRID_CELL_SIZE * 0.5

func _get_player_sprite_center_in_field() -> Vector2:
	return _get_player_head_pos_in_field()

func _get_pet_sprite_center_in_field() -> Vector2:
	return _get_pet_head_pos_in_field()

func _get_ally_sprite_for_hit_type(hit_type: String) -> CanvasItem:
	match hit_type:
		"player":
			return _safe_battle_canvas_item(_battle_player_sprite)
		"pet":
			return _safe_battle_canvas_item(_battle_pet_sprite)
		"coop_player":
			return _safe_battle_canvas_item(_battle_coop_player_sprite)
		"coop_pet":
			return _safe_battle_canvas_item(_battle_coop_pet_sprite)
	return null

func _get_ally_head_pos_at_home_in_field(hit_type: String) -> Vector2:
	var wrap: = _get_ally_wrap_for_hit_type(hit_type)
	if not is_instance_valid(wrap):
		match hit_type:
			"player":
				return _get_player_head_pos_in_field()
			"pet":
				return _get_pet_head_pos_in_field()
			"coop_player":
				return _get_coop_player_head_pos_in_field()
			"coop_pet":
				return _get_coop_pet_head_pos_in_field()
		return Vector2.ZERO
	var live_head: = _get_ally_head_pos_in_field_for_wrap(wrap, _get_ally_sprite_for_hit_type(hit_type))
	var live_origin: = _get_wrap_origin_in_field(wrap)
	var home: = _battle_wrap_home_field_pos(wrap)
	return home + (live_head - live_origin)

func _get_monster_head_pos_at_home_in_field(monster_ui: Control) -> Vector2:
	if not is_instance_valid(monster_ui):
		return Vector2.ZERO
	var live_head: = _get_monster_head_pos_in_field(monster_ui)
	var home: Vector2 = monster_ui.position
	if monster_ui.has_meta("_battle_home_pos"):
		home = monster_ui.get_meta("_battle_home_pos")
	elif monster_ui.has_meta("_lunge_home_pos"):
		home = _battle_wrap_home_field_pos(monster_ui)
	return home + (live_head - monster_ui.position)

func _get_battle_popup_anchor_pos(anchor: String, anchor_index: int = -1) -> Vector2:
	var field = monster_container
	if not field:
		return Vector2.ZERO
	match anchor:
		"player":
			return _field_local_to_panel_pos(_get_ally_head_pos_at_home_in_field("player"))
		"pet":
			return _field_local_to_panel_pos(_get_ally_head_pos_at_home_in_field("pet"))
		"coop_player":
			return _field_local_to_panel_pos(_get_ally_head_pos_at_home_in_field("coop_player"))
		"coop_pet":
			return _field_local_to_panel_pos(_get_ally_head_pos_at_home_in_field("coop_pet"))
		"monster":
			if anchor_index >= 0 and anchor_index < monster_ui_nodes.size():
				var mui = monster_ui_nodes[anchor_index]
				if is_instance_valid(mui):
					return _field_local_to_panel_pos(_get_monster_head_pos_at_home_in_field(mui))
			var field_size_m: Vector2 = field.size
			if field_size_m.x <= 0.0 or field_size_m.y <= 0.0:
				field_size_m = Vector2(400.0, 320.0)
			return field.position + Vector2(field_size_m.x * 0.5, field_size_m.y * 0.42)
		"center":
			var field_size: Vector2 = field.size
			if field_size.x <= 0.0 or field_size.y <= 0.0:
				field_size = Vector2(400.0, 320.0)
			return field.position + Vector2(field_size.x * 0.5, field_size.y * 0.42)
		_:
			return field.position + field.size * 0.5

func _format_battle_moment_display(moment_type: String, text: String) -> String:
	match moment_type:
		"battle_start":
			return "★ %s ★" % text
		"combo":
			return "【 %s 】" % text
		"joint":
			return "【 %s 】" % text
		"skill":
			return text
		_:
			return text

func _create_battle_moment_card(moment_type: String, text: String, accent: Color, large: bool) -> Control:
	if moment_type == "skill":
		return _create_skill_burst_banner(text)
	var wrap = PanelContainer.new()
	wrap.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var style = StyleBoxFlat.new()
	style.set_border_width_all(1)
	style.set_corner_radius_all(6)
	style.shadow_color = Color(0.0, 0.0, 0.0, 0.45)
	style.shadow_size = 3
	style.shadow_offset = Vector2(0, 1)
	match moment_type:
		"combo":
			style.bg_color = Color(0.06, 0.28, 0.12, 0.9)
			style.border_color = Color(0.45, 0.95, 0.55, 1.0)
		"joint":
			style.bg_color = Color(0.32, 0.14, 0.04, 0.9)
			style.border_color = Color(1.0, 0.62, 0.22, 1.0)
		"battle_start":
			style.bg_color = Color(0.12, 0.14, 0.22, 0.92)
			style.border_color = Color(0.75, 0.82, 1.0, 1.0)
			style.set_border_width_all(2)
		_:
			style.bg_color = Color(0.08, 0.08, 0.1, 0.88)
			style.border_color = accent
	style.content_margin_left = 8
	style.content_margin_right = 8
	style.content_margin_top = 3
	style.content_margin_bottom = 3
	wrap.add_theme_stylebox_override("panel", style)
	var lbl = Label.new()
	lbl.text = _format_battle_moment_display(moment_type, text)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.add_theme_font_size_override("font_size", 18 if large else 15)
	lbl.add_theme_color_override("font_color", accent)
	lbl.add_theme_constant_override("outline_size", 3)
	lbl.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.9))
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wrap.add_child(lbl)
	return wrap

func _create_skill_burst_banner(text: String) -> Control:
	var wrap: = Control.new()
	wrap.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wrap.custom_minimum_size = SKILL_BURST_BANNER_SIZE
	wrap.size = SKILL_BURST_BANNER_SIZE
	var tex: = TextureRect.new()
	tex.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tex.texture = load(SKILL_BURST_BANNER_PATH) as Texture2D
	tex.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tex.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tex.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	wrap.add_child(tex)
	var lbl: = Label.new()
	lbl.text = _format_battle_moment_display("skill", text)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.add_theme_font_size_override("font_size", 16)
	lbl.add_theme_color_override("font_color", Color(0.08, 0.08, 0.08, 1.0))
	lbl.add_theme_constant_override("outline_size", 0)
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	lbl.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	wrap.add_child(lbl)
	return wrap

func _skill_burst_spread_offset(stack_idx: int) -> Vector2:
	var n: = SKILL_BURST_SPREAD_OFFSETS.size()
	if n <= 0:
		return Vector2.ZERO
	var idx: = maxi(0, stack_idx)
	var base: Vector2 = SKILL_BURST_SPREAD_OFFSETS[idx % n]
	var ring: = idx / n
	return base + Vector2(0.0, - float(ring) * 90.0)

func _show_battle_floating_text(anchor: String, text: String, color: Color, large: bool = false, moment_type: String = "", anchor_index: int = -1) -> void :
	_ensure_battle_banner_layer()
	if not _battle_banner_layer:
		return
	if moment_type == "":
		moment_type = anchor
	if text == "一击三伤":
		if anchor == "pet":
			anchor = "player"
		elif anchor == "coop_pet":
			anchor = "coop_player"
	var stack_key: = anchor
	if anchor == "monster" and anchor_index >= 0:
		stack_key = "monster_%d" % anchor_index
	if moment_type == "skill":
		stack_key = "%s_skill" % stack_key
	var stack_idx: int = int(_battle_popup_stack.get(stack_key, 0))
	_battle_popup_stack[stack_key] = stack_idx + 1
	var card = _create_battle_moment_card(moment_type, text, color, large)
	var y_stack_offset: = float(stack_idx) * (26.0 if large else 22.0)
	_battle_banner_layer.add_child(card)
	card.reset_size()
	card.pivot_offset = card.size * 0.5
	var anchor_pos = _get_battle_popup_anchor_pos(anchor, anchor_index)
	var center_pos: Vector2
	var end_pos: Vector2
	var on_unit: = anchor == "player" or anchor == "pet" or anchor == "coop_player" or anchor == "coop_pet" or (anchor == "monster" and anchor_index >= 0)
	var spread_idx: = 0 if text == "一击三伤" else stack_idx
	if on_unit:
		var stack_off: = Vector2(0.0, - float(stack_idx) * 20.0)
		if moment_type == "skill":
			stack_off = _skill_burst_spread_offset(spread_idx)

		center_pos = anchor_pos + BATTLE_SKILL_BANNER_ALLY_OFFSET + stack_off
		if moment_type == "skill" and anchor in ["player", "coop_player"]:
			center_pos += PLAYER_SKILL_BURST_NUDGE
		end_pos = center_pos + Vector2(0.0, - BATTLE_DAMAGE_FLOAT_RISE)
	else:
		var extra: = y_stack_offset
		if moment_type == "skill":
			center_pos = anchor_pos + Vector2(0.0, - card.size.y * 0.5 - 8.0) + _skill_burst_spread_offset(spread_idx)
		else:
			center_pos = anchor_pos + Vector2(0.0, - card.size.y * 0.5 - 8.0 - extra)
		end_pos = center_pos + Vector2(0.0, -12.0)
	card.position = center_pos - card.pivot_offset
	card.scale = Vector2(0.88, 0.88)
	card.modulate = Color(1.0, 1.0, 1.0, 0.0)
	var tween = create_tween()
	tween.bind_node(card)
	tween.set_parallel(true)
	tween.tween_property(card, "modulate:a", 1.0, 0.12)
	tween.tween_property(card, "scale", Vector2(1.03, 1.03), 0.2).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(card, "position", end_pos - card.pivot_offset, 0.55).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.set_parallel(false)
	tween.tween_property(card, "scale", Vector2.ONE, 0.12).set_trans(Tween.TRANS_SINE)
	tween.tween_interval(BATTLE_BANNER_LIFETIME)
	tween.tween_property(card, "modulate:a", 0.0, 0.28)
	tween.tween_callback( func() -> void :
		if is_instance_valid(card):
			card.queue_free()
		_battle_popup_stack[stack_key] = maxi(0, int(_battle_popup_stack.get(stack_key, 1)) - 1)
	)

func _is_battle_ally_name(unit_name: String) -> bool:
	if not game_manager or not game_manager.battle_system:
		return false
	var bs = game_manager.battle_system
	if bs.player and bs.player.player_name == unit_name:
		return true
	if bs.active_pet and bs.active_pet.pet_name == unit_name:
		return true
	for cu in bs.coop_units:
		if cu != null and str(cu.display_name) == unit_name:
			return true
	return false

func _get_battle_damage_stack_key(hit_target_type: String, hit_target_index: int) -> String:
	match hit_target_type:
		"monster":
			if hit_target_index >= 0:
				return "monster_%d" % hit_target_index
		"player":
			return "player"
		"pet":
			return "pet"
		"coop_player":
			return "coop_player_%d" % hit_target_index
		"coop_pet":
			return "coop_pet_%d" % hit_target_index
	return "unknown"


func _get_ally_sprite_center_in_field_for_wrap(wrap: Control, sprite: CanvasItem = null) -> Vector2:
	if not is_instance_valid(wrap):
		return Vector2.ZERO
	var origin: = _get_wrap_origin_in_field(wrap)
	var pet_slot: = wrap.get_node_or_null("PetSpriteSlot") as Control
	if pet_slot == null:
		pet_slot = wrap.get_node_or_null("CoopPetSpriteSlot") as Control
	if is_instance_valid(pet_slot):
		origin += pet_slot.position
	if is_instance_valid(sprite) and sprite is AnimatedSprite2D:
		var rect: = _get_animated_sprite_visual_rect(sprite as AnimatedSprite2D)
		return origin + rect.position + rect.size * 0.5
	if is_instance_valid(sprite) and sprite is TextureRect:
		var tr: = sprite as TextureRect
		var display_size: Vector2 = tr.size * tr.scale
		return origin + tr.position + display_size * 0.5
	if is_instance_valid(pet_slot):
		return origin + pet_slot.size * 0.5
	return origin + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + BATTLE_SPRITE_SLOT_SIZE.y * 0.5)

func _get_ally_sprite_center_in_field(hit_type: String) -> Vector2:
	var wrap: = _get_ally_wrap_for_hit_type(hit_type)
	if is_instance_valid(wrap):
		return _get_ally_sprite_center_in_field_for_wrap(wrap, _get_ally_sprite_for_hit_type(hit_type))
	match hit_type:
		"player":
			return _get_player_battle_wrap_pos() + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + BATTLE_SPRITE_SLOT_SIZE.y * 0.5)
		"pet":
			return _get_pet_battle_wrap_pos() + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, _bt_pet_sprite_offset().y + _ally_pet_battle_slot_size().y * 0.5)
		"coop_player":
			return _get_bt_unit_field_pos("coop_player") + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, BT_SLOT_SPRITE_OFFSET.y + BATTLE_SPRITE_SLOT_SIZE.y * 0.5)
		"coop_pet":
			return _get_bt_unit_field_pos("coop_pet") + Vector2(BATTLE_GRID_CELL_SIZE.x * 0.5, _bt_pet_sprite_offset().y + _ally_pet_battle_slot_size().y * 0.5)
	return Vector2.ZERO

func _get_ally_battle_damage_float_panel_pos(ally_hit_type: String) -> Vector2:
	return _field_local_to_panel_pos(_get_ally_sprite_center_in_field(ally_hit_type)) + BATTLE_DAMAGE_FLOAT_MONSTER_START_OFFSET

func _get_battle_damage_float_pos_by_hit(hit_target_type: String, hit_target_index: int) -> Vector2:
	if not is_instance_valid(monster_container):
		return Vector2.ZERO
	match hit_target_type:
		"monster":
			if hit_target_index >= 0 and hit_target_index < monster_ui_nodes.size():
				var ui = monster_ui_nodes[hit_target_index]
				if is_instance_valid(ui):
					return _field_local_to_panel_pos(_get_monster_sprite_center_in_field(ui)) + BATTLE_DAMAGE_FLOAT_MONSTER_START_OFFSET
		"player", "pet":
			return _get_ally_battle_damage_float_panel_pos(hit_target_type)
		"coop_player", "coop_pet":
			return _get_ally_battle_damage_float_panel_pos(hit_target_type)
	return _get_battle_popup_anchor_pos("center")


func _show_battle_damage_float(hit_target_type: String, hit_target_index: int, text: String, color: Color, font_size: int = 20) -> void :
	_ensure_battle_banner_layer()
	if not _battle_banner_layer or text == "":
		return
	var stack_key: = _get_battle_damage_stack_key(hit_target_type, hit_target_index)
	var stack_idx: int = int(_battle_damage_popup_stack.get(stack_key, 0))
	_battle_damage_popup_stack[stack_key] = stack_idx + 1
	var lbl = Label.new()
	lbl.text = text
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.add_theme_font_size_override("font_size", font_size)
	lbl.add_theme_color_override("font_color", color)
	lbl.add_theme_constant_override("outline_size", 3)
	lbl.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.92))
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	lbl.set_meta("battle_damage_float", true)
	_battle_banner_layer.add_child(lbl)
	lbl.reset_size()
	lbl.pivot_offset = lbl.size * 0.5
	var y_stack_offset: = float(stack_idx) * 20.0
	var is_heal: = text.begins_with("+")
	var start_pos = _get_battle_damage_float_pos_by_hit(hit_target_type, hit_target_index) + Vector2(0.0, - y_stack_offset)
	var drift: = Vector2(0.0, - BATTLE_DAMAGE_FLOAT_RISE)
	if is_heal and hit_target_type == "monster":
		start_pos += Vector2(20.0, 0.0)
		drift = Vector2(20.0, -20.0)
	var end_pos = start_pos + drift
	var use_global_top: = _is_world_boss_battle()
	if use_global_top:
		lbl.set_as_top_level(true)
		lbl.z_index = BATTLE_BANNER_LAYER_Z_INDEX
		lbl.global_position = _battle_panel_local_to_global(start_pos) - lbl.pivot_offset
	else:
		lbl.position = start_pos - lbl.pivot_offset
	lbl.scale = Vector2(0.75, 0.75)
	lbl.modulate = Color(1.0, 1.0, 1.0, 0.0)
	var tween = create_tween()
	tween.bind_node(lbl)
	tween.set_parallel(true)
	tween.tween_property(lbl, "modulate:a", 1.0, 0.08)
	var pop: = Vector2(1.12, 1.12) if is_heal else Vector2(1.05, 1.05)
	tween.tween_property(lbl, "scale", pop, 0.14).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	if use_global_top:
		tween.tween_property(lbl, "global_position", _battle_panel_local_to_global(end_pos) - lbl.pivot_offset, 0.65).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	else:
		tween.tween_property(lbl, "position", end_pos - lbl.pivot_offset, 0.65).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.set_parallel(false)
	tween.tween_property(lbl, "scale", Vector2.ONE, 0.1)
	tween.tween_interval(BATTLE_DAMAGE_FLOAT_LIFETIME)
	tween.tween_property(lbl, "modulate:a", 0.0, 0.22)
	tween.tween_callback( func() -> void :
		if is_instance_valid(lbl):
			lbl.queue_free()
		_battle_damage_popup_stack[stack_key] = maxi(0, int(_battle_damage_popup_stack.get(stack_key, 1)) - 1)
	)

func _battle_element_float_kind(element_tag: String) -> String:
	var tag: = element_tag.strip_edges()
	if tag.is_empty():
		return ""
	if tag.contains("被克") or tag.contains("伤害降低"):
		return "被克"
	if tag.contains("相克") or tag.contains("伤害提升"):
		return "克制"
	if tag.contains("克") and not tag.contains("被"):
		return "克制"
	return ""

func _format_battle_damage_float_text(damage: int, is_critical: bool, element_tag: String) -> String:
	if damage <= 0:
		return ""
	var kind: = _battle_element_float_kind(element_tag)
	if kind.is_empty():
		return "暴击 -%d!" % damage if is_critical else "-%d" % damage
	if is_critical:
		return "暴击 %d %s" % [damage, kind]
	return "%d %s" % [damage, kind]

func _on_battle_damage_dealt(attacker: String, target: String, damage: int, is_critical: bool, hit_target_type: String, hit_target_index: int, element_tag: String = "", is_armor_pierce: bool = false, is_counter: bool = false) -> void :
	var text: = ""
	var color: = Color.WHITE
	var font_size: = 16
	if damage <= 0:
		var who: = attacker.strip_edges()
		if who.is_empty():
			who = "攻击"
		if hit_target_type == "monster":
			text = "%s未命中" % who
		else:
			text = "%s被闪" % who
		color = Color(0.45, 0.92, 1.0, 1.0)
		font_size = 16
	elif is_armor_pierce:
		text = _format_battle_damage_float_text(damage, is_critical, element_tag)
		color = Color(0.78, 0.38, 1.0, 1.0)
		font_size = 22 if is_critical else 16
	elif is_counter:
		text = _format_battle_damage_float_text(damage, is_critical, element_tag)
		color = Color(1.0, 0.65, 0.45, 1.0)
		font_size = 22 if is_critical else 16
	elif is_critical:
		text = _format_battle_damage_float_text(damage, true, element_tag)
		color = Color(1.0, 0.86, 0.25, 1.0)
		font_size = 22
	elif hit_target_type == "monster":
		_bst_damage += damage
		text = _format_battle_damage_float_text(damage, false, element_tag)
		color = Color(1.0, 0.38, 0.32, 1.0)
		font_size = 16
	else:
		text = _format_battle_damage_float_text(damage, false, element_tag)
		color = Color(1.0, 0.86, 0.25, 1.0)
		font_size = 16
	# 前面几个分支（暴击/破甲/反击）也会打在怪身上，统一在这里补计，
	# 否则"累计输出"只统计普通命中，数字比玩家看到的伤害飘字小一大截。
	if damage > 0 and hit_target_type == "monster" and not (not is_armor_pierce and not is_counter and not is_critical):
		_bst_damage += damage
	_show_battle_damage_float(hit_target_type, hit_target_index, text, color, font_size)
	_refresh_active_battle_hud()
	_show_hit_target_hp_bar(hit_target_type, hit_target_index)
	var heavy: = is_critical or is_armor_pierce or is_counter
	_on_battle_hit_reaction(hit_target_type, hit_target_index, damage, heavy)


# 受击后退的距离按像素给：普通一刀 7px（约半个字宽），重击 13px。
# 再大就会让人物跳出格子，和斜阵的站位打架。
const BATTLE_HIT_RECOIL_NORMAL: = 7.0
const BATTLE_HIT_RECOIL_HEAVY: = 13.0
const BATTLE_HIT_SHAKE_HEAVY: = 4.0


## 挨打的那一方要有反应：先后退一下，再弹回来；重击还要闪、要震。
## 没有这层，伤害数字就成了"自己跳出来的"，看不出是谁打了谁。
func _on_battle_hit_reaction(hit_target_type: String, hit_target_index: int, damage: int, heavy: bool) -> void :
	if damage <= 0:
		return
	if _is_bt_battle():
		_sync_bt_battle_sprite_refs()
	var sprite: = _resolve_hit_reaction_sprite(hit_target_type, hit_target_index)
	if sprite == null:
		return
	var dir_x: = 1.0 if hit_target_type == "monster" else -1.0
	BattleHitReaction.knock(sprite, dir_x, BATTLE_HIT_RECOIL_HEAVY if heavy else BATTLE_HIT_RECOIL_NORMAL)
	# 已经倒下的人再闪红会顶掉阵亡表现，这里只对还站着的做闪烁
	if not _is_hit_target_downed(hit_target_type, hit_target_index):
		BattleHitReaction.flash(sprite)
	if not heavy:
		return
	var wrap: = _resolve_hit_reaction_wrap(hit_target_type, hit_target_index)
	if is_instance_valid(wrap):
		var center: = _get_hit_target_center_in_field(hit_target_type, hit_target_index)
		BattleSplashHitEffect.play_on_wrap(wrap, center - _get_wrap_origin_in_field(wrap))
	if is_instance_valid(monster_container):
		BattleHitReaction.shake(monster_container, BATTLE_HIT_SHAKE_HEAVY)


func _resolve_hit_reaction_sprite(hit_target_type: String, hit_target_index: int) -> CanvasItem:
	if hit_target_type == "monster":
		var spr: = _get_monster_battle_animated_sprite(hit_target_index)
		if spr != null:
			return spr
		if hit_target_index >= 0 and hit_target_index < monster_ui_nodes.size():
			var ui = monster_ui_nodes[hit_target_index]
			if is_instance_valid(ui):
				var slot: = ui.get_node_or_null("MonsterSpriteSlot") as Control
				if is_instance_valid(slot):
					var inner = slot.find_child("MonsterSprite", true, false)
					if inner is TextureRect:
						return inner as TextureRect
		return null
	return _get_ally_sprite_for_hit_type(hit_target_type)


func _resolve_hit_reaction_wrap(hit_target_type: String, hit_target_index: int) -> Control:
	if hit_target_type == "monster":
		if hit_target_index >= 0 and hit_target_index < monster_ui_nodes.size():
			var ui = monster_ui_nodes[hit_target_index]
			if is_instance_valid(ui):
				return ui as Control
		return null
	return _get_ally_wrap_for_hit_type(hit_target_type)


func _get_hit_target_center_in_field(hit_target_type: String, hit_target_index: int) -> Vector2:
	if hit_target_type == "monster":
		var wrap: = _resolve_hit_reaction_wrap("monster", hit_target_index)
		if is_instance_valid(wrap):
			return _get_monster_sprite_center_in_field(wrap)
		return Vector2.ZERO
	return _get_ally_sprite_center_in_field(hit_target_type)


func _is_hit_target_downed(hit_target_type: String, hit_target_index: int) -> bool:
	if game_manager == null or game_manager.battle_system == null:
		return false
	var bs = game_manager.battle_system
	match hit_target_type:
		"monster":
			if hit_target_index >= 0 and hit_target_index < bs.monsters.size():
				return not bs.is_monster_alive(bs.monsters[hit_target_index])
		"player":
			var p = _get_battle_display_player()
			return p != null and p.hp <= 0
		"pet":
			var pet = _get_battle_display_pet()
			return pet != null and pet.hp <= 0
	return false



