func _show_shengsi_replay_result(summary: Dictionary) -> void :
	_ensure_shengsi_result_overlay()
	if _shengsi_result_overlay == null:
		if game_manager and game_manager.has_method("finish_shengsi_replay_result"):
			game_manager.finish_shengsi_replay_result()
		return
	if battle_view:
		battle_view.visible = true
		battle_view.modulate.a = 1.0
	var win: = bool(summary.get("victory", false))
	if _shengsi_result_title:
		_shengsi_result_title.text = "此役独活" if win else "此役身陨"
		_shengsi_result_title.add_theme_color_override("font_color", Color(1.0, 0.86, 0.32) if win else Color(0.92, 0.42, 0.38))
	if _shengsi_result_vs:
		_shengsi_result_vs.text = "%s\nvs\n%s" % [str(summary.get("allyName", "己方")), str(summary.get("enemyName", "对手"))]
	if _shengsi_result_round:
		var rnd: = int(summary.get("round", 0))
		_shengsi_result_round.text = "第 %d 轮" % rnd if rnd > 0 else ""
		_shengsi_result_round.visible = rnd > 0
	if _shengsi_result_replay_btn:
		_shengsi_result_replay_btn.visible = bool(summary.get("canReplay", true))
	_shengsi_result_overlay.visible = true
	_refresh_shengsi_end_replay_button()
	_refresh_challenge_nav_lock()

func _hide_shengsi_replay_result() -> void :
	if _shengsi_result_overlay != null and is_instance_valid(_shengsi_result_overlay):
		_shengsi_result_overlay.visible = false
	_refresh_shengsi_end_replay_button()
	_refresh_challenge_nav_lock()

func _place_battle_bottom_btn(btn: Button, x: float, w: float) -> void :
	if btn == null or not is_instance_valid(btn):
		return
	btn.anchor_left = 0.0
	btn.anchor_top = 1.0
	btn.anchor_right = 0.0
	btn.anchor_bottom = 1.0
	btn.offset_left = x
	btn.offset_right = x + w
	btn.offset_top = -46.0
	btn.offset_bottom = -10.0
	btn.z_index = 20

func _layout_battle_bottom_action_buttons() -> void :
	var panel = get_node_or_null("MainContent/BattleView/BattlePanel") as Control
	if panel == null:
		return
	var log_btn = get_node_or_null("MainContent/BattleView/BattlePanel/LogBtn") as Button
	_ensure_battle_stance_btn()
	_ensure_shengsi_end_replay_btn()
	var buttons: Array = [log_btn, stop_battle_btn, disable_battle_anim_btn, _battle_stance_btn]
	if _shengsi_end_replay_btn != null and is_instance_valid(_shengsi_end_replay_btn) and _shengsi_end_replay_btn.visible:
		buttons.append(_shengsi_end_replay_btn)
	var valid: Array = []
	for b in buttons:
		if b != null and is_instance_valid(b) and b.visible:
			valid.append(b)
	if valid.is_empty():
		return
	var panel_w: = float(panel.size.x)
	if panel_w < 8.0:
		return
	var n: = valid.size()
	var margin: = 10.0
	var gap: = 8.0
	var w: = (panel_w - margin * 2.0 - gap * float(n - 1)) / float(n)
	if w < 56.0:
		w = 56.0
		gap = 4.0
		margin = 6.0
		w = (panel_w - margin * 2.0 - gap * float(n - 1)) / float(n)
	var x: = margin
	for b in valid:
		_place_battle_bottom_btn(b, x, w)
		x += w + gap

