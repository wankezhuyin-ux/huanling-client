[gd_resource type="Theme" load_steps=7 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/ink_serif.otf" id="1_serif"]

[sub_resource type="SystemFont" id="SystemFont_fallback"]
font_names = PackedStringArray("Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "sans-serif")

[sub_resource type="FontVariation" id="FontVariation_body"]
base_font = ExtResource("1_serif")
fallbacks = Array[Font]([SubResource("SystemFont_fallback")])

[sub_resource type="StyleBoxFlat" id="SB_scroll_track"]
content_margin_left = 0.0
content_margin_right = 0.0
bg_color = Color(0.070, 0.060, 0.045, 0.35)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_scroll_grabber"]
bg_color = Color(0.788, 0.635, 0.294, 0.55)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_scroll_grabber_hi"]
bg_color = Color(1.0, 0.788, 0.29, 0.85)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[resource]
default_font = SubResource("FontVariation_body")
HScrollBar/styles/grabber = SubResource("SB_scroll_grabber")
HScrollBar/styles/grabber_highlight = SubResource("SB_scroll_grabber_hi")
HScrollBar/styles/grabber_pressed = SubResource("SB_scroll_grabber_hi")
HScrollBar/styles/scroll = SubResource("SB_scroll_track")
VScrollBar/styles/grabber = SubResource("SB_scroll_grabber")
VScrollBar/styles/grabber_highlight = SubResource("SB_scroll_grabber_hi")
VScrollBar/styles/grabber_pressed = SubResource("SB_scroll_grabber_hi")
VScrollBar/styles/scroll = SubResource("SB_scroll_track")
